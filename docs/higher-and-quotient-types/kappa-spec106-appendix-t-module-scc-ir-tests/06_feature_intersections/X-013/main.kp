data Code : Type =
    NatCode
    PiCode
        (domain : Code)
        (codomain : decode domain -> Code)

decode : Code -> Type
let decode code decreases structural code =
    match code
    case NatCode ->
        Nat
    case PiCode domain codomain ->
        (x : decode domain) -> decode (codomain x)
keepPath :
    forall (A : Type) (x : A) (y : A).
    x = y -> x = y
let keepPath p =
    p
