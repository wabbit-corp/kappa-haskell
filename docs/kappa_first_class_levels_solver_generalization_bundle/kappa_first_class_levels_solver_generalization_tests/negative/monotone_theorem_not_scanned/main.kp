--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_UNIVERSE_VARIANCE_TOO_PERMISSIVE
--! allow_unsafe_assert_proof

expect term bump : TypeLevel -> TypeLevel

expect term bumpMonotoneProof :
    (x y : TypeLevel) ->
    (@0 p : x <= y) ->
    (bump x <= bump y) = True

data Bad.{covariant u} : Type (succ (bump u)) =
    Bad (ordinary 0 A : Type (bump u))
