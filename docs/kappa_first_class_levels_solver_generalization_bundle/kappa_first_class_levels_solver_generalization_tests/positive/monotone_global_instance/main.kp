--! mode check
--! assertNoErrors
--! assertUniverseRole Lifted 0 covariant
--! assertSelectedEvidence (Monotone bump) bumpMonotone
--! assertSchemaCertificateValid Lifted
--! assertStageDumpRoundTrips KCore
--! allow_unsafe_assert_proof

expect term bump : TypeLevel -> TypeLevel

expect term bumpMonotone :
    (x y : TypeLevel) ->
    (@0 p : x <= y) ->
    (bump x <= bump y) = True

instance Monotone bump =
    monotone = bumpMonotone

data Lifted.{u} : Type (succ (bump u)) =
    Lifted (ordinary 0 A : Type (bump u))
