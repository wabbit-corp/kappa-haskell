let buildConfig : BuildConfig =
    package
        ( name = "test.fragment_multiple_unknowns"
        , version = semver "0.0.0"
        , sourceRoots =
            [ sourceRoot "src"
            ]
        , fragmentAxes =
            [ axis "platform" [tag "native", tag "jvm"]
            , axis "mode" [tag "debug", tag "release"]
            ]
        , targets =
            [ library
                ( name = "lib"
                , backend = jvm ()
                , fragments = tags ["jvm", "debug"]
                , modules = modulesUnder "demo"
                )
            ]
        )
