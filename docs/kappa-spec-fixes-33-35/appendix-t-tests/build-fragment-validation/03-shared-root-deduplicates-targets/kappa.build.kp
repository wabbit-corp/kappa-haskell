let buildConfig : BuildConfig =
    package
        ( name = "test.fragment_shared_root"
        , version = semver "0.0.0"
        , sourceRoots =
            [ sourceRoot "src"
            ]
        , fragmentAxes =
            [ axis "platform" [tag "native", tag "jvm"]
            ]
        , targets =
            [ library
                ( name = "a"
                , backend = jvm ()
                , fragments = tags ["native"]
                , modules = modulesUnder "demo"
                )
            , library
                ( name = "b"
                , backend = jvm ()
                , fragments = tags ["jvm"]
                , modules = modulesUnder "demo"
                )
            ]
        )
