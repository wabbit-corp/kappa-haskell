module main

data Token : Type =
    Token

data LinearBox : Type =
    LinearBox (value : Int) (1 token : Token)

readValue : (1 & box : LinearBox) -> Int
let readValue box =
    box.value

useAffineBorrowOnce : (<=1 & box : LinearBox) -> Int
let useAffineBorrowOnce box =
    readValue box

--! mode check
--! assertNoErrors
--! assertTotal readValue
--! assertTotal useAffineBorrowOnce
