@PrivateByDefault module main

data Bit : Type =
    O
    I

derive Eq Bit

trait Missing

instance Missing => Equiv Bit =
    let (~=) _ _ = True
    let equivRefl _ = refl
    let equivSym _ _ _ = refl
    let equivTrans _ _ _ _ _ = refl

result : Bool
let result = O ~= I

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! requires capability fallbackInstances
--! assertNoErrors
--! assertEval result False
--! assertFallbackSelected Equiv Bit std.prelude.eqToEquivFallback
