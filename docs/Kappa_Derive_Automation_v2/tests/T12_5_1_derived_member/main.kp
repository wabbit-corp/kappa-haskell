@PrivateByDefault module main

trait LawfulIdentity (parametric 0 a : Type) =
    identity : a -> a
    derive identityLaw :
        forall (x : a). identity x = x

instance LawfulIdentity Bool =
    let identity x = x

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! assertNoErrors
--! assertDerivedMember identityLaw for LawfulIdentity Bool
