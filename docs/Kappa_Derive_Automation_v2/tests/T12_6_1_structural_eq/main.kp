@PrivateByDefault module main

data Color : Type =
    Red
    Green
    Blue
derive Eq Color

same : Bool
let same = Red == Red

different : Bool
let different = Red == Blue

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! assertNoErrors
--! assertEval same True
--! assertEval different False
--! assertDerivedInstance Eq Color
--! assertDerivedSupertrait IsSet Color from Eq Color
