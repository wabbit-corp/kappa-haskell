@PrivateByDefault module main

relation : BoolRelation Bool
let relation x y =
    match (x, y)
    case (True, False) -> False
    case _             -> True

laws : IsTotalOrder Bool relation
let laws = derive

needsAmbient : Ord Bool
let needsAmbient = laws

