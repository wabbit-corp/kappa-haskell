cabal-version:   3.8
name:            kappa-haskell
version:         0.1.0.0
synopsis:        A Haskell implementation of the Kappa language
description:
    Lexer, parser, resolver, elaborator, interpreter, prelude, CLI and
    conformance test harness for the Kappa language as specified in
    docs/Spec.md. Targets the @kappa-v1@ portable profile surface that is
    implementable without backend codegen; see SPEC_COMPLIANCE.md.
license:         MIT
license-file:    LICENSE
build-type:      Simple
extra-doc-files:
    CHANGELOG.md
    third_party/ghc-typelits-presburger/LICENSE

common warnings
    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wincomplete-patterns
        -Wmissing-export-lists -Wredundant-constraints -Wpartial-fields

common deps
    build-depends:
        , array       >=0.5
        , base        >=4.17 && <5
        , binary      >=0.8
        , bytestring  >=0.11
        , containers  >=0.6
        , directory   >=1.3
        , filepath    >=1.4
        , mtl         >=2.2
        , process     >=1.6
        , pretty      >=1.1
        , stm         >=2.5
        , text        >=2.0
        , time        >=1.12
        , transformers >=0.5

library
    import:           warnings, deps
    exposed-modules:
        Kappa.Backend.C
        Kappa.Backend.Capabilities
        Kappa.Backend.Driver
        Kappa.Backend.HeaderGen
        Kappa.Backend.IR
        Kappa.Backend.LLVM
        Kappa.Backend.NativeFfi
        Kappa.Backend.NativeProbe
        Kappa.Backend.Repr
        Kappa.Backend.Verify
        Kappa.Arithmetic
        Kappa.AsyncException
        Kappa.Builtins
        Kappa.Build.Lock
        Kappa.Build.Plan
        Kappa.Build.Provenance
        Kappa.Build.Reify
        Kappa.Build.Types
        Kappa.Cardinality
        Kappa.Check
        Kappa.Check.Arith
        Kappa.Check.Artifact
        Kappa.Check.Blocks
        Kappa.Check.CallGraph
        Kappa.Check.Comprehensions
        Kappa.Check.Decls
        Kappa.Check.Derive
        Kappa.Check.Do
        Kappa.Check.Elab
        Kappa.Check.Effects
        Kappa.Check.GeneratedPrelude
        Kappa.Check.Kernel
        Kappa.Check.Implicits
        Kappa.Check.Match
        Kappa.Check.Names
        Kappa.Check.Patch
        Kappa.Check.Pending
        Kappa.Check.Positivity
        Kappa.Check.Projections
        Kappa.Check.Quotes
        Kappa.Check.Records
        Kappa.Check.StateOps
        Kappa.Check.Support
        Kappa.Check.Totality
        Kappa.Check.Types
        Kappa.Check.Unify
        Kappa.Check.UniverseConstraints
        Kappa.Config
        Kappa.Core
        Kappa.CoreText
        Kappa.CoreLint
        Kappa.CoreOps
        Kappa.KFrontIR.Identity
        Kappa.KFrontIR.Origin
        Kappa.KFrontIR.Types
        Kappa.KFrontIR.Build
        Kappa.KFrontIR.Dump
        Kappa.KFrontIR.Expand
        Kappa.KFrontIR.Facts
        Kappa.KFrontIR.Phase
        Kappa.KFrontIR.Query
        Kappa.KFrontIR.Verify
        Kappa.DependencyFrontier
        Kappa.DirectedGraph
        Kappa.Diagnostic
        Kappa.Eval
        Kappa.Explain
        Kappa.Inhabitance
        Kappa.Interp
        Kappa.Lexer
        Kappa.Level
        Kappa.LevelEvidence
        Kappa.MonotoneWorklist
        Kappa.NominalVariance
        Kappa.Observation
        Kappa.ObservationDeps
        Kappa.Ownership
        Kappa.Parser
        Kappa.Parser.Monad
        Kappa.Pipeline
        Kappa.Prelude
        Kappa.Pretty
        Kappa.Regex
        Kappa.Representation
        Kappa.Resolve
        Kappa.SemanticHash
        Kappa.Source
        Kappa.StructuralBinary
        Kappa.Syntax
        Kappa.SyntaxOps
        Kappa.SurfaceValidation
        Kappa.TestHarness
        Kappa.Termination
        Kappa.Token
        Kappa.TypeTag
        Kappa.Unicode
        Kappa.UnicodeData
        Kappa.UniverseProjection
        Kappa.Usage

    other-modules:
        Data.Integer.SAT
        Kappa.KFrontIR.Identity.Internal
        Kappa.KFrontIR.Types.Internal

    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        MultiWayIf
        OverloadedStrings
        RecordWildCards
        StrictData

executable kappa
    import:           warnings, deps
    main-is:          Main.hs
    build-depends:    kappa-haskell
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions: LambdaCase, OverloadedStrings
    -- §18.1 concurrency runtime: the threaded RTS pinned to a single
    -- capability (-N1) realizes the single runtime agent (§18.1.5 cooperative
    -- realization) while giving a scheduler/IO-manager that delivers cross-fiber
    -- throwTo, MVar wakeups, and timers reliably (the non-threaded RTS can mis-
    -- fire the deadlock detector on a throwTo immediately followed by a wait).
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -K64m"

executable gen-kappa-prelude
    import:           warnings, deps
    main-is:          GeneratePreludeArtifact.hs
    build-depends:    kappa-haskell
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions: LambdaCase, OverloadedStrings

test-suite kappa-test
    import:           warnings, deps
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:    kappa-haskell
    hs-source-dirs:   test
    default-language: GHC2021
    default-extensions: LambdaCase, OverloadedStrings
    -- same RTS settings as the executable (single-capability threaded runtime,
    -- 64m stack), so in-process fixtures behave identically to the CLI
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -K64m"

test-suite kappa-async-wake-test
    import:           warnings, deps
    type:             exitcode-stdio-1.0
    main-is:          AsyncWakeSpec.hs
    build-depends:    kappa-haskell
    hs-source-dirs:   test
    default-language: GHC2021
    default-extensions: DerivingStrategies
    ghc-options:      -threaded
