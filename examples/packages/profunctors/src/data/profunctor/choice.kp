module data.profunctor.choice

import data.profunctor.core.*

import data.bifunctor.*
import data.either.*

trait Profunctor p => Choice p =
    leftP : forall a b c.
        p a b -> p (Either a c) (Either b c)
    rightP : forall a b c.
        p a b -> p (Either c a) (Either c b)

instance Choice Fn =
    let leftP value =
        match value
        case MkFn function ->
            MkFn (\choice ->
                match choice
                case Left a -> Left (function a)
                case Right c -> Right c)
    let rightP value =
        match value
        case MkFn function ->
            MkFn (\choice ->
                match choice
                case Left c -> Left c
                case Right a -> Right (function a))

instance (Functor f, Applicative f) => Choice (Star f) =
    let leftP value =
        match value
        case MkStar function ->
            MkStar (\choice ->
                match choice
                case Left a -> map (\b -> Left b) (function a)
                case Right c -> pure (Right c))
    let rightP value =
        match value
        case MkStar function ->
            MkStar (\choice ->
                match choice
                case Left c -> pure (Left c)
                case Right a -> map (\b -> Right b) (function a))
