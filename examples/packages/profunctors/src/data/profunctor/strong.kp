module data.profunctor.strong

import data.bifunctor.*
import data.profunctor.core.*

trait Profunctor p => Strong p =
    firstP : forall a b c. p a b -> p (PairF a c) (PairF b c)
    secondP : forall a b c. p a b -> p (PairF c a) (PairF c b)

instance Strong Fn =
    let firstP value =
        match value
        case MkFn function ->
            MkFn (\pair ->
                match pair
                case PairF a c -> PairF (function a) c)
    let secondP value =
        match value
        case MkFn function ->
            MkFn (\pair ->
                match pair
                case PairF c a -> PairF c (function a))

instance Functor f => Strong (Star f) =
    let firstP value =
        match value
        case MkStar function ->
            MkStar (\pair ->
                match pair
                case PairF a c -> map (\b -> PairF b c) (function a))
    let secondP value =
        match value
        case MkStar function ->
            MkStar (\pair ->
                match pair
                case PairF c a -> map (\b -> PairF c b) (function a))
