module delve.config

import delve.core.*
import delve.natutil.*
import delve.files as files
import delve.json as json

-- Delve content packs follow the Minecraft/Hytale lesson: gameplay content is
-- authored as JSON data assets, then checked into typed Kappa definitions before
-- the engine uses it.

defaultPackFile : String
let defaultPackFile = "assets/delve/pack.json"

loadDefault : IO GameError ContentPack
let loadDefault = loadPack defaultPackFile

decodeRecipe : json.JsonValue -> IO GameError RecipeDef
let decodeRecipe value =
    do
        let id <- stringField "id" value
        let label <- stringField "label" value
        let inputName <- stringField "input" value
        let input <- decodeItemKind inputName
        let outputName <- stringField "output" value
        let output <- decodeItemKind outputName
        let toolName <- stringField "tool" value
        let tool <- decodeItemClass toolName
        let skill <- stringField "skill" value
        let minLevel <- intField "min_level" value
        pure (RecipeDef id label input output tool skill minLevel)

loadRecipes : String -> IO GameError (List RecipeDef)
let loadRecipes path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "recipes" root
        traverse decodeRecipe xs

decodeRarity : json.JsonValue -> IO GameError RarityDef
let decodeRarity value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let color <- stringField "color" value
        let weight <- intField "weight" value
        pure (RarityDef id name color weight)

loadRarities : String -> IO GameError (List RarityDef)
let loadRarities path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "rarities" root
        traverse decodeRarity xs

loadPack : String -> IO GameError ContentPack
let loadPack packPath =
    do
        let packJson <- readJsonFile packPath
        let filesObject <- objectField "files" packJson
        let saveObject <- objectField "save" packJson
        let rulesObject <- objectField "rules" packJson
        let revealObject <- objectField "reveal" packJson
        let packId <- stringField "pack_id" packJson
        let version <- stringField "version" packJson
        let worldPath <- filePath "worldgen" filesObject
        let itemPath <- filePath "items" filesObject
        let actorPath <- filePath "actors" filesObject
        let systemPath <- filePath "systems" filesObject
        let spawnPath <- filePath "spawns" filesObject
        let lorePath <- filePath "lore" filesObject
        let recipePath <- filePath "recipes" filesObject
        let rarityPath <- filePath "rarities" filesObject
        let colorPath <- filePath "colors" filesObject
        let skillsPath <- filePath "skills" filesObject
        let spellsPath <- filePath "spells" filesObject
        let statusPath <- filePath "status_effects" filesObject
        let tuningPath <- filePath "tuning" filesObject
        let tilesPath <- filePath "tiles" filesObject
        let world <- loadWorldGen worldPath
        let branches <- loadBranches worldPath
        let items <- loadItems itemPath
        let affixes <- loadAffixes itemPath
        let actors <- loadActors actorPath
        let systems <- loadSystems systemPath
        let spawns <- loadSpawns spawnPath
        let lore <- loadLore lorePath
        let recipes <- loadRecipes recipePath
        let rarities <- loadRarities rarityPath
        let colors <- loadColors colorPath
        let skills <- loadSkills skillsPath
        let spells <- loadSpells spellsPath
        let statuses <- loadStatuses statusPath
        let tuning <- loadTuning tuningPath
        let tileEffects <- loadTileEffects tilesPath
        let save <- decodeSave saveObject
        let rules <- decodeRules rulesObject
        let reveal <- decodeReveal revealObject
        let pack =
            ContentPack {
                packId = packId,
                version = version,
                rules = rules,
                worldgen = world,
                save = save,
                items = items,
                actors = actors,
                monsterSpawns = spawns.monsters,
                itemSpawns = spawns.items,
                tactics = systems.tactics,
                starSigns = systems.starSigns,
                mutations = systems.mutations,
                faiths = systems.faiths,
                rumors = lore,
                affixes = affixes,
                branches = branches,
                languages = systems.languages,
                structures = spawns.structures,
                recipes = recipes,
                rarities = rarities,
                colors = colors,
                skills = skills,
                reveal = reveal,
                spells = spells,
                statuses = statuses,
                tuning = tuning,
                tileEffects = tileEffects
            }
        validateContentPack pack

readJsonFile : String -> IO GameError json.JsonValue
let readJsonFile path =
    do
        let text <- files.readText path
        match json.parse text
        case Ok value -> pure value
        case Err e -> raise e

filePath : String -> json.JsonValue -> IO GameError String
let filePath name obj =
    match json.objectField name obj
    case Some v ->
        match json.asString v
        case Ok s -> pure s
        case Err e -> raise e
    case None -> raise (ConfigError ("pack file missing path for " ++ name))

stringField : String -> json.JsonValue -> IO GameError String
let stringField name obj =
    match json.require name obj
    case Ok v ->
        match json.asString v
        case Ok s -> pure s
        case Err e -> raise e
    case Err e -> raise e

intField : String -> json.JsonValue -> IO GameError Int
let intField name obj =
    match json.require name obj
    case Ok v ->
        match json.asInt v
        case Ok n -> pure n
        case Err e -> raise e
    case Err e -> raise e

optionalIntField : Int -> String -> json.JsonValue -> IO GameError Int
let optionalIntField fallback name obj =
    match json.objectField name obj
    case None -> pure fallback
    case Some v ->
        match json.asInt v
        case Ok n -> pure n
        case Err e -> raise e

boolField : String -> json.JsonValue -> IO GameError Bool
let boolField name obj =
    match json.require name obj
    case Ok v ->
        match json.asBool v
        case Ok b -> pure b
        case Err e -> raise e
    case Err e -> raise e

arrayField : String -> json.JsonValue -> IO GameError (List json.JsonValue)
let arrayField name obj =
    match json.require name obj
    case Ok v ->
        match json.asArray v
        case Ok xs -> pure xs
        case Err e -> raise e
    case Err e -> raise e

objectField : String -> json.JsonValue -> IO GameError json.JsonValue
let objectField name obj =
    match json.require name obj
    case Ok v -> pure v
    case Err e -> raise e

optStringField : String -> String -> json.JsonValue -> IO GameError String
let optStringField fallback name obj =
    match json.objectField name obj
    case None -> pure fallback
    case Some v ->
        match json.asString v
        case Ok s -> pure s
        case Err e -> raise e

decodeDamageType : String -> IO GameError DamageType
let decodeDamageType s =
    if s == "physical" then pure Physical
    elif s == "fire" then pure Fire
    elif s == "cold" then pure Cold
    elif s == "poison" then pure Poison
    elif s == "chaos" then pure Chaos
    else raise (ConfigError ("unknown damage type: " ++ s))

decodeStatKind : String -> IO GameError StatKind
let decodeStatKind s =
    if s == "str" then pure StrStat
    elif s == "dex" then pure DexStat
    elif s == "def" then pure DefStat
    else raise (ConfigError ("unknown stat: " ++ s))

-- One effect (every verb except chance). decodeEffect wraps this to add chance,
-- so neither is self-recursive — chance holds a flat list of simple effects.
decodeSimpleEffect : json.JsonValue -> IO GameError Effect
let decodeSimpleEffect value =
    do
        let kind <- stringField "kind" value
        if kind == "deal_damage" then
            do
                let elemName <- stringField "element" value
                let dt <- decodeDamageType elemName
                let amount <- intField "amount" value
                pure (DealDamage dt amount)
        elif kind == "heal" then
            do
                let amount <- intField "amount" value
                let clear <- boolField "clear_wounds" value
                pure (Heal amount clear)
        elif kind == "corrupt" then
            do
                let amount <- intField "amount" value
                pure (Corrupt amount)
        elif kind == "add_corruption" then
            do
                let amount <- intField "amount" value
                pure (AddCorruption amount)
        elif kind == "gain_mutation" then pure GainMutation
        elif kind == "boost_stat" then
            do
                let statName <- stringField "stat" value
                let sk <- decodeStatKind statName
                let n <- intField "n" value
                pure (BoostStat sk n)
        elif kind == "nourish" then
            do
                let amount <- intField "amount" value
                pure (Nourish amount)
        elif kind == "grant_species_resist" then pure GrantSpeciesResist
        elif kind == "douse_tile" then pure DouseTile
        elif kind == "reveal_area" then
            do
                let radius <- intField "radius" value
                pure (RevealArea radius)
        elif kind == "reveal_map" then pure RevealMap
        elif kind == "make_noise" then
            do
                let loudness <- intField "loudness" value
                pure (MakeNoise loudness)
        elif kind == "spawn_phantom" then
            do
                let turns <- intField "turns" value
                pure (SpawnPhantom turns)
        elif kind == "ward_tile" then pure WardTile
        elif kind == "identify_inventory" then pure IdentifyInventory
        elif kind == "learn_taught_spell" then pure LearnTaughtSpell
        elif kind == "cleanse_corruption" then pure CleanseCorruption
        elif kind == "inflict" then
            do
                let elemName <- stringField "element" value
                let dt <- decodeDamageType elemName
                let magnitude <- intField "magnitude" value
                pure (Inflict dt magnitude)
        elif kind == "set_attitude" then
            do
                let attName <- stringField "attitude" value
                let att <- decodeAttitude attName
                pure (SetAttitude att)
        elif kind == "set_faction" then
            do
                let facName <- stringField "faction" value
                let fac <- decodeFaction facName
                pure (SetFaction fac)
        elif kind == "message" then
            do
                let text <- stringField "text" value
                pure (Message text)
        elif kind == "noop" then pure Noop
        else raise (ConfigError ("unknown effect kind: " ++ kind))

decodeEffect : json.JsonValue -> IO GameError Effect
let decodeEffect value =
    do
        let kind <- stringField "kind" value
        if kind == "chance" then
            do
                let pct <- intField "pct" value
                let subVals <- arrayField "effects" value
                let fxs <- traverse decodeSimpleEffect subVals
                pure (Chance pct fxs)
        else decodeSimpleEffect value

decodeEffectsField : String -> json.JsonValue -> IO GameError (List Effect)
let decodeEffectsField name obj =
    match json.objectField name obj
    case None -> pure Nil
    case Some v ->
        match json.asArray v
        case Err e -> raise e
        case Ok xs -> traverse decodeEffect xs

decodeTileKindName : String -> IO GameError TileKind
let decodeTileKindName s =
    if s == "trap" then pure Trap
    elif s == "lava" then pure Lava
    elif s == "chaos_vent" then pure ChaosVent
    elif s == "water" then pure Water
    else raise (ConfigError ("unknown tile kind for effects: " ++ s))

decodeTileEffect : json.JsonValue -> IO GameError TileEffectDef
let decodeTileEffect value =
    do
        let kindName <- stringField "kind" value
        let kind <- decodeTileKindName kindName
        let onEnter <- decodeEffectsField "on_enter" value
        let perTurn <- decodeEffectsField "per_turn" value
        pure (TileEffectDef kind onEnter perTurn)

loadTileEffects : String -> IO GameError (List TileEffectDef)
let loadTileEffects path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "tiles" root
        traverse decodeTileEffect xs

optDamageType : String -> json.JsonValue -> IO GameError DamageType
let optDamageType name obj =
    match json.objectField name obj
    case None -> pure Physical
    case Some v ->
        match json.asString v
        case Ok s -> decodeDamageType s
        case Err e -> raise e

optDamageTypes : String -> json.JsonValue -> IO GameError (List DamageType)
let optDamageTypes name obj =
    match json.objectField name obj
    case None -> pure Nil
    case Some v ->
        match json.asArray v
        case Err e -> raise e
        case Ok xs ->
            do
                let strs <- traverse decodeStringFromJson xs
                traverse decodeDamageType strs

optDamageTypeOption : String -> json.JsonValue -> IO GameError (Option DamageType)
let optDamageTypeOption name obj =
    match json.objectField name obj
    case None -> pure None
    case Some v ->
        match json.asString v
        case Ok s ->
            do
                let dt <- decodeDamageType s
                pure (Some dt)
        case Err e -> raise e

decodeColor : json.JsonValue -> IO GameError ColorDef
let decodeColor value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let r <- intField "r" value
        let g <- intField "g" value
        let b <- intField "b" value
        pure (ColorDef id name r g b)

loadColors : String -> IO GameError (List ColorDef)
let loadColors path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "colors" root
        traverse decodeColor xs

decodeSpell : json.JsonValue -> IO GameError SpellDef
let decodeSpell value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let manaCost <- intField "mana_cost" value
        let skillRequired <- stringField "skill_required" value
        let skillMinLevel <- intField "skill_min_level" value
        let needsTarget <- boolField "needs_target" value
        let flavor <- optStringField "" "flavor" value
        let effects <- decodeEffectsField "effects" value
        pure (SpellDef id name manaCost skillRequired skillMinLevel needsTarget flavor effects)

loadSpells : String -> IO GameError (List SpellDef)
let loadSpells path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "spells" root
        traverse decodeSpell xs

decodeStatus : json.JsonValue -> IO GameError StatusDef
let decodeStatus value =
    do
        let elementName <- stringField "element" value
        let dt <- decodeDamageType elementName
        let chance <- intField "chance" value
        let magnitude <- intField "magnitude" value
        let perTurn <- intField "per_turn" value
        pure (StatusDef dt chance magnitude perTurn)

loadStatuses : String -> IO GameError (List StatusDef)
let loadStatuses path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "statuses" root
        traverse decodeStatus xs

hasStatusElement : List StatusDef -> DamageType -> Bool
let hasStatusElement xs dt decreases listLength xs =
    match xs
    case Nil -> False
    case s :: rest -> if s.element == dt then True else hasStatusElement rest dt

decodeTuning : json.JsonValue -> IO GameError TuningConfig
let decodeTuning value =
    do
        let attackDie <- intField "attack_die" value
        let defenseBase <- intField "defense_base" value
        let damageSpread <- intField "damage_spread" value
        let stunThreshold <- intField "stun_threshold" value
        let stunTurns <- intField "stun_turns" value
        let headBonus <- intField "head_bonus" value
        let legBleedSeverity <- intField "leg_bleed_severity" value
        let armBruiseSeverity <- intField "arm_bruise_severity" value
        let torsoBruiseSeverity <- intField "torso_bruise_severity" value
        let crippledPenalty <- intField "crippled_penalty" value
        let bleedSurcharge <- intField "bleed_surcharge" value
        let xpFactor <- intField "xp_factor" value
        let levelHpGain <- intField "level_hp_gain" value
        let levelStrGain <- intField "level_str_gain" value
        let levelLoyaltyGain <- intField "level_loyalty_gain" value
        let trapDamage <- intField "trap_damage" value
        let lavaDamage <- intField "lava_damage" value
        let chaosVentCorruption <- intField "chaos_vent_corruption" value
        let starvationDamage <- intField "starvation_damage" value
        let emberlanceDamage <- intField "emberlance_damage" value
        let manaRegen <- intField "mana_regen" value
        let poolHealBand <- intField "pool_heal_band" value
        let poolPoisonBand <- intField "pool_poison_band" value
        let poolNothingBand <- intField "pool_nothing_band" value
        let poolCorruptBand <- intField "pool_corrupt_band" value
        let poolHealAmount <- intField "pool_heal_amount" value
        let poolPoisonAmount <- intField "pool_poison_amount" value
        let poolCorruptAmount <- intField "pool_corrupt_amount" value
        let feedTameBand <- intField "feed_tame_band" value
        let feedPacifyBand <- intField "feed_pacify_band" value
        pure (TuningConfig {
            attackDie = attackDie,
            defenseBase = defenseBase,
            damageSpread = damageSpread,
            stunThreshold = stunThreshold,
            stunTurns = stunTurns,
            headBonus = headBonus,
            legBleedSeverity = legBleedSeverity,
            armBruiseSeverity = armBruiseSeverity,
            torsoBruiseSeverity = torsoBruiseSeverity,
            crippledPenalty = crippledPenalty,
            bleedSurcharge = bleedSurcharge,
            xpFactor = xpFactor,
            levelHpGain = levelHpGain,
            levelStrGain = levelStrGain,
            levelLoyaltyGain = levelLoyaltyGain,
            trapDamage = trapDamage,
            lavaDamage = lavaDamage,
            chaosVentCorruption = chaosVentCorruption,
            starvationDamage = starvationDamage,
            emberlanceDamage = emberlanceDamage,
            manaRegen = manaRegen,
            poolHealBand = poolHealBand,
            poolPoisonBand = poolPoisonBand,
            poolNothingBand = poolNothingBand,
            poolCorruptBand = poolCorruptBand,
            poolHealAmount = poolHealAmount,
            poolPoisonAmount = poolPoisonAmount,
            poolCorruptAmount = poolCorruptAmount,
            feedTameBand = feedTameBand,
            feedPacifyBand = feedPacifyBand
        })

loadTuning : String -> IO GameError TuningConfig
let loadTuning path =
    do
        let root <- readJsonFile path
        decodeTuning root

decodeSkill : json.JsonValue -> IO GameError SkillDef
let decodeSkill value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let maxLevel <- intField "max_level" value
        pure (SkillDef id name maxLevel)

loadSkills : String -> IO GameError (List SkillDef)
let loadSkills path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "skills" root
        traverse decodeSkill xs

decodeReveal : json.JsonValue -> IO GameError RevealConfig
let decodeReveal value =
    do
        let vagueAt <- intField "vague_at" value
        let approxAt <- intField "approx_at" value
        let knownAt <- intField "known_at" value
        let vagueTough <- stringField "vague_tough" value
        let vagueWeak <- stringField "vague_weak" value
        let vagueNeutral <- stringField "vague_neutral" value
        pure (RevealConfig vagueAt approxAt knownAt vagueTough vagueWeak vagueNeutral)

loadWorldGen : String -> IO GameError WorldGenConfig
let loadWorldGen path =
    do
        let root <- readJsonFile path
        let wg <- objectField "worldgen" root
        let map <- objectField "map" wg
        let room <- objectField "room" wg
        let spawn <- objectField "spawn" wg
        let features <- objectField "features" wg
        let minWidth <- intField "min_width" map
        let maxWidth <- intField "max_width" map
        let minHeight <- intField "min_height" map
        let maxHeight <- intField "max_height" map
        let minSize <- intField "min_size" room
        let maxSize <- intField "max_size" room
        let attempts <- intField "attempts" room
        let monsterBase <- intField "monster_base_chance" spawn
        let monsterPerDepth <- intField "monster_chance_per_depth" spawn
        let itemChance <- intField "item_chance" spawn
        let altarChance <- intField "altar_chance" features
        let loreChance <- intField "lore_stone_chance" features
        let trapBase <- intField "trap_base_chance" features
        let trapDepth <- intField "trap_chance_per_depth" features
        let chaosBase <- intField "chaos_vent_base_chance" features
        let chaosDepth <- intField "chaos_vent_chance_per_depth" features
        let chaosSpread <- intField "chaos_vent_spread_chance" features
        let poolChance <- intField "pool_chance" features
        if minWidth < 20 || maxWidth < minWidth || minHeight < 10 || maxHeight < minHeight then
            raise (ConfigError "worldgen map size limits are invalid")
        elif minSize < 3 || maxSize < minSize then
            raise (ConfigError "worldgen room sizes must satisfy 3 <= min <= max")
        elif attempts < 2 then
            raise (ConfigError "worldgen room attempts must be at least 2")
        elif maxSize > minWidth - 6 || maxSize > minHeight - 6 then
            raise (ConfigError "worldgen max room size does not fit inside the minimum map size")
        else
            pure (WorldGenConfig minWidth maxWidth minHeight maxHeight minSize maxSize attempts monsterBase monsterPerDepth itemChance altarChance loreChance trapBase trapDepth chaosBase chaosDepth chaosSpread poolChance)

decodeBranch : json.JsonValue -> IO GameError BranchDef
let decodeBranch value =
    do
        let id <- intField "id" value
        let name <- stringField "name" value
        let entranceDepth <- intField "entrance_depth" value
        let floors <- intField "floors" value
        let bossName <- stringField "boss" value
        let boss <- decodeSpecies bossName
        pure (BranchDef id name entranceDepth floors boss)

loadBranches : String -> IO GameError (List BranchDef)
let loadBranches path =
    do
        let root <- readJsonFile path
        match json.objectField "branches" root
        case None -> pure Nil
        case Some arrv ->
            match json.asArray arrv
            case Ok xs -> traverse decodeBranch xs
            case Err e -> raise e

loadItems : String -> IO GameError (List ItemDef)
let loadItems path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "items" root
        traverse decodeItem xs

decodeItem : json.JsonValue -> IO GameError ItemDef
let decodeItem value =
    do
        let id <- stringField "id" value
        let kindName <- stringField "kind" value
        let kind <- decodeItemKind kindName
        let name <- stringField "name" value
        let trueName <- stringField "true_name" value
        let glyph <- stringField "glyph" value
        let className <- stringField "class" value
        let cls <- decodeItemClass className
        let stackable <- boolField "stackable" value
        let power <- intField "power" value
        let charges <- intField "charges" value
        let identified <- boolField "starts_identified" value
        let beatitudeKnown <- boolField "beatitude_known" value
        let flammable <- boolField "flammable" value
        let damageType <- optDamageType "damage_type" value
        let baseUse <- decodeEffectsField "use_effects" value
        let blessedRaw <- decodeEffectsField "use_effects_blessed" value
        let cursedRaw <- decodeEffectsField "use_effects_cursed" value
        let useBlessed = if listLength blessedRaw == 0 then baseUse else blessedRaw
        let useCursed = if listLength cursedRaw == 0 then baseUse else cursedRaw
        pure (ItemDef id kind name trueName glyph cls stackable power charges identified beatitudeKnown flammable damageType useBlessed baseUse useCursed)

decodeAffix : json.JsonValue -> IO GameError ItemAffix
let decodeAffix value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let className <- stringField "class" value
        let cls <- decodeItemClass className
        let powerBonus <- intField "power_bonus" value
        let weight <- intField "weight" value
        pure (ItemAffix id name cls powerBonus weight)

loadAffixes : String -> IO GameError (List ItemAffix)
let loadAffixes path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "affixes" root
        traverse decodeAffix xs

loadActors : String -> IO GameError (List ActorDef)
let loadActors path =
    do
        let root <- readJsonFile path
        let xs <- arrayField "actors" root
        traverse decodeActor xs

abilityWith : (Int -> Ability) -> String -> json.JsonValue -> IO GameError Ability
let abilityWith mk fieldName value =
    do
        let n <- intField fieldName value
        pure (mk n)

decodeAbilityKind : String -> json.JsonValue -> IO GameError Ability
let decodeAbilityKind kind value =
    if kind == "Regenerate" then abilityWith Regenerate "amount" value
    elif kind == "Ranged" then abilityWith Ranged "power" value
    elif kind == "Frenzy" then pure Frenzy
    else raise (ConfigError ("unknown ability kind: " ++ kind))

decodeAbility : json.JsonValue -> IO GameError Ability
let decodeAbility value =
    do
        let kind <- stringField "kind" value
        decodeAbilityKind kind value

decodeActor : json.JsonValue -> IO GameError ActorDef
let decodeActor value =
    do
        let id <- stringField "id" value
        let speciesName <- stringField "species" value
        let species <- decodeSpecies speciesName
        let name <- stringField "name" value
        let glyph <- stringField "glyph" value
        let factionName <- stringField "faction" value
        let faction <- decodeFaction factionName
        let attitudeName <- stringField "attitude" value
        let attitude <- decodeAttitude attitudeName
        let statsJson <- objectField "stats" value
        let stats <- decodeStats statsJson
        let morale <- intField "morale" value
        let loyalty <- intField "loyalty" value
        let invJson <- arrayField "inventory" value
        let inv <- traverse decodeItemKindFromJson invJson
        let tagJson <- arrayField "tags" value
        let tags <- traverse decodeStringFromJson tagJson
        let abilityJson <- arrayField "abilities" value
        let abilities <- traverse decodeAbility abilityJson
        let description <- stringField "description" value
        let sightRange <- intField "sight_range" value
        let hearing <- intField "hearing" value
        let language <- stringField "language" value
        let corpseNutrition <- intField "corpse_nutrition" value
        let resistances <- optDamageTypes "resistances" value
        let vulnerabilities <- optDamageTypes "vulnerabilities" value
        let rangedElement <- optDamageType "ranged_element" value
        let corpseEffects <- decodeEffectsField "corpse_effects" value
        pure (ActorDef id species name glyph stats attitude faction morale loyalty inv tags abilities description sightRange hearing language corpseNutrition resistances vulnerabilities rangedElement corpseEffects)

decodeStats : json.JsonValue -> IO GameError Stats
let decodeStats value =
    do
        let hp <- intField "hp" value
        let maxHp <- intField "max_hp" value
        let mp <- intField "mp" value
        let maxMp <- intField "max_mp" value
        let strength <- intField "str" value
        let dex <- intField "dex" value
        let defense <- intField "def" value
        let xp <- intField "xp" value
        let level <- intField "level" value
        pure (Stats hp maxHp mp maxMp strength dex defense xp level)

loadSpawns : String -> IO GameError (monsters : List SpawnRule, items : List SpawnRule, structures : List StructureDef)
let loadSpawns path =
    do
        let root <- readJsonFile path
        let monsterJson <- arrayField "monster_spawns" root
        let itemJson <- arrayField "item_spawns" root
        let structureJson <- arrayField "structures" root
        let monsters <- traverse decodeSpawn monsterJson
        let items <- traverse decodeSpawn itemJson
        let structures <- traverse decodeStructure structureJson
        pure (monsters = monsters, items = items, structures = structures)

decodeStructureMember : json.JsonValue -> IO GameError StructureMember
let decodeStructureMember value =
    do
        let speciesName <- stringField "species" value
        let species <- decodeSpecies speciesName
        let minCount <- intField "min" value
        let maxCount <- intField "max" value
        pure (StructureMember species minCount maxCount)

decodeStructure : json.JsonValue -> IO GameError StructureDef
let decodeStructure value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let branch <- optionalIntField 0 "branch" value
        let minDepth <- intField "min_depth" value
        let maxDepth <- intField "max_depth" value
        let weight <- intField "weight" value
        let fire <- boolField "fire" value
        let memberJson <- arrayField "members" value
        let members <- traverse decodeStructureMember memberJson
        let lootJson <- arrayField "loot" value
        let loot <- traverse decodeItemKindFromJson lootJson
        pure (StructureDef id name branch minDepth maxDepth weight fire members loot)

decodeSpawn : json.JsonValue -> IO GameError SpawnRule
let decodeSpawn value =
    do
        let id <- stringField "id" value
        let minDepth <- intField "min_depth" value
        let maxDepth <- intField "max_depth" value
        let weight <- intField "weight" value
        let branch <- optionalIntField 0 "branch" value
        if minDepth < 1 || maxDepth < minDepth || weight < 1 then
            raise (ConfigError ("invalid spawn rule for " ++ id))
        else pure (SpawnRule id minDepth maxDepth weight branch)

loadSystems : String -> IO GameError (tactics : List TacticDef, starSigns : List StarSignDef, mutations : List MutationDef, faiths : List FaithDef, languages : List LanguageDef)
let loadSystems path =
    do
        let root <- readJsonFile path
        let tacticJson <- arrayField "tactics" root
        let signJson <- arrayField "star_signs" root
        let mutationJson <- arrayField "mutations" root
        let faithJson <- arrayField "faiths" root
        let languageJson <- arrayField "languages" root
        let tactics <- traverse decodeTactic tacticJson
        let signs <- traverse decodeStarSign signJson
        let mutations <- traverse decodeMutation mutationJson
        let faiths <- traverse decodeFaith faithJson
        let languages <- traverse decodeLanguage languageJson
        pure (tactics = tactics, starSigns = signs, mutations = mutations, faiths = faiths, languages = languages)

decodeLexEntry : json.JsonValue -> IO GameError LexEntry
let decodeLexEntry value =
    do
        let key <- stringField "key" value
        let word <- stringField "word" value
        pure (LexEntry key word)

decodeLanguage : json.JsonValue -> IO GameError LanguageDef
let decodeLanguage value =
    do
        let id <- stringField "id" value
        let name <- stringField "name" value
        let sylJson <- arrayField "syllables" value
        let syllables <- traverse decodeStringFromJson sylJson
        let lexJson <- arrayField "lexicon" value
        let lexicon <- traverse decodeLexEntry lexJson
        pure (LanguageDef id name syllables lexicon)

decodeTactic : json.JsonValue -> IO GameError TacticDef
let decodeTactic value =
    do
        let id <- stringField "id" value
        let tactic <- decodeTacticId id
        let name <- stringField "name" value
        let attack <- intField "attack" value
        let damage <- intField "damage" value
        let defense <- intField "defense" value
        let hunger <- intField "hunger" value
        let description <- stringField "description" value
        pure (TacticDef tactic name attack damage defense hunger description)

decodeStarSign : json.JsonValue -> IO GameError StarSignDef
let decodeStarSign value =
    do
        let id <- stringField "id" value
        let sign <- decodeStarSignId id
        let name <- stringField "name" value
        let description <- stringField "description" value
        let hp <- optionalIntField 0 "hp_bonus" value
        let mp <- optionalIntField 0 "mp_bonus" value
        let strength <- optionalIntField 0 "str_bonus" value
        let dex <- optionalIntField 0 "dex_bonus" value
        let defense <- optionalIntField 0 "def_bonus" value
        let hunger <- optionalIntField 0 "hunger_bonus" value
        let resistance <- intField "corruption_resistance" value
        pure (StarSignDef sign name description hp mp strength dex defense hunger resistance)

decodeMutation : json.JsonValue -> IO GameError MutationDef
let decodeMutation value =
    do
        let id <- stringField "id" value
        let mutation <- decodeMutationId id
        let name <- stringField "name" value
        let hp <- optionalIntField 0 "hp_bonus" value
        let mp <- optionalIntField 0 "mp_bonus" value
        let strength <- optionalIntField 0 "str_bonus" value
        let dex <- optionalIntField 0 "dex_bonus" value
        let defense <- optionalIntField 0 "def_bonus" value
        let hunger <- intField "hunger_tax" value
        let description <- stringField "description" value
        let dealsDamageType <- optDamageTypeOption "damage_type" value
        pure (MutationDef mutation name hp mp strength dex defense hunger description dealsDamageType)

decodeFaith : json.JsonValue -> IO GameError FaithDef
let decodeFaith value =
    do
        let id <- stringField "id" value
        let faith <- decodeFaithId id
        let name <- stringField "name" value
        let alignment <- stringField "alignment" value
        pure (FaithDef faith name alignment)

loadLore : String -> IO GameError (List Rumor)
let loadLore path =
    do
        let root <- readJsonFile path
        let rumorJson <- arrayField "rumors" root
        let texts <- traverse decodeStringFromJson rumorJson
        pure (map Rumor texts)

decodeSave : json.JsonValue -> IO GameError SaveConfig
let decodeSave value =
    do
        let directory <- stringField "directory" value
        let path <- stringField "path" value
        let version <- intField "format_version" value
        let autosave <- boolField "autosave_on_quit" value
        pure (SaveConfig directory path version autosave)


decodeRules : json.JsonValue -> IO GameError RulesConfig
let decodeRules value =
    do
        let hunger <- intField "starting_hunger" value
        let limit <- intField "message_limit" value
        if hunger <= 0 then raise (ConfigError "starting_hunger must be positive")
        elif limit <= 0 then raise (ConfigError "message_limit must be positive")
        else pure (RulesConfig hunger (intToNat limit))


decodeStringFromJson : json.JsonValue -> IO GameError String
let decodeStringFromJson value =
    match json.asString value
    case Ok s -> pure s
    case Err e -> raise e

decodeItemKindFromJson : json.JsonValue -> IO GameError ItemKind
let decodeItemKindFromJson value =
    do
        let text <- decodeStringFromJson value
        decodeItemKind text

decodeItemKind : String -> IO GameError ItemKind
let decodeItemKind s =
    if s == "Gold" then pure Gold
    elif s == "PotionHealing" then pure PotionHealing
    elif s == "PotionMutation" then pure PotionMutation
    elif s == "PotionWater" then pure PotionWater
    elif s == "ScrollIdentify" then pure ScrollIdentify
    elif s == "ScrollMapping" then pure ScrollMapping
    elif s == "ScrollWard" then pure ScrollWard
    elif s == "FoodRation" then pure FoodRation
    elif s == "Dagger" then pure Dagger
    elif s == "Sword" then pure Sword
    elif s == "Mace" then pure Mace
    elif s == "LeatherArmor" then pure LeatherArmor
    elif s == "ChainMail" then pure ChainMail
    elif s == "WandFire" then pure WandFire
    elif s == "WandDigging" then pure WandDigging
    elif s == "WandPolymorph" then pure WandPolymorph
    elif s == "HolySymbol" then pure HolySymbol
    elif s == "Corpse" then pure Corpse
    elif s == "Bones" then pure Bones
    elif s == "Mushroom" then pure Mushroom
    elif s == "BoneCharm" then pure BoneCharm
    elif s == "ChaosShard" then pure ChaosShard
    elif s == "Amulet" then pure Amulet
    elif s == "Tome" then pure Tome
    else raise (ConfigError ("unknown item kind: " ++ s))

decodeItemClass : String -> IO GameError ItemClass
let decodeItemClass s =
    if s == "CoinClass" then pure CoinClass
    elif s == "PotionClass" then pure PotionClass
    elif s == "ScrollClass" then pure ScrollClass
    elif s == "FoodClass" then pure FoodClass
    elif s == "WeaponClass" then pure WeaponClass
    elif s == "ArmorClass" then pure ArmorClass
    elif s == "WandClass" then pure WandClass
    elif s == "ToolClass" then pure ToolClass
    elif s == "CorpseClass" then pure CorpseClass
    elif s == "ArtifactClass" then pure ArtifactClass
    else raise (ConfigError ("unknown item class: " ++ s))

