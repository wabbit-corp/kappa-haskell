module recursion_schemes.run_tests

import data.functor.foldable.*

sumLayer : ListF Int Int -> Int
let sumLayer layer =
    match layer
    case NilF -> 0
    case ConsF head tail -> addInt head tail

sumParaLayer : ListF Int (LayerResult (List Int) Int) -> Int
let sumParaLayer layer =
    match layer
    case NilF -> 0
    case ConsF head tail -> addInt head tail.result

catamorphismWorks : Bool
let catamorphismWorks = eqInt (cata sumLayer [1, 2, 3, 4]) 10

paramorphismWorks : Bool
let paramorphismWorks = eqInt (para sumParaLayer [1, 2, 3, 4]) 10

projectEmbedWorks : Bool
let projectEmbedWorks = eqInt (cata sumLayer (embed (project [10, 20, 12]))) 42

line : String -> Bool -> String
let line name ok = stringAppend name (if ok then ": PASS" else ": FAIL")

main : UIO Unit
let main = do
    printlnString (line "recursion-schemes.cata" catamorphismWorks)
    printlnString (line "recursion-schemes.para" paramorphismWorks)
    printlnString (line "recursion-schemes.project-embed" projectEmbedWorks)
    if catamorphismWorks && paramorphismWorks && projectEmbedWorks then
        printlnString "RECURSION-SCHEMES TESTS: ALL PASS"
    else
        printlnString "RECURSION-SCHEMES TESTS: FAIL"
