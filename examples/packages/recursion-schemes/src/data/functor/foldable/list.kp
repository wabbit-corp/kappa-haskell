module data.functor.foldable.list

import data.functor.foldable.*

data ListF a r =
    NilF
    ConsF (head : a) (tail : r)

instance Functor (ListF a) =
    let map function layer =
        match layer
        case NilF -> NilF
        case ConsF head tail -> ConsF head (function tail)

instance Recursive (List a) (ListF a) =
    let project values =
        match values
        case Nil -> NilF
        case head :: tail -> ConsF head tail
    let cataRecursive algebra values =
        match values
        case Nil -> algebra NilF
        case head :: tail -> algebra (ConsF head (cataRecursive algebra tail))
    let paraRecursive algebra values =
        match values
        case Nil -> algebra NilF
        case head :: tail ->
            algebra (ConsF head (LayerResult tail (paraRecursive algebra tail)))

instance Corecursive (List a) (ListF a) =
    let embed layer =
        match layer
        case NilF -> Nil
        case ConsF head tail -> (::) head tail
