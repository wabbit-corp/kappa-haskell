module control.comonad.env

import control.comonad.*

-- The environment (or coreader) comonad.
data Env e a =
    Env (environment : e) (value : a)

instance Functor (Env e) =
    let map function wrapped =
        match wrapped
        case Env environment value -> Env environment (function value)

instance Comonad (Env e) =
    let extract wrapped =
        match wrapped
        case Env environment value -> value
    let duplicate wrapped =
        match wrapped
        case Env environment value -> Env environment wrapped
    let extend function wrapped =
        match wrapped
        case Env environment value -> Env environment (function wrapped)

ask : forall e a. Env e a -> e
let ask wrapped =
    match wrapped
    case Env environment value -> environment

asks : forall e a b. (e -> b) -> Env e a -> b
let asks function wrapped = function (ask wrapped)

local : forall e a. (e -> e) -> Env e a -> Env e a
let local function wrapped =
    match wrapped
    case Env environment value -> Env (function environment) value
