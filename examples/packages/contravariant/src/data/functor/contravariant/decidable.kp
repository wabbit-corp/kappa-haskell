module data.functor.contravariant.decidable

import data.functor.contravariant.*
import data.functor.contravariant.divisible.*

trait Divisible f => Decidable f =
    lose : forall a. (a -> Void) -> f a
    choose : forall a b c. (a -> Either b c) -> f b -> f c -> f a

instance Decidable Predicate =
    let lose impossible = MkPredicate (\input -> absurd (impossible input))
    let choose branch left right =
        match left
        case MkPredicate testLeft ->
            match right
            case MkPredicate testRight ->
                MkPredicate (\input ->
                    match branch input
                    case Left first -> testLeft first
                    case Right second -> testRight second)

instance Monoid r => Decidable (Op r) =
    let lose impossible = MkOp (\input -> absurd (impossible input))
    let choose branch left right =
        match left
        case MkOp consumeLeft ->
            match right
            case MkOp consumeRight ->
                MkOp (\input ->
                    match branch input
                    case Left first -> consumeLeft first
                    case Right second -> consumeRight second)
