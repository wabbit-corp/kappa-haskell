module data.bitraversable

import data.bifunctor.*
import data.bifoldable.*

trait (Bifunctor p, Bifoldable p) => Bitraversable p =
    bitraverse :
        forall f a b c d.
        (@_ : Applicative f) ->
        (a -> f c) -> (b -> f d) -> p a b -> f (p c d)

instance Bitraversable PairF =
    let bitraverse f g value =
        match value
        case PairF a b -> liftA2 (\c -> \d -> PairF c d) (f a) (g b)

instance Bitraversable Either =
    let bitraverse f g value =
        match value
        case Left a -> map (\c -> Left c) (f a)
        case Right b -> map (\d -> Right d) (g b)

instance Bitraversable Result =
    let bitraverse f g value =
        match value
        case Err e -> map (\c -> Err c) (f e)
        case Ok a -> map (\d -> Ok d) (g a)
