module data.bifunctor

import data.either.*

-- A Kappa port of the core abstraction from Edward Kmett's `bifunctors`.
-- The two arguments are parametric: an implementation may transform them, but
-- cannot inspect a type merely because it is passed to `bimap`.
trait Bifunctor p =
    bimap : forall a b c d.
        (a -> b) -> (c -> d) -> p a c -> p b d

first :
    forall p a b c.
    (@_ : Bifunctor p) -> (a -> b) -> p a c -> p b c
let first f value = bimap f (\x -> x) value

second :
    forall p a b c.
    (@_ : Bifunctor p) -> (b -> c) -> p a b -> p a c
let second f value = bimap (\x -> x) f value

-- A concrete product makes the abstraction useful without relying on tuple
-- syntax and is the Kappa counterpart of Data.Bifunctor.Product's base case.
data PairF a b =
    Pair (left : a) (right : b)

instance Bifunctor PairF =
    let bimap f g value =
        match value
        case Pair a b -> Pair (f a) (g b)

instance Bifunctor Either =
    let bimap f g value =
        match value
        case Left a -> Left (f a)
        case Right b -> Right (g b)

instance Bifunctor Result =
    let bimap f g value =
        match value
        case Err e -> Err (f e)
        case Ok a -> Ok (g a)
