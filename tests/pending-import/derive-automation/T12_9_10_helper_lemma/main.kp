@PrivateByDefault module main

data Seq (0 a : Type) : Type =
    Nil
    Cons (head : a) (tail : Seq a)

reverseAcc : Seq a -> Seq a -> Seq a
let reverseAcc xs acc =
    match xs
    case Nil -> acc
    case Cons h t -> reverseAcc t (Cons h acc)

reverse : Seq a -> Seq a
let reverse xs = reverseAcc xs Nil

reverseReverse :
    forall (a : Type) (xs : Seq a).
    reverse (reverse xs) = xs
let reverseReverse = derive

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! assertNoErrors
--! assertDeriveProviderUsed reverseReverse helper-lemma
--! assertDeriveHelperCount reverseReverse >= 1

