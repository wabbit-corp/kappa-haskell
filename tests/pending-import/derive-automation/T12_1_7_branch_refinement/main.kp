@PrivateByDefault module main

branchProof :
    (b : Bool) ->
    if b then b = True else b = False
let branchProof b =
    if b then
        derive
    else
        derive

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! assertNoErrors
--! assertDeriveProofChecks branchProof

