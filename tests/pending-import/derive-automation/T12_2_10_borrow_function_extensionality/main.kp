@PrivateByDefault module main

borrowedExtensionality :
    forall (a : Type) (b : Type)
           (f : (& x : a) -> b)
           (g : (& x : a) -> b).
    (forall (x : a). f x = g x) ->
    f = g
let borrowedExtensionality pointwise =
    borrowFunExt pointwise

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! assertNoErrors
--! assertType borrowedExtensionality forall (a : Type) (b : Type) (f : (& x : a) -> b) (g : (& x : a) -> b). (forall (x : a). f x = g x) -> f = g

