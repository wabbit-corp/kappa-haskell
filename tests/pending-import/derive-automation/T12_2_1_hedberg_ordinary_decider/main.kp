@PrivateByDefault module main

decideBool :
    (& x : Bool) -> (& y : Bool) -> Dec (x = y)
let decideBool x y =
    match (x, y)
    case (True, True)   -> Dec.Yes refl
    case (False, False) -> Dec.Yes refl
    case _ -> Dec.No (\equality ->
        match equality
        case impossible)

makeSet :
    forall (a : Type).
    ((& x : a) -> (& y : a) -> Dec (x = y)) ->
    IsSet a
let makeSet decision = derive

boolSet : IsSet Bool
let boolSet = makeSet decideBool

