@PrivateByDefault module main

trait Parent =
    proof : True = True
    evidence uniqueness = derive

trait derive Parent => Child =
    token : Unit

instance Parent =
    let proof = refl

instance Child =
    let token = ()

--! mode check
--! packageMode
--! requires capability deriveAutomation
--! requires capability evidenceUniqueness
--! assertNoErrors
--! assertSupertraitCompletionMode Parent from Child direct
