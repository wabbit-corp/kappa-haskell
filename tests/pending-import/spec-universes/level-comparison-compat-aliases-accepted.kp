-- §11.1.2.2: `LevelLt` and `LevelLe` remain transparent compatibility aliases
-- for erased level-comparison proof binders.
--! mode check
--! assertNoErrors

data BelowViaAlias (κ : TypeLevel) : Type κ =
    PackBelowViaAlias
        (u : TypeLevel)
        (@0 lt : LevelLt u κ)
        (T : Type u)

data AtMostViaAlias (κ : TypeLevel) : Type(κ+1) =
    PackAtMostViaAlias
        (u : TypeLevel)
        (@0 le : LevelLe u κ)
        (T : Type u)
