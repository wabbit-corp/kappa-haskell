-- §11.1.2.3A/§11.1.2.8: a record or data field may store a small
-- parametric-polymorphic function and instantiate it at multiple small types.
--! mode check
--! assertNoErrors

type Poly : Type =
    (0 A : Type) -> A -> A

data Box : Type =
    MkBox (f : Poly)

type Sig : Type =
    (n : Int)

box : Box
let box = MkBox (\ A x -> x)

r : Sig
let r = (n = 5)

useBoth : Unit
let useBoth =
    match box
    case MkBox f ->
        let a = f Int 1
        let b = f Sig r
        ()
