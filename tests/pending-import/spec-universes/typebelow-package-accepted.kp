-- §11.1.2.8: the `TypeBelow`-shaped package is accepted because the earlier
-- erased `u < κ` proof binder is in scope as a level assumption when the later
-- field `T : Type u` is checked.
--! mode check
--! assertNoErrors

data LocalTypeBelow (κ : TypeLevel) : Type κ =
    LocalPackTypeBelow
        (u : TypeLevel)
        (@0 lt : u < κ)
        (T : Type u)
