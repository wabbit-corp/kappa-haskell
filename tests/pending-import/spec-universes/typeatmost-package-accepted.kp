-- §11.1.2.8: the `TypeAtMost`-shaped package is accepted at one level above
-- its bound using erased `u <= κ` proof evidence.
--! mode check
--! assertNoErrors

data LocalTypeAtMost (κ : TypeLevel) : Type(κ+1) =
    LocalPackTypeAtMost
        (u : TypeLevel)
        (@0 le : u <= κ)
        (T : Type u)
