-- §11.1.2.7/§11.1.2.8: an unbounded dependent record over TypeLevel has no
-- ceiling independent of the bound level variable.
--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_UNIVERSE_UNBOUNDED_TELESCOPE
--! assertDiagnosticFamily error kappa.universe.unbounded-telescope

type LevelRecord =
    (u : TypeLevel, T : Type u)
