--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_RECORD_PROJECTION_MISSING_FIELD
-- §3.2.2: E_RECORD_PROJECTION_MISSING_FIELD is emitted with family
-- kappa.name.unresolved (field names are one of the listed name kinds),
-- so its payload MUST include the unresolved spelling and the candidate
-- spellings considered for typo suggestions, and — since 'name' is edit
-- distance 1 from 'nmae' in the admissible kind set (the record's field
-- labels, which the renderer even lists in prose) — the diagnostic
-- SHOULD carry a maybe-applicable fix.  Today the payload is
-- {"kind":"none"} with no fix.  Payload keys follow the schema already
-- used by the name-unresolved kind (see conformance/names/unresolved.kp).
--! assertDiagnosticPayload error kappa.name.unresolved /payload/name nmae
--! assertDiagnosticPayload error kappa.name.unresolved /payload/suggestion name
--! assertDiagnosticFix error kappa.name.unresolved maybe-applicable
module main

person : (name : String, age : Integer)
let person = (name = "ada", age = 36)

let x = person.nmae --!! kappa.name.unresolved
-- STATUS(74742dfd): FAIL — no error diagnostic matching kappa.name.unresolved has payload /payload/name = nmae (saw: /payload/name=<absent>); no error diagnostic matching kappa.name.unresolved has payload /payload/suggestion = name (saw: /payload/suggestion=<absent>); no error diagnostic matching kappa.name.unresolved has a fix with applicability maybe-applicable
