-- §3.1.13 / §3.1.2A / §3.1.4: the explanation registry behind
-- `kappa explain` covers the diagnostic-infrastructure portable aliases
-- of §3.1.4 — the recovery codes (inserted token, missing node, skipped
-- syntax) and the provenance codes — alongside the feature-gating family
-- and code the ordinary pipeline emits.
--! assertNoErrors
--! assertDiagnosticExplainExists kappa.feature.gated
--! assertDiagnosticExplainExists E_FEATURE_INACTIVE
--! assertDiagnosticExplainExists E_RECOVERY_SKIPPED_INVALID_SYNTAX
--! assertDiagnosticExplainExists E_RECOVERY_INSERTED_TOKEN
--! assertDiagnosticExplainExists E_RECOVERY_MISSING_NODE
--! assertDiagnosticExplainExists E_PROVENANCE_MISSING
--! assertDiagnosticExplainExists E_PROVENANCE_CYCLE
--! assertDiagnosticExplainExists E_SYNTHETIC_ORIGIN_UNMAPPED
module main

main : IO Unit
let main = println "ok"

