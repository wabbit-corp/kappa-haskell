-- token repair inside the same import item).  Today the payload is
-- {"kind":"none"} and there is no fix.
--! assertDiagnosticPayload error kappa.name.unresolved /payload/name bytesLenght
--! assertDiagnosticPayload error kappa.name.unresolved /payload/suggestion bytesLength
--! assertDiagnosticFix error kappa.name.unresolved maybe-applicable
module main

import std.bytes.(bytesLenght) --!! kappa.name.unresolved

