-- imported opaque item be treated as TRANSPARENT for definitional equality
-- in this importing module, so the `refl` proof of `secret = 7` must be
-- accepted; the accepted modifier is recorded in the §4.7 audit ledger.
import oplib.(clarify secret)

proof : secret = 7
let proof = refl

useSecret : Int
let useSecret = secret

--! allow_clarify
--! assertNoErrors
--! assertEval useSecret 7
--! assertAuditLedger clarify
