module main

-- §4.3/§8.3.1.1: `unhide` and `clarify` may be combined on one import item
-- and their surface ORDER is not semantically significant. With both build
-- settings enabled, each private+opaque item must become accessible (unhide)
-- AND transparent for definitional equality (clarify), under either
-- modifier ordering.
import plib.(unhide clarify secretA)
import plib.(clarify unhide secretB)

proofA : secretA = 11
let proofA = refl

proofB : secretB = 22
let proofB = refl

total : Int
let total = addInt secretA secretB

--! allow_unhiding
--! allow_clarify
--! assertNoErrors
--! assertEval total 33
