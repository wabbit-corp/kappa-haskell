-- Spec 5.2 (declaration-head disambiguation): a soft keyword is read as a
-- declaration introducer only when its declaration grammar can continue
-- from the next token; 'effect : Int' begins a signature for the term name
-- 'effect', and 'let effect <- e' binds the identifier in a do block.
--! mode run
--! assertNoErrors
--! assertStdout "8\n"

module main

effect : Int
let effect = 3

addEffect : Int -> Int
let addEffect effect = effect + 1

main : UIO Unit
let main = do
    let effect <- pure (addEffect effect)
    println effect
-- STATUS(74742dfd): FAIL — expected 0 errors, got 1; first error: E_RECOVERY_DECLARATION_SKIPPED "unexpected 'effect' at start of declaration" at line 11; stdout mismatch: expected "8\n", got ""
