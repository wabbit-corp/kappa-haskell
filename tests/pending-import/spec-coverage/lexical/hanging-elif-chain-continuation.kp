-- Spec 5.4 (continuation-leading tokens) sibling: `elif` and `else` lines
-- belonging to the innermost open conditional continue it when indented
-- strictly deeper than the anchor -- the full hanging chain form.
--! mode check
--! assertNoErrors
--! assertEval small 1
--! assertEval medium 2
--! assertEval large 3

module main

classify : Int -> Int
let classify x =
    let y = x
    in if y < 10 then 1
       elif y < 100 then 2
       else 3

small : Int
let small = classify 5

medium : Int
let medium = classify 50

large : Int
let large = classify 500
-- STATUS(a0497523): FAIL — hanging elif/else chain still yields E_UNEXPECTED_INDENTATION x2; Spec 5.4 continuation-leading tokens now accept it
