-- Spec 6.1.4: prefix (-) resolves by ordinary operator name resolution and
-- fixity lookup (5.5.2/5.5.3); the prelude binding is negate, and a scoped
-- prefix (-) binding shadows it like any other operator. -Token must apply
-- the local Token -> Int binding; hard-wiring minus to negate is
-- non-conforming.
module main

-- Kappa exposes prefix operators and fixity declarations as ordinary scoped
-- bindings.  Once a local prefix (-) for Token is in scope, `-Token` should
-- resolve through that binding just like any other prefix operator.  Routing
-- every minus-shaped expression directly to the prelude `negate` operation is
-- surprising and makes the advertised operator model non-uniform.

data Token : Type =
    Token

prefix 90 (-)

(-) : Token -> Int
let (-) token = 99

result : Int
let result = -Token

--! mode check
--! assertNoErrors
--! assertEval result 99
-- STATUS(a0497523): FAIL — minus still hard-routed to prelude negate; the scoped prefix (-) binding is bypassed (E_APPLICATION_ARGUMENT_MISMATCH); Spec 6.1.4 now requires ordinary operator resolution
