-- §5.1: the ASCII identifier grammar is [A-Za-z_][A-Za-z0-9_]* with no
-- length bound, and no implementation limit on identifier length is
-- declared anywhere in the spec. Robustness pin: 500-character identifiers
-- used simultaneously as a type constructor name, a data constructor name,
-- a top-level function name, and a do-local binder must lex, resolve,
-- check, and run (41 + 1 = 42).
--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "42\n"
module main

data  : Type =
     Int

 :  -> Int
let  p =
    match p
      case  n -> n + 1

main : UIO Unit
let main =
    do
        let  =  41
        printInt ( )

