-- Spec 5.4: a U+000D CARRIAGE RETURN not immediately followed by U+000A is
-- a compile-time error, and the diagnostic MUST name the carriage return.
--! mode check
--! assertErrorCount 1
--! assertDiagnosticMatch CARRIAGE RETURN|U\+000D

module main

x : Int
let x =  42
-- STATUS(74742dfd): FAIL — expected 1 errors, got 0; no diagnostic message matches /CARRIAGE RETURN|U\+000D/ (no diagnostics)
