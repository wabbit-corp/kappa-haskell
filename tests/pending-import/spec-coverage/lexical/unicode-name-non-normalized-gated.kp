--! requires capability unicode-names
--! mode check
--! assertDiagnostic error E_UNICODE_NAME_NON_NORMALIZED

-- §5.1A: unquoted Unicode identifiers MUST already be in the profile's
-- normalizationForm (NFKC); if normalizing the source spelling would
-- change it, compilation fails with E_UNICODE_NAME_NON_NORMALIZED.
-- `café` below is decomposed (e + U+0301 changes under NFC/NFKC);
-- `ﬁle` uses U+FB01 which NFKC folds to "fi".

module main

let café = 1 --!! E_UNICODE_NAME_NON_NORMALIZED
let ﬁle = 2 --!! E_UNICODE_NAME_NON_NORMALIZED

-- STATUS(74742dfd): UNSUPPORTED — requires capability unicode-names: not provided
