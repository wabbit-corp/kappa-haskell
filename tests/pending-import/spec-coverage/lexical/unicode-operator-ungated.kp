--! mode check
--! assertDiagnosticFamily error kappa.feature.gated
--! assertDiagnostic error E_FEATURE_INACTIVE

-- §5.5.1/§2.1A: a Unicode operator token (here U+2264, category Sm) is
-- accepted only when `unicode-names` is active; while the gate is
-- inactive its use is a feature-gating rejection, i.e. family
-- kappa.feature.gated (§3.2.2 "used when ... owning feature gate is
-- inactive"; E_FEATURE_INACTIVE is the SHOULD-stable code) — matching
-- the gate rejection already pinned for unquoted Unicode identifiers.

module main

bad : Bool
let bad = 1 ≤ 2 --!! E_FEATURE_INACTIVE

-- STATUS(a0497523): FAIL — ungated Unicode operator is rejected with family-less E_UNEXPECTED_CHARACTER (lexer operator-char set is ASCII-only, so the E_FEATURE_INACTIVE unicode-operator path in Lexer.hs is unreachable); spec wants a kappa.feature.gated rejection
