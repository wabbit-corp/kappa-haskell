-- REVISED for Spec 5.5.2 per-role operator identity: prefix/postfix
-- operator definitions now carry the role keyword (let prefix (op) ...);
-- a plain definition declares the infix-role operator. Moved from the
-- gated tree until the compiler implements role markers.
--! mode run
--! assertNoErrors
--! assertType custom2 Int -> Int -> Int
--! assertStdout "42\n3\n-9\n7\n"

-- §5.5.1 operator function references: `(infix op)` denotes the curried
-- binary function of an in-scope infix fixity, `(prefix op)` the unary
-- function of an in-scope prefix fixity, `(postfix op)` the unary
-- function of an in-scope postfix fixity. For `-` (both prelude
-- fixities in scope, §28.2.3) `(prefix -)` is negation and `(infix -)`
-- is subtraction.

module main

infix left 60 (<+>)
(<+>) : Int -> Int -> Int
let (<+>) x y = addInt x y

postfix 90 (?)
postfix (?) : Int -> Int
let postfix (?) x = addInt x 1

custom2 : Int -> Int -> Int
let custom2 = (infix <+>)

neg1 : Int -> Int
let neg1 = (prefix -)

post1 : Int -> Int
let post1 = (postfix ?)

main : UIO Unit
let main = do
    println (custom2 20 22)
    println ((infix -) 5 2)
    println (neg1 9)
    println (post1 6)
-- STATUS(74742dfd): FAIL — expected 0 errors, got 5; first error: E_RECOVERY_DECLARATION_SKIPPED "unexpected 'postfix' at start of declaration" at line 24; stdout mismatch: expected "42\n3\n-9\n7\n", got ""
