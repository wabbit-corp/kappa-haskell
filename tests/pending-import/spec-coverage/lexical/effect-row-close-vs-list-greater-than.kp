-- Spec 5.5.1: ']>' is a single token only when an unmatched '<[' is open
-- in the current balanced-delimiter context; otherwise ']' closes its
-- bracket and '>' begins an ordinary operator token (longest-match resets
-- at a balanced closing delimiter). firstOrZero [1]>0 is a comparison.
--! mode check
--! assertNoErrors
--! assertEval probe True

module main

firstOrZero : List Int -> Int
let firstOrZero xs =
    match xs
    case x :: rest -> x
    case Nil -> 0

probe : Bool
let probe = firstOrZero [1]>0
-- STATUS(a0497523): FAIL — [1]>0 still lexes ]> as an effect-row closer, skipping the declaration; Spec 5.5.1 now scopes ]> to an open <[ context
