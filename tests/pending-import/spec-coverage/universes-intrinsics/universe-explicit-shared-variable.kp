--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_UNIVERSE_UNBOUNDED_TELESCOPE
--! assertDiagnosticFamily error kappa.universe.unbounded-telescope

-- §11.1/§11.1.2: `forall (u : TypeLevel)` binds an explicit universe variable;
-- every `Type u` occurrence shares that user-written variable (no fresh
-- metavariables), and explicit universe variables participate in ordinary
-- constraint solving. A dependent type former that uses `Type u` must have an
-- erased level-comparison proof bound.
module main

-- POSITIVE: both `Type u` occurrences share the same level; `u` solves at 0
-- for value-type instantiations.
appU :
    (u : TypeLevel) ->
    (@0 p : u < ω) ->
    (0 a : Type u) ->
    (0 b : Type u) ->
    (a -> b) ->
    a ->
    b
let appU f x = f x

atValues : Bool
let atValues = appU (\n -> True) 5

-- POSITIVE: cumulativity feeds the same constraint set — instantiating `a`
-- with Type0 (an inhabitant of Type1) forces u >= 1 on BOTH binders.
atTypes : Type1
let atTypes = appU (\t -> t) Type0

-- NEGATIVE: the unbounded telescope itself has no ceiling independent of `u`.
selfTy : (u : TypeLevel) -> Type u
let selfTy u = Type u

-- STATUS(a51e1bf): FAIL — 'TypeLevel' is not implemented: every use is
-- E_NAME_UNRESOLVED (plus cascade), so explicit universe variables and their
-- constraints are untestable today.
