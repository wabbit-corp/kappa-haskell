--! mode check
--! assertNoErrors

-- §11.1.1/§11.1.2.2/§31.1.3: the Nat -> TypeLevel crossings, positive half.
-- Nonnegative integer literals cross into TypeLevel positions silently via
-- `FromInteger TypeLevel` ("accepts nonnegative integer literals only",
-- §11.1.2.2), so `let u : TypeLevel = 3`, `Type 3`, and a literal at an
-- ordinary TypeLevel data index are all valid. A runtime `n : Nat` crosses
-- only EXPLICITLY through `typeLevelFromInteger : Nat -> TypeLevel`, and the
-- image is solver-known finite: the prelude theorem typeLevelFiniteBelowOmega
-- discharges `typeLevelFromInteger n < omega` for an OPEN n.
module main

-- POSITIVE: literal at an annotated TypeLevel binding (silent crossing).
litLevel : TypeLevel
let litLevel = 3

-- POSITIVE: literal as the index of Type itself.
atLit :
    (A : Type 3) ->
    A ->
    A
let atLit A x = x

-- POSITIVE: literal at an ordinary user data-type TypeLevel index, and the
-- solver collapse of literal arithmetic at that index — both directions of
-- NBox (1 + 2) <-> NBox 3 (§11.1.2.4A constructor normalization).
data NBox (u : TypeLevel) : Typeω = MkNBox

castLitSum : NBox (1 + 2) -> NBox 3
let castLitSum b = b

castLitSumBack : NBox 3 -> NBox (1 + 2)
let castLitSumBack b = b

-- POSITIVE: a literal level IS the fromInteger image — `Type 4` and
-- `Type (typeLevelFromInteger 4)` are the same classifier.
useFinLit :
    (A : Type (typeLevelFromInteger 4)) ->
    A ->
    A
let useFinLit A x = x

atFour :
    (A : Type 4) ->
    A ->
    A
let atFour A x = useFinLit A x

-- POSITIVE: explicit crossing from an OPEN runtime Nat. The bound
-- `typeLevelFromInteger n < omega` on the telescope is dischargeable for
-- open n by the prelude theorem (the solver knows fromInteger images are
-- finite), which the body exercises instead of forwarding @p.
finAt :
    (n : Nat) ->
    (@0 p : typeLevelFromInteger n < omega) ->
    (A : Type (typeLevelFromInteger n)) ->
    A ->
    A
let finAt n p A x = x

dischargeFin :
    (n : Nat) ->
    (@0 p : typeLevelFromInteger n < omega) ->
    (A : Type (typeLevelFromInteger n)) ->
    A ->
    A
let dischargeFin n p A x = finAt n @(typeLevelFiniteBelowOmega n) A x

