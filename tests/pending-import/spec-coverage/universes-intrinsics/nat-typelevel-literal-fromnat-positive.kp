--! mode check
--! assertErrorCount 1

-- §11.1.1/§11.1.2.2/§31.1.3: the Nat -> TypeLevel crossings, positive half.
-- Nonnegative integer literals cross into TypeLevel positions silently via
-- `FromInteger TypeLevel` ("accepts nonnegative integer literals only",
-- §11.1.2.2), so `let u : TypeLevel = 3`, `Type 3`, and a literal at an
-- ordinary TypeLevel data index are all valid. A runtime `n : Nat` crosses
-- only EXPLICITLY through `typeLevelFromInteger : Nat -> TypeLevel`, and the
-- image is solver-known finite: the prelude theorem typeLevelFiniteBelowOmega
-- discharges `typeLevelFromInteger n < omega` for an OPEN n.
--
-- Since the §28.2 revision the literal payload handed to
-- `FromInteger TypeLevel` is the ordinary inductive Nat; closed payloads
-- normalize by §28.2's exact-computation clause, and §11.1.2.2's
-- `typeLevelSucc` body computes `n + 1` = `natAdd n 1` — which for an
-- OPEN n is definitionally STUCK (natAdd recurses on its left
-- argument), making the succCross arms below genuinely non-definitional.
module main

-- POSITIVE: literal at an annotated TypeLevel binding (silent crossing).
litLevel : TypeLevel
let litLevel = 3

-- POSITIVE: literal as the index of Type itself.
atLit :
    (A : Type 3) ->
    A ->
    A
let atLit A x = x

-- POSITIVE: literal at an ordinary user data-type TypeLevel index, and the
-- solver collapse of literal arithmetic at that index — both directions of
-- NBox (1 + 2) <-> NBox 3 (§11.1.2.4A constructor normalization).
data NBox (u : TypeLevel) : Typeω = MkNBox

castLitSum : NBox (1 + 2) -> NBox 3
let castLitSum b = b

castLitSumBack : NBox 3 -> NBox (1 + 2)
let castLitSumBack b = b

-- POSITIVE: a literal level IS the fromInteger image — `Type 4` and
-- `Type (typeLevelFromInteger 4)` are the same classifier.
useFinLit :
    (A : Type (typeLevelFromInteger 4)) ->
    A ->
    A
let useFinLit A x = x

atFour :
    (A : Type 4) ->
    A ->
    A
let atFour A x = useFinLit A x

-- POSITIVE: explicit crossing from an OPEN runtime Nat. The bound
-- `typeLevelFromInteger n < omega` on the telescope is dischargeable for
-- open n by the prelude theorem (the solver knows fromInteger images are
-- finite), which the body exercises instead of forwarding @p.
finAt :
    (n : Nat) ->
    (@0 p : typeLevelFromInteger n < omega) ->
    (A : Type (typeLevelFromInteger n)) ->
    A ->
    A
let finAt n p A x = x

dischargeFin :
    (n : Nat) ->
    (@0 p : typeLevelFromInteger n < omega) ->
    (A : Type (typeLevelFromInteger n)) ->
    A ->
    A
let dischargeFin n p A x = finAt n @(typeLevelFiniteBelowOmega n) A x

-- POSITIVE: open-Nat successor crossing. `typeLevelFromInteger (Succ n)`
-- is Level 0 (Succ n) while `typeLevelSucc (typeLevelFromInteger n)` is
-- Level 0 (natAdd n 1) — NOT interconvertible by ordinary reduction for
-- open n. The classifier boundary below is accepted because the
-- universe solver's certified normalization bridge (§11.1.2.2) plus the
-- required QF Presburger fragment (§15.8.4: `Succ n = natAdd n 1` is
-- linear) decides the level constraint, and §16.1.8 accepts
-- solver-produced equality evidence at an expected-type boundary — no
-- user-written subst.
succCross :
    (n : Nat) ->
    (@0 p : typeLevelFromInteger (Nat.Succ n) < omega) ->
    (A : Type (typeLevelFromInteger (Nat.Succ n))) ->
    A ->
    A
let succCross n p A x = x

succCrossCaller :
    (n : Nat) ->
    (A : Type (typeLevelSucc (typeLevelFromInteger n))) ->
    A ->
    A
let succCrossCaller n A x =
    succCross n @(typeLevelFiniteBelowOmega (Nat.Succ n)) A x

-- NEGATIVE companion: the same identity as a refl-spelled TERM equality
-- goal must fail. The operation bodies are opaque outside std.typelevel
-- for ordinary δ-reduction (§11.1.2.2), the certified bridge serves
-- only universe-checking positions, and §16.1.8 transport insertion is
-- elaboration-only — it "does not extend definitional equality" — so
-- refl has no converting endpoints here.
succImageNotDefinitional :
    (n : Nat) ->
    typeLevelFromInteger (Nat.Succ n) = typeLevelSucc (typeLevelFromInteger n)
let succImageNotDefinitional n = refl --!! E_TYPE_MISMATCH
-- STATUS: SPEC-ISSUE — the Spec names typeLevelFiniteBelowOmega but omits its canonical signature/application form
