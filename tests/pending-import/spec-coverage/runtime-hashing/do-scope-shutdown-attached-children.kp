--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "child-cleanup\nparent-defer\nchild-exit:scope-shutdown\n"
--! assertExitCode 0

-- §32.2.3: an IO `do` block behaves as a nested supervision scope. `fork`
-- attaches to the innermost such scope, so when `spawnAndLeave`'s do block
-- exits, its still-live attached child MUST be interrupted (ScopeShutdown)
-- and drained — including the child's finalizers — BEFORE the scope's own
-- deferred actions run (child-cleanup precedes parent-defer), and before
-- the caller resumes with the escaped fiber handle.
module main

sleeper : UIO Int
let sleeper = do
    defer (printlnString "child-cleanup")
    sleepFor (seconds 2)
    pure 1

spawnAndLeave : UIO (Fiber Void Int)
let spawnAndLeave = do
    defer (printlnString "parent-defer")
    let f <- fork sleeper
    pure f

main : UIO Unit
let main = do
    let f <- spawnAndLeave
    let ex <- await f
    match ex
      case Exit.Success v -> printlnString "child-exit:completed"
      case Exit.Failure (Cause.Interrupt (InterruptCause InterruptTag.ScopeShutdown by)) -> printlnString "child-exit:scope-shutdown"
      case Exit.Failure c -> printlnString "child-exit:other"
-- STATUS(8c3c7747): FAIL — the parent defer runs before child cleanup and the child reports success instead of ScopeShutdown.
