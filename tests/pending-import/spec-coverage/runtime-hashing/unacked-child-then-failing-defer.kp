--! mode run
--! assertNoErrors
--! assertStdout "then:child-defect-first-defer-fail-second\n"

-- §32.2.4 + §32.2.12: cleanup-cause construction at scope exit. The body
-- succeeds; cleanup produces (a) an UnhandledChildFailure defect for an
-- unacknowledged failed child and (b) a Fail cause from a failing defer.
-- §32.2.12 mandates child-shutdown causes are composed BEFORE finalizer
-- causes are appended (children are drained before the scope's own exit
-- actions run, §32.2.3), so the overall cleanup cause is
-- Then (Defect UnhandledChildFailure) (Fail 9), and the body's success
-- makes that cleanup cause the whole result: Failure (Then _ _).
module main

failingChild : IO Int Int
let failingChild = throwIO 7

body : IO Int Int
let body = do
    defer (throwIO 9)
    let f <- fork failingChild
    let _ = f
    -- let the child terminate with its (never-acknowledged) typed failure
    sleepFor (millis 20)
    ioPure 1

classify : Cause Int -> IO Void String
let classify c = match c
    case Cause.Then (Cause.Defect (DefectInfo DefectTag.UnhandledChildFailure m)) (Cause.Fail 9) -> ioPure "then:child-defect-first-defer-fail-second"
    case Cause.Then (Cause.Fail 9) (Cause.Defect (DefectInfo DefectTag.UnhandledChildFailure m)) -> ioPure "then:wrong-order"
    case Cause.Fail 9 -> ioPure "defer-fail-only"
    case Cause.Defect (DefectInfo DefectTag.UnhandledChildFailure m) -> ioPure "child-defect-only"
    case _ -> ioPure "cause:other"

main : UIO Unit
let main = do
    let r <- catchIO (ioBind (sandbox body) (\v -> ioPure "body-succeeded")) classify
    printlnString r
-- STATUS(e25d64e1): FAIL — stdout mismatch: expected composed unhandled-child defect then defer failure, got "defer-fail-only\n"
