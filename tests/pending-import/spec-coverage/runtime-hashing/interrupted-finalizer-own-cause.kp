--! mode run
--! assertNoErrors
--! assertStdout "later-finalizer\ninterrupted-finalizer-composed\n"

-- §32.2.12 × §32.2.5: finalizers run masked, but one that explicitly opts
-- back into delivery (here via `poll`, the §18.1.12 checkpoint that
-- delivers a pending interrupt even inside a masked region) and is thereby
-- interrupted contributes `Interrupt _` as its OWN cleanup cause — composed
-- after the body's primary Interrupt with Then — while remaining
-- earlier-registered finalizers still run ("later-finalizer" prints).
module main

import std.prelude.(type Exit(..))

pollingFin : Promise Void Unit -> UIO Unit
let pollingFin inFin = do
    let _ <- completePromise inFin (Success ())
    -- masked: the second interrupt request pends here without delivery
    sleepFor (millis 30)
    poll

victim : Promise Void Unit -> Promise Void Unit -> UIO Int
let victim ready inFin = do
    defer (printlnString "later-finalizer")
    defer (pollingFin inFin)
    let _ <- completePromise ready (Success ())
    sleepFor (seconds 10)
    ioPure 0

main : UIO Unit
let main = do
    let ready <- newPromise
    let inFin <- newPromise
    let f <- fork (victim ready inFin)
    let _ <- awaitPromise ready
    interruptFork f
    let _ <- awaitPromise inFin
    interruptFork f
    let ex <- await f
    match ex
      case Success v -> printlnString "completed"
      case Failure (Then (Interrupt ia) (Interrupt ib)) -> printlnString "interrupted-finalizer-composed"
      case Failure (Interrupt ic) -> printlnString "finalizer-interrupt-lost"
      case Failure c -> printlnString "cause:other"
