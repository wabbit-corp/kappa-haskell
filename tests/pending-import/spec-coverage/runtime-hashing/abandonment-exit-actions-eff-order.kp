--! assertNoErrors
--! assertEval encoded 1020340

-- §32.2.20 / §32.2.21 (× §18.8.3): pure-oracle ORDER pin for abandonment
-- unwinding. The folding Log handler encodes emission order in digits
-- (earliest emit = least-significant pair). Spec order: pre-op note 40,
-- then masked-LIFO unwind note 3, note 2, then the using-release note 1;
-- the post-op note 99 never runs. Encoded:
-- ((((0*100+1)*100+2)*100+3)*100+40) = 1020340.
module main

effect Log =
    1 emit : Int -> Unit

effect Abort =
    0 stop : Unit -> Int

data Res : Type = MkRes (rid : Int)

instance Releasable (Eff <[Log : Log, Abort : Abort]>) Res =
    let release r = match r case MkRes i -> Log.emit i

acquireRes : Int -> Eff <[Log : Log, Abort : Abort]> Res
let acquireRes i = pure (MkRes i)

comp : Eff <[Log : Log, Abort : Abort]> Int
let comp = do
    using a <- acquireRes 1
    defer (Log.emit 2)
    defer (Log.emit 3)
    let _ <- Log.emit 40
    let _ <- Abort.stop ()
    let _ <- Log.emit 99
    pure 999

handledAbort : Eff <[Log : Log]> Int
let handledAbort =
    deep handle Abort comp with
        case return x -> pure 0
        case stop _ k -> pure 0

folded : Eff <[ ]> Int
let folded =
    deep handle Log handledAbort with
        case return x -> pure x
        case emit n k -> do
            let rest <- k ()
            pure (rest * 100 + n)

encoded : Int
let encoded = runPure folded
