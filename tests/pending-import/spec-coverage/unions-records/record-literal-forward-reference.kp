--! mode check
--! assertErrorCount 1

-- §13.2.3 (Spec.md L12636-L12643): in a record VALUE, a runtime-relevant
-- sibling reference `this.f` is valid only if `f` appears EARLIER in
-- source order (already evaluated into its temporary). A reference to a
-- later source field is rejected — unless that field is compile-time-only
-- and its value is available during elaboration without runtime
-- evaluation. (The spec names no diagnostic family for this rejection,
-- so this test pins the error count only.)
module main

type P = (x : Integer, y : Integer)

-- backward runtime sibling reference: OK
okBack : P
let okBack = (x = 5, y = this.x)

-- forward reference to a COMPILE-TIME field whose manifest value needs
-- no runtime evaluation: OK per the exception clause
type Pkg = (T : Type, value : this.T)

okCompileTime : Pkg
let okCompileTime = (value = (1 : this.T), T = Integer)

-- NEGATIVE: forward reference to a RUNTIME field — `x` has not been
-- evaluated into its temporary when `y`'s initializer runs. Rejected.
badFwd : P
let badFwd = (y = this.x, x = 5)

-- STATUS(a0497523): FAIL — the compiler accepts the forward runtime
-- sibling reference (0 errors): it reorders by the dependency graph and
-- never enforces the §13.2.3 source-order availability rule. NOTE the
-- gating test tests/conformance/records/dependent-telescope.kp pins the
-- contrary behavior ((buf = makeVec this.len, len = n) asserted
-- error-free), so spec and blessed corpus disagree here.
