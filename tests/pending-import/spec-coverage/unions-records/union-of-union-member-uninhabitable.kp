--! mode check
--! assertNoErrors

-- §13.1.1 (Spec.md L16237-L16263) x §13.1.2 (L16266-L16280) x §13.1.3
-- (L16282-L16299): a union type is itself a type, so it can be a MEMBER of
-- another union: Outer = (| Inner | Bool |) with Inner = (| Integer |
-- String |). ContainsVar Outer.row Inner holds (MemberId is computed from
-- the fully elaborated member type), so the explicit injection
-- (| v : Inner |) ("(| e : T |) : Variant r if ContainsVar r T") and the
-- expected-type-directed injection of v : Inner at Outer MUST both be
-- available. Widening does NOT apply here (Integer and String are not
-- members of Outer's row), so injection is the only reading — the two
-- §13.1.3 rules do not overlap in this row.
--
-- Currently the explicit injection (| v : Inner |) elaborates at type
-- Inner (a union-typed member annotation is treated as an ascription,
-- never as an injection) and checking Inner against (| Inner | Bool |)
-- fails E_TYPE_EQUALITY_MISMATCH. Consequently the Inner arm of Outer is
-- matchable (matchOuter typechecks) but no value for it can ever be
-- constructed: union-typed members are uninhabitable dead arms.
module main

type Inner = (| Integer | String |)
type Outer = (| Inner | Bool |)

injExplicit : Inner -> Outer
let injExplicit v = (| v : Inner |)

injExpected : Inner -> Outer
let injExpected v = v

matchOuter : Outer -> Integer
let matchOuter u =
    match u
    case (| i : Inner |) -> 1
    case (| b : Bool |)  -> 2

-- STATUS(74742dfd): FAIL — expected 0 errors, got 2; first error: E_TYPE_EQUALITY_MISMATCH "type mismatch" at line 27
