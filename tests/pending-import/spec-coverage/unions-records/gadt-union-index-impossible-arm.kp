--! mode check
--! assertNoErrors

-- §13.1.8 delegates exhaustiveness to §17.1.1. viaPermuted is a positive
-- control: union rows are definitionally equal modulo permutation. classify
-- states the desired complementary rule: two closed normalized VarRows that
-- differ by a member should be structurally incompatible, so BigShape's
-- three-member union index is refuted at the two-member demanded index.
--
-- The current Spec does not clearly say whether this structural VarRow
-- inequality supplies a checked §30.2.7 no-confusion proof or merely leaves
-- UnknownCompatibility. This is intentionally staged as a SPEC-ISSUE until
-- that choice is made; the preferred behavior exercised here is acceptance.
module main

data Shape (u : Type) : Type =
    SmallShape : Shape (| Integer | String |)
    BigShape   : Shape (| Integer | String | Bool |)

viaPermuted : Shape (| String | Integer |)
let viaPermuted = SmallShape

classify : Shape (| String | Integer |) -> Integer
let classify s =
    match s
    case SmallShape -> 1

-- STATUS: SPEC-ISSUE — decide whether distinct closed normalized VarRows provide structural no-confusion for Type-valued GADT indices; preferred behavior is to refute BigShape and accept this exhaustive match.
