--! mode check
--! assertNoErrors

-- §13.1.4 (Spec.md L16305-L16330) introduces residual-row matching for
-- OPEN unions; the implementation also accepts (| ..rest |) on a CLOSED
-- union, and the binder receives the NARROWED residual: after the Integer
-- arm of (| Integer | String | Bool |), rest : (| Bool | String |).
-- docs/SPEC_ISSUES.md already records that §13.1.4 leaves
-- original-vs-narrowed unstated; this pins the narrowed reading through
-- two consequences:
--   * a submatch on rest with only String/Bool arms is exhaustive
--     (impossible under the un-narrowed reading, which would demand an
--     Integer arm);
--   * the narrowed rest re-widens to the full union by §13.1.3
--     (every member of (| Bool | String |) is in U's row).
module main

type U = (| Integer | String | Bool |)

narrowed : U -> Integer
let narrowed u =
    match u
    case (| n : Integer |) -> n
    case (| ..rest |)      ->
        match rest
        case (| s : String |) -> 1
        case (| b : Bool |)   -> 2

rewiden : U -> U
let rewiden u =
    match u
    case (| n : Integer |) -> n
    case (| ..rest |)      -> rest

-- STATUS(a0497523): PASS — (| ..rest |) on a closed union binds the NARROWED residual.
