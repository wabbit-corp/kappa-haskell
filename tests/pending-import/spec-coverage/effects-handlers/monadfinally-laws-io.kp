--! mode run
--! assertNoErrors
--! assertStdout "unit:7\nf1\nf2\nnested:3\nf1\nf2\nflat:3\nfin\ncaught:boom\nfin2\ncaught:e1\n"

-- §18.1.25.1 MonadFinally laws for the IO e instance:
-- (1) right unit: finally ma (pure ()) yields ma's value;
-- (2) associativity: finally (finally ma f1) f2 sequences finalizers
--     identically to finally ma (f1; f2) — both print f1 then f2;
-- (3) finalizer runs on the error path, BEFORE the error propagates
--     ("fin" before "caught:boom");
-- (4) error masking: when ma throws e1 and the finalizer throws e2, the
--     propagated error observed by catchError is e1 (printed verbatim).
module main

showIt : String -> Integer -> IO String Unit
let showIt tag n = printlnString (stringAppend tag (showInt n))

report : String -> IO String Integer
let report e = do
    printlnString (stringAppend "caught:" e)
    ioPure 0

f12 : IO String Unit
let f12 = do
    printlnString "f1"
    printlnString "f2"

fin2 : IO String Unit
let fin2 = do
    printlnString "fin2"
    throwIO "e2"

body : IO String Unit
let body = do
    let u <- finally (ioPure 7) (ioPure ())
    showIt "unit:" u
    let n <- finally (finally (ioPure 3) (printlnString "f1")) (printlnString "f2")
    showIt "nested:" n
    let m <- finally (ioPure 3) f12
    showIt "flat:" m
    let a <- catchError (finally (throwIO "boom") (printlnString "fin")) report
    let b <- catchError (finally (throwIO "e1") fin2) report
    pure ()

main : UIO Unit
let main = do
    let f <- fork body
    let _ <- await f
    pure ()
-- STATUS(a0497523): FAIL — laws 1-3 hold, law 4 fails: prints caught:e2 — the finalizer error e2 REPLACES the body error e1, violating §18.1.25.1 law 4 (MUST NOT replace e1).
