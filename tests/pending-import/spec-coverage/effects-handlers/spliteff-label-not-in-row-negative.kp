--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_EFFECT_LABEL_NOT_IN_ROW

-- §18.1.21 / §18.1.22: handler typing requires SplitEff r_all label E r
-- to be solvable — handling label B over a computation whose row
-- contains only A fails with the label-not-in-row diagnostic.
module main

effect A =
    1 opA : Unit -> Int

effect B =
    1 opB : Unit -> Int

comp : Eff <[A : A]> Int
let comp = A.opA ()

bad : Eff <[A : A]> Int
let bad =
    deep handle B comp with --!! E_EFFECT_LABEL_NOT_IN_ROW
        case return x -> pure x
        case opB _ k -> k 1

r : Int
let r = 0
-- STATUS(a0497523): PASS
