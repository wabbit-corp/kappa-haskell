--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_ERASED_RUNTIME_USE

-- §18.1.17.1: an abortive operation (resumption quantity 0) binds the
-- resumption k at quantity 0, so k is unusable by the ordinary quantity
-- rules — applying it in the clause body is a quantity error.
module main

effect Fail =
    0 raise : Unit -> Int

comp : Eff <[Fail : Fail]> Int
let comp =
    do
        let a <- Fail.raise ()
        pure a

bad : Eff <[ ]> Int
let bad =
    deep handle Fail comp with
        case return x -> pure x
        case raise _ k -> k 5 --!! E_QTT_ERASED_RUNTIME_USE

result : Int
let result = runPure bad
