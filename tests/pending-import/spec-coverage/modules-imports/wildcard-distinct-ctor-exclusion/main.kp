module main

-- §8.3.1: `import M.*` imports all exported binding groups EXCEPT
-- distinct-spelling constructors. The same-spelling family Box arrives
-- as one paired binding group (type + constructor); Red/Green require an
-- explicit `ctor Red` or `type Color(..)` item (see ctors.kp).
import clib.*

paint : Color -> Color
let paint c = c

boxed : Int
let boxed =
    match Box 4
      case Box n -> n

badCtor : Color
let badCtor = Red --!! E_NAME_UNRESOLVED

