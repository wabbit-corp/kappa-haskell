module main

-- §8.3: a URL moduleRef (string-literal module reference) may NOT appear
-- in the bare module-only form `import "url"`; a URL import must use
-- `as`, `.*`, `.(...)`, or `.* except (...)`. (The spec names no
-- diagnostic family; E_IMPORT_ITEM_MALFORMED is the closest registered
-- code.)
import "https://example.com/lib" --!! E_IMPORT_ITEM_MALFORMED

--! assertErrorCount 1
-- STATUS(a0497523): FAIL — the bare URL form is diagnosed only via the pinning gate (E_URL_IMPORT_UNPINNED_IN_PACKAGE_MODE), not rejected as an ill-formed bare module form
