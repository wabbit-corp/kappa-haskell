module aliased

-- §8.3: `import M as A` brings ONLY the alias into scope for qualified
-- access; the original module name is NOT brought into scope by this
-- form.
import qlib as Q

ok : Int
let ok = Q.val

bad : Int
let bad = qlib.val --!! E_NAME_UNRESOLVED
