module main

-- Effect declared in one module, performed and handled in another,
-- referenced only through ordinary qualified access.
-- §8.3: `import elib` gives qualified access to elib's exports; the
-- effect interface (declaration kind `type`, §18.1.15) and the
-- effect-label declaration are exported by default (§8.5).
-- §7.5: `m.l` in effect-label position selects the exported
-- effect-label facet. §7.1: effect-label position admits effect-label
-- declarations and compile-time EffLabel values. §18.1.15: effect-row
-- syntax may refer to such values, `handle label expr with` accepts
-- them, and `label.op` selects operations.
import elib

comp : Eff <[elib.counterL : elib.Counter]> Int
let comp = elib.counterL.tick ()

handledEff : Eff <[ ]> Int
let handledEff =
    deep handle elib.counterL comp with
        case return x -> pure x
        case tick _ k -> k 42

result : Int
let result = runPure handledEff
-- STATUS(a0497523): FAIL — qualified references to an imported effect label are rejected everywhere: the row annotation <[elib.counterL : ...]> is a parse error ("unexpected '<['", dotted names are not accepted in row-label position), and `deep handle elib.counterL` reports E_NAME_UNRESOLVED "'handle' requires an effect label in scope"
