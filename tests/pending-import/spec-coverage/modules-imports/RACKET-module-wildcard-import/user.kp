-- Source: Racket guide module-require.scrbl (importing all exported names)
-- Source docs: racket guide module-require.scrbl (corpus repos/github-racket-racket/docs/pkgs/racket-doc/scribblings/guide/module-require.scrbl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §8.3 (import M.* imports all exported binding groups), §8.5.1 (private
--       items are not exported), §3.2.2 (kappa.name.unresolved)
--
-- Pins: `import M.*` brings every public name of M into unqualified scope
-- (Racket's bare require analogue); private names are not brought in; an
-- unknown name is still unresolved.
module user
import stringslib.*

-- POSITIVE: all public names from stringslib are in scope.
greeting : String
let greeting = concatS "Hello, " "World"

-- POSITIVE: emptyS is available too.
emptyTest : String
let emptyTest = concatS emptyS "tail"

-- NEGATIVE: internalBuf is private in stringslib; the wildcard import does
-- not expose it.
badAccess : String
let badAccess = internalBuf      --!! E_NAME_UNRESOLVED

-- NEGATIVE: a completely unknown name is still not in scope.
badName : String
let badName = nonExistentFn "x"  --!! E_NAME_UNRESOLVED
-- STATUS(a0497523): PASS (whole suite)
