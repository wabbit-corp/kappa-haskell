-- Source: Racket guide module-require.scrbl (except-in)
-- Source docs: racket guide module-require.scrbl (corpus repos/github-racket-racket/docs/pkgs/racket-doc/scribblings/guide/module-require.scrbl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §8.3 (import M.* except (...)), §3.2.2 (kappa.name.unresolved)
--
-- Pins: `import M.* except (x, y)` imports every public name of M except the
-- listed ones; the excepted names are not in unqualified scope but remain
-- reachable via qualified access when M itself is also imported (Racket's
-- except-in analogue).
module consumer
import utilslib.* except (safeDiv, identityFn)
import utilslib

-- POSITIVE: doubleU, tripleU, and safeMod were not excluded.
doubled : Int
let doubled = doubleU 7

tripled : Int
let tripled = tripleU 4

maybeMod : Option Int
let maybeMod = safeMod 10 3

-- POSITIVE: excluded names remain accessible via the qualified path
-- (utilslib is separately imported module-only).
qualDiv : Option Int
let qualDiv = utilslib.safeDiv 10 2

-- NEGATIVE: safeDiv was excluded from the wildcard import.
badDiv : Option Int
let badDiv = safeDiv 10 2    --!! E_NAME_UNRESOLVED

-- NEGATIVE: identityFn was excluded from the wildcard import.
badId : Int
let badId = identityFn 5     --!! E_NAME_UNRESOLVED
-- STATUS(a0497523): PASS (whole suite)
