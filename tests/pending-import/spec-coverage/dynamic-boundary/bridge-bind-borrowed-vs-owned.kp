--! mode check
--! assertNoErrors

-- §25.1: bindModule BORROWS the handle for a region r and returns a
-- surface whose lifetime is captured by that region ((surface r)
-- captures (r)); bindModuleOwned CONSUMES the handle (quantity 1) and
-- returns an owned BridgePackage surface that may outlive the borrow.
-- Both fail into the handle's associated H.Error type.
module main

import std.bridge.*

useBorrowed :
    forall (@0 surface : Region -> Type) (h : Type) (r : Region).
    (@B : BridgeBindable surface) ->
    (@H : BridgeHandle h) ->
    (&[r] handle : h) ->
    String ->
    IO H.Error ((surface r) captures (r))
let useBorrowed handle name = bindModule handle name

useOwned :
    forall (@0 surface : Region -> Type) (h : Type).
    (@B : BridgeBindable surface) ->
    (@H : BridgeHandle h) ->
    (1 handle : h) ->
    String ->
    IO H.Error (BridgePackage surface)
let useOwned handle name = bindModuleOwned handle name

