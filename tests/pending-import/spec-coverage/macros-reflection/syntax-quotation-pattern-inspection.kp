--! mode check
--! assertNoErrors

-- §21.5: a conforming implementation MUST provide quotation-pattern
-- matching on Syntax t (or an observationally equivalent stable public
-- inspection API) distinguishing at minimum identifiers, literals, and
-- application spines. This file pins the quotation-pattern option: a
-- literal pattern, an application-spine pattern binding head and
-- argument sub-syntax, and a wildcard fallback.
-- HOLD: §21.5's inspection MUST is disjunctive (quotation-pattern
-- matching OR an observationally equivalent stable public Syntax API),
-- and the spec defines no normative quotation-pattern grammar; the
-- `case '{ ... } ->` spellings below are conjectural. Not promotable
-- until a surface is normatively fixed (KNOWN_SPEC_ISSUES Part III).
module main

classify : Syntax Integer -> Elab (Syntax String)
let classify s =
    match s
    case '{ 0 } -> pure '{ "zero literal" }
    case '{ ${f} ${x} } -> pure '{ "application" }
    case _ -> pure '{ "other" }

zeroCase : String
let zeroCase = $(classify '{ 0 })

appCase : String
let appCase = $(classify '{ addInt 1 2 })

otherCase : String
let otherCase = $(classify '{ 7 })

-- STATUS: SPEC-ISSUE — §21.5 mandates inspection capability without a normative surface for either disjunct; assertNoErrors is not portably entailed
