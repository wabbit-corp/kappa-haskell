--! mode check
--! assertErrorCount 2

-- §12.3.1: a user-written capture annotation is an upper bound —
-- elaboration accepts a value at `T captures (sbar)` only if its
-- inferred hidden region environment is contained in {sbar}. Neither
-- {s} ⊆ {} nor {s} ⊆ {t} holds, so both bodies must be rejected.
module main

-- {s} not ⊆ {}: `captures ()` demands an empty hidden environment
escapesEmpty :
    forall (s : Region).
    (&[s] x : Int) -> ((Unit -> Int) captures ())
let escapesEmpty (@0 s : Region) (&[s] x : Int) : ((Unit -> Int) captures ()) =
    \() -> x

-- {s} not ⊆ {t}: disjoint capture sets are not subsumed
crossRegion :
    forall (s : Region) (t : Region).
    (&[s] x : Int) -> (&[t] y : Int) -> ((Unit -> Int) captures (t))
let crossRegion (@0 s : Region) (@0 t : Region) (&[s] x : Int) (&[t] y : Int) : ((Unit -> Int) captures (t)) =
    \() -> x

