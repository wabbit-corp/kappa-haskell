-- §12.4.2: downstream modules perform escape checking against the
-- capture-annotated exported type. POSITIVE: the imported getter is
-- usable while the instantiating region is live. NEGATIVE: returning
-- it at a plain function type would need the caller-local anonymous
-- rigid region in an annotation, which §12.3.1 forbids — skolem
-- escape.
module main

import lib.(makeGetter)

useLocal : forall (s : Region). (&[s] x : Int) -> Int
let useLocal (@0 s : Region) (&[s] x : Int) : Int =
    block
        let g = makeGetter x
        g ()

bad : (& x : Int) -> (Unit -> Int)
let bad (& x : Int) : (Unit -> Int) =
    makeGetter x --!! E_QTT_BORROW_ESCAPE

