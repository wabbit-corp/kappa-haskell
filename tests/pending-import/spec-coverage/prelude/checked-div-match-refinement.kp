--! mode check
--! assertNoErrors

-- §17.1.6 (boolean matches introduce assumptions) × §28.2.1 checked
-- division: matching y == 0 against the literal False checks the branch
-- under @p : (y == 0) = False, which discharges the divDefined
-- obligation of (/) exactly as the equivalent if-guard does.
module main

matchDiv : Int -> Int -> Int
let matchDiv x y =
    match y == 0
    case True -> 0
    case False -> x / y

d1 : Int
let d1 = matchDiv 10 5

d2 : Int
let d2 = matchDiv 3 0

--! assertEval d1 2
--! assertEval d2 0
-- STATUS(a0497523): FAIL — §17.1.6 is not implemented for match: the False branch is not checked under @p : (y == 0) = False, so the divDefined obligation of (/) is E_UNSOLVED_IMPLICIT (the equivalent if-guard refinement works; see checked-div-proof-flow-refinement.kp).
