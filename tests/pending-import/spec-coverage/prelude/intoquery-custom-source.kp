--! mode check
--! assertNoErrors

-- §28.2 IntoQuery (normative member shape of §23.7: Mode, ItemQuantity,
-- Item, SourceDemand, toQuery): a user instance makes a custom type
-- usable in comprehension source position, with the item binder typed
-- by the instance's Item member.
module main

data Pair : Type =
    MkPair (a : Int) (b : Int)

instance IntoQuery Pair =
    let Mode = QueryMode.QueryMode QueryUse.Reusable QueryCard.QZeroOrMore
    let ItemQuantity = ω
    let Item = Int
    let SourceDemand = ω
    let toQuery p =
        match p
        case MkPair a b -> toQuery (a :: b :: Nil)

collect : Pair -> List Int
let collect p =
    [
        for x in p
        yield x + 1
    ]
