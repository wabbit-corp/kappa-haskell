-- §28.2 ElabGoal: the exported goal type is the dependent record alias
-- (ctx : CoreCtx, expected : Option (Core this.ctx Type)); both fields
-- project, with expected's type depending on the projected ctx.
module main

goalCtx : ElabGoal -> CoreCtx
let goalCtx g = g.ctx

goalExpected : (g : ElabGoal) -> Option (Core g.ctx Type)
let goalExpected g = g.expected

