--! mode check
--! assertNoErrors

-- §6.3.4.5 (L6156): "The standard `f`, `re`, `b`, and `type` prefixes
-- supplied by `std.prelude` are ordinary terms participating in this
-- mechanism." §28.1 (L33403): std.prelude "must include ... the
-- conventional prefixed-string handlers `f`, `re`, `b`, and `type` if
-- prefixed strings are supported". Prefixed strings ARE supported, so
-- re"..." and b"..." must resolve to prelude handlers and elaborate
-- without errors. (The result types are the handlers' respective
-- InterpolatedMacro indices - conventionally Regex and Bytes - so the
-- bindings below are deliberately unannotated.)

probe : Unit
let probe =
    block
        let compiled = re"[a-z]+"
        let raw = b"payload"
        ()
-- STATUS(74742dfd): FAIL — expected 0 errors, got 2; first error: E_NAME_UNRESOLVED "unresolved name 're' used as a string-literal prefix (Spec §6.3.4)" at line 17
