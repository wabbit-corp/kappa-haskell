--! mode check
--! assertErrorCount 1

-- §14.1.1 (Spec.md L14128-L14160): source code "may not construct, update,
-- pattern match on, or structurally reflect the evidence record" — `match d
-- with ...` is listed as rejected ("no constructor pattern for trait
-- evidence"). A record pattern against a trait evidence scrutinee is
-- structural reflection and MUST be rejected even when a catch-all case
-- makes the match exhaustive. No diagnostic family is fixed by the Spec,
-- so this test deliberately asserts only the required rejection.
module main

trait Named (a : Type) =
    nameOf : a -> String

instance Named Int =
    let nameOf n = "int"

-- NEGATIVE: record/constructor pattern on trait evidence.
bad : String
let bad =
    let
        d = summon (Named Int)
    in
        match d
        case (nameOf = f,) -> "reflected"
        case _ -> "opaque"

-- STATUS(e25d64e1): FAIL — expected 1 errors, got 0; source can structurally pattern-match trait evidence
