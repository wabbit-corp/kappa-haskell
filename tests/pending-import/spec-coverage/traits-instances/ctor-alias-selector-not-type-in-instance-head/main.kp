module main

-- §8.3.1 (Spec.md L7333-L7334): "If a kind selector is present, only that
-- selected kind is imported under the alias spelling." `ctor Pair as mkP`
-- imports ONLY the constructor facet of the same-spelling family under
-- `mkP`; the alias must NOT be paired with the type facet (pairing under
-- an alias is only for UNQUALIFIED aliased items, L7331-L7332).
import lib.(type Pair, ctor Pair as mkP, trait Sum, total)

-- POSITIVE: the aliased constructor constructs.
v : Pair
let v = mkP 3 4

-- NEGATIVE: `mkP` names only a data constructor, so it is not admissible
-- as the type argument of an instance head. (The exact code is not fixed
-- by the spec; a name-kind resolution error or an instance-head error are
-- both acceptable — but SOME error is required.)
instance Sum mkP =
    let total p = 7
-- STATUS(a0497523): FAIL — expected 1 errors, got 0
