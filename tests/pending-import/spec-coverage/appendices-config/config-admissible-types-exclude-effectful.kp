--! mode check
--! requires capability configMode
--! x-configProfile config-expression
--! x-configSchemaScope std.config std.build

-- §35.3/§35.5: the schema scope supplies only config-safe names, and
-- config-admissible types exclude IO, Ref, and function types. Effectful
-- vocabulary is simply absent from a config unit's scope, so referencing
-- IO or Ref is E_CONFIG_UNRESOLVED_NAME (§35.11); an ordinary type error
-- inside a config unit is reported as E_CONFIG_TYPE. No exact error
-- count is asserted: cascaded E_CONFIG_TYPE on the unresolved-annotation
-- lines is not forbidden by §35.11.
-- Staged until a harness provides the configMode capability.

let act : IO String = "x" --!! E_CONFIG_UNRESOLVED_NAME

let cell : Ref Int = 0 --!! E_CONFIG_UNRESOLVED_NAME

let g : Int -> Int = 0 --!! E_CONFIG_TYPE

-- STATUS(a0497523): UNSUPPORTED — configMode capability not provided; manifest-checker cross-check matches all three markers (plus cascaded E_CONFIG_TYPE on the unresolved-annotation lines)
