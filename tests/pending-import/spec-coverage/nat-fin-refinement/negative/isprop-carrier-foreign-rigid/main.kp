-- Spec 14.4 soundness — carrier-recovery integrity in the IsProp
-- solver. The carrier of an equality is the equands' OWN homogeneous
-- type; here that is `Bool -> Bool`, which has no Eq and hence no IsSet
-- in any coherent closure (Spec 28.2 provides no function-type Eq, and
-- Spec 14.5.1 refuses to assume function extensionality). The stuck
-- equand additionally mentions a String rigid `s`, and `IsSet String`
-- is obtainable from the required `Eq String`. A solver that recovered
-- the carrier from a foreign type merely OCCURRING in the equand could
-- grab that evidence and incorrectly certify the equality as an
-- h-proposition. The IsProp obligation over the TRUE carrier must stay
-- unsolved. (The production consumer of this obligation is
-- unsafeAssertProof's IsProp gate, Spec 4.5; that unsafe form is
-- build-configuration-gated and has no standard harness directive, so
-- the obligation is demanded here directly through witness.)

forge :
    (s : String) ->
    (f : String -> (Bool -> Bool)) ->
    IsProp ((f s) = (\ (b : Bool) -> b))

let forge s f =
    witness

--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.implicit.unsolved
