-- Spec 14.4 soundness: Kappa equality is intensional and does not
-- assume UIP. `unsafeAssertProof` may construct an equality proof only
-- when its carrier is known to be a set. Under Spec 14.1's
-- `trait IsSet a => Eq`, every carrier with Eq in its coherent closure
-- is a set, so the pre-revision Option Bool / List Bool carriers no
-- longer discriminate (their IsSet goals now resolve — see
-- positive/isset-supertrait-closure). Function types receive no Eq
-- instance (Spec 28.2.3), and Spec 14.5.1 refuses to assume function
-- extensionality when deriving, so `Bool -> Bool` has NO IsSet anywhere
-- in its closure: the IsProp obligation on the asserted equality stays
-- unsolved and the assertion is REJECTED. This keeps the no-UIP
-- tripwire closed in the revised prelude.

bogus : (=) @(Bool -> Bool) (\ (b : Bool) -> b) (\ (b : Bool) -> True)
let bogus = unsafeAssertProof "spec-forbidden: function carriers are not known sets"

--! allow_unsafe_assert_proof
--! assertErrorCount 1
--! assertDiagnostic error E_UNSOLVED_IMPLICIT
