-- T.12.3 / Spec 14.3.3 + 33.2.1: Semiring reaches AdditiveMonoid along
-- two supertrait paths (Semiring => CommutativeAdditiveMonoid =>
-- AdditiveMonoid and Semiring => AdditivelyNoncommutativeSemiring =>
-- AdditiveMonoid), and a well-formed Semiring dictionary must project
-- the SAME coherent AdditiveMonoid evidence along both.

-- ACCEPTED control: path multiplicity alone is harmless. Projecting
-- through ONE Semiring premise reaches AdditiveMonoid twice, but a
-- well-formed trait stores one canonical coherent supertrait
-- projection per normalized goal, so resolution selects a
-- deterministic representative (Spec 14.3.3).
coherentWithinOneDictionary :
    forall (A : Type).
    (@semiringEvidence : Semiring A) ->
    AdditiveMonoid A

let coherentWithinOneDictionary @semiringEvidence =
    witness

-- REJECTED: abstracting the two paths as independent premises models
-- incompatible path evidence: the shared AdditiveMonoid goal is
-- reachable from two local evidence values whose projections cannot be
-- proven coherent under Spec 33.2.1 (two distinct symbolic evidence
-- roots have distinct canonical identities), and an
-- implementation-dependent path choice is forbidden, so the goal must
-- be rejected rather than silently picking one dictionary.
pickAdditivePath :
    forall (A : Type).
    (@commutativePath : CommutativeAdditiveMonoid A) ->
    (@noncommutativePath : AdditivelyNoncommutativeSemiring A) ->
    AdditiveMonoid A

let pickAdditivePath @commutativePath @noncommutativePath =
    witness

--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.implicit.ambiguous
