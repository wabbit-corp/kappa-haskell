-- Spec 14.5.1: compiler-owned `derive Eq` on first-order data generates
-- checked (==)/eqSound/eqComplete members and discharges the IsSet
-- supertrait. IntChain is the recursive first-order shape — checked by
-- the guarded structural fragment, the same generator the mandatory
-- prelude `derive Eq Nat` uses (Spec 28.2) — and ChainW is a
-- single-constructor wrapper over it.
data IntChain : Type =
    ChainNil
    ChainCons (head : Int) (tail : IntChain)

derive Eq IntChain

data ChainW : Type =
    MkChainW (payload : IntChain)

derive Eq ChainW

-- The derived evidence exposes the IsSet supertrait by ordinary
-- projection (Spec 14.1.4, 14.3.3).
wrapperIsSet : IsSet ChainW
let wrapperIsSet = summon (IsSet ChainW)

twoCopies : ChainW
let twoCopies = MkChainW (ChainCons 1 (ChainCons 2 ChainNil))

eqWrapped : Bool
let eqWrapped = twoCopies == MkChainW (ChainCons 1 (ChainCons 2 ChainNil))

oneCopy : ChainW
let oneCopy = MkChainW (ChainCons 1 ChainNil)

distinct : Bool
let distinct = oneCopy /= twoCopies

--! assertNoErrors
--! assertType eqWrapped Bool
--! assertEval eqWrapped True
--! assertEval distinct True
