--! assertNoErrors
--! assertEval aboveWord 18446744073709551617
--! assertEval largeProduct 18446744073709551616
--! assertEval largeQuotient 6148914691236517205
--! assertEval largeRemainder 2
--! assertEval largeSuccessor 18446744073709551618
--! assertEval largePredecessor 18446744073709551616
--! assertEval largeComparison GT
--! assertEval hugeDelta 1
--! assertEval hugeComparison GT
--! assertExactNaturalRepresentation for Nat
--! assertRepresentationClass aboveWord ExactNatural
--! assertRepresentationClass huge ExactNatural
