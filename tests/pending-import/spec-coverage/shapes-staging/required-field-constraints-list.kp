--! mode check
--! assertNoErrors

-- §22.4: 'requiredRuntimeFieldConstraints tc shape' returns exactly
-- one 'FieldConstraint tc' for every runtime-relevant constructor
-- field — the erased 'ghost' field contributes no constraint, so a
-- constructor with two runtime fields yields exactly two constraints.

import std.deriving.shape.*

data PairT : Type =
    MkPairT (0 ghost : Nat) (x : Integer) (y : Integer)

checkCount : Elab (Syntax String)
let checkCount = do
    let shape <- inspectAdt @PairT '{ type PairT }
    let cs <- requiredRuntimeFieldConstraints @Eq @PairT shape
    match listLength cs == 2
    case True -> stringSyntax "ok"
    case False -> failElab "expected one FieldConstraint per runtime-relevant field"

ok : String
let ok = $(checkCount)
-- STATUS(74742dfd): FAIL — expected 0 errors, got 2; first error: E_NAME_UNRESOLVED "unresolved name 'requiredRuntimeFieldConstraints' (not in scope)" at line 17
