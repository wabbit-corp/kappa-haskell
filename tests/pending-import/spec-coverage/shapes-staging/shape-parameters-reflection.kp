--! mode check
--! assertNoErrors

-- §22 (ShapeParameter) / §22.2: AdtShape.parameters reflects the
-- declared type parameters with stable names — for 'Box (a : Type)'
-- exactly one parameter whose renderName is "a". Inspection of an
-- applied data type ('Box Integer') succeeds per §22.1.

import std.deriving.shape.*

data Box (a : Type) : Type =
    MkBox (v : a)

checkParams : Elab (Syntax String)
let checkParams = do
    let shape <- inspectAdt @(Box Integer) '{ Box Integer }
    match shape.parameters
    case p :: Nil ->
        (match p.renderName == "a"
         case True -> stringSyntax "ok"
         case False -> failElab "wrong parameter name")
    case _ -> failElab "expected exactly one reflected parameter"

ok : String
let ok = $(checkParams)
-- STATUS(a0497523): FAIL — AdtShape has no 'parameters' member (E_UNRESOLVED_MEMBER); §22 ShapeParameter reflection unimplemented
