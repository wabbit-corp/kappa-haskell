--! mode run
--! assertNoErrors
--! assertStdout "Green\n"

-- §22.5 x §23.2 combination: a function whose body was generated by
-- shape reflection (matchAdt) is referenced inside a staged-code
-- quote; the derived code crosses the stage boundary through
-- closeCode/runCode unchanged.

import std.deriving.shape.*

data Color : Type =
    Red
    Green
    Blue

deriveTag : forall (@0 a : Type). Syntax Type -> Syntax a -> Elab (Syntax String)
let deriveTag @a target value = do
    let shape <- inspectAdt @a target
    matchAdt shape value \ctor fields ->
        stringSyntax ctor.renderName

tagName : Color -> String
let tagName value =
    $(deriveTag @Color '{ type Color } '{ value })

staged : Code String
let staged = .< tagName Green >.

main : UIO Unit
let main = do
    match closeCode staged
    case Some cc -> do
        let s <- runCode cc
        printlnString s
    case None -> printlnString "not closed"
