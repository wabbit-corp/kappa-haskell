-- §19.2/§18.8.3.1: except handlers do not intercept break; a break inside the
-- try body propagates outward to the enclosing loop, and the finally clause
-- (elaborated via defer) still runs while the do-scope unwinds — spec §19.2
-- lists "a break/continue propagating through the try" as a finally trigger.
--! mode run
--! assertNoErrors
--! assertStdout "body\nfin\nafter\n"
module main

main : UIO Unit
let main = do
    while True do
        try do
            printlnString "body"
            break
        finally ->
            printlnString "fin"
    printlnString "after"
-- STATUS(74742dfd): FAIL — expected 0 errors, got 1; first error: E_BREAK_OUTSIDE_LOOP "'break' is valid only within the body of a loop of this do-scope (§18.6)" at line 15; stdout mismatch: expected "body\nfin\nafter\n", got ""
