-- §20.5.1/§20.5: on an Ordered pipeline, `on conflict keep first` retains v0
-- and `keep last` retains vn for each key's encountered values; with no
-- `on conflict` clause the default policy is `keep last` in encounter order.
--! mode run
--! assertNoErrors
--! assertStdout "first: 1\nlast: 3\ndefault: 3\n"
module main

showLookup : String -> Map Int Int -> UIO Unit
let showLookup tag m = do
    match mapLookup 0 m
    case Some v -> printlnString (stringAppend tag (showInt v))
    case None -> printlnString "none"

main : UIO Unit
let main = do
    let firstM = { for x in [1, 2, 3], yield 0 : x on conflict keep first }
    let lastM  = { for x in [1, 2, 3], yield 0 : x on conflict keep last }
    let defM   = { for x in [1, 2, 3], yield 0 : x }
    showLookup "first: " firstM
    showLookup "last: " lastM
    showLookup "default: " defM
