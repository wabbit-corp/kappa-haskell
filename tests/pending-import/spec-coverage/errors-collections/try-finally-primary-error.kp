-- §19.2 rule 6 / §18.8.3 steps 4-6: when both the try body and the finalizer
-- raise, the propagated error is `throwError primary` — the finalizer error
-- may be attached as suppressed information or discarded, but it MUST NOT
-- replace the primary error as the ordinary propagated error.
--! mode run
--! assertNoErrors
--! assertStdout "cleanup\ncaught: primary\n"
module main

both : IO String Unit
let both = do
    try (raise "primary")
    finally -> do
        printlnString "cleanup"
        raise "secondary"

main : UIO Unit
let main = do
    try both
    except e -> printlnString (stringAppend "caught: " e)
-- STATUS(74742dfd): FAIL — stdout mismatch: expected "cleanup\ncaught: primary\n", got "cleanup\ncaught: secondary\n"
