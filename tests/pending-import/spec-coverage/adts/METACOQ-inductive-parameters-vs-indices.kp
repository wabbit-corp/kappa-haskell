-- Source issues: METACOQ-1120, METACOQ-1108
-- Spec: §10.1.3 (uniform data-family arguments), §10.2 (GADT-style
--       constructors), §10.4 (well-formedness).
--
-- MetaCoq distinguishes parameters from indices. Kappa instead places every
-- family argument in the data header; a GADT constructor's explicit result
-- determines which family arguments it constrains. This fixture preserves the
-- portable substance: `a` remains unchanged while constructor results vary `n`.

module test

--! mode check

-- POSITIVE: uniform parameter `a` is constant across constructors; index
-- `n : Nat` varies per constructor.
data Vec (0 a : Type) (n : Nat) : Type =
    VNil  : Vec a 0
    VCons : (head : a) -> (tail : Vec a n) -> Vec a (n + 1)

-- POSITIVE: same data type used at different uniform parameters.
boolVec : Vec Bool 2
let boolVec = VCons True (VCons False VNil)

natVec : Vec Nat 1
let natVec = VCons 1 VNil

-- POSITIVE: a constructor that introduces an index dependency between
-- parameters (Geq x y ≡ x ≥ y).
data Geq (n : Nat) (m : Nat) : Type =
    EqBase : Geq n 0
    EqSuc  : (proof : Geq n m) -> Geq (n + 1) (m + 1)

ok : Geq 2 1
let ok = EqSuc EqBase

--! assertNoErrors
--! assertType boolVec Vec Bool 2
--! assertType natVec Vec Nat 1

-- STATUS(a0497523): FAIL (GADT constructor-result equalities do not normalize)
