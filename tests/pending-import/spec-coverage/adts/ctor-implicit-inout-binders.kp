-- Spec: §10.1 (L8320-8322, L8331-8340). Constructor parameters may use the
-- ordinary quantity/implicit machinery, e.g. (@0 p : P); 'inout' binders
-- are NOT permitted in constructor declarations, and default clauses are
-- not permitted on implicit constructor binders.

module main

--! mode check

data Nat : Type =
    Zero
    Succ (n : Nat)

-- POSITIVE: an erased implicit binder among constructor parameters.
data Sized : Type =
    MkSized (@0 bound : Nat) (value : Nat)

small : Sized
let small = MkSized { value = Zero }

-- NEGATIVE: 'inout' is not permitted in a constructor declaration.
data BadInout : Type =
    MkBadInout (inout cell : Nat) --!! E_QTT_INOUT_BINDER_CONTEXT

-- NEGATIVE: a default clause on an implicit constructor binder written
-- with '@' is not permitted (L8331-8337).
data BadImplicitDefault : Type =
    MkBadImplicitDefault (@w : Nat = Zero) (x : Nat)

--! assertErrorCount 2

-- STATUS(a51e1bf): FAIL — the inout rejection works (E_QTT_INOUT_BINDER_
-- CONTEXT), but a default clause on an implicit constructor binder
-- (@w : Nat = Zero) is accepted silently at the declaration (1 error
-- instead of 2); the default is then ignored — a use site reports
-- E_UNSOLVED_IMPLICIT instead of defaulting — so the L8331-8337 ban is
-- unenforced.
