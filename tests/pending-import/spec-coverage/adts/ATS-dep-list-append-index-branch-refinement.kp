-- Source: ATS-Xanadu tests/srcgen1/TEST/DATA/test01.dats
--         (`fun<a:type> append(xs:list(a),ys:list(a)): list(a)`)
-- Spec: §10.1.3 / §10.2 ("When pattern matching on a GADT-style
--       constructor, the branch-local environment receives the
--       equalities between the scrutinee's family arguments and the
--       constructor result's family arguments forced by that
--       constructor result type"), §17 (constructor branches).
-- Pins the branch-refinement half of dependent list traversal: an
-- index-preserving identity function over a length-indexed list is
-- well-typed because the SLNil branch learns n = 0 and the SLCons
-- branch learns n = k + 1. No symbolic arithmetic identities are
-- needed - only the forced family-argument equalities themselves.

--! mode check

module main

data SL (n : Nat) (0 a : Type) : Type =
    SLNil  : SL 0 a
    SLCons : (head : a) -> (tail : SL n a) -> SL (n + 1) a

-- POSITIVE (spec-required): each branch's forced index equality makes
-- the branch body check at the refined index.
idSL : forall (n : Nat) (a : Type). SL n a -> SL n a
let idSL xs =
    match xs
    case SLNil -> SLNil
    case SLCons x tl -> SLCons x (idSL tl)

--! assertNoErrors
