-- §10.4.2 (strict positivity) × §11.2 (suspension types): `Thunk` is not an
-- admissible positivity-preserving type former (it carries no
-- parameter-positivity signature), and that fact must PROPAGATE through a
-- user-defined wrapper: `Box a = MkBox (Thunk a)` gets its parameter marked
-- non-positive by the §10.4.2 signature computation, so recursion under
-- `Box` must be rejected exactly like direct recursion under `Thunk`
-- (the direct case is pinned in spec-coverage/adts/ATS-lazy-stream-eval-
-- positivity.kp). Contrast: a function-typed field whose domain does not
-- mention the defined type IS admissible (§10.4.2 admissibility bullet 4),
-- so `Codata` is accepted.
module main

data Box (a : Type) : Type =
    MkBox (unbox : Thunk a)

data Rose : Type =                       --!! E_DATA_NOT_STRICTLY_POSITIVE
    Node Int (Box Rose)

data Codata : Type =
    Tip
    Branch Int (Unit -> Codata)

--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_DATA_NOT_STRICTLY_POSITIVE
-- STATUS(a0497523): PASS
