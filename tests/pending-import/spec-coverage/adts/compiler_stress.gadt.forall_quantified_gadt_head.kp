-- Stress test: GADT constructor with forall-quantified erased implicit; inferred at application sites
-- Spec: §10.2 (GADT constructors), §12.1-§12.2 (erased parameters),
--       §17.1.1 (GADT branch refinement).
--
-- The equality GADT is named `EqT`/`ReflT` (matching
-- adts/gadt-result-constraint-refinement.kp): `Eq` is now a prelude
-- TRAIT with an `IsSet a` supertrait and required `eqSound`/`eqComplete`
-- members (§18, §14.5.1) and must not be shadowed by test fixtures —
-- shadowing it would make `derive Eq`, `instance Eq ...`, and
-- `IsSet`/`Eq` supertrait obligations unwritable in this module.

--! mode check

data Pair (0 a : Type) (0 b : Type) : Type =
    MkPair : a -> b -> Pair a b

-- Propositional equality as a GADT; erased implicit x inferred from application context.
data EqT (0 a : Type) (0 x : a) (0 y : a) : Type =
    ReflT : forall (@0 x : a). EqT a x x

-- Construct ReflT for a known element; erased x is inferred from the return type.
eqInt : EqT Int 42 42
let eqInt = ReflT

eqBool : EqT Bool True True
let eqBool = ReflT

-- cong: if x = y then f x = f y.  Erased implicit in ReflT inferred at both uses.
cong : forall (a : Type) (b : Type) (x : a) (y : a). (f : a -> b) -> EqT a x y -> EqT b (f x) (f y)
let cong f pf = match pf
  case ReflT -> ReflT

-- trans: transitivity; erased implicits inferred at each ReflT.
trans : forall (a : Type) (x : a) (y : a) (z : a). EqT a x y -> EqT a y z -> EqT a x z
let trans p q = match p
  case ReflT -> match q
    case ReflT -> ReflT

--! assertNoErrors

-- STATUS(74742dfd): FAIL — expected 0 errors, got 2; first error: E_TYPE_EQUALITY_MISMATCH "type mismatch" at line 31
