-- Spec: §10.1.3, §10.2 (a GADT constructor may instantiate any
-- data-family argument in its result type; matching it makes the forced
-- family-argument equalities available branch-locally), §10.2.1
-- (generated no-confusion packages; for the prelude Nat these are the
-- `expect term`s natSuccInjective / natZeroNotSucc), §30.2.7 (4-way
-- ConstructorCompatibility), §15.8 (required arithmetic/index solver),
-- §16.1.8 (automatic transport insertion), §28.2 (inductive prelude
-- Nat — a local Peano Nat is no longer needed; note `Zero`/`Succ` are
-- NOT in §28.1's unqualified constructor subset, hence `Nat.Zero` /
-- `Nat.Succ`).
--
-- The cases below cover all four §30.2.7 outcomes: forced-equality
-- refinement (DefinitionallyCompatible), a solver-bridged construction
-- (PropositionallyCompatible via §16.1.8), a no-confusion refutation
-- (Refuted), and an undecidable rigid mismatch (UnknownCompatibility).

module main

--! mode check

data EqT (a : Type) (x : a) (y : a) : Type =
    ReflT : EqT a x x

-- POSITIVE (DefinitionallyCompatible): with x = y in scope, ReflT also
-- checks at EqT a y x.
symmE : forall (a : Type) (x : a) (y : a). EqT a x y -> EqT a y x
let symmE p =
    match p
    case ReflT -> ReflT

-- POSITIVE (DefinitionallyCompatible): transport across the forced
-- index equality, over the prelude Nat on constructor spelling so the
-- indices stay definitional.
data Vec (n : Nat) (a : Type) : Type =
    VNil  : Vec Nat.Zero a
    VCons : (head : a) -> (tail : Vec n a) -> Vec (Nat.Succ n) a

castLen : forall (n : Nat) (m : Nat). EqT Nat n m -> Vec n Int -> Vec m Int
let castLen p v =
    match p
    case ReflT -> v

-- POSITIVE (PropositionallyCompatible): `n + 1` and `Nat.Succ n` are
-- NOT definitionally equal (`natAdd n 1` is stuck on the rigid `n`), so
-- `ReflT : EqT Nat (Nat.Succ n) (Nat.Succ n)` does not check at the
-- stated type by unification alone. The §15.8 solver proves
-- `n + 1 = Succ n`, and §16.1.8 inserts the (erased, IsProp by §28.2
-- `derive IsSet Nat`) transport at the expected-type boundary.
reflBridge : forall (n : Nat). EqT Nat (n + 1) (Nat.Succ n)
let reflBridge = ReflT

-- POSITIVE (Refuted): ReflT demands `Nat.Zero = Nat.Succ Nat.Zero`,
-- refuted by the §10.2.1 no-confusion package (natZeroNotSucc); the
-- remainder is empty and §17.1.5 accepts `case impossible`.
noConf : EqT Nat Nat.Zero (Nat.Succ Nat.Zero) -> Void
let noConf p =
    match p
    case impossible

-- NEGATIVE (UnknownCompatibility): without matching ReflT no equality
-- is available; x and y are rigid NON-ARITHMETIC terms, so §30.2.7
-- rule 2 has no required solver domain to bridge them and no
-- refutation applies — neither compatibility nor incompatibility is
-- proved, and §16.1.8 has no proof source. ReflT cannot check at
-- EqT a x y.
bogus : forall (a : Type) (x : a) (y : a). EqT a x y
let bogus = ReflT --!! kappa.type.mismatch

--! assertErrorCount 1
