--! mode check
--! assertErrorCount 2
--! assertDiagnosticFamily error kappa.pattern.constructor-arity

-- Source issues: ELIXIR-PR-13518 (type inference for structs),
--   module/types/pattern_test.exs "unknown field"
-- Spec: §17.2 (named-field constructor patterns), §3.2.10
--       (kappa.pattern.constructor-arity: "supplies fields not declared by
--       the constructor")
-- A named-field constructor pattern mentioning a field the constructor does
-- not declare is rejected with kappa.pattern.constructor-arity, both alone
-- and mixed with valid fields.  (The duplicate-field case is split into
-- ELIXIR-pattern-struct-unknown-field-rejected-duplicate.kp.)
module main

data Point : Type =
    Point (x : Int) (y : Int)

-- POSITIVE: pattern uses exactly the declared fields.
isOrigin : Point -> Bool
let isOrigin p =
    match p
    case Point { x = 0, y = 0 } -> True
    case _                      -> False

-- POSITIVE: pattern with an explicit wildcard on an unused field.
getX : Point -> Int
let getX p =
    match p
    case Point { x = n, y = _ } -> n

-- NEGATIVE: `z` is not a field of Point.  (The arm body avoids the dropped
-- binder so the undeclared-field diagnostic stands alone.)
badField : Point -> Int
let badField p =
    match p
    case Point { z = _ } -> 1 --!! kappa.pattern.constructor-arity
    case _               -> 0

-- NEGATIVE: an undeclared field alongside a valid one.
mixedBadField : Point -> Int
let mixedBadField p =
    match p
    case Point { x = n, label = _ } -> n --!! kappa.pattern.constructor-arity
    case _                          -> 0

-- STATUS(a0497523): PASS
