-- §17.1.3 equality-proof scrutinees (Spec L17849-L17864): a source match
-- on an equality proof available only at quantity 0 is accepted when it
-- elaborates to erased equality induction — the branch only refines types
-- or produces proof-level results — or when the scrutinee is forced to
-- `refl` by definitional equality of its endpoints.

--! mode check
--! assertNoErrors

-- Proof-only result: erased symmetry. IsSet a makes both the scrutinee and
-- result equality proofs RuntimeErased, so this does not assume erasure for
-- proof-relevant higher paths (accepted per §17.1.3, second bullet).
sym0 : forall (@0 a : Type) (@0 x : a) (@0 y : a) (@_ : IsSet a). (0 p : (=) x y) -> (=) y x
let sym0 p =
    match p
    case refl -> refl

-- Endpoints definitionally equal: the scrutinee is already forced to
-- `refl`, so a runtime-relevant result is fine (third bullet).
forcedRefl : (0 p : (=) True True) -> Int
let forcedRefl p =
    match p
    case refl -> 7

-- Type-refining only: the runtime result `v` passes through unchanged;
-- the match performs no runtime discrimination of `p` (second bullet).
cast0 : forall (@0 a : Type) (@0 b : Type). (0 p : (=) a b) -> a -> b
let cast0 p v =
    match p
    case refl -> v

-- STATUS(ab0a1126): FAIL — SPEC-CORRECT — all three allowed erased equality-induction shapes are rejected with E_QTT_ERASED_RUNTIME_USE at their proof scrutinees: RuntimeErased symmetry, definitionally forced refl, and a type-refining cast that returns its runtime payload unchanged (§17.1.3).
