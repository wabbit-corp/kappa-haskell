-- Source: Racket guide match.scrbl (struct patterns in match)
-- Source docs: racket guide match.scrbl (corpus repos/github-racket-racket/docs/pkgs/racket-doc/scribblings/guide/match.scrbl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §17.1 (match exhaustiveness), §10.1 (data declarations), §3.2.9 (kappa.pattern.non-exhaustive)
-- NOTE: overlaps with tests/conformance/match/not-exhaustive.kp (missing-ctor negative)
--
-- Pins: a match on a user data type must cover all constructors; constructor
-- patterns bind the fields; a wildcard arm covers the residual; omitting a
-- constructor produces kappa.pattern.non-exhaustive (two shapes: missing one
-- of three, and matching only one of three).

--! mode check

data Shape : Type =
    Circle Float
    Rect Float Float
    Triangle Float Float Float

-- POSITIVE: all three constructors covered.
area : Shape -> Float
let area s =
    match s
    case Circle r       -> 3.14159 * r * r
    case Rect w h       -> w * h
    case Triangle a b c ->
        let s0 = (a + b + c) / 2.0
        in
        s0 * (s0 - a) * (s0 - b) * (s0 - c)

-- POSITIVE: match with a wildcard covers the remaining cases.
isCircle : Shape -> Bool
let isCircle s =
    match s
    case Circle _ -> True
    case _        -> False

-- POSITIVE: every arm produces the same declared type.
describe : Shape -> String
let describe s =
    match s
    case Circle _       -> "circle"
    case Rect _ _       -> "rectangle"
    case Triangle _ _ _ -> "triangle"

described : String
let described = describe (Rect 2.0 3.0)

-- NEGATIVE: match missing the Triangle case — non-exhaustive.
badArea : Shape -> Float
let badArea s =
    match s              --!! E_PATTERN_NON_EXHAUSTIVE
    case Circle r -> 3.14159 * r * r
    case Rect w h -> w * h

-- NEGATIVE: single-constructor match on a three-constructor type.
onlyCircle : Shape -> Float
let onlyCircle s =
    match s              --!! E_PATTERN_NON_EXHAUSTIVE
    case Circle r -> r

--! assertDiagnosticFamily error kappa.pattern.non-exhaustive
--! assertErrorCount 2
--! assertEval described "rectangle"
-- STATUS(a0497523): PASS
