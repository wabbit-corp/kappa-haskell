-- Stress test: a match missing at least one constructor is rejected
-- Spec: §17.1 (exhaustiveness), §3.2.10 (pattern diagnostics).

--! mode check

data Direction : Type =
    North
    South
    East
    West

-- NEGATIVE: West is not covered; the match is non-exhaustive.
partial : Direction -> Int
let partial d =
    match d
    case North -> 0
    case South -> 1
    case East  -> 2   --!! kappa.pattern.non-exhaustive

--! assertDiagnosticFamily error kappa.pattern.non-exhaustive

-- STATUS(a0497523): FAIL (correct family is emitted at the match, not the pinned arm span)
