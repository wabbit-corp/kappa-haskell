--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.deriving.shape
--! assertDiagnosticMatch (constructor|field|argument)

-- §3.2.13, §22 (expect term constructAdt; §22.5): supplying an empty
-- field-argument list for a constructor with one declared field MUST
-- fail in family kappa.deriving.shape (portable meaning
-- E_DERIVING_SHAPE_BAD_CONSTRUCTOR_ARGUMENTS).
module main

import std.deriving.shape.*

data Wrap : Type =
    MkWrap (value : Int)

firstConstructor : forall (@0 a : Type). AdtShape a -> Elab ShapeConstructor
let firstConstructor shape =
    match shape
    case AdtShape _ _ _ _ (c :: _) -> pure c
    case AdtShape _ _ _ _ Nil -> failElab "no constructors"

badBuild : Elab (Syntax Wrap)
let badBuild = do
    let shape <- inspectAdt @Wrap '{ type Wrap }
    let ctor <- firstConstructor shape
    -- MkWrap requires one field argument; none are supplied
    constructAdt shape ctor []

bad : Wrap
let bad = $(badBuild)
-- STATUS(a0497523): FAIL — std.deriving.shape does not provide constructAdt (unresolved name); §22 expect-term surface incomplete, so no kappa.deriving.shape BAD_CONSTRUCTOR_ARGUMENTS is emitted
