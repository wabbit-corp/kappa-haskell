--! mode check
--! requires capability unicodeNames
--! assertErrorCount 1
--! assertDiagnostic error E_UNICODE_NAME_NON_NORMALIZED
--! assertDiagnosticFamily error kappa.unicode.name

-- §3.2.19 + §5.1A (L4664): with the unicode-names gate active,
-- unquoted Unicode identifiers MUST already be in the profile
-- normalization form; `café` (e + U+0301 combining acute, non-NFC)
-- MUST be rejected with E_UNICODE_NAME_NON_NORMALIZED. The NFC-composed
-- spelling of a different name (positive half) is accepted.
-- (This implementation never activates unicode-names, so the test is
-- staged behind an implementation capability and reports unsupported.)
module main

let café = 1

let caféMenu = 2
-- STATUS(a0497523): UNSUPPORTED — requires capability unicodeNames, which this implementation does not provide (unquoted Unicode identifiers are gate-rejected with E_FEATURE_INACTIVE)
