--! mode check
--! assertErrorCount 1
-- §3.2.14: a bridge binding that fails at compile time MUST use family
-- kappa.bridge.contract, with the bridge origin, contract identity,
-- expected Kappa surface, and boundary direction in the payload.
--! assertDiagnosticFamily error kappa.bridge.contract
--! assertDiagnosticMatch (bridge|contract|surface|BridgeBindable)

-- §3.2.14, §25.1, §26.1.12: `bindModule` demands `BridgeBindable
-- MathSurface` contract evidence. No contract can be formed for this
-- local surface (no generator, summary, or contract-builder supplied),
-- so the bridge binding MUST fail with a bridge-contract diagnostic
-- rather than a generic implicit-resolution error.
module main

import std.bridge.*

data DummyHandle : Type =
    MkDummyHandle

instance BridgeHandle DummyHandle =
    let bridgeOrigin h = pure (MkBridgeOrigin "dummy")
    let bridgeFailure f = "dummy"

type MathSurface (r : Region) = (add : Int -> Int -> Int)

useBridge : IO BridgeFailure Unit
let useBridge = do
    let m <- bindModule @MathSurface MkDummyHandle "math"
    pure ()
-- STATUS(a51e1bf): FAIL — family kappa.bridge.contract is not registered (harness-error §T.5.1); the failed contract formation surfaces only as generic E_UNSOLVED_IMPLICIT (kappa.implicit.unsolved) for BridgeBindable MathSurface
