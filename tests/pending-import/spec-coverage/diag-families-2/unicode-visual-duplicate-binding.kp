-- §3.2.19 + §5.1A: the StrongVisualNameTable MUST include the visual
-- equivalence class { U+0041 LATIN A, U+0391 GREEK ALPHA, U+0410
-- CYRILLIC A }, and two same-scope declarations with distinct source
-- spellings but one StrongVisualNameKey MUST be rejected with
-- E_UNICODE_VISUAL_DUPLICATE_BINDING (kappa.unicode.name). Backtick
-- spellings contribute the SAME visual key as unquoted ones (§5.1A),
-- so the gate on unquoted Unicode identifiers does not excuse this.
module main

let A = 1
let `А` = 2
