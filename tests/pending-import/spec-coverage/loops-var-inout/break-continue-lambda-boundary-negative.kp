--! mode check
--! assertErrorCount 2

-- §18.8.10/§18.6: break/continue resolve lexically within the current
-- user-written function or lambda body and MUST NOT cross a user-written
-- lambda boundary — not even to reach a loop or loop label that encloses
-- the lambda.
module main

bad1 : UIO Unit
let bad1 = do
    for i in 1 :: Nil do
        let f : Unit -> UIO Unit = \() -> do
            break --!! E_BREAK_OUTSIDE_LOOP
        let _ <- f ()
        pure ()
    pure ()

bad2 : UIO Unit
let bad2 = do
    outer@for i in 1 :: Nil do
        let g : Unit -> UIO Unit = \() -> do
            continue@outer --!! E_LABEL_UNRESOLVED
        let _ <- g ()
        pure ()
    pure ()

-- STATUS(a0497523): PASS
