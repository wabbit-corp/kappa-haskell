--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.type.mismatch

-- §18.6.4: escape prevention via rank-2 polymorphism. `runST` requires its
-- computation to be polymorphic in the region `s`; a computation whose
-- result type mentions `s` (returning the STRef itself) cannot instantiate
-- `a` without the rigid region variable escaping its scope, and is rejected
-- as a standard skolem-escape type error. A region-independent result is
-- accepted.
module main

data ST (0 s : Type) (0 a : Type) : Type =
    MkST (run : a)

data STRef (0 s : Type) (0 a : Type) : Type =
    MkSTRef (idx : Int)

runST : forall (a : Type). (forall (s : Type). ST s a) -> a
let runST comp =
    match comp @Unit
    case MkST x -> x

leakRef : forall (s : Type). ST s (STRef s Int)
let leakRef = MkST (MkSTRef 0)

okComp : forall (s : Type). ST s Int
let okComp = MkST 42

ok : Int
let ok = runST okComp

badRun : UIO Unit
let badRun = do
    let r = runST leakRef --!! kappa.type.mismatch
    pure ()

