--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.var.mutable-binding

-- §18.6.1 (no-read contexts): a mutable binding's current-value facet is
-- unavailable in type positions — a dependent type index must not read the
-- cell (`badType`). Mentioning the current value in a later type requires
-- binding a snapshot first (`ok`). NOTE: whether an explicit erased
-- ARGUMENT position, e.g. (0 n : Int), is also a no-read context is left
-- unclear by the spec ("erased proof positions"); this implementation
-- accepts a lifted snapshot read there, so that case is not pinned here.
module main

data Tagged (0 n : Int) : Type =
    MkTagged

badType : UIO Unit
let badType = do
    var n = 3
    let t : Tagged n = MkTagged --!! E_VAR_IN_STATIC_POSITION
    pure ()

ok : UIO Unit
let ok = do
    var n = 3
    let n0 = n
    let t : Tagged n0 = MkTagged
    pure ()

-- STATUS(a0497523): PASS
