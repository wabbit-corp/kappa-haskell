-- Source issue: ROSETTE-PR-172 (Add the value destructuring library),
--                ROSETTE-216 (match inconsistency motivates predictable
--                destructuring)
-- Spec: §9.1.2 (irrefutable patterns for let bindings), §9.3 (let-in and
--       local let items), §17.2.1 (tuple patterns), §16.2 (binder
--       patterns in parameters).
-- Pins: a let may bind a tuple pattern directly (also nested, also as a
-- function parameter); a width-mismatched tuple pattern is a static
-- type error, with no symbolic-vs-concrete discrepancy.

--! mode check

module main

splitInTwo : Int -> (Int, Int)
let splitInTwo n = (divInt n 2, subInt n (divInt n 2))

-- POSITIVE: tuple destructuring at the let binding.
sumHalves : Int -> Int
let sumHalves n =
    let (a, b) = splitInTwo n
    a + b

-- POSITIVE: nested tuple destructuring.
flatten : ((Int, Int), Int) -> Int
let flatten t =
    let ((a, b), c) = t
    a + (b + c)

-- POSITIVE: destructuring immediately behind a parameter binder
-- (parameters themselves use the lambda binder forms of §16.2, which do
-- not include tuple patterns).
addPair : (Int, Int) -> Int
let addPair p =
    let (x, y) = p
    x + y

-- POSITIVE: destructuring through a chain of lets.
chained : Int
let chained =
    let p = (10, 20)
    let (a, b) = p
    let q = (b, a)
    let (c, d) = q
    subInt c d

halves : Int
let halves = sumHalves 9

flat : Int
let flat = flatten ((1, 2), 3)

-- NEGATIVE: tuple width mismatch in the binding pattern — a three-tuple
-- pattern cannot check against the scrutinee type (Int, Int) (§9.1.2,
-- §17.2.1, §3.2.3).
badWidth : Int
let badWidth =
    let (a, b, c) = splitInTwo 8            --!! kappa.type.mismatch
    a + (b + c)

--! assertDiagnosticFamily error kappa.type.mismatch
--! assertEval halves 9
--! assertEval flat 6
--! assertEval chained 10

-- STATUS(a0497523): FAIL — the width-mismatched pattern `let (a, b, c) = (e : (Int, Int))` is accepted silently: no diagnostic at all is emitted for the extra component `c` (spec requires the pattern to check against the scrutinee type, §9.1.2/§17.2.1).
