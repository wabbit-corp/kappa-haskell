module main

-- §9.2: every exported top-level `let` definition MUST have an explicit
-- top-level signature: either a separate `name : T` declaration, or ALL
-- binders typed AND an explicit result type inline. Without
-- @PrivateByDefault everything here is exported (§8.5), so `untyped`
-- (no signature at all) and `partial` (untyped binder `y` despite the
-- result annotation) must both be rejected.

let untyped x = x + 1 --!! E_MISSING_EXPLICIT_SIGNATURE

let partial (x : Int) y : Int = x + y --!! E_MISSING_EXPLICIT_SIGNATURE

