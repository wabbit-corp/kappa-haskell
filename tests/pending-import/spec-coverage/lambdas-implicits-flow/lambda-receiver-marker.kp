-- §16.2 (receiver-marked binders): (this : T) binds the receiver locally
-- as `this`; (this x : T) marks the binder as receiver but names it x.
-- Method-call sugar (§7.4) consults the receiver MARKER, not the local
-- binder name — including when the function is defined by a lambda whose
-- binder carries the marker.
module main

data Pt : Type =
    MkPt (px : Int)

-- POSITIVE: declaration-form receiver binder, local name differs.
getPx : (this p : Pt) -> Int
let getPx (this p : Pt) : Int = p.px

-- POSITIVE: (this : T) form binds the receiver as `this`.
norm : (this : Pt) -> Int
let norm (this : Pt) : Int = this.px

-- POSITIVE per spec: a lambda-defined function whose signature and
-- binder carry the receiver marker is eligible for method-call sugar.
viaLambda : (this p : Pt) -> Int
let viaLambda = \ (this p : Pt) -> p.px

useDecl : Int
let useDecl = (MkPt 3).getPx

useThis : Int
let useThis = (MkPt 9).norm

useLambda : Int
let useLambda = (MkPt 4).viaLambda

--! mode check
--! assertNoErrors
--! assertEval useDecl 3
--! assertEval useThis 9
--! assertEval useLambda 4
