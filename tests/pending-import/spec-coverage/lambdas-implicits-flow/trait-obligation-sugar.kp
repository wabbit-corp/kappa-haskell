-- §16.3.1 (trait-obligation sugar): C => T expands to (@_ : C) -> T when
-- IsTrait C holds (pinned via assertType); multiple obligations associate
-- right; and the boolean special case b => T expands to
-- (@0 _ : b = True) -> T, discharged by refinement-context normalization
-- and reported unsolved otherwise.
module main

-- POSITIVE: the sugar elaborates to an implicit trait-evidence binder.
sugar : Eq Int => Bool
let sugar = 3 == 3

-- POSITIVE: right-associated multiple obligations, both resolvable.
ordAndEq : forall (a : Type). Eq a => Ord a => a -> Bool
let ordAndEq x = x == x

useOrdEq : Bool
let useOrdEq = ordAndEq 3

-- POSITIVE: boolean special case; (3 > 0) normalizes to True at the call.
requirePos : (n : Int) -> (n > 0) => Int
let requirePos n = n

usePos : Int
let usePos = requirePos 3

-- NEGATIVE: (m > 0) is not provable in the ambient refinement context.
badCall : (m : Int) -> Int
let badCall m = requirePos m --!! E_UNSOLVED_IMPLICIT

--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.implicit.unsolved
--! assertType sugar (@_ : Eq Int) -> Bool
