-- §16.3.4 × §17.1.1/§17.1.2: `e is C` requires only that C be a
-- constructor of the scrutinee's data type. Never : Choice False is a
-- constructor of Choice, so `c is Never` on c : Choice True is well-formed
-- even though the index makes it statically refutable; dynamically it
-- evaluates the scrutinee once and returns False. The success branch
-- (contradictory index evidence True = False) still typechecks an ordinary
-- body.
--! mode check
--! assertNoErrors
--! assertEval rNever 0
--! assertEval rAlso 0
module main

data Choice (flag : Bool) : Type =
    Always : (size : Int) -> Choice True
    Also : (size : Int) -> Choice True
    Never : Choice False

-- POSITIVE: statically refutable is-test is accepted and returns False.
neverTest : Choice True -> Int
let neverTest c =
    if c is Never then 1 else 0

rNever : Int
let rNever = neverTest (Always 3)

rAlso : Int
let rAlso = neverTest (Also 4)
