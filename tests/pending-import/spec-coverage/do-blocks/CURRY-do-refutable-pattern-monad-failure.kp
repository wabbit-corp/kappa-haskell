-- Source: Curry/KiCS2 testsuite/TypeclassTests/TestDoList.curry
--   (do (True,x) <- return (False,42); return x =-= []).
-- Spec: §18.2 (bind `let pat <- expr` requires an IRREFUTABLE pattern),
--       §18.2.1 (refutable local binding `let?`: on match failure the
--       do-path short-circuits via `empty`, requiring `Alternative m`
--       or an equivalent structure providing `empty`).
--
-- Pins: refutable monadic destructuring uses the dedicated `let?` form,
-- which short-circuits through `empty` on failure. The instances below
-- give Option the required short-circuiting structure. (§28.2's
-- Alternative declares `empty` directly; this implementation's prelude
-- names the Alternative member `emptyA` and resolves the desugared
-- `empty` through its Pointed trait — both are provided as scaffolding.)

module test

--! mode check

instance Pointed (Option a) =
    let empty = None

instance Alternative Option =
    let emptyA = None
    let (<|>) x y =
        match x
        case None -> y
        case Some v -> Some v

--! assertNoErrors

-- POSITIVE: an irrefutable bare-binder `let x <- ...` always succeeds.
sampleIrrefutable : Option Int
let sampleIrrefutable =
    do
        let x <- Some 42
        pureA x

intScore : Option Int -> Int
let intScore o =
    match o
    case None -> 0 - 1
    case Some n -> n

irrefutableScore : Int
let irrefutableScore = intScore sampleIrrefutable

--! assertType sampleIrrefutable (Option Int)
--! assertEval irrefutableScore 42

-- POSITIVE: `let?` accepts a refutable pattern; the literal `True` in
-- the tuple pattern matches, so the block continues.
sampleRefutableSucceeds : Option Int
let sampleRefutableSucceeds =
    do
        let? (True, x) = (True, 42)
        pureA x

succeedsScore : Int
let succeedsScore = intScore sampleRefutableSucceeds

--! assertType sampleRefutableSucceeds (Option Int)
--! assertEval succeedsScore 42

-- POSITIVE: `let?` failure path short-circuits via `empty`, producing
-- None for the Option monad.
sampleRefutableFails : Option Int
let sampleRefutableFails =
    do
        let? (True, x) = (False, 42)
        pureA x

failsScore : Int
let failsScore = intScore sampleRefutableFails

--! assertNoErrors
--! assertType sampleRefutableFails (Option Int)
--! assertEval failsScore -1

-- STATUS(a0497523): PASS
