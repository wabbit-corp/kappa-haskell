--! mode run
--! assertNoErrors
--! assertStdout "step 1\nstep 2\n3\nadd\n5\nstep 4\n8\n"

-- §18.3.1: each user-written `!` occurrence is evaluated exactly once, in
-- left-to-right order (two splices in one item → two effects, in order);
-- the immediate-application form `!f x y` takes the ENTIRE application
-- spine as the splice operand (here `addAct 2 3 : UIO Int` — `!addAct`
-- alone would not denote a computation); and a splice nested as a pure
-- function's argument (`double !(step 4)`) still runs exactly once.
module main

step : Int -> UIO Int
let step n = do
    printlnString (stringAppend "step " (showInt n))
    ioPure n

addAct : Int -> Int -> UIO Int
let addAct a b = do
    printlnString "add"
    ioPure (a + b)

double : Int -> Int
let double n = n + n

main : UIO Unit
let main = do
    let a = !(step 1) + !(step 2)
    printlnString (showInt a)
    let z = !addAct 2 3
    printlnString (showInt z)
    let y = double !(step 4)
    printlnString (showInt y)
