--! mode run
--! assertNoErrors
--! assertStdout "1\n2\n3\n4\n5\n"

-- Section 5.4: "Blank lines and comment-only lines do not affect
-- indentation and do not produce INDENT/DEDENT changes." Inside a do
-- statement block this must hold for every trivia-line shape between
-- statements: a fully empty line; a whitespace-only line with FEWER
-- spaces than the block indentation; a whitespace-only line with MORE
-- spaces; a line comment at column 1; and an indented block-comment
-- line. None of these may dedent, terminate, or split the block.
-- (Existing coverage exercises continuation regions and top-level
-- declarations; this pins statement blocks.)

module main

main : UIO Unit
let main = do
    printInt 1

    printInt 2
  
    printInt 3
-- comment at column one inside the do block
    printInt 4
        
      {- indented block comment between statements -}
    printInt 5
-- STATUS(a0497523): PASS — empty, whitespace-only (shallower and deeper), column-1-comment, and indented-block-comment lines all leave the do block intact
