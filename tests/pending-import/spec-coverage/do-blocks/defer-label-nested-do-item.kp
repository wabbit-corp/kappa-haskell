-- §18.7 x §18.2.5: "A do-scope is introduced by: an explicit do block" —
-- including a labeled do block in do-ITEM (statement) position. `defer@L`
-- resolves to the nearest enclosing labeled do-scope, so scheduling onto
-- the statement-position L@do must work exactly like the accepted
-- function-body form (conformance/labels/defer-label-self.kp) and the
-- first-class do-value form (`let block = L@do ...`), both of which the
-- compiler already accepts.
module main

main : UIO Unit
let main = do
    L@do
        defer@L printlnString "defer-ran"
        printlnString "body"
    printlnString "after"

--! mode run
--! assertNoErrors
--! assertStdout "body\ndefer-ran\nafter\n"
-- STATUS(a0497523): FAIL — defer@L on a labeled STATEMENT-position do block is rejected with E_LABEL_UNRESOLVED ("defer@L does not target an enclosing labeled do-scope"), though the identical function-body (defer-label-self.kp) and first-class do-value forms are accepted.
