-- §18.2.5: "If multiple labeled constructs with the same label occur at
-- the same lexical nesting level, it is a compile-time error. (Shadowing
-- by nested labels is permitted.)" Two sibling loops sharing label L and
-- two sibling lambdas sharing label M are exactly that case, so this file
-- must produce two errors (one per duplicated label).
module main

main : UIO Unit
let main = do
    L@for i in (1 :: Nil) do
        printlnString "one"
    L@for j in (2 :: Nil) do
        break@L
    let f = M@\ (n : Int) -> n + 1
    let g = M@\ (n : Int) -> n + 2
    printlnString (showInt (f 1 + g 1))

--! mode check
--! assertErrorCount 2
-- STATUS(e25d64e1): FAIL — expected 2 errors, got 4; finalized Core reports E_PARAMETRIC_TYPE_PROMOTION
