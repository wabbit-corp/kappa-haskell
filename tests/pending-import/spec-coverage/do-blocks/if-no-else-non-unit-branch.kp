-- §18.4: `if` without `else` in do desugars with an implicit `else pure ()`
-- and `if` remains an expression, so a then-suite whose nested-do result is
-- `m Int` cannot unify with the implicit `m Unit` else branch and must be
-- rejected. (The result must be made explicit — e.g. with Option — to
-- survive the branch.)
module main

bad : UIO Unit
let bad = do
    if True then
        ioPure 42 --!! kappa.type.mismatch
    pure ()

--! mode check
--! assertErrorCount 1
-- STATUS(a0497523): FAIL — compiler accepts (0 errors): the then-suite of an
-- if-without-else may have non-Unit result type; the implicit `else pure ()`
-- unification of §18.4 is not enforced (the branch value is silently dropped).
