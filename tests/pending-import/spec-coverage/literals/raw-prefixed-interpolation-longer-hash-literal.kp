--! mode run
--! assertNoErrors
--! assertStdout "x ##{n} y\n"

-- §6.3.4.1: in a raw prefixed string with hash count n, a #-sequence
-- begins interpolation ONLY when it is exactly n '#' characters
-- immediately followed by '{'; any LONGER #-sequence is ordinary
-- literal text. So `##{n}` inside a 1-hash literal stays fully
-- literal — it must not be read as '#' + interpolation of n.

n : Integer
let n = 7

main : UIO Unit
let main = do
    printlnString f#"x ##{n} y"#
-- STATUS(74742dfd): FAIL — stdout mismatch: expected "x ##{n} y\n", got "x #7 y\n"
