-- Spec 6.1.1 (token boundary) sibling: when the FIRST digit after the radix
-- prefix is invalid for the base, the malformed-literal diagnostic already
-- fires today; this pins the good half so the trailing-digit fix cannot
-- regress it.
--! mode check
--! assertErrorCount 2
--! assertDiagnostic error E_NUMERIC_LITERAL_MALFORMED

badBin : Integer
let badBin = 0b2

badOct : Integer
let badOct = 0o8
-- STATUS(a0497523): FAIL — only 0b2 reports E_NUMERIC_LITERAL_MALFORMED; 0o8 produces NO diagnostic at all (expected 2 errors)
