--! mode run
--! assertNoErrors
--! assertStdout "True\nTrue\nTrue\nTrue\nTrue\nTrue\nTrue\nTrue\n"

-- SPEC COVERAGE (robust literals): Double literals at the binary64
-- representation boundaries. Spec 6.1.3: `Double` IS IEEE-754 binary64
-- and default Eq is raw-bit equality, so each check below is a
-- bit-level statement about which binary64 value a literal denotes.
-- The rounding rule is now stated outright by 6.1.3: "A syntactically
-- well-formed floating-point literal denotes the IEEE-754 binary64
-- value obtained by correct rounding (round-to-nearest, ties-to-even)
-- of its mathematical value" — so every expectation below is directly
-- normative, no longer an assumed reading. No
-- W_FLOAT_LITERAL_EXTREME_ROUNDING is expected here: every literal in
-- this file rounds to a finite nonzero value (6.1.3 flags only
-- overflow-to-infinity and total underflow-to-zero, and explicitly not
-- the representable extremes), and `maxFinite + maxFinite` overflows by
-- computation, not by a literal — which makes this the clean sibling of
-- float-literal-representable-extremes-no-warning.
--
--   maxFinite    = greatest finite binary64 (1.7976931348623157e308)
--   minNormal    = least positive normal    (2.2250738585072014e-308)
--   minSubnormal = least positive subnormal (5e-324, bit pattern 0x1)
--
-- 4.9e-324 is within half an ulp of minSubnormal so it MUST round to
-- the same bits; 2^53+1 is exactly between 2^53 and 2^53+2 so nearest-
-- even sends the literal 9007199254740993.0 to 2^53; 0.1 + 0.2
-- famously differs from the literal 0.3 by one ulp.

maxFinite : Double
let maxFinite = 1.7976931348623157e308

minNormal : Double
let minNormal = 2.2250738585072014e-308

minSubnormal : Double
let minSubnormal = 5e-324

main : UIO Unit
let main = do
    println (minSubnormal > 0.0)
    println (4.9e-324 == minSubnormal)
    println (minNormal > minSubnormal)
    println (maxFinite == 1.7976931348623157E+308)
    println (maxFinite < maxFinite + maxFinite)
    println (9007199254740993.0 == 9007199254740992.0)
    println (not (0.1 + 0.2 == 0.3))
    println (0.1 + 0.2 == 0.30000000000000004)
-- STATUS(a0497523): PASS
