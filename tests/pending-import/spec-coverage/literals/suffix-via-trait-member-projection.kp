--! mode check
--! assertNoErrors
--! assertEval got 12
--! assertEval gotBare 5

-- §6.1.6 (L5796-5797): "If the user prefers typeclass-mediated
-- construction, they may define a term such as
-- `px = FromInteger.fromInteger @Length`; then `12px` works by
-- ordinary name resolution." This pins the spec's own recipe with a
-- user FromInteger type. The bare-member spelling (`fromInteger
-- @Meters`, control `m` below) is accepted today; the trait-qualified
-- projection the spec example uses is rejected with E_UNRESOLVED_MEMBER
-- ("'fromInteger' has no receiver-marked binder, so it is not eligible
-- for method-call sugar (§7.4)").
--
-- The Trait.member spelling is no longer merely a §6.1.6 example idiom.
-- §14.2 now declares `eqSound`/`eqComplete` as REQUIRED Eq members ("An
-- Eq instance participates in equality reflection only because eqSound
-- and eqComplete are required members"), §16.3.3's equality-reflection
-- step elaborates through the spelling `Eq.eqSound`, and §28.2 mandates
-- `derive Eq Nat` — so if Trait.member projection does not resolve, the
-- prelude's own required Eq members are unreachable at their specified
-- spelling (probe `sound` below), not just the §6.1.6 example.
module main

data Meters : Type =
    MkMeters Int

instance FromInteger Meters =
    let fromInteger n = MkMeters (natToInt n)

unwrap : Meters -> Int
let unwrap x =
    match x
    case MkMeters n -> n

-- the spec's exact idiom: trait-qualified member + type application
px : Nat -> Meters
let px = FromInteger.fromInteger @Meters

got : Int
let got = unwrap 12px

-- control: bare overloaded member reference works today
m : Nat -> Meters
let m = fromInteger @Meters

gotBare : Int
let gotBare = unwrap 5m

-- the same spelling at the prelude's own mandatory API: Eq.eqSound at
-- the derived Eq Nat (§14.2 member type instantiated at a = Nat)
sound :
    (& x : Nat) ->
    (& y : Nat) ->
    ((x == y) = True) ->
    x = y

let sound = Eq.eqSound @Nat
