-- Spec 6.1.3 (out-of-range literals): a literal at Double denotes the
-- correctly rounded binary64 value, and extreme rounding MUST warn
-- (W_FLOAT_LITERAL_EXTREME_ROUNDING, 3.1.4) once per literal: overflow to
-- an infinity (1e309) and total underflow of a nonzero value to 0.0
-- (1e-324). The program still compiles and runs with the IEEE values.
--! mode run
--! assertNoErrors
--! assertWarningCount 2
--! assertStdout "True\nTrue\n"

huge : Double
let huge = 1e309

tiny : Double
let tiny = 1e-324

main : UIO Unit
let main = do
    println (huge == huge + huge)
    println (tiny == 0.0)
-- STATUS(a0497523): FAIL — no diagnostic: 1e309 silently denotes Infinity, 1e-324 silently denotes 0.0; Spec 6.1.3 now mandates W_FLOAT_LITERAL_EXTREME_ROUNDING (expected 2 warnings)
