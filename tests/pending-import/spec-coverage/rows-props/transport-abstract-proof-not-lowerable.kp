--! mode compile
--! assertErrorCount 1
--! assertDiagnosticExplainExists E_PROOF_RELEVANT_TRANSPORT_NOT_LOWERABLE

-- §11.4.1 proof-relevant transport (negative): here the proof p is
-- runtime-relevant (default ω), the result VecB m is runtime-relevant,
-- the proof is not definitionally refl, no cubical extension is active
-- and no trusted intrinsic specifies the transport, so selecting this
-- transport for runtime lowering must fail before KBackendIR with
-- portable alias E_PROOF_RELEVANT_TRANSPORT_NOT_LOWERABLE (family
-- kappa.equality.transport-not-lowerable), which must be registered
-- (§3.1.2A). An implementation "MUST NOT silently erase a
-- proof-relevant equality proof merely because all visible constructors
-- of equality are spelled refl". The carrier is an abstract Nat index,
-- so no IsProp/RuntimeErased evidence licenses erased transport.
module main

data VecB (n : Nat) : Type =
    MkVecB

castAbs : forall (@0 n : Nat) (@0 m : Nat). (p : n = m) -> VecB n -> VecB m
let castAbs (@0 n : Nat) (@0 m : Nat) (p : n = m) (v : VecB n) : VecB m =
    subst @Nat @VecB @n @m p v

-- STATUS(a51e1bf): FAIL — mode compile accepts the abstract-proof runtime transport with 0 errors (proof silently erased) and E_PROOF_RELEVANT_TRANSPORT_NOT_LOWERABLE is not registered
