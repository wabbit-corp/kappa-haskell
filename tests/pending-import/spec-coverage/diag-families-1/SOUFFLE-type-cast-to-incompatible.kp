-- Source issues: souffle-lang/souffle tests/semantic/type_as2/type_as2.dl,
--   tests/semantic/type_as3/type_as3.dl,
--   souffle-lang #657 (type cast using the AS keyword),
--   souffle-lang #1640 (type conversion with "as" fails).
-- Spec: §3.2.4 type-equality diagnostics (family kappa.type.mismatch);
--   §13.1.3 expected-type-directed union injection (the only implicit
--   "widening" Kappa defines); §10.3 (Float = Double is a transparent alias,
--   so Float-vs-String is a real mismatch, not an alias artifact).
-- Kappa has no cast operator: Souffle's bad `as(x, T)` casts correspond to
-- using a value at an incompatible type directly. Pins that no implicit
-- conversion exists between distinct base or nominal types, while
-- same-type use and union widening remain accepted.

--! mode check

module main

-- POSITIVE: same-type use is the identity.
sameType : Int -> Int
let sameType x = x

-- POSITIVE: widening into a union that contains the member type (§13.1.3).
type NumOrStr = (| Int | String |)

widen : Int -> NumOrStr
let widen n = (| n : Int |)

-- NEGATIVE: no implicit String -> Int conversion.
badNarrow : String -> Int
let badNarrow s = s    --!! kappa.type.mismatch

-- NEGATIVE: no implicit Float -> String conversion.
floatToStr : Float -> String
let floatToStr f = f    --!! kappa.type.mismatch

-- NEGATIVE: no structural conversion between unrelated data types.
data PointA : Type =
    MkPointA (x : Int)
data PointB : Type =
    MkPointB (y : Int)

castPoint : PointA -> PointB
let castPoint p = p    --!! kappa.type.mismatch

--! assertDiagnosticFamily error kappa.type.mismatch
--! assertErrorCount 3

-- STATUS(a0497523): PASS
