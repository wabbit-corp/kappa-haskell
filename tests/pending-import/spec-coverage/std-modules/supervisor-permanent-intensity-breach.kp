--! mode run
--! assertNoErrors
--! assertStdout "exit:fail:7\nruns:3\n"

-- §29.2 std.supervisor: Permanent children are restarted after any terminal
-- exit other than supervisor-requested shutdown; a nonpositive RestartIntensity
-- window puts every restart attempt in one window, so a permanently failing
-- child runs exactly 1 + maxRestarts times before the breach terminates the
-- supervisor, and the triggering child Failure (Fail e) propagates as Fail e.
module main

import std.prelude.(type Cause(..), type Exit(..))
import std.supervisor.*
import std.atomic.*

weakenVoidIO : forall (e : Type) (a : Type). UIO a -> IO e a
let weakenVoidIO act = catchIO act (\v -> ioPure (absurd v))

child : AtomicRef Integer -> IO Int Unit
let child counter = do
    let _ <- weakenVoidIO (atomicFetchAdd RmwOrder.RmwSeqCst counter 1)
    throwIO 7

main : UIO Unit
let main = do
    let counter <- newAtomicRef 0
    let children = childSpec "boom" RestartPolicy.Permanent (child counter) :: Nil
    let sup <- startSupervisor SupervisorStrategy.OneForOne (RestartIntensity 2 (millis 0)) children
    let exit <- awaitSupervisor sup
    match exit
      case Exit.Failure c ->
        match c
          case Cause.Fail e -> printlnString ("exit:fail:" ++ showInt e)
          case _ -> printlnString "exit:other-cause"
      case Exit.Success _ -> printlnString "exit:success"
    let runs <- atomicLoad LoadOrder.LoadSeqCst counter
    printlnString ("runs:" ++ showInt runs)
-- STATUS(e25d64e1): FAIL — stdout mismatch: expected "exit:fail:7\nruns:3\n", got "exit:success\nruns:0\n"
