--! mode run
--! allow_debug_introspection
--! assertNoErrors
--! assertStdout "secret:opaque\nplain:node\n"

-- §29.6 std.debug: when elaboration at the call site cannot inspect a value's
-- representation because of opacity (dlib.Secret is `opaque data`), inspect
-- MUST return OpaqueValue Opaque — specifically the Opaque reason. For a
-- locally declared transparent data value, implementations SHOULD expose the
-- constructor as a Node.
module main

import std.debug.*
import dlib.(type Secret, term mkSecret)

data Pair : Type = Pair (a : Int) (b : Int)

describe : DebugTree -> String
let describe t =
    match t
    case OpaqueValue Opaque -> "opaque"
    case OpaqueValue _ -> "opaque-wrong-reason"
    case Node tag fields -> "node"
    case Scalar s -> "scalar"

main : UIO Unit
let main = do
    printlnString ("secret:" ++ describe (inspect (mkSecret 5)))
    printlnString ("plain:" ++ describe (inspect (Pair 1 2)))
-- STATUS(74742dfd): FAIL — stdout mismatch: expected "secret:opaque\nplain:node\n", got "secret:node\nplain:node\n"
