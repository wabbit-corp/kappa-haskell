--! mode run
--! assertNoErrors
--! assertStdout "a:1\nb:2\nc:2\nd:2\nexit:success\n"

-- §29.2 RestForOne: when child b (2nd of 4) fails, b and every child AFTER it
-- in original list order (c, d) are interrupted, waited for, and restarted in
-- original order; children BEFORE it (a) are left running. So a's atomic run
-- counter stays 1 while b, c, d reach 2. The failing child gates on the
-- first-run markers of a, c, and d, making the failure point deterministic.
module main

import std.prelude.(type Cause(..), type Exit(..))
import std.supervisor.*
import std.atomic.*

weakenVoidIO : forall (e : Type) (a : Type). UIO a -> IO e a
let weakenVoidIO act = catchIO act (\v -> ioPure (absurd v))

markThenBlock : Promise Int Unit -> Promise Int Unit -> IO Int Unit
let markThenBlock mark never = do
    let _ <- weakenVoidIO (completePromise mark (Success ()))
    awaitPromise never

gateThenFail : Promise Int Unit -> Promise Int Unit -> Promise Int Unit -> IO Int Unit
let gateThenFail g1 g2 g3 = do
    let _ <- weakenVoidIO (awaitPromiseExit g1)
    let _ <- weakenVoidIO (awaitPromiseExit g2)
    let _ <- weakenVoidIO (awaitPromiseExit g3)
    throwIO 3

-- Steady child: complete `first` on run 1 and block; complete `done` on run 2.
steady : AtomicRef Integer -> Promise Int Unit -> Promise Int Unit -> Promise Int Unit -> IO Int Unit
let steady counter first done never = do
    let old <- weakenVoidIO (atomicFetchAdd RmwSeqCst counter 1)
    if old == 0 then markThenBlock first never else markThenBlock done never

failer : AtomicRef Integer -> Promise Int Unit -> Promise Int Unit -> Promise Int Unit -> Promise Int Unit -> Promise Int Unit -> IO Int Unit
let failer counter g1 g2 g3 done never = do
    let old <- weakenVoidIO (atomicFetchAdd RmwSeqCst counter 1)
    if old == 0 then gateThenFail g1 g2 g3 else markThenBlock done never

main : UIO Unit
let main = do
    let ca <- newAtomicRef 0
    let cb <- newAtomicRef 0
    let cc <- newAtomicRef 0
    let cd <- newAtomicRef 0
    let firstA <- newPromise
    let firstC <- newPromise
    let firstD <- newPromise
    let db <- newPromise
    let dc <- newPromise
    let dd <- newPromise
    let unusedA <- newPromise
    let never <- newPromise
    let children = childSpec "a" Permanent (steady ca firstA unusedA never) :: childSpec "b" Permanent (failer cb firstA firstC firstD db never) :: childSpec "c" Permanent (steady cc firstC dc never) :: childSpec "d" Permanent (steady cd firstD dd never) :: Nil
    let sup <- startSupervisor RestForOne (RestartIntensity 10 (seconds 1)) children
    let _ <- awaitPromiseExit db
    let _ <- awaitPromiseExit dc
    let _ <- awaitPromiseExit dd
    let a <- atomicLoad LoadSeqCst ca
    printlnString ("a:" ++ showInt a)
    let b <- atomicLoad LoadSeqCst cb
    printlnString ("b:" ++ showInt b)
    let c <- atomicLoad LoadSeqCst cc
    printlnString ("c:" ++ showInt c)
    let d <- atomicLoad LoadSeqCst cd
    printlnString ("d:" ++ showInt d)
    shutdownSupervisor sup
    let exit <- awaitSupervisor sup
    match exit
      case Success _ -> printlnString "exit:success"
      case Failure _ -> printlnString "exit:failure"
-- STATUS(a0497523): FAIL — std.supervisor is a typecheck-only stub: startSupervisor never starts child fibers, so the done-promises never complete and the run produces no output (expected RestForOne counters a:1/b:2/c:2/d:2)
