-- §14.5 (opacity clause) + §14.5.1: the Eq instance derived inside lib
-- for the opaque data type is usable outside only through the trait
-- interface ("the resulting exported instances expose only their
-- declared trait interfaces"); it grants no constructor access,
-- pattern-matching access, or definitional transparency for Secret
-- outside its defining module. §10.2.1's visibility clause backs the
-- negative half independently: outside an `opaque data` declaration's
-- defining scope, hidden-constructor no-confusion metadata is not
-- available for new source proofs.
--! mode check
--! assertErrorCount 2
module main

import lib.(Secret, mkSecret)

-- POSITIVE: the exported derived instance works through the interface.
sameSecret : Bool
let sameSecret = mkSecret 1 == mkSecret 1

-- POSITIVE: the exported instance also exposes IsSet Secret by ordinary
-- supertrait projection (§14.5.1) without revealing the constructor.
secretIsSet : IsSet Secret
let secretIsSet = summon (IsSet Secret)

-- NEGATIVE: the derived instance does not leak the constructor. Both
-- errors are direct consequences of opacity: the constructor name is not
-- in scope, so its pattern binder 'n' never binds either.
peek : Secret -> Int
let peek s =
    match s
    case MkSecret n -> n --!! kappa.name.unresolved
    case _ -> 0
