-- Source: Curry/KiCS2 testsuite/LanguageTests/TestNewtype.curry
--   (newtype LIST a = LIST [a] deriving (Eq, Read, Show); testReadShowNT).
-- Spec: §14.5 (deriving: `derive Eq T` accepted when eqSound/eqComplete
--       are synthesizable), §10.1 (single-constructor wrapper data).
-- NOTE: overlaps with tests/pending-import/spec-coverage/proofs-deriving-totality/CURRY-deriving-show-read-roundtrip.kp
--       (derive Eq on ground ADTs); this file pins the wrapper shape.
--
-- Pins: standalone `derive Eq` on a first-order single-constructor
-- wrapper (a Curry newtype) and on its payload type. Both targets are
-- first-order, so §14.5's proof-synthesis obligation is satisfiable and
-- the derivations MUST be accepted; derived equality then compares
-- payloads structurally. (Curry's Read/Show round-trip is dropped: the
-- spec defines no Read counterpart.)

module test

--! mode check

data IntChain : Type =
    ChainNil
    ChainCons (head : Int) (tail : IntChain)

derive Eq IntChain

-- A transparent wrapper around IntChain.
data ChainW : Type =
    MkChainW (payload : IntChain)

derive Eq ChainW

--! assertNoErrors

-- POSITIVE: derived equality on the wrapper compares payloads.
twoCopies : ChainW
let twoCopies = MkChainW (ChainCons 1 (ChainCons 2 ChainNil))

eqWrapped : Bool
let eqWrapped = twoCopies == MkChainW (ChainCons 1 (ChainCons 2 ChainNil))

--! assertType eqWrapped Bool
--! assertEval eqWrapped True

-- POSITIVE: different payloads are unequal.
oneCopy : ChainW
let oneCopy = MkChainW (ChainCons 1 ChainNil)

distinct : Bool
let distinct = oneCopy /= twoCopies

--! assertNoErrors
--! assertEval distinct True

-- STATUS(a0497523): FAIL — derive declarations are wholly unsupported (E_UNSUPPORTED on both derives); the wrapper and payload Eq evidence never exists, so both witnesses are stuck. §14.5 requires these first-order derivations to be accepted.
