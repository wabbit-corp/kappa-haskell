-- §14.5.1 (derived Eq/IsSet) × §14.5.3 (derived Hashable): derived Eq
-- must ship checkable eqSound/eqComplete plus the IsSet supertrait, and
-- §10.2.1 injectivity compares EVERY constructor argument, erased or
-- not — so an erased bare-data field (say `@0 audit : Int`) admits no
-- derived Eq: a (==) that ignored it could not have a checkable eqSound
-- (MkCred @1 42 = MkCred @2 42 would entail 1 = 2). The one exemption is
-- §14.5.1's conservative structural fragment: an erased PROOF field with
-- IsProp evidence for its exact field type. This test uses that carrier:
-- derived Eq lawfully ignores the proof field, and derived Hashable is
-- structurally aligned with it (§14.5.3) — erased proof fields do not
-- contribute to the runtime hash, and record fields hash in canonical
-- order, so record-literal field order cannot affect the hash.
--! mode run
--! assertStdout "True\nTrue\nTrue\n"
module main

import std.hash.*

data Cred : Type =
    MkCred
        (user : Int)
        (@0 audit : (0 <= user) = True)

derive Eq Cred
derive Hashable Cred

type Pt = (x : Int, y : Int)

-- Hashable refines Eq (§14.1.3), so the record needs both derivations.
derive Eq Pt
derive Hashable Pt

hEq : forall (a : Type). (@_ : Hashable a) -> a -> a -> Bool
let hEq l r = hashWith defaultHashSeed l == hashWith defaultHashSeed r

-- Two separately constructed audit proofs: one synthesized by boolean
-- proposition normalization (§16.3.3 step 3), one supplied explicitly.
-- IsProp of the boolean-equality fiber makes them interchangeable, so
-- derived Eq and the derived hash must both ignore the erased field.
credA : Cred
let credA = MkCred 42

credB : Cred
let credB = MkCred 42 @refl

main : UIO Unit
let main = do
    println (hEq credA credB)
    println (credA == credB)
    -- record-literal source order is canonicalized before hashing (§14.5.3)
    println (hEq ((x = 1, y = 2) : Pt) ((y = 2, x = 1) : Pt))
