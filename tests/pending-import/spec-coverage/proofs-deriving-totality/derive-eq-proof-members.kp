-- §14.5 (Spec L15000-L15006): `derive Eq T` is permitted only if the
-- compiler can synthesize BOTH `eqSound` and `eqComplete` for T; if either
-- proof cannot be synthesized, deriving Eq fails. A function-typed field
-- has no decidable structural equality, so its derivation must be rejected
-- while the first-order enumeration must be accepted.
--! mode check
--! assertErrorCount 1
module main

data Color : Type =
    Red
    Green
    Blue

-- POSITIVE: first-order enumeration — (==), eqSound, and eqComplete are
-- all synthesizable, so the derivation is accepted.
derive Eq Color

sameRed : Bool
let sameRed = Red == Red

data Blob : Type =
    MkBlob (fn : Int -> Int) (tag : Int)

-- NEGATIVE: eqSound/eqComplete cannot be synthesized for the function
-- field 'fn', so this derivation MUST fail (one error; the spec names no
-- diagnostic family for a failed derivation).
derive Eq Blob

-- STATUS(a0497523): FAIL — derive declarations are wholly unsupported
-- (E_UNSUPPORTED on BOTH derives, plus a cascading unsolved (==) at
-- sameRed); no eqSound/eqComplete synthesis path exists yet.
