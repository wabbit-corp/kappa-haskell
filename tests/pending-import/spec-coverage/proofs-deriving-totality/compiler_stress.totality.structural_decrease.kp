-- Stress test: structural decrease on a recursive data type is accepted
-- Spec: §15.3 and §15.11 (explicit structural descent on constructor
--       subterms).

--! mode check

-- Nat2 is a deliberately user-local Peano type: §28.2 now ships the
-- canonical inductive `Nat` (Zero/Succ), so a local `data Nat` would
-- shadow a spec-canonical type of the same shape. Per §15.8.1, the user
-- `add` below is also NOT recognized as prelude Nat addition even though
-- it has natAdd's exact shape — recognition is by resolved semantic
-- identity, never source spelling or syntactic resemblance.
data Nat2 : Type =
    Z
    | S Nat2

-- POSITIVE: add decreases structurally on n; each recursive call passes n', a sub-term of S n'.
add : Nat2 -> Nat2 -> Nat2
let add n m decreases structural n =
    match n
    case Z    -> m
    case S smaller -> S (add smaller m)

-- POSITIVE: length decreases structurally on xs.
data List a : Type =
    Nil
    | Cons a (List a)

len : List a -> Nat2
let len xs decreases structural xs =
    match xs
    case Nil       -> Z
    case Cons _ tl -> S (len tl)

--! assertNoErrors

-- Finalized Core reports E_PARAMETRIC_TYPE_PROMOTION while materializing the
-- polymorphic List constructor.
-- STATUS(a0497523): FAIL
