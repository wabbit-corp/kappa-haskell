-- Source: Curry/KiCS2 testsuite/TypeclassTests/TestDeriving.curry
--   (showOfRead x = read (show x) -=- x; showOfReadNat / TreeColor / ...).
-- Spec: §14.5 + §14.5.1 (compiler-owned `derive IsSet T` / `derive Eq T`;
--       `derive Eq T` is permitted only if eqSound, eqComplete, AND the
--       IsSet T supertrait can be synthesized), §14.5.2 (derived
--       exact-natural representation), §10.1 (`data` declarations).
-- NOTE: overlaps with tests/pending-import/spec-coverage/nat-fin-refinement/positive/derive-eq-enumeration
--       (ground derive Eq acceptance); this file adds recursive and
--       multi-field derive targets with evaluated equality witnesses.
--
-- The Curry `read . show = id` round-trip has no portable counterpart:
-- Kappa's spec defines no Read trait, and §14.5.1/§14.5.3 standardize
-- only the IsSet/Eq (and std.hash Hashable) derivations. Reduced here to
-- derived-Eq structural-equality witnesses over an enum, a recursive
-- ADT, and a multi-field constructor — all first-order, inside §14.5.1's
-- required conservative structural fragment, so every derivation below
-- MUST be accepted.

module test

--! mode check

data Color : Type =
    Red
    Blue

-- §14.5.1: `derive IsSet` and `derive Eq` in the same coherent scope
-- share one canonical generated IsSet Color evidence object; no
-- duplicate competing instances are published.
derive IsSet Color
derive Eq Color

data NatLike : Type =
    NLZero
    NLSucc NatLike

derive Eq NatLike

-- §14.5.2: NatLike has exactly one nullary constructor and one unary
-- constructor whose sole retained field is one strict recursive
-- occurrence of NatLike, so `derive ExactNaturalRepresentation` MUST be
-- accepted (constructor names, spelling, and declaration order do not
-- determine eligibility).
derive ExactNaturalRepresentation NatLike

data ColorPair : Type =
    ColorPair (fst : Color) (snd : NatLike)

derive Eq ColorPair

-- §14.5.1: the derived Eq ColorPair exposes IsSet ColorPair by ordinary
-- supertrait projection (no direct IsSet ColorPair derivation exists).
pairIsSet : IsSet ColorPair
let pairIsSet = summon (IsSet ColorPair)

--! assertNoErrors

-- POSITIVE: derived Eq witnesses structural equality for the enum.
colorsEqual : Bool
let colorsEqual = Red == Red

colorsDiffer : Bool
let colorsDiffer = Red == Blue

--! assertType colorsEqual Bool
--! assertEval colorsEqual True
--! assertEval colorsDiffer False

-- POSITIVE: derived Eq witnesses structural equality for a recursive
-- ADT (equal and unequal depths).
threeNat : NatLike
let threeNat = NLSucc (NLSucc (NLSucc NLZero))

natsEqual : Bool
let natsEqual = threeNat == NLSucc (NLSucc (NLSucc NLZero))

natsDiffer : Bool
let natsDiffer = threeNat == NLSucc NLZero

--! assertType natsEqual Bool
--! assertEval natsEqual True
--! assertEval natsDiffer False

-- POSITIVE: derived Eq on a multi-field constructor compares fieldwise.
pairsEqual : Bool
let pairsEqual = ColorPair Red threeNat == ColorPair Red (NLSucc (NLSucc (NLSucc NLZero)))

pairsDiffer : Bool
let pairsDiffer = ColorPair Red threeNat == ColorPair Blue threeNat

--! assertNoErrors
--! assertEval pairsEqual True
--! assertEval pairsDiffer False
