-- §15.8 (shared proof-producing arithmetic and index solver) + §15.8.4
-- (minimum required termination obligations): the required portable
-- service MUST decide "lexicographic comparison of accepted measure
-- tuples" and "non-negative affine combinations of accepted
-- inequalities", and its required piecewise-linear domain covers
-- max/min/clamp/abs and transparent `if` expressions over the admitted
-- fragment — so the hand-rolled max0 below (a transparent `if` whose
-- condition is in the required fragment) is inside the required measure
-- language. All three SCCs below are therefore MUST-accept, and a Solved
-- result counts only after the produced proof term typechecks or the
-- produced certificate passes its independent §15.8.7 checker.
--! mode check
--! assertNoErrors
--! assertNoWarnings
module main

-- MUST accept: 3-component lexicographic tuple, last component strictly
-- decreasing, earlier components definitionally equal.
lex3 : Int -> Int -> Int -> Int
let lex3 a b c decreases (a, b, c) =
    if leInt c 0 then 0
    else lex3 a b (subInt c 1)

-- MUST accept: a strict decrease in the first component permits resetting
-- the later component upward.
lexReset : Int -> Int -> Int
let lexReset a b decreases (a, b) =
    if leInt a 0 then 0
    else if leInt b 0 then lexReset (subInt a 1) 7
    else lexReset a (subInt b 1)

max0 : Int -> Int
let max0 x = if ltInt x 0 then 0 else x

-- MUST accept: the affine combination max0 a + 2*max0 b of non-negative
-- components; each edge decreases one max0 component under its guard
-- ("max 0 (n - 1) < max 0 n under 0 < n" scaled and summed, §15.8.4).
affine : Int -> Int -> Int
let affine a b decreases addInt (max0 a) (mulInt 2 (max0 b)) =
    if leInt a 0 then
        if leInt b 0 then 0 else affine a (subInt b 1)
    else affine (subInt a 1) b

