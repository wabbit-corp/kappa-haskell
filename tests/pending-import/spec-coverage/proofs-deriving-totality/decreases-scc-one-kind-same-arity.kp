-- §15.11 (Spec L15469-L15475): within one recursive SCC all explicit
-- decreases clauses MUST be of one kind, with matching tuple arities.
-- A 1-tuple/2-tuple measure mix and a measure/structural kind mix are both
-- ill-formed and must be rejected (family kappa.termination.failure), even
-- though each SCC below is in fact terminating.
--! mode check
--! assertErrorCount 2
--! assertDiagnosticFamily error kappa.termination.failure
module main

fA : Int -> Int -> Int
gA : Int -> Int -> Int

-- NEGATIVE: 1-tuple vs 2-tuple visible measures in one SCC.
let fA a b decreases a = --!! kappa.termination.failure
    if leInt a 0 then 0 else gA (subInt a 1) b

let gA m k decreases (m, k) =
    if leInt m 0 then 0 else fA (subInt m 1) k

fB : Int -> Int
gB : List Int -> Int

-- NEGATIVE: measure-kind vs structural-kind clauses in one SCC.
let fB a decreases a = --!! kappa.termination.failure
    if leInt a 0 then 0 else gB Nil

let gB xs decreases structural xs =
    match xs
    case Nil -> fB 0
    case _ :: rest -> gB rest

