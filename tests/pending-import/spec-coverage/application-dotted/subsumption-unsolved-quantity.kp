-- q stays underconstrained.
module main

hof : (@0 q : Quantity) -> ((q x : Int) -> Int) -> Int
let hof (@0 q : Quantity) (f : (q x : Int) -> Int) : Int = 0

-- NEGATIVE: q is unsolved; must not default to any quantity.
ambiguous : Int
let ambiguous = hof (\x -> 0)

