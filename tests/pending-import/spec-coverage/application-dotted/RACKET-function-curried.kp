-- Source: Racket guide define.scrbl (curried function shorthand)
-- Source docs: racket guide define.scrbl (corpus repos/github-racket-racket/docs/pkgs/racket-doc/scribblings/guide/define.scrbl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §16.1 (application is left-associative/curried), §16.2 (lambdas, multiple parameters are curried), §9.1 (named let definitions), §3.1 (E_APPLICATION_NON_CALLABLE portable alias)
--
-- Pins: Kappa functions are curried — `f x y` is `(f x) y`; partial application
-- yields a function value usable directly or via lambda sections; applying a
-- saturated application result to a further argument applies a non-callable
-- value (spec portable alias E_APPLICATION_NON_CALLABLE).

--! mode check

-- POSITIVE: two-argument function is naturally curried.
plusInt : Int -> Int -> Int
let plusInt x y = x + y

-- POSITIVE: partial application — supply one argument to get a unary function.
addFive : Int -> Int
let addFive = plusInt 5

-- POSITIVE: section-style — a function returning a lambda.
addOffset : Int -> Int -> Int
let addOffset offset = \n -> n + offset

-- POSITIVE: curried map — first supply the function, then the list.
mapInt : (Int -> Int) -> List Int -> List Int
let mapInt f xs =
    match xs
    case Nil    -> Nil
    case h :: t -> f h :: mapInt f t

incrementAll : List Int -> List Int
let incrementAll = mapInt (\x -> x + 1)

-- POSITIVE: compose two functions by partial application.
composeFn : (b -> c) -> (a -> b) -> a -> c
let composeFn g f x = g (f x)

addSeven : Int -> Int
let addSeven = composeFn addFive (plusInt 2)

-- POSITIVE: curried function used inline without naming the partial application.
tripled : List Int
let tripled = mapInt (\x -> x * 3) [1, 2, 3, 4]

applied : Int
let applied = addSeven 10

-- NEGATIVE: applying a two-argument function to three arguments applies the
-- saturated Int result to a further argument — not callable (§16.1, §3.1).
badArity : Int
let badArity = plusInt 1 2 3    --!! E_APPLICATION_NON_CALLABLE

--! assertErrorCount 1
--! assertEval applied 17
-- STATUS(a0497523): PASS
