-- Source issue: ROSETTE-202 (`apply` / `foldl` over a non-callable
--                argument)
-- Spec: §16.1 (variables and application), §16.2 (lambdas),
--       §3.1.4 (portable alias E_APPLICATION_ARGUMENT_MISMATCH),
--       §6.1 / §3.2.3 (kappa.type.literal-domain-mismatch for a numeric
--       literal against a function type).
-- Pins: a higher-order parameter annotated (Int -> Int -> Int) rejects a
-- numeric literal (literal-domain mismatch) and rejects a unary function
-- (argument mismatch); lambdas and named binary functions are accepted.

--! mode check

module main

foldlInt : (Int -> Int -> Int) -> Int -> List Int -> Int
let foldlInt f acc xs =
    match xs
    case Nil -> acc
    case h :: t -> foldlInt f (f acc h) t

-- POSITIVE: passing a binary lambda.
sumAll : Int
let sumAll = foldlInt (\acc x -> acc + x) 0 [1, 2, 3, 4, 5]

-- POSITIVE: passing a named binary function.
addAcc : Int -> Int -> Int
let addAcc a b = a + b

sumNamed : Int
let sumNamed = foldlInt addAcc 0 [10, 20, 30]

-- NEGATIVE: passing a numeric literal as the accumulator function.
badProc : Int
let badProc = foldlInt 0 0 [1, 2, 3]

-- NEGATIVE: passing a unary function where a binary one is expected.
unaryFn : Int -> Int
let unaryFn x = x + 1

badArity : Int
let badArity = foldlInt unaryFn 0 [1, 2, 3]         --!! kappa.application.argument-mismatch

--! assertDiagnosticFamily error kappa.application.argument-mismatch
--! assertErrorCount 2

-- STATUS(a0497523): PASS
