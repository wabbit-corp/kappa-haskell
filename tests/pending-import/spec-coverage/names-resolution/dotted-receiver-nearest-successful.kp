-- §7.3 (steps 1-5): dotted receiver lookup is nearest-SUCCESSFUL, not
-- nearest-spelling: "if no candidate in the current binding group yields
-- a well-formed full chain, continue outward". The inner x : Int has no
-- member m and no fallback sugar applies, so the inner binding group is
-- skipped and the outer record x completes the chain.
module main

nested : Int
let nested =
    block
        let x = (m = 42,)
        block
            let x = 5
            x.m

--! assertNoErrors
--! assertEval nested 42
-- STATUS(a0497523): FAIL — receiver lookup stops at the nearest spelled binding group: E_UNRESOLVED_MEMBER (no member 'm') on the inner x instead of continuing outward to the record x
