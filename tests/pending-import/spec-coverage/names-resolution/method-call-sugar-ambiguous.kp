-- §7.4 eligibility: after ordinary member selection fails, fallback
-- sugar keeps — from the nearest binding group — ordinary callable terms
-- with exactly one receiver-marked binder AND selector-form projection
-- definitions with exactly one receiver-marked place binder. "If more
-- than one eligible callable remains, the member step is ambiguous."
-- Both the term pick and the projection pick are eligible here.
module main

type Pair = (left : Int, right : Int)

let pick (this p : Pair) : Int = p.left

projection pick (place this : Pair) : Int =
    yield this.right

p : Pair
let p = (left = 7, right = 9)

viaSugar : Int
let viaSugar = p.pick --!! E_NAME_AMBIGUOUS

--! assertErrorCount 1
--! assertDiagnosticCodes E_NAME_AMBIGUOUS
-- STATUS(a51e1bf): FAIL — compiler silently elaborates p.pick via the projection definition (0 errors, evaluates to 9) instead of reporting the two-eligible-callable ambiguity
