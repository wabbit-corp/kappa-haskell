-- §12.2.1 (L10855-10866): the quantity solver MUST solve obligations
-- derivable from in-scope `QuantitySatisfies` evidence by
-- reflexive-transitive closure. With premises `QuantitySatisfies q1 q2`
-- and `QuantitySatisfies q2 1` in scope, the body obligation
-- `QuantitySatisfies q1 1` is derivable (interval containment:
-- [1,1] ⊆ q2 ⊆ q1) and must be discharged without a new premise.
module main

consume1 :
    forall (q : Quantity) (a : Type).
    QuantitySatisfies q 1 =>
    (q x : a) -> a
let consume1 x = x

-- POSITIVE: direct (reflexive-closure) use of in-scope evidence.
direct :
    forall (q : Quantity) (a : Type).
    QuantitySatisfies q 1 =>
    (q x : a) -> a
let direct x = consume1 x

-- POSITIVE: transitive chaining q1 --> q2 --> 1 discharges the
-- `QuantitySatisfies q1 1` obligation generated by `consume1 x`.
chained :
    forall (q1 : Quantity) (q2 : Quantity) (a : Type).
    QuantitySatisfies q1 q2 =>
    QuantitySatisfies q2 1 =>
    (q1 x : a) -> a
let chained x = consume1 x

--! mode check
--! assertNoErrors
-- STATUS(a0497523): FAIL — `QuantitySatisfies` premises are unimplemented (E_NAME_UNRESOLVED) and quantity-variable binders misparse; 5 errors instead of acceptance, so §12.2.1 reflexive-transitive evidence closure cannot be exercised.
