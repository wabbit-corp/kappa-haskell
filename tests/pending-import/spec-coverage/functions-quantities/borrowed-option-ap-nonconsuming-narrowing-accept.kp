-- §17.1.8 (Spec L22276-L22294) + §17.3.6.1 (L22806-L22810) + §17.3.2:
-- an Option-returning active pattern with a BORROWED scrutinee binder
-- `(& b : Buf)` only borrows the value it inspects. Narrowing is
-- non-consuming, so matching a quantity-1 scrutinee through such a
-- pattern leaves the original value owned by the selected branch, which
-- may (and, being linear, must) still consume it. The wildcard subpattern
-- discards only the ω-borrowed payload, which is droppable (§12.2.6).

--! mode check
--! assertNoErrors

data Buf : Type =
    Buf (n : Int)

bufValue : (1 b : Buf) -> Int
let bufValue (1 b : Buf) : Int =
    match b
    case Buf n -> n

pattern PosVal (& b : Buf) : Option Int =
    match b
    case Buf n -> if n > 0 then Some n else None

f : (1 b : Buf) -> Int
let f (1 b : Buf) : Int =
    match b
    case PosVal (_) -> bufValue b
    case rest -> bufValue rest

-- STATUS(74742dfd): FAIL — expected 0 errors, got 1; first error: E_QTT_LINEAR_OVERUSE "'b' is consumed more often than its linear quantity permits (§12.2)" at line 27
