-- §12.3.1 (L11821-11824): the regions listed in a capture annotation
-- form a set and "duplicates are a compile-time error". A signature
-- writing `captures (s, s)` MUST be rejected.
module main

data Box : Type =
    MkBox Int

badDup :
    forall (s : Region).
    (&[s] x : Box) -> ((Unit -> Int) captures (s, s))
let badDup (@0 s : Region) (&[s] x : Box) : ((Unit -> Int) captures (s, s)) =
    \() -> 0

