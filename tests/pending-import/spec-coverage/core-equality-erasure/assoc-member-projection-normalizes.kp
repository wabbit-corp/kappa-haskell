--! mode check
--! assertNoErrors
--! assertType result List Int

-- §31.1.1 associated static-member projections: once the governing
-- evidence is selected and the member is transparent, the projection
-- normalizes — uniformly in type-signature position and term position —
-- and the instance head is substituted into the member before the
-- member body (here itself a transparent alias) unfolds.
module main

type Payload = List Int

trait Store (a : Type) =
    Content : Type
    put : a -> Content

instance Store Int =
    let Content = Payload
    let put x = x :: Nil

-- type-signature position: d.Content for the selected instance must
-- normalize through Content = Payload = List Int
viaEvidence : (@d : Store Int) -> d.Content
let viaEvidence (@d : Store Int) = d.put 4

-- the projection normalized all the way to List Int, so the result may
-- be consumed at the fully expanded type
result : List Int
let result = viaEvidence

-- term position: projection from an explicitly summoned dictionary
stored : List Int
let stored =
    let d = summon (Store Int)
    d.put 3

-- ============================================================
-- Canonical prelude instance of the same rule (§28.2): "The canonical
-- Add Nat, Mul Nat, and Ord Nat instances delegate to these
-- definitions. Their selected dictionary projections normalize to the
-- same semantic operation identities before arithmetic reification",
-- and §15.8.1 lists selected coherent trait-member projection
-- reduction among the normalizations performed before arithmetic
-- recognition.
--
-- Reading caveat: "before arithmetic reification" may be read as
-- solver-view normalization only rather than full definitional
-- projection unfolding, so these arms pin only the WEAK reading — the
-- trait spelling and the canonical spelling interconvert at an
-- expected-type boundary (ordinary §31.1.1 conversion under the strong
-- reading, §16.1.8 transport over §15.8 evidence under the weak one;
-- both readings accept these declarations). The strong reading's
-- refl-spelled `x + y = natAdd x y` is deliberately NOT asserted.
-- ============================================================

data NatIdx (n : Nat) : Type =
    MkNatIdx

plusDelegates : (x : Nat) -> (y : Nat) -> NatIdx (x + y) -> NatIdx (natAdd x y)
let plusDelegates x y v = v

plusDelegatesBack : (x : Nat) -> (y : Nat) -> NatIdx (natAdd x y) -> NatIdx (x + y)
let plusDelegatesBack x y v = v

data OrdIdx (o : Ordering) : Type =
    MkOrdIdx

compareDelegates : (x : Nat) -> (y : Nat) -> OrdIdx (compare x y) -> OrdIdx (natCompare x y)
let compareDelegates x y v = v
