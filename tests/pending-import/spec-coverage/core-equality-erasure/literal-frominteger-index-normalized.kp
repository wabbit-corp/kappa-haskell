--! mode check
--! assertNoErrors

-- §31.1.3: a numeric literal at a user type with a total transparent
-- FromInteger reduces by δ to its canonical value during definitional-
-- equality checking; literals appearing as type indices are normalized
-- before comparison. §30.2.2.11: matching an index-forcing constructor
-- makes the forced index equality available in the branch.
module main

data Meters : Type =
    MkMeters Int

instance FromInteger Meters =
    let fromInteger n = MkMeters (natToInt n)

-- control (works today): the same witness reduces in TERM position
seven : Meters
let seven = 7

data Road (len : Meters) : Type =
    MkRoad

-- literal index vs its written canonical form: Road 7 ≡ Road (MkMeters 7)
lit : Road 7
let lit = MkRoad

canonical : Road (MkMeters 7) -> Int
let canonical r = 0

used : Int
let used = canonical lit

-- and the reverse direction
canonicalVal : Road (MkMeters 9)
let canonicalVal = MkRoad

usedRev : Road 9 -> Int
let usedRev r = 1

revOk : Int
let revOk = usedRev canonicalVal

-- constructor-forced index equality: in the TagSeven branch the family
-- argument m is forced equal to the (normalized) literal index
data Tag (m : Meters) : Type =
    TagSeven : Tag 7

forced : forall (m : Meters). Tag m -> m = MkMeters 7
let forced t =
    match t
    case TagSeven -> refl

-- STATUS(a0497523): FAIL — integer literals in TYPE-INDEX position never resolve the user FromInteger instance: they elaborate to a stuck `__stuck_app _.fromInteger n` and E_NUMERIC_LITERAL_DOMAIN_MISMATCH claims "Meters has no FromInteger witness" (term-position control works)
