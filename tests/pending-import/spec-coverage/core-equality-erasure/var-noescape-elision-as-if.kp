--! mode run
--! assertNoErrors
--! assertStdout "0\n0\n1\n3\n6\n"

-- §31.5 elision of mutable state is an as-if optimization: a var that
-- never escapes its frame (no closure capture, never returned as a
-- Ref) may be lowered to stack/register form, but reads, writes, and
-- the final value escaping AS A VALUE must be indistinguishable from
-- the explicit heap-Ref semantics.
module main

main : UIO Unit
let main = do
    var acc = 0
    var i = 0
    while ltInt i 4 do
        printlnString (showInt acc)
        acc = addInt acc i
        i = addInt i 1
    -- the VALUE of the var escapes; the var itself does not
    let final = acc
    printlnString (showInt final)

