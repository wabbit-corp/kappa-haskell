--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_EXISTENTIAL_WITNESS_ESCAPE

-- This probe lands on a current §13.2.11 ambiguity. The `open` rule says
-- that no opened witness may remain in a stored value or inferred result
-- type, which would reject the inferred `Option a` below. The projection
-- rules separately permit hidden witness selections in local elaboration
-- while the owning package path remains available; here `p` is still in
-- scope, so an implementation could re-render the type as `Option p.<wit>`.
-- KNOWN_SPEC_ISSUES.md tracks whether that re-rendering discharges the
-- strict end-of-open non-escape check.
module main

useIt : Int
let useIt =
    let p = seal (Some 1) as exists (a : Type). Option a in
    let esc =
        open p as exists (a). x in --!! E_EXISTENTIAL_WITNESS_ESCAPE
            match x
            case Option.None -> Option.None
            case Option.Some y -> Option.Some y
    in 0

-- STATUS: SPEC-ISSUE — decide whether a result mentioning the opened witness may be re-rendered through the still-available package path, or whether the strict `open` non-escape rule always rejects it.
