--! mode check
--! assertNoErrors

-- §13.2.9 introduction: "When constructing a record literal, the user
-- may omit any field marked with `@`. The compiler attempts to
-- synthesize each omitted implicit field using the ordinary elaboration
-- machinery and, when applicable, the implicit resolution procedure of
-- §16.3.3 at the point of construction." Both a propositional field
-- (5 > 0 discharged by refl synthesis, §11.4.2) and a trait-evidence
-- field (instance in scope) must be synthesizable when omitted.
module main

trait Pretty a =
    pretty : a -> String

instance Pretty Int =
    let pretty n = "int"

type SafeInt : Type = (v : Int, @p : this.v > 0)

-- omitted @p must be synthesized: `5 > 0` reduces to True, refl closes it
safe : SafeInt
let safe = (v = 5)

type Box : Type = (a : Type, @tc : Pretty this.a, val : this.a)

-- omitted @tc must be resolved from the Pretty Int instance (§16.3.3)
box : Box
let box = (a = Int, val = 5)

-- STATUS(a51e1bf): FAIL — omitted @-fields are never synthesized; the literal is rejected with E_TYPE_EQUALITY_MISMATCH 'record literal fields do not match the expected record type'
