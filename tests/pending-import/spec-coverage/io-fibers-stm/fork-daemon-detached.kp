--! mode run
--! assertNoErrors
--! assertStdout "scope-exited\ndaemon:5\n"

-- §18.1.4/§18.1.8: forkDaemon creates a child NOT attached to the current
-- structured runtime scope. When the enclosing withScope exits, its
-- ScopeShutdown interruption reaches attached fibers (the forkIn sleeper)
-- but MUST NOT interrupt the daemon, which stays parked on its gate and
-- completes normally once released from outside the scope.
module main

daemonBody : Promise Void Unit -> UIO Int
let daemonBody gate = do
    let _ <- awaitPromise gate
    ioPure 5

sleeper : UIO Int
let sleeper = do
    sleepFor (seconds 10)
    ioPure 0

useScope : Promise Void Unit -> Scope -> UIO (Fiber Void Int)
let useScope gate sc = do
    let s <- forkIn sc sleeper
    let _ = s
    forkDaemon (daemonBody gate)

main : UIO Unit
let main = do
    let gate <- newPromise
    -- withScope shuts the scope down on exit: the attached sleeper is
    -- interrupted and drained; the daemon must survive.
    let d <- withScope (useScope gate)
    printlnString "scope-exited"
    let _ <- completePromise gate (Success ())
    let ex <- await d
    match ex
      case Success v -> printlnString ("daemon:" ++ showInt v)
      case Failure (Interrupt c) -> printlnString "daemon:interrupted"
      case Failure c -> printlnString "daemon:other"
