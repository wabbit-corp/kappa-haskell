--! mode run
--! assertNoErrors
--! assertStdout "returned\nfin-done\ninterrupt:Requested\n"

-- §18.1.4 (Spec.md L18848-18850): interruptFork requests interruption but
-- does NOT wait for termination. The child's ensuring finalizer parks on a
-- promise only the parent completes AFTER interruptFork returns — if
-- interruptFork waited for termination (like interrupt), this would
-- deadlock. "returned" printing before "fin-done" pins the async nature.
module main

childBody : Promise Void Unit -> UIO Unit
let childBody ready = do
    let _ <- completePromise ready (Success ())
    sleepFor (seconds 10)

finalizer : Promise Void Unit -> UIO Unit
let finalizer unblock = do
    let _ <- awaitPromise unblock
    printlnString "fin-done"

child : Promise Void Unit -> Promise Void Unit -> UIO Unit
let child ready unblock = ensuring (childBody ready) (finalizer unblock)

main : UIO Unit
let main = do
    let ready <- newPromise
    let unblock <- newPromise
    let f <- fork (child ready unblock)
    let _ <- awaitPromise ready
    interruptFork f
    -- control is back although the child has not terminated (its finalizer
    -- is still parked on `unblock`)
    printlnString "returned"
    let _ <- completePromise unblock (Success ())
    let ex <- await f
    match ex
      case Success v -> printlnString "completed"
      case Failure (Interrupt (InterruptCause Requested by)) -> printlnString "interrupt:Requested"
      case Failure c -> printlnString "other"
-- STATUS(a0497523): FAIL — expected 0 errors, got 2; first error: E_NAME_UNRESOLVED "unresolved name 'Success' (not in scope)" at line 14; stdout mismatch: expected "returned\nfin-done\ni… [was PASS in an earlier STATUS line]
