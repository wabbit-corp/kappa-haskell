--! mode run
--! assertNoErrors
--! assertStdout "during-retry:0\ncommitted:99\nafter-commit:99\n"

-- §18.1.13 (Spec.md L19307-19313): STM is isolated and optimistic; aborted
-- transaction attempts expose NO partial writes. A transaction writes a
-- TVar and then retries on a guard; while it is parked, other atomically
-- executions MUST NOT observe the aborted attempt's write.
module main

txn : TVar Int -> TVar Int -> STM Int
let txn a guard = do
    writeTVar a 99
    let g <- readTVar guard
    check (g > 0)
    readTVar a

main : UIO Unit
let main = do
    let a <- atomically (newTVar 0)
    let guard <- atomically (newTVar 0)
    let f <- fork (atomically (txn a guard))
    -- give the transaction time to attempt, write, and park in retry
    sleepFor (millis 25)
    let mid <- atomically (readTVar a)
    -- the aborted attempt's write to `a` must be invisible
    printlnString ("during-retry:" ++ showInt mid)
    atomically (writeTVar guard 1)
    let ex <- await f
    match ex
      case Success v -> printlnString ("committed:" ++ showInt v)
      case Failure c -> printlnString "failed"
    let fin <- atomically (readTVar a)
    printlnString ("after-commit:" ++ showInt fin)
