--! mode run
--! assertNoErrors
--! assertStdout "retry-branch:200\nrollback:0\nleft-first:1\nright-skipped:0\n"

-- §18.1.13 (Spec.md L19291-19303): STM participates in Alternative; `<|>` /
-- orElse runs the right branch ONLY when the left branch retries, and the
-- retrying left branch's writes are rolled back (aborted attempts expose no
-- partial writes).
module main

leftRetries : TVar Int -> TVar Int -> STM Unit
let leftRetries out marker = do
    writeTVar out 100
    writeTVar marker 100
    retry

rightWrites : TVar Int -> STM Unit
let rightWrites out = writeTVar out 200

leftWrites : TVar Int -> STM Unit
let leftWrites out = writeTVar out 1

rightMustNotRun : TVar Int -> STM Unit
let rightMustNotRun marker = writeTVar marker 1000

main : UIO Unit
let main = do
    -- left retries: right branch runs; left's writes are rolled back
    let out1 <- atomically (newTVar 0)
    let marker1 <- atomically (newTVar 0)
    atomically (leftRetries out1 marker1 <|> rightWrites out1)
    let v1 <- atomically (readTVar out1)
    let m1 <- atomically (readTVar marker1)
    printlnString ("retry-branch:" ++ showInt v1)
    printlnString ("rollback:" ++ showInt m1)
    -- left succeeds: right branch does not run
    let out2 <- atomically (newTVar 0)
    let marker2 <- atomically (newTVar 0)
    atomically (leftWrites out2 <|> rightMustNotRun marker2)
    let v2 <- atomically (readTVar out2)
    let m2 <- atomically (readTVar marker2)
    printlnString ("left-first:" ++ showInt v2)
    printlnString ("right-skipped:" ++ showInt m2)
