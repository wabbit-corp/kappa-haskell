--! mode run
--! assertNoErrors
--! assertStdout "defect:unhandled-child\n"

-- §18.1.3 (Spec.md L18779-18781): an attached child fiber that terminates
-- with unacknowledged typed failure and remains unacknowledged when its
-- enclosing scope exits MUST become Defect (DefectInfo UnhandledChildFailure
-- msg) — observed here on the scope owner's exit via sandbox (§18.1.2).
module main

failingChild : IO String Int
let failingChild = throwIO "child-boom"

useScope : Scope -> UIO Int
let useScope sc = do
    let f <- forkIn sc failingChild
    let _ = f
    -- let the child terminate with its (never-awaited) typed failure
    sleepFor (millis 20)
    ioPure 7

parent : UIO Int
let parent = withScope useScope

classify : Cause Void -> IO Void String
let classify c = match c
    case Defect (DefectInfo UnhandledChildFailure m) -> ioPure "defect:unhandled-child"
    case Defect (DefectInfo t m) -> ioPure "defect:other-tag"
    case _ -> ioPure "cause:other"

main : UIO Unit
let main = do
    let r <- catchIO (ioBind (sandbox parent) (\v -> ioPure "scope-succeeded")) classify
    printlnString r
-- STATUS(a0497523): FAIL — compiler gap: scope exit ignores the unacknowledged failed child (runs 'scope-succeeded'); no Defect(DefectInfo UnhandledChildFailure _) promotion per §18.1.3.
