--! mode run
--! assertNoErrors
--! assertStdout "child-finalized\nscope-done\nscope-shutdown\n"

-- Combination §18.1.8 + §18.1.11 + §18.1.12: a child forked into an
-- explicit scope parks inside `blocking`. Scope exit (withScope) interrupts
-- it with tag ScopeShutdown, the interruption reaches through the blocking
-- region, the child's finalizer runs (masked finalization), and the scope
-- shutdown completes without deadlock before withScope returns.
module main

childBody : Promise Void Unit -> UIO Unit
let childBody ready = do
    let _ <- completePromise ready (Success ())
    blocking (sleepFor (seconds 10))

child : Promise Void Unit -> UIO Unit
let child ready = ensuring (childBody ready) (printlnString "child-finalized")

useScope : Promise Void Unit -> Scope -> UIO (Fiber Void Unit)
let useScope ready sc = do
    let f <- forkIn sc (child ready)
    let _ <- awaitPromise ready
    ioPure f

main : UIO Unit
let main = do
    let ready <- newPromise
    let f <- withScope (useScope ready)
    -- withScope's exit shutdown waited for the child and its finalizers
    printlnString "scope-done"
    let ex <- await f
    match ex
      case Success v -> printlnString "completed"
      case Failure (Interrupt (InterruptCause ScopeShutdown by)) -> printlnString "scope-shutdown"
      case Failure c -> printlnString "other"
