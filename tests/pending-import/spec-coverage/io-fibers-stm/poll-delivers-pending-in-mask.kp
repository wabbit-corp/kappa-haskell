--! mode run
--! assertNoErrors
--! assertStdout "resumed-masked\ninterrupted:Requested\n"

-- §18.1.12 (Spec.md L19234-19237): poll is an explicit interruption
-- checkpoint that delivers a PENDING interruption immediately, even from
-- within uninterruptible. The pending request does not wake the masked
-- promise wait (delivery is suppressed there), but the explicit poll after
-- it must deliver — "after-poll" must never print.
module main

body : Promise Void Unit -> Promise Void Unit -> UIO Unit
let body ready go = do
    let _ <- completePromise ready (Success ())
    let _ <- awaitPromise go
    -- reached with the interrupt request already pending (sent while this
    -- fiber was parked, masked, on `go`)
    printlnString "resumed-masked"
    poll
    printlnString "after-poll"

child : Promise Void Unit -> Promise Void Unit -> UIO Unit
let child ready go = uninterruptible (body ready go)

main : UIO Unit
let main = do
    let ready <- newPromise
    let go <- newPromise
    let f <- fork (child ready go)
    let _ <- awaitPromise ready
    interruptFork f
    let _ <- completePromise go (Success ())
    let ex <- await f
    match ex
      case Success u -> printlnString "completed"
      case Failure (Interrupt (InterruptCause Requested by)) -> printlnString "interrupted:Requested"
      case Failure c -> printlnString "other"
