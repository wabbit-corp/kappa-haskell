--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_CONTINUATION_CAPTURE
--! assertDiagnosticRelated error E_QTT_CONTINUATION_CAPTURE handler-boundary

-- §18.1.20.2 diagnostic requirement (Spec.md L23211-23219): when a
-- multi-shot invocation is rejected because the captured suffix holds
-- non-duplicable state, the diagnostic MUST identify the operation, an
-- offending value, the rejection kind, AND the nearest handler boundary
-- used for capture — the latter asserted here as a related origin.
module main

bad : (1 x : Int) -> Int
let bad (1 x : Int) : Int =
    block
        scoped effect Choice =
            ω choose : Unit -> Bool

        let comp : Eff <[Choice : Choice]> Int =
            do
                let b <- Choice.choose ()
                if b then x else x

        let handled =
            deep handle Choice comp with
                case return y -> pure y
                case choose _ k ->
                    do
                        let a <- k True
                        let _ <- k False
                        pure a

        runPure handled
-- STATUS(a0497523): FAIL — compiler gap: E_QTT_CONTINUATION_CAPTURE names the operation, offending value, and rejection kind in its message, but emits NO related origins ("saw roles:" empty), so the §18.1.20.2-required handler-boundary citation is missing.
