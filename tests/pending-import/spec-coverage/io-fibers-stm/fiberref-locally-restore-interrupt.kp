--! mode run
--! assertNoErrors
--! assertStdout "restored:7\ninterrupted\nafter-fail:7\n"

-- §18.1.7 (Spec.md L19012-19019): locallyFiberRef restores the previous
-- value on INTERRUPTION and on TYPED FAILURE, not only on normal completion
-- (restoration behaves as a masked finalizer). The interrupted child's
-- outer ensuring finalizer observes the restored (pre-locally) value.
module main

localBody : FiberRef Int -> Promise Void Unit -> UIO Unit
let localBody ref ready = do
    let _ <- completePromise ready (Success ())
    sleepFor (seconds 10)

reportRestored : FiberRef Int -> UIO Unit
let reportRestored ref = do
    let v <- getFiberRef ref
    printlnString ("restored:" ++ showInt v)

child : FiberRef Int -> Promise Void Unit -> UIO Unit
let child ref ready =
    ensuring (locallyFiberRef ref 99 (localBody ref ready)) (reportRestored ref)

failing : IO String Int
let failing = throwIO "boom"

main : UIO Unit
let main = do
    let ref <- newFiberRef 7
    -- interruption path: the child inherits 7; locallyFiberRef installs 99;
    -- the interrupt unwinds and restores 7 before the ensuring finalizer runs
    let ready <- newPromise
    let f <- fork (child ref ready)
    let _ <- awaitPromise ready
    interrupt f
    printlnString "interrupted"
    -- typed-failure path in this fiber: locallyFiberRef restores 7 on Fail
    let v <- catchIO (locallyFiberRef ref 55 failing) (\m -> getFiberRef ref)
    printlnString ("after-fail:" ++ showInt v)
