--! mode run
--! assertNoErrors
--! assertStdout "initiator:caller\n"

-- §18.1.4 (Spec.md L18855-18858): `interrupt fiber` behaves as
-- `interruptAs (InterruptCause Requested (Some id)) fiber` where id is the
-- CURRENT CALLER's fiber id — the initiating fiber MUST be recorded in the
-- delivered InterruptCause, not dropped to None.
-- NOTE: the FiberId.MkFiberId pattern below matches this repository's
-- prelude; the spec declares FiberId opaque (expect data), so a portable
-- respelling would compare through provided operations instead.
module main

sleeper : UIO Int
let sleeper = do
    sleepFor (seconds 10)
    ioPure 0

sameId : FiberId -> FiberId -> Bool
let sameId a b = match a
    case FiberId.MkFiberId x -> match b
      case FiberId.MkFiberId y -> x == y

main : UIO Unit
let main = do
    let me <- currentFiberId
    let f <- fork sleeper
    interrupt f
    let ex <- await f
    match ex
      case Exit.Success v -> printlnString "completed"
      case Exit.Failure (Cause.Interrupt (InterruptCause InterruptTag.Requested (Some by))) ->
        if sameId by me
        then printlnString "initiator:caller"
        else printlnString "initiator:other-fiber"
      case Exit.Failure (Cause.Interrupt (InterruptCause InterruptTag.Requested None)) -> printlnString "initiator:none"
      case Exit.Failure c -> printlnString "other-cause"
-- STATUS(3014a0d9): FAIL — initiator recorded as none; §32.2.8 requires the requesting fiber id
