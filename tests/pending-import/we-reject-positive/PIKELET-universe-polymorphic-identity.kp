-- Source issues: PIKELET-10 (cumulative universe hierarchy — motivating the
--               polymorphic identity over levels),
--               PIKELET-125 (universe shifting),
--               PIKELET-237 (Andras Kovacs' universe lifting).
-- Spec: types.universes.inference_sketch, types.universes.cumulativity,
--       expressions.lambdas, types.quantification
--
-- Kappa exposes universe polymorphism in two complementary ways. An explicit
-- bounded `forall (u : TypeLevel)` telescope (§11.1.2.8, §11.3) needs an
-- erased `u < ω` outer-ceiling witness. An ordinary unannotated
-- `forall a. ...` instead leaves the universe metavariable to declaration
-- generalization, producing the hidden schema `idImplicit.{u}` with
-- `a : Type u` (§11.1.2.3). Both forms must instantiate at multiple levels.

--! mode check
--! assertNoWarnings

-- POSITIVE: identity polymorphic over both a bounded universe level and a
-- type. The proof is compile-time-only and synthesized at each use.
idAll :
    forall (u : TypeLevel).
    forall (@0 uBound : u < ω).
    forall (A : Type u).
    A -> A
let idAll x = x

-- POSITIVE: applied at Type0 by inferring `u`.
useNat : Nat
let useNat = idAll 7

-- POSITIVE: applied at Type1 — passing a `Type0` as the argument.
useTy : Type0
let useTy = idAll Nat

-- POSITIVE: applied at Type2 — passing `Type1` as the argument.
useTy1 : Type1
let useTy1 = idAll Type0

-- POSITIVE: an unannotated `forall a.` binder gets an inferred `Type u`
-- annotation. The unsolved `u` is generalized into a hidden declaration
-- universe parameter, rather than requiring a term-level TypeLevel binder.
idImplicit : forall a. a -> a
let idImplicit x = x

useImplicitNat : Nat
let useImplicitNat = idImplicit 1

useImplicitTy : Type0
let useImplicitTy = idImplicit Nat

useImplicitTy1 : Type1
let useImplicitTy1 = idImplicit Type0

--! assertNoErrors

-- STATUS(8c3c7747): PASS — explicit bounded levels and inferred declaration-universe polymorphism both instantiate through Type2.
