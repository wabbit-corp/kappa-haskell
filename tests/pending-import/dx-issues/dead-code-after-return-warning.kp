-- DX expectation, not (yet) spec-required. Per §18.2.4 (L24704-24707) the
-- checker ALREADY models do-items after `return`/`break` as unreachable (it
-- exempts them from usage counting — see spec-coverage/combo-2026-07-23/
-- dead-do-items-no-linear-overuse.kp, accepted today), yet it emits no
-- dead-code diagnostic: statements after an abrupt completion compile in
-- total silence. The reachability information is already computed, so a
-- warning is nearly free; silently dropping user statements is a classic
-- footgun (a stray early `return` swallows the rest of the block). Expected:
-- one warning per dead do-item region (one after `return`, one after
-- `break`). Currently: compiles silently (0 warnings).
--! mode check
--! assertNoErrors
--! assertWarningCount 2
module main

-- WARNING EXPECTED: `return 0` is dead — the block already returned.
afterReturn : Int -> UIO Int
let afterReturn x =
    do
        return (x + 1)
        return 0

-- WARNING EXPECTED: the loop-body item after `break` is dead.
afterBreak : Bool -> UIO Unit
let afterBreak cond =
    do
        while cond do
            break
            printlnString "dead"
        pure ()

main : UIO Unit
let main = printlnString "ok"

-- STATUS(a0497523): FAIL — do-items after return/break are silently dropped-as-dead (checker already exempts them from usage) with 0 warnings (expected 2)
