-- DX EXPECTATION — §6.1.5, §11.1.3: §6.1.5 applies the Integer
-- default "after all type inference completes on the enclosing
-- declaration".  A parenthesized partial application of a
-- trait-polymorphic operator must therefore not default its literal
-- argument before the outer application and the declaration's
-- expected type are seen: `tPoly : Nat = ((+) 1) 2` should check
-- exactly like the saturated spine `(+) 1 2`, the infix `1 + 2`, and
-- the monomorphic `(myAdd 1) 2` — all accepted today.  Today only
-- tPoly fails: the parenthesized subterm is a synthesis boundary that
-- commits 1 to Integer early, then reports kappa.type.mismatch
-- "actual: Integer / expected: Nat" on the whole application.  The
-- same failure blocks the natural way to write computed indices,
-- e.g. `P (((+) 1) 2)` — now asserted below (pIdx/pLit): with the
-- 2026-07-25 Nat/Fin revision, closed Nat index computation is
-- definitional (§28.2 canonical natAdd equations, §31.1.3 literal
-- normalization), so `P (((+) 1) 2)` and `P 3` must be the same type
-- by ordinary closed evaluation, no solver involved.
--! mode check
--! assertNoErrors

module main

myAdd : Nat -> Nat -> Nat
let myAdd x y = x + y

-- control: monomorphic parenthesized partial application — accepted
tMono : Nat
let tMono = (myAdd 1) 2

-- control: trait-polymorphic operator, saturated spine — accepted
tSat : Nat
let tSat = (+) 1 2

-- control: infix spelling — accepted
tInfix : Nat
let tInfix = 1 + 2

-- trait-polymorphic operator, parenthesized partial application:
-- rejected today with actual Integer / expected Nat
tPoly : Nat
let tPoly = ((+) 1) 2

-- the dependent-index manifestation: the same spine in type position,
-- plus the pin that closed Nat index computation is definitional
data P (n : Nat) : Type =
    MkP

pIdx : P (((+) 1) 2)
let pIdx = MkP

pLit : P 3
let pLit = pIdx
-- STATUS(a0497523): FAIL — expected 0 errors, got 1: tMono/tSat/tInfix check clean but tPoly fails E_TYPE_EQUALITY_MISMATCH "actual: Integer / expected: Nat" (the parenthesized partial application defaulted its literal before the outer application was seen, contradicting §6.1.5's after-inference timing)
-- (Recorded against the pre-revision file shape; P/pIdx/pLit were added
-- 2026-07-25 and have not been run on a0497523.)
