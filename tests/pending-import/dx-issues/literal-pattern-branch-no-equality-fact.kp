-- DX EXPECTATION (§17.1.6, §17.2.1, §16.4.1, §16.1.8): matching an INTEGER
-- scrutinee against a literal pattern (`match n ... case 0 ->`) should
-- introduce a branch fact — the propositional n = 0, or at least the
-- boolean (n == 0) = True — exactly as §17.1.6 already mandates for Bool
-- literal patterns. This is a SPEC gap that the 2026-07 Nat/Fin revision
-- left open: §17.1.6 covers only True/False literals, and §17.2.1 still
-- lists "Literal: numeric" as a pattern form with no evidence rule at all.
-- Integer remains `expect data Integer` (§28.2) with no constructor
-- theory, so no constructor-branch channel exists for it.
--
-- Nat is different now: §28.2 gives Nat ordinary constructors, and the
-- constructor spelling (`case Nat.Zero` / `case Nat.Succ k`) is required
-- to refine dependent uses — pinned as spec coverage in
-- ../spec-coverage/nat-fin-refinement/positive/nat-constructor-branch-fact
-- and .../positive/nat-indexed-replicate. The residual Nat ask kept HERE
-- (parts d/e) is the SPELLING gap: `case 0` at Nat should behave exactly
-- like `case Nat.Zero` — §31.1.3 makes the literal definitionally
-- Nat.Zero — but §17.2.1 never says a numeric literal pattern elaborates
-- to a constructor pattern, so the literal spelling (including the
-- `case 0` / `case _` way of writing replicate) is unspecified.
--
-- The guard respelling `case _ if n == 0` (control (c)) is accepted
-- today, so users must trade the literal pattern for a guard to get the
-- fact.
--! mode check
--! assertNoErrors
module main

atZero : (n : Int) -> (@0 p : n = 0) -> Int
let atZero n = 7

zeroFact : (n : Int) -> (@0 p : (n == 0) = True) -> Int
let zeroFact n = 7

-- (a) literal branch should discharge the propositional goal n = 0.
viaLitProp : Int -> Int
let viaLitProp n =
    match n
      case 0 -> atZero n
      case _ -> 0

-- (b) literal branch should at least carry the boolean fact.
viaLitBool : Int -> Int
let viaLitBool n =
    match n
      case 0 -> zeroFact n
      case _ -> 0

-- (c) control (works today, must keep working): the guard spelling
-- introduces the boolean fact per §17.1.9.
viaGuard : Int -> Int
let viaGuard n =
    match n
      case _ if n == 0 -> zeroFact n
      case _ -> 0

-- (d) Nat literal-SPELLING twin of the required constructor behavior:
-- `case 0` should refine exactly like `case Nat.Zero` (§31.1.3 plus the
-- §17.2.1 omission described in the header).
data Vec (n : Nat) : Type =
    MkVec

expects0 : Vec 0 -> Unit
let expects0 (v : Vec 0) : Unit = ()

viaMatchNat : (n : Nat) -> Vec n -> Unit
let viaMatchNat n v =
    match n
      case 0 -> expects0 v
      case _ -> ()

-- (e) and the literal branch should materialize the propositional proof.
proofViaMatch : (n : Nat) -> Option ((=) n 0)
let proofViaMatch n =
    match n
      case 0 -> Some refl
      case _ -> None
