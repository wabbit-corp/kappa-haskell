--! mode run
--! assertDiagnostic error E_UNSOLVED_IMPLICIT

module main

bogus : (=) True False
let bogus = witness             --!! kappa.implicit.unsolved

discr : Bool -> Type
let discr b = if b then Unit else Void

toVoid : Void
let toVoid = subst @Bool @discr bogus ()

main : IO Void Unit
let main =
    do
        println "start"
        match toVoid
        case impossible
