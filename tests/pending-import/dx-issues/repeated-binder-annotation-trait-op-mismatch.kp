-- DX EXPECTATION — §9.1, §14.2, §16.3.3, §15.8.1: restating the
-- signature's binder annotations on the `let` line is legal and is how
-- dependent proofs stay readable.  When an annotation contains a
-- trait-operator application, the definition-side re-elaboration must
-- re-solve (or unify) the operator's instance argument so the restated
-- annotation converts with the signature.  The Nat/Fin revision makes
-- this normative rather than an implementation nicety: §15.8.1 says
-- operations are recognized "by resolved semantic identity", and "a
-- transparent alias or selected dictionary projection participates only
-- when normalization exposes the same semantic operation" — an unsolved
-- `_` instance on the definition side defeats reification as well as
-- conversion.  Today the instance is left as an unsolved metavariable
-- compared RIGIDLY against the signature's solved instance, so coerceA
-- fails with kappa.type.mismatch while the identical program with bare
-- let-side binders (coerceB) checks clean.  Users writing dependent
-- proofs are forced to drop precisely the annotations that make such
-- code readable.
-- Caveat (2026-07-25): under §28.2's left-recursive natAdd plus §31.1.3,
-- `(0 : Nat) + n` is now DEFINITIONALLY `n`, so coerceA alone is a weak
-- witness — it could go green through the arithmetic path without the
-- instance ever being re-solved.  coerceC pins the non-definitional
-- twin: §28.2 explicitly does not add `n + Zero = n` to definitional
-- equality, so only a correctly re-solved instance lets the §15.8 /
-- §16.1.8 machinery close it.
--! mode check
--! assertNoErrors

module main

data Vec (n : Nat) : Type =
    MkVec

-- signature binders restated on the let line: rejected today
coerceA : (n : Nat) -> (@0 pf : (=) ((0 : Nat) + n) n) -> Vec (0 + n) -> Vec n
let coerceA (n : Nat) (@0 pf : (=) ((0 : Nat) + n) n) (v : Vec (0 + n)) : Vec n =
    subst pf v

-- control: identical signature and body, bare binders — accepted
coerceB : (n : Nat) -> (@0 pf : (=) ((0 : Nat) + n) n) -> Vec (0 + n) -> Vec n
let coerceB n pf v = subst pf v

-- non-definitional twin: right identity is not definitional (§28.2), so
-- this cannot pass by the arithmetic path alone — the restated binder's
-- + instance must actually be re-solved
coerceC : (n : Nat) -> (@0 pf : (=) (n + (0 : Nat)) n) -> Vec (n + 0) -> Vec n
let coerceC (n : Nat) (@0 pf : (=) (n + (0 : Nat)) n) (v : Vec (n + 0)) : Vec n =
    subst pf v
-- STATUS(a0497523): FAIL — expected 0 errors, got 1: coerceA's restated pf annotation fails E_TYPE_EQUALITY_MISMATCH "actual: = Nat (+ Nat __inst_Add_71 0 @0) @0 / expected: = Nat (+ Nat _ 0 @0) @0" (the let-side re-elaboration leaves the + instance argument as an unsolved '_' compared rigidly); bare-binder coerceB checks clean
-- (Recorded against the pre-revision file shape; coerceC was added
-- 2026-07-25 and has not been run on a0497523.)
