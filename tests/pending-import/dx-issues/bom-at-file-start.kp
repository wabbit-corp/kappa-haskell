-- DX EXPECTATION, not necessarily spec-required (the spec is silent on
-- byte-order marks): a UTF-8 BOM (EF BB BF) at the very start of a source
-- file should be skipped, as most compilers do -- Windows editors and
-- PowerShell redirection produce BOM-prefixed files routinely. At minimum
-- a rejection must NAME the byte-order mark. Currently the file is
-- rejected with: error[E_UNEXPECTED_CHARACTER]: unexpected character
-- '<U+FEFF>' -- and U+FEFF is invisible, so the user sees "unexpected
-- character ''" with no printable clue what is wrong or how to fix it.
-- The first byte of THIS file is a UTF-8 BOM (before the first comment).
--! mode check
--! assertNoErrors

module main

x : Int
let x = 42
-- STATUS(a0497523): FAIL — leading UTF-8 BOM rejected as E_UNEXPECTED_CHARACTER quoting the invisible U+FEFF; message shows an apparently-empty character and never names the BOM
