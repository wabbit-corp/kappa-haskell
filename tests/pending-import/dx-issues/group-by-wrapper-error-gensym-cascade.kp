-- DX EXPECTATION (not necessarily spec-required): when the `using Wrapper`
-- constructor of a group-by aggregate fails to resolve, the diagnostics
-- should stop at the unresolved wrapper name. Compiler-internal hygienic
-- temporaries must never surface in user diagnostics.
--
-- WHAT CURRENTLY HAPPENS (a0497523): after the two legitimate
-- E_NAME_UNRESOLVED errors for 'NoSuchWrapper', elaboration recovery emits
-- a THIRD error at the comprehension head referencing internal gensyms:
--   unresolved name '__x174' ... help: did you mean '__g171'?
--   fix: replace '__x174' with '__g171' [maybe-applicable]
-- i.e. a machine-generated binder leak complete with a nonsense
-- auto-applicable fix suggestion.
--! mode check
--! assertErrorCount 2

f : Unit -> List Int
let f u =
    [
        for x in [1, 2]
        group by 1 { c = 1 using NoSuchWrapper } into g
        yield 0
    ]
-- STATUS(a0497523): FAIL — 3 errors: the two legitimate NoSuchWrapper errors plus "unresolved name '__x174' ... did you mean '__g171'?" with a maybe-applicable gensym-to-gensym fix.
