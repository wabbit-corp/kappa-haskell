-- DX EXPECTATION, not spec-required: division under a strictly-positive
-- divisor guard should typecheck. Every mainstream flow/refinement system
-- (and ordinary developer intuition) treats `y > 0` as establishing `y /= 0`
-- for integers. In Kappa, §16.4.1 only injects the syntactic branch fact
-- ((y > 0) = True) and discharge happens by definitional normalization alone,
-- so the (y /= 0)-shaped divDefined obligation stays unsolved — guarding on
-- `y /= 0`, `y == 0` (else-side), or `divDefined x y` works instead (pinned
-- green in tests/conformance/qtt/checked-div-branch-refinement.kp and
-- tests/pending-import/spec-coverage/prelude/checked-div-proof-flow-refinement.kp).
-- Expected-good behavior: either derive the entailment (y > 0) => (y /= 0)
-- for integer comparisons, or at minimum have the diagnostic suggest the
-- discharging guard shape. What currently happens (a0497523): a bare
-- E_UNSOLVED_IMPLICIT whose obligation prints as
--   = Bool (divDefined Integer __inst_CheckedDiv_12 @1 @0) True
-- with no hint (see unsolved-implicit-proof-rendering.kp for the rendering).
--! mode check
--! assertNoErrors
module main

posDiv : Int -> Int -> Int
let posDiv x y = if y > 0 then x / y else 0

-- STATUS(a0497523): FAIL — E_UNSOLVED_IMPLICIT: the (y > 0) = True branch fact
-- does not entail the (y /= 0)-shaped divDefined obligation, and the message
-- offers no discharging-guard hint.
