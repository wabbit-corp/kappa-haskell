-- DX: leading infix operators are a conventional multiline-expression style.
-- Supporting them under a deeper continuation indent avoids the current remote
-- E_EXPECTED_SYNTAX_TOKEN at the following declaration. If the language keeps
-- rejecting this layout, the eventual regression should instead pin one local
-- targeted layout diagnostic at `||` with a useful repair.
--! mode check
--! assertNoErrors
--! assertEval eitherTrue True
--! assertEval neitherTrue False

module main

either : Bool -> Bool -> Bool
let either a b =
    a
    || b

eitherTrue : Bool
let eitherTrue = either False True

neitherTrue : Bool
let neitherTrue = either False False
