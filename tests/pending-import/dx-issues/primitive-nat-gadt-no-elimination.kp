-- DX EXPECTATION (§17.1.1, §17.1.4, §10.1.3, §31.1.3; contrast §11.1):
-- GADTs indexed by PRIMITIVE Nat with arithmetic result indices support
-- construction (v2 below checks today) but should also support safe
-- ELIMINATION: at Vec (n + 1) a the VNil constructor is refuted by
-- 0 /= n + 1, so a single VCons arm is exhaustive (vhead/vtail); at the
-- ground index Vec 0 a the VCons constructor is refuted by n + 1 /= 0, so
-- a single VNil arm is exhaustive and an explicit `case VCons -> impossible`
-- arm is provably unreachable. §17.1.1's exhaustiveness MUST is qualified
-- by a "should" on index-refutation strength, so the conservative answer is
-- spec-PERMITTED — this is a capability gap, not nonconformance — but it
-- leaves primitive-Nat GADTs construction-only: no catch-all body can
-- produce `a` from thin air, so safe head/tail are simply unwritable. The
-- user-inductive route (PNat with Z/S constructors) supports both
-- refutations today, and TypeLevel's solver-backed arithmetic (§11.1)
-- decides such disequalities — the bridge is missing only for primitive
-- numeric indices on data.
--
-- CURRENTLY (a0497523): vhead and vtail each fail E_PATTERN_NON_EXHAUSTIVE
-- "missing cases: VNil"; onlyNil fails E_PATTERN_NON_EXHAUSTIVE "missing
-- cases: VCons"; onlyNil2's impossible arm fails E_IMPOSSIBLE_REACHABLE
-- "not provably unreachable here (§17.1.4)". If arithmetic refutation ever
-- lands, this file flips to a positive pin.
--! mode check
--! assertNoErrors
module main

data Vec (n : Nat) (a : Type) : Type =
    VNil  : Vec 0 a
    VCons : (head : a) -> (tail : Vec n a) -> Vec (n + 1) a

-- Construction works today (known baseline) and must keep working.
v2 : Vec 2 Int
let v2 = VCons 1 (VCons 2 VNil)

-- Elimination at a successor index: VNil should be refuted by 0 /= n + 1.
vhead : forall (@0 a : Type) (@0 n : Nat). Vec (n + 1) a -> a
let vhead v =
    match v
      case VCons x _ -> x

vtail : forall (@0 a : Type) (@0 n : Nat). Vec (n + 1) a -> Vec n a
let vtail v =
    match v
      case VCons _ t -> t

-- Elimination at the ground index 0: VCons should be refuted.
onlyNil : forall (@0 a : Type). Vec 0 a -> Int
let onlyNil v =
    match v
      case VNil -> 0

onlyNil2 : forall (@0 a : Type). Vec 0 a -> Int
let onlyNil2 v =
    match v
      case VNil -> 0
      case VCons _ _ -> impossible
-- STATUS(a0497523): FAIL — expected 0 errors, got 4: E_PATTERN_NON_EXHAUSTIVE
-- "missing cases: VNil" at lines 38 and 43 (vhead, vtail);
-- E_PATTERN_NON_EXHAUSTIVE "missing cases: VCons" at line 49 (onlyNil);
-- E_IMPOSSIBLE_REACHABLE at line 56 (onlyNil2). Construction (v2) checks.
