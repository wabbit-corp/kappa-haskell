-- DX EXPECTATION (not necessarily spec-required): a syntactically
-- finite Double literal that cannot be represented as a finite (or
-- nonzero) binary64 value should draw a compile-time warning.
--
-- Spec 6.1.2 gives only the literal grammar and 6.1.3 only fixes
-- Double = IEEE-754 binary64; NO rule states what value an
-- out-of-range literal denotes (reported separately as a spec
-- ambiguity). Today the compiler silently applies IEEE rounding at
-- the extremes: `1e309` (and a 500-digit integer literal used at
-- Double) becomes Infinity, and `1e-324` — below half the smallest
-- subnormal — becomes 0.0, with no diagnostic at all. A user typo in
-- an exponent thus compiles clean and produces Infinity/zero at
-- runtime. C compilers warn, Swift rejects, Rust lints; a warning per
-- offending literal is the expected-good behavior.
--
-- Expected: the program still compiles and runs (values below are the
-- IEEE results), but each of the two extreme literals is flagged.
--! mode run
--! assertNoErrors
--! assertWarningCount 2
--! assertStdout "True\nTrue\n"

huge : Double
let huge = 1e309

tiny : Double
let tiny = 1e-324

main : UIO Unit
let main = do
    println (huge == huge + huge)
    println (tiny == 0.0)
-- STATUS(a0497523): FAIL — no diagnostic at all: 1e309 silently denotes Infinity and 1e-324 silently denotes 0.0 (the stdout asserts themselves hold)
