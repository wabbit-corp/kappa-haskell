-- DX EXPECTATION — §12.2.1, §31.2, §28.2, §12.1.1: a subst motive
-- written as a named type-level function with an ERASED index binder,
-- `VecIntA : (0 i : Nat) -> Type`, should be accepted: the only
-- occurrence of i is inside the Type-valued body `Vec i Int`, and
-- types are erased (§31.2) — there is no runtime use to charge
-- against quantity 0.  Today it is rejected with
-- E_QTT_ERASED_RUNTIME_USE "erased (quantity 0) binding 'i' is used
-- at runtime (§12.2.1)", while the unrestricted spelling VecIntB is
-- accepted AND coerces to subst's `(parametric 0 z : a) -> Type v`
-- motive classifier.
-- PROMOTED FRICTION (2026-07-25, with the Nat/Fin revision): the
-- classifier spelling that subst's own prelude signature uses must be
-- writable in user code.  The revision writes `parametric` binders into
-- two user-facing canonical declarations — §28.2's
-- `data Refined.{u, v} (0 a : Type u) (parametric 0 predicate : a ->
-- Type v)` and §16.1.9's `trait RefinementView` members — and §16.1.9
-- allows hand-written RefinementView instances, so users must be able
-- to restate those binder shapes.  §12.1.1's shared binder prefixes
-- list `parametric` as an observation mode for signature and lambda
-- binders alike.  Previously `parametric` in a user signature was
-- E_NAME_UNRESOLVED and in a lambda binder a parse error; both
-- spellings are now asserted below (VecIntC, VecIntD, MyRefinedShape).
--! mode check
--! assertNoErrors

module main

data Vec (n : Nat) (a : Type) : Type =
    MkVec

-- erased-index type-level function: rejected today
VecIntA : (0 i : Nat) -> Type
let VecIntA i = Vec i Int

-- control: unrestricted spelling of the same function — accepted
VecIntB : Nat -> Type
let VecIntB i = Vec i Int

-- the prelude's own motive classifier spelling, in a user signature
VecIntC : (parametric 0 i : Nat) -> Type
let VecIntC i = Vec i Int

-- and in a lambda binder
VecIntD : (parametric 0 i : Nat) -> Type
let VecIntD = \(parametric 0 i : Nat) -> Vec i Int

-- restating the canonical §28.2 Refined binder shape in user code
MyRefinedShape : (0 a : Type) -> (parametric 0 p : a -> Type) -> Type
let MyRefinedShape a p = Refined a p
-- STATUS(a0497523): FAIL — expected 0 errors, got 1: VecIntA rejected with E_QTT_ERASED_RUNTIME_USE "erased (quantity 0) binding 'i' is used at runtime (§12.2.1)" even though the only use is in the Type-valued (erased) body; VecIntB accepted
-- (Recorded against the pre-revision file shape, which used a local PNat
-- instead of canonical Nat and did not assert the `parametric` spellings
-- added 2026-07-25.)
