-- DX EXPECTATION (documented twin pair), re-based 2026-07-25 on the Nat/Fin
-- spec revision. The old ADDITIVE TypeLevel/Nat asymmetry this file used to
-- document is DELETED by the revision:
--   * Type (0 + u) / Type (u + 0) / Type (u + v) ~ Type (v + u) still hold
--     definitionally (§11.1.2.4A level normalization) — Level half below;
--   * the identical shapes at a Nat data index are now ALSO accepted:
--     `0 + n = n` is definitional (§28.2 natAdd Zero n -> n plus §31.1.3
--     literal normalization), `n + 0` closes via §15.8.4 monoid
--     normalization + §16.1.8 automatic transport, and `n + m ~ m + n`
--     closes via the required CommutativeAdditiveMonoid Nat instance
--     (§28.2.3) driving a commutative-monoid provider (§15.8.2/§15.8.4);
--     the bridge equalities are IsProp (derive IsSet Nat, §28.2), so the
--     §16.1.8 runtime-relevance gate passes.
-- The one SURVIVING asymmetry is multiplicative, and only because the Level
-- half cannot even be stated (no Mul TypeLevel exists): at Nat, §15.8.4 says
-- "Neither `Semiring` nor `Ring` permits reordering multiplicative factors"
-- and no commutative-multiplication law bundle is required by §28.2.3, so
-- `Vec (n * m) -> Vec (m * n)` remains kappa.type.mismatch. The asserted DX
-- ask: that surviving mismatch should tell the user the identity needs a
-- propositional proof plus subst (§11.4.1) — the transport route that DOES
-- typecheck — instead of a bare mismatch (assertDiagnosticMatch below).
-- (TypeLevel is an ordinary std.prelude Types export per §28.2, so no
-- import is needed for the Level half.)
--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.type.mismatch
--! assertDiagnosticMatch propositional proof
module main

-- Level half: the additive identities collapse definitionally (§11.1.2.4A).
idAt : (u : TypeLevel) -> (A : Type u) -> A -> A
let idAt u A x = x

levelPlusZeroR : (u : TypeLevel) -> (A : Type (u + 0)) -> A -> A
let levelPlusZeroR u A x = idAt u A x

levelPlusZeroL : (u : TypeLevel) -> (A : Type (0 + u)) -> A -> A
let levelPlusZeroL u A x = idAt u A x

levelComm : (u : TypeLevel) -> (v : TypeLevel) -> (A : Type (u + v)) -> A -> A
let levelComm u v A x = idAt (v + u) A x

-- Nat half: the same additive shapes at a Nat data index are now accepted.
data Vec (n : Nat) : Type =
    MkVec : Vec n

-- accepted: §15.8.4 monoid normalization + §16.1.8 inserted transport
castPlusZeroR : (0 n : Nat) -> Vec (n + 0) -> Vec n
let castPlusZeroR n x = x

-- accepted: definitional (§28.2 left recursion + §31.1.3 literals)
castPlusZeroL : (0 n : Nat) -> Vec (0 + n) -> Vec n
let castPlusZeroL n x = x

-- accepted: required CommutativeAdditiveMonoid Nat provider (§28.2.3,
-- §15.8.2/§15.8.4) + §16.1.8 inserted transport
castComm : (0 n : Nat) -> (0 m : Nat) -> Vec (n + m) -> Vec (m + n)
let castComm n m x = x

-- Surviving asymmetry: multiplicative reordering is NOT in the required
-- fragment (§15.8.4; no commutative-multiplication bundle in §28.2.3),
-- so this stays a mismatch — and should carry the propositional-proof
-- + subst hint asserted above.
castMulComm : (0 n : Nat) -> (0 m : Nat) -> Vec (n * m) -> Vec (m * n)
let castMulComm n m x = x                --!! kappa.type.mismatch
