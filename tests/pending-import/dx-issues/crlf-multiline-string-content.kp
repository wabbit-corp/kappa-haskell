--! mode run
--! assertNoErrors
--! assertStdout "LF-CLEAN\n"

-- DX EXPECTATION, not necessarily spec-required (the spec, Section 5 /
-- Section 5.4, is silent on source line terminators): a CRLF-encoded file
-- should denote the same program as its LF equivalent. The implementation
-- already accepts CRLF everywhere in Section 5.4 layout (CR is skipped in
-- indentation and between tokens), but multiline-string bodies (Section
-- 6.3.3) keep the raw CR bytes: with a flush-left closing delimiter this
-- string's content silently becomes "\r\nab\r\n" (a phantom blank first
-- line plus a CR after every content line) instead of "ab\n", so the same
-- program means different strings depending on line-ending convention.
-- Every line of THIS file ends with CRLF.

module main

sample : String
let sample = """
ab
"""

main : UIO Unit
let main = println (if sample == "ab\n" then "LF-CLEAN" else "DIRTY")
-- STATUS(a0497523): FAIL — multiline string in a CRLF file keeps raw CRs plus a phantom leading line: content is "\r\nab\r\n", program prints DIRTY instead of LF-CLEAN
