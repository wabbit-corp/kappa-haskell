--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_NAMED_ARG_MISSING
-- DX expectation (SHOULD-level, §3.1.10 "root causes over cascade
-- failures" / "domain-specific diagnostics over generic type mismatch
-- diagnostics" and §3.1.11 root-cause suppression), not a hard spec MUST:
-- a named constructor application that omits a required field should
-- produce ONE diagnostic, the domain-specific E_NAMED_ARG_MISSING
-- (kappa.constructor.arity).  The partially-applied value's follow-on
-- generic mismatch "(y : Integer) -> P vs P" is fully explained by the
-- missing argument and should be suppressed into that record (or not
-- emitted), not surfaced as an independent second error.
--
-- Today the same single mistake yields TWO errors in two families:
--   E_NAMED_ARG_MISSING (kappa.constructor.arity) at the application, and
--   E_TYPE_EQUALITY_MISMATCH (kappa.type.mismatch) "actual:
--   (y : Integer) -> P / expected: P" at the same expression —
-- while the positional-arity route (MkP 1 2 3) reports exactly one
-- E_CONSTRUCTOR_ARITY_MISMATCH.  The named route should not be noisier
-- than the positional route for the same class of mistake.
module main

data P : Type = MkP (x : Integer) (y : Integer)

v : P
let v = MkP { x = 1 } --!! E_NAMED_ARG_MISSING
-- STATUS(a0497523): FAIL — two errors: E_NAMED_ARG_MISSING plus an unsuppressed cascade E_TYPE_EQUALITY_MISMATCH ((y : Integer) -> P vs P) from the same missing field
