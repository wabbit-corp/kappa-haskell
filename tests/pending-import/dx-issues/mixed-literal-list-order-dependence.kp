-- DX / §6.1.5 × §11.1.3: with no annotation, the two spellings
-- `[2.5, 1]` and `[1, 2.5]` constrain ONE element metavariable with
-- FromFloat (from 2.5) and FromInteger (from 1); both constraint sets
-- are identical, so both lists should elaborate to the same type.
-- Today the outcome depends on ELEMENT ORDER: `[2.5, 1]` type-checks
-- as List Float (2.5 defaults to Float, then FromInteger Float admits
-- 1), while `[1, 2.5]` is rejected (1 is eagerly defaulted to Integer
-- mid-inference, then E_NUMERIC_LITERAL_DOMAIN_MISMATCH "expected
-- Integer but found a float literal"). §6.1.5 says the default "is
-- applied after all type inference completes on the enclosing
-- declaration" — the eager per-element commitment contradicts that
-- timing, and the spec never resolves which per-literal default wins
-- when one variable carries both. DX expectation pinned: both orders
-- agree, at the type that keeps every constraint satisfiable
-- (List Float).
--! mode check
--! assertNoErrors
--! assertType floatFirst (List Float)
--! assertType intFirst (List Float)

module main

let floatFirst = [2.5, 1]

let intFirst = [1, 2.5]
-- STATUS(a0497523): FAIL — [2.5, 1] : List Float accepted but [1, 2.5] rejected with E_NUMERIC_LITERAL_DOMAIN_MISMATCH "expected Integer but found a float literal" (first element eagerly defaulted mid-inference)
