-- CONFORMANCE GAP (§16.4.1, §17.1.7, §30.2.7; re-based 2026-07-25 on the
-- Nat/Fin revision — this used to be filed as "at minimum a spec
-- ambiguity", which is no longer true): unique-remaining constructor
-- narrowing must count index-refuted constructors as already excluded.
-- §30.2.7 now defines the four-way ConstructorCompatibility judgment:
-- comparing Never's result Choice False with the demanded Choice True is
-- settled by no-confusion/family-argument refutation as an explicit
-- `Refuted incompatibilityProof` (rule 3), and a Refuted constructor
-- contributes Empty to reachability. At Choice True the visible set is
-- {Always, Also, Never} with Never Refuted; ruling out Always via a
-- failed is-test (or a residual catch-all, §17.1.7) therefore leaves
-- exactly one reachable constructor, Also, and the §16.4.1 narrowing
-- MUST ("proves LacksCtor for all but one visible constructor") must
-- derive HasCtor Also so c.size projects. Rejecting here is also
-- inconsistent with the same compiler's own index-aware exhaustiveness,
-- which already accepts matches on Choice True that omit Never.
--
-- CURRENTLY (a0497523): both projections fail with E_UNRESOLVED_MEMBER
-- (receiver type: Choice True) — narrowing only counts explicit LacksCtor
-- facts, so two constructors "remain" and no HasCtor is derived.
--! mode check
--! assertNoErrors
module main

data Choice (flag : Bool) : Type =
    Always : (size : Int) -> Choice True
    Also : (size : Int) -> Choice True
    Never : Choice False

-- EXPECTED: else side derives HasCtor Also (Never is index-refuted).
narrowTrim : Choice True -> Int
let narrowTrim c =
    if c is Always then c.size else c.size

-- EXPECTED: residual branch after the unguarded Always arm likewise.
narrowTrimMatch : Choice True -> Int
let narrowTrimMatch c =
    match c
    case Always s -> s
    case _ -> c.size
