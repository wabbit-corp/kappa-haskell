data UCode.{u} : Type (succ u) =
    BaseU (ordinary 0 A : Type u)
    NestU
        (ordinary 0 v : TypeLevel)
        (@0 lower : v <= u)
        (inner : UCode.{v})
        (sample : UEl.{v} inner)

UEl.{u} : UCode.{u} -> Type u
let UEl code decreases structural code =
    match code
    case BaseU A -> A
    case NestU v inner sample -> UEl inner
