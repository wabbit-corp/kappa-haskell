even : Nat -> Bool
let even n decreases structural n =
    match n
    case Zero ->
        True
    case Succ k ->
        odd k

odd : Nat -> Bool
let odd n decreases structural n =
    match n
    case Zero ->
        False
    case Succ k ->
        even k

