data Code : Type =
    NatCode
    NestedPi
        (a : Code)
        (b : decode a -> Code)
        (c : (x : decode a) -> decode (b x) -> Code)

decode : Code -> Type
let decode code decreases structural code =
    match code
    case NatCode ->
        Nat
    case NestedPi a b c ->
        (x : decode a) ->
        (y : decode (b x)) ->
        decode (c x y)

