data Repeat (n : Nat) (0 a : Type) : Type =
    MkRepeat (values : List a)

data Code : Type =
    NatCode
    VectorCode
        (element : Code)
        (payload : Repeat (arity element) (decode element))

arity : Code -> Nat
let arity code decreases structural code =
    match code
    case NatCode -> Succ Zero
    case VectorCode element payload -> Succ (arity element)

decode : Code -> Type
let decode code decreases structural code =
    match code
    case NatCode -> Nat
    case VectorCode element payload -> List (decode element)

