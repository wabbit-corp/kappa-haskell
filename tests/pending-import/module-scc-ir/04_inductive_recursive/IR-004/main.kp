data BoxCode : Type =
    NatBox
    Nested
        (inner : BoxCode)
        (sample : interpret inner)

interpret : BoxCode -> Type
let interpret code decreases structural code =
    match code
    case NatBox ->
        Nat
    case Nested inner sample ->
        interpret inner

