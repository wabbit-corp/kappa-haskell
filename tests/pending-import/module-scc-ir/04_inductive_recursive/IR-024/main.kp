level : Code -> TypeLevel
let level code =
    0

data Code : Type =
    NatCode
    Bad (inner : Code) (value : decode inner)

decode : (code : Code) -> Type (level code)
let decode code decreases structural code =
    match code
    case NatCode -> Nat
    case Bad inner value -> decode inner

