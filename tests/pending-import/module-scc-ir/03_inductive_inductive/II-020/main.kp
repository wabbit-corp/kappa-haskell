data Ctx : Type =
    Empty
    Extend (ctx : Ctx) (ty : Ty ctx)

data Ty (ctx : Ctx) : Type =
    Base : Ty Empty
    Lift
        (parent : Ctx)
        (ty : Ty parent) :
        Ty (Extend parent ty)

