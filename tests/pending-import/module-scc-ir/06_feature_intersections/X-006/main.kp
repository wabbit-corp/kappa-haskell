data Code : Type =
    NatCode
    PiCode
        (domain : Code)
        (codomain : decode domain -> Code)

decode : Code -> Type
let decode code decreases structural code =
    match code
    case NatCode ->
        Nat
    case PiCode domain codomain ->
        (x : decode domain) -> decode (codomain x)
natPi : Code
let natPi =
    PiCode { domain = NatCode, codomain = \_ -> NatCode }

