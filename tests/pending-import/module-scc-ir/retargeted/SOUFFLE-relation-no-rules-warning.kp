-- Retargeted from tests/conformance/spec-coverage/declarations/SOUFFLE-relation-no-rules-warning.kp (Spec 107 module-SCC/induction-recursion revision, 2026-08-01).
-- Comment-only retarget: §9.1 signature/definition pairing is now same-effective-module
-- (either order, possibly cross-fragment), not same-source-file; an unpaired signature is
-- still rejected (§9.2), so the directives are unchanged.
--
-- Source issues: souffle-lang/souffle tests/semantic/rule_grounded/rule_grounded.dl
--   (warning: "No rules/facts defined for relation B"),
--   tests/semantic/rule_undeclared_relation/rule_undeclared_relation.dl.
-- Spec: §9.1 ("A non-`expect` top-level term signature declaration MUST be
--   paired with exactly one matching top-level definition in the same
--   effective module under §9.2. The definition may occur before or after
--   the signature and may be contributed by another selected fragment of
--   that module." "Standalone definitionless top-level items MUST use
--   `expect term`."); §9.2 ("A separate signature with no selected matching
--   definition is rejected."). No §3.2 family is standardized for this
--   rejection, so the assertions pin only that compilation fails, with a
--   message shape check.
-- Pins the Kappa analogue of Souffle's declared-but-undefined relation: a
-- top-level signature with no matching definition anywhere in the effective
-- module is an error, not silently abstract.

--! mode check

module main

-- POSITIVE: declared and defined.
implemented : Int -> Int
let implemented x = x + 1

alsoGood : String -> Bool
let alsoGood _ = True

-- NEGATIVE: declaration without a matching definition.
noImpl : Int -> String

-- NEGATIVE: another definitionless signature.
recNoImpl : Nat -> Nat

--! assertErrorCount 2
--! assertDiagnosticMatch signature|definition

