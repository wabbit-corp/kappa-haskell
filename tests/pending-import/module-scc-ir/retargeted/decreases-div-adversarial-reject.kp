-- Retargeted from tests/conformance/recursion/decreases-div-adversarial-reject.kp (Spec 107 module-SCC/induction-recursion revision, 2026-08-01).
-- badMutA/badMutB flip to ACCEPT: their phase-constraint graph {badMutA -> badMutB} is acyclic,
-- so the §15.10 hidden-phase scheme certifies the SCC and §15.11's explicit-decreases minimum
-- acceptance applies (§15.4 discharges the Int non-negative-subset side conditions via the
-- n <= 0 guards). Error count drops from 8 to 6; the six singleton SCCs are still rejected.
-- §15.11: adversarial lookalikes must not be certified as decreasing.
--! assertErrorCount 6
--! assertDiagnostic error E_TERMINATION_UNVERIFIED
module main

data Box : Type = Box Int

boxValue : Box -> Int
let boxValue b = match b case Box x -> x

derive IsSet Box

instance Eq Box =
    let (==) x y = eqInt (boxValue x) (boxValue y)

instance Ord Box =
    let compare x y =
        if ltInt (boxValue y) (boxValue x) then LT
        elif eqInt (boxValue x) (boxValue y) then EQ
        else GT

customOrdFlippedBoundary : Int -> Int
let customOrdFlippedBoundary n decreases n =
    if Box n < Box 2 then 0
    else customOrdFlippedBoundary (divInt n 2)

customCompareMatch : Int -> Int
let customCompareMatch n decreases n =
    match compare (Box n) (Box 2)
    case LT -> 0
    case EQ -> 0
    case GT -> customCompareMatch (divInt n 2)

idInt : Int -> Int
let idInt x = x

helperIdentity : Int -> Int
let helperIdentity n decreases n =
    if n <= 0 then 0
    else helperIdentity (idInt n)

divOne : Int -> Int
let divOne x = divInt x 1

helperDivOne : Int -> Int
let helperDivOne n decreases n =
    if n < 2 then 0
    else helperDivOne (divOne n)

badGuardDiv : Int -> Int
let badGuardDiv n decreases n =
    if match compare n 2
       case LT if eqInt 0 0 -> True
       case LT -> False
       case EQ -> True
       case GT -> True
    then addInt 1 (badGuardDiv (divInt n 2))
    else 0

badGuardSub : Int -> Int
let badGuardSub n decreases n =
    if match compare n 1
       case LT if eqInt 0 0 -> True
       case LT -> False
       case EQ -> True
       case GT -> True
    then addInt 1 (badGuardSub (subInt n 1))
    else 0

-- ACCEPTED under Spec 107 (no error contributed): edge badMutB -> badMutA is visibly strict
-- (guard n <= 0 puts n >= 1 on the recursive branch, so n - 1 >= 0 and n - 1 < n; §15.4),
-- edge badMutA -> badMutB is visibly nonincreasing (equal measure n, n >= 1 provable). The
-- phase-constraint graph {badMutA -> badMutB} is acyclic, so the §15.10 hidden phase
-- (badMutA = 1, badMutB = 0) certifies the SCC; phases are never derived from source order
-- and the implementation MUST NOT break the cycle using declaration order. Both members carry
-- uniform explicit 'decreases n', so §15.11's minimum acceptance makes acceptance mandatory.
badMutA : Int -> Int
badMutB : Int -> Int

let badMutA n decreases n =
    if n <= 0 then 0 else badMutB n

let badMutB n decreases n =
    if n <= 0 then 0 else badMutA (n - 1)

