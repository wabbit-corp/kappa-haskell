-- Retargeted from tests/conformance/spec-coverage/adts/RACKET-data-tree-mutual.kp (Spec 107 module-SCC/induction-recursion revision, 2026-08-01).
-- §9.2 now lets a separate signature and its definition occur in either textual order, and
-- source position never enables or disables recursion — the "preceding signatures" framing
-- is rewritten. This fixture keeps the positive mutual-family coverage focused;
-- non-exhaustive matching is exercised by dedicated diagnostics fixtures.

-- Source: Racket guide data structures, Racket letrec for mutual data types
-- Source tests: racket letrec.rktl (corpus repos/github-racket-racket/tests/pkgs/racket-test-core/tests/racket/letrec.rktl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §10.1 (data declarations), §10.4 (mutually recursive data groups), §9.2/§15 (recursive SCC members need complete explicit signatures, in either textual order)
-- NOTE: overlaps with tests/conformance/data_types/positivity-mutual-accept.kp (mutual data acceptance only)
--
-- Pins: mutually recursive data types (Tree defined via Forest and vice versa)
-- are accepted; mutually recursive consumer functions over them typecheck when
-- each SCC member has a complete explicit signature (separate or complete
-- inline) — per §9.2 the separate signature may appear before or after its
-- definition, and source position does not enable or disable recursion.

--! mode check
--! assertNoErrors

data MTree (0 a : Type) : Type =
    MLeaf
    MNode a (MForest a)

data MForest (0 a : Type) : Type =
    MNil
    MCons (MTree a) (MForest a)

-- POSITIVE: count nodes (mutually recursive functions with complete explicit signatures).
countTree : MTree a -> Int
countForest : MForest a -> Int

let countTree t =
    match t
    case MLeaf       -> 0
    case MNode _ fs  -> 1 + countForest fs

let countForest f =
    match f
    case MNil        -> 0
    case MCons t fs  -> countTree t + countForest fs

maxInt : Int -> Int -> Int
let maxInt x y = if x >= y then x else y

-- POSITIVE: depth of a tree, again through the mutual family.
treeDepth : MTree a -> Int
forestDepth : MForest a -> Int

let treeDepth t =
    match t
    case MLeaf      -> 0
    case MNode _ fs -> 1 + forestDepth fs

let forestDepth f =
    match f
    case MNil       -> 0
    case MCons t fs -> maxInt (treeDepth t) (forestDepth fs)

-- POSITIVE: parametric map over the mutual family.
mapTree : (a -> b) -> MTree a -> MTree b
mapForest : (a -> b) -> MForest a -> MForest b

let mapTree g t =
    match t
    case MLeaf      -> MLeaf
    case MNode x fs -> MNode (g x) (mapForest g fs)

let mapForest g f =
    match f
    case MNil       -> MNil
    case MCons t fs -> MCons (mapTree g t) (mapForest g fs)

sample : MTree Int
let sample = MNode 1 (MCons (MNode 2 MNil) MNil)

counted : Int
let counted = countTree sample

--! assertEval counted 2
