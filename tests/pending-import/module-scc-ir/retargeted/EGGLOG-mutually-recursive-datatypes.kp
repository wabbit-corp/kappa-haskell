-- Retargeted from tests/conformance/imported-anon/EGGLOG-mutually-recursive-datatypes.kp (Spec 107 module-SCC/induction-recursion revision, 2026-08-01).
-- Comments reworded: recursive groups are inferred from module-wide semantic facet dependency
-- SCCs (§9.5), never from source adjacency or signature position (§9.2); outcomes unchanged.
-- Source issues: egraphs-good/egglog #397 (Mutually recursive datatypes),
--   egraphs-good/egglog #664 (datatype* with mutually recursive families).
-- Spec: data_types.data_declarations (§10.1),
--       data_types.well_formedness (§10.4 — mutual fixed-point positivity),
--       see also EGGLOG-SA-05 in EGGLOG_SPEC_ADDITIONS.md.
-- Kappa allows mutually recursive data declarations: two or more `data`
-- declarations may reference each other in their constructor signatures and
-- be elaborated together. Egglog gained this feature via `datatype*`; Kappa
-- accepts the same shape natively: the recursive SCC is inferred from
-- module-wide semantic facet dependencies (§9.5), never from source
-- adjacency, and no `and` keyword is required.

module test

--! mode check

-- POSITIVE: mutually recursive data types.
data Expr : Type =
    EVar (s : String)
    EApp (f : Expr) (a : Expr)
    EBlock (b : Block)

data Block : Type =
    BNil
    BCons (e : Expr) (rest : Block)

-- POSITIVE: structurally recursive functions across the mutual group. Both
-- members carry complete explicit signatures as recursive-group members must
-- (§9.2, §9.5.5); where those signatures sit in the module is irrelevant (§9.5).
exprSize : Expr -> Int
blockSize : Block -> Int

let exprSize e =
    match e
    case (EVar _)    -> 1
    case (EApp f a)  -> 1 + exprSize f + exprSize a
    case (EBlock b)  -> blockSize b

let blockSize b =
    match b
    case BNil          -> 0
    case (BCons e r)   -> exprSize e + blockSize r

e1 : Expr
let e1 = EApp (EVar "f") (EBlock (BCons (EVar "x") BNil))

n1 : Int
let n1 = exprSize e1

--! assertNoErrors
--! assertType n1 Int
--! assertType exprSize (Expr -> Int)
--! assertType blockSize (Block -> Int)

-- STATUS(f1e4161b): PASS
