--! mode check
--! assertNoErrors
--! assertType constLeft forall (b : Type) (a : Type). b -> a -> b
--! assertType stay forall (f : (A : Type0) -> Type). f Int -> f Int
--! assertType discard forall (a : Type). a -> Int

-- §11.3.3: implicitly universalized binders are ordered by first
-- left-to-right occurrence in source order (constLeft pins b before a —
-- not alphabetical); each binder's annotation is inferred from its uses
-- (stay pins f : (A : Type) -> Type) and defaults to Type when unconstrained
-- (discard). For instances, elaboration abstracts the ENTIRE instance
-- declaration over the binders before premises and head are checked, so
-- the same 'a' scopes over both premise (Small a) and head (Box a).
module main

constLeft : b -> a -> b
let constLeft x y = x

stay : f Int -> f Int
let stay v = v

discard : a -> Int
let discard v = 0

data Box (a : Type) : Type =
    MkBox a

trait Small t =
    small : t

instance Small Int =
    let small = 0

instance Small a => Small (Box a) =
    let small = MkBox small

useInstance : Box Int
let useInstance = small

