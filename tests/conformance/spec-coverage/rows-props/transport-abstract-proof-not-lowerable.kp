--! mode compile
--! assertErrorCount 1
--! assertDiagnostic error E_PROOF_RELEVANT_TRANSPORT_NOT_LOWERABLE
--! assertDiagnosticFamily error kappa.equality.transport-not-lowerable
--! assertDiagnosticExplainExists E_PROOF_RELEVANT_TRANSPORT_NOT_LOWERABLE

-- §11.4.1: the proof and result are runtime-relevant, but the abstract proof
-- is not definitionally refl and no computational path extension is active.
-- Keep the carrier abstract: Nat has checked IsSet evidence, which makes its
-- equality proofs RuntimeErased under §11.1.6.
module main

data VecB (parametric 0 a : Type) (parametric 0 x : a) : Type =
    MkVecB

castAbs : forall (@0 a : Type) (@0 x : a) (@0 y : a). (p : x = y) -> VecB a x -> VecB a y
let castAbs (@0 a : Type) (@0 x : a) (@0 y : a) (p : x = y) (v : VecB a x) : VecB a y =
    subst @a @(VecB a) @x @y p v
