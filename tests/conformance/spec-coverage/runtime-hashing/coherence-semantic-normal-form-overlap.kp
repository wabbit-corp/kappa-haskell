--! assertNoErrors
--! assertEval use "tag"

-- §33.2.1: in script mode the default coherence_mode is
-- "semantic-if-available". These two instances have DIFFERENT Easy Hashes
-- (ordinary function bodies are not unfolded at the Easy tier, §33.1.1: one
-- body is a literal, the other calls transparent `helper`) but the SAME
-- HardIdentity after full normalization (δ-unfolding `helper`, §33.1.2), so
-- they are extensionally-equal harmless overlap and MUST be accepted, with
-- a deterministic representative selected for `use`.
module main

trait Label (a : Type) =
    label : a -> String

helper : Integer -> String
let helper n = "tag"

instance Label Integer =
    let label n = "tag"

instance Label Integer =
    let label n = helper n

use : String
let use = label 5
