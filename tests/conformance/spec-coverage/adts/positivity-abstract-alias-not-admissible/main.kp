module main

-- §10.4 (L8832-8843): an imported opaque/abstract type constructor whose
-- interface carries NO parameter-positivity signature is not admissible in
-- a strictly positive position. The recursive occurrence of D inside
-- Hidden's argument must therefore be rejected — Hidden MUST NOT be assumed
-- to preserve positivity.
import lib.(type Hidden)

data D : Type =
    MkD (Hidden D)

