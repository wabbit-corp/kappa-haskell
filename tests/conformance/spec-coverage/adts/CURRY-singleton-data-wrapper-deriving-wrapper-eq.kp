-- Source: Curry/KiCS2 testsuite/LanguageTests/TestNewtype.curry
--   (newtype LIST a = LIST [a] deriving (Eq, Read, Show); testReadShowNT).
-- Spec: §10.1 (`data` declarations: a Curry newtype is a
--       single-constructor single-field data declaration), §18 (`Eq`
--       trait: `IsSet a` supertrait plus required `eqSound`/`eqComplete`
--       members), §14.3.4 (missing associated static members fail
--       instance checking), §14.5.1 (derived `IsSet`/`Eq`).
--
-- *** FLIPPED BY THE NAT/FIN SPEC REVISION — this test was green. ***
-- The old pin accepted `instance Eq IntListW` supplying ONLY `(==)`.
-- New §18 declares
--     trait IsSet a => Eq (parametric 0 a : Type) =
--         (==) ; eqSound ; eqComplete
-- (the old `eqIsSet` member was deleted in favour of the `IsSet a`
-- SUPERTRAIT). An instance supplying only `(==)` therefore fails
-- instance checking per §14.3.4: required associated static members
-- with no default that the instance does not define, and no
-- `IsSet IntListW` evidence in scope for the supertrait.
--
-- The green half of the original Curry pin (equality on wrapped values
-- is equality on their payloads) lives in
-- proofs-deriving-totality/CURRY-singleton-data-wrapper-deriving-derive-eq.kp
-- via `derive Eq`, which per §14.5.1 must synthesize
-- `eqSound`/`eqComplete` through the §10.2.1 no-confusion package and
-- discharge the `IsSet IntListW` supertrait. (§14.5.2
-- `derive RefinementView` is NOT applicable here: the payload field
-- carries no predicate/IsProp evidence fields.)

module test

--! mode check

-- A transparent single-constructor wrapper around `List Int`.
data IntListW : Type =
    MkIntListW (payload : List Int)

-- POSITIVE: the constructor applies as an ordinary function.
wrap : List Int -> IntListW
let wrap xs = MkIntListW xs

--! assertType wrap (List Int -> IntListW)

eqIntList : List Int -> List Int -> Bool
let eqIntList xs ys =
    match (xs, ys)
    case (Nil, Nil) -> True
    case (x :: xr, y :: yr) -> if x == y then eqIntList xr yr else False
    case _ -> False

-- NEGATIVE: a handwritten `Eq` instance that supplies only `(==)` omits
-- the required `eqSound` and `eqComplete` members and discharges no
-- `IsSet IntListW` supertrait, so instance checking fails (§14.3.4:
-- "If a required associated static member has no default and the
-- instance does not define it, instance checking fails").
instance Eq IntListW =
    let (==) a b =
        match a
        case MkIntListW xs ->
            match b
            case MkIntListW ys -> eqIntList xs ys

--! assertErrorCount 1
--! assertDiagnosticMatch eqSound|eqComplete|IsSet|member|instance
