-- Spec: §10.1 (L8342-8360), §10.2 (L8734-8748), §17.2.1. Named constructor
-- patterns nest, and work on GADT constructors whose names come from the Pi
-- signature. Matching VCons on a scrutinee typed Vec (Succ n) a is
-- exhaustive: the VNil result type Vec Zero a is excluded by the family-
-- argument equalities of §10.1.3.

module main

--! mode check

data Inner : Type =
    MkInner (value : Int)

data Outer : Type =
    MkOuter (inner : Inner) (tag : Int)

-- POSITIVE: nested named patterns.
deepValue : Outer -> Int
let deepValue o =
    match o
    case MkOuter { inner = MkInner { value = v } } -> v

deepResult : Int
let deepResult = deepValue (MkOuter (MkInner 42) 0)

data Nat : Type =
    Zero
    Succ (n : Nat)

data Vec (n : Nat) (a : Type) : Type =
    VNil  : Vec Zero a
    VCons : (head : a) -> (tail : Vec n a) -> Vec (Succ n) a

-- POSITIVE: named GADT pattern; VNil branch impossible at index Succ n,
-- so the single case is exhaustive.
headOf : forall (n : Nat) (a : Type). Vec (Succ n) a -> a
let headOf v =
    match v
    case VCons { head = h } -> h

one : Vec (Succ Zero) Int
let one = VCons { head = 7, tail = VNil }

headResult : Int
let headResult = headOf one

--! assertNoErrors
--! assertEval deepResult 42
--! assertEval headResult 7

