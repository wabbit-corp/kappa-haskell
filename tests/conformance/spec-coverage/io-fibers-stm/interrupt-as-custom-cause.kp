--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "as:shed-load:attributed\nforkAs:rebalance:attributed\n"
--! assertExitCode 0

-- §18.1.4: interruptAs / interruptForkAs carry
-- explicit structured interrupt metadata; §18.1.2: InterruptTag.Custom
-- permits library-defined interruption reasons. The custom tag and explicit
-- nonempty attribution MUST be preserved in the target fiber's terminal Exit.
module main

sleeper : UIO Int
let sleeper = do
    sleepFor (seconds 10)
    pure 0

report : String -> Exit Void Int -> UIO Unit
let report label ex = match ex
    case Exit.Success v -> printlnString (label ++ ":completed")
    case Exit.Failure (Cause.Interrupt (InterruptCause (InterruptTag.Custom t) (Some by))) ->
      -- FiberId is opaque in the portable surface, so this pins preservation
      -- of explicit attribution without relying on its hidden representation.
      printlnString (label ++ ":" ++ t ++ ":attributed")
    case Exit.Failure (Cause.Interrupt (InterruptCause (InterruptTag.Custom t) None)) ->
      printlnString (label ++ ":" ++ t ++ ":unattributed")
    case Exit.Failure c -> printlnString (label ++ ":other")

main : UIO Unit
let main = do
    let me <- currentFiberId
    -- interruptAs: waits for termination, custom tag preserved
    let f1 <- fork sleeper
    interruptAs (InterruptCause (InterruptTag.Custom "shed-load") (Some me)) f1
    let e1 <- await f1
    report "as" e1
    -- interruptForkAs: fire-and-forget, custom tag preserved
    let f2 <- fork sleeper
    interruptForkAs (InterruptCause (InterruptTag.Custom "rebalance") (Some me)) f2
    let e2 <- await f2
    report "forkAs" e2
-- STATUS(6c99ee15): PASS
