--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "both-left:1\nthen-first:2\nthen-defect:panic-msg\n"
--! assertExitCode 0

-- §18.1.2: Cause carries parallel (Both) and sequential (Then) composition
-- alongside Fail/Interrupt/Defect. A composite cause survives an
-- unsandbox/sandbox round trip verbatim: unsandbox re-raises it as the
-- runtime cause and sandbox re-exposes the SAME structure in the typed
-- channel, so composite causes are first-class observable values.
module main

composite : Cause Int
let composite =
    Cause.Both (Cause.Fail 1) (Cause.Then (Cause.Fail 2) (Cause.Defect (DefectInfo DefectTag.Panic (Some "panic-msg"))))

sealed : IO (Cause Int) Int
let sealed = throwIO composite

classify : Cause Int -> IO Void Int
let classify c = match c
    case Cause.Both (Cause.Fail a) (Cause.Then (Cause.Fail b) (Cause.Defect (DefectInfo DefectTag.Panic (Some msg)))) -> do
        printlnString ("both-left:" ++ showInt a)
        printlnString ("then-first:" ++ showInt b)
        printlnString ("then-defect:" ++ msg)
        pure 0
    case _ -> do
        printlnString "structure-lost"
        pure 1

main : UIO Unit
let main = do
    let r <- catchIO (sandbox (unsandbox sealed)) classify
    let _ = r
    pure ()
