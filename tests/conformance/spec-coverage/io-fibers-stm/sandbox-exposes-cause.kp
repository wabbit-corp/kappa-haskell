--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "sandbox-fail:boom\nsandbox:interrupt-requested\nchild-continues\nchild:2\n"
--! assertExitCode 0

-- §18.1.2 sandbox: the full terminal Cause (typed Fail AND Interrupt) is
-- exposed in the typed error channel, so sandboxed code MAY discriminate
-- InterruptCause; §18.1.12: recovering from Cause.Interrupt via sandbox
-- consumes the delivered request, so the fiber continues and completes
-- with Success.
module main

failing : IO String Int
let failing = throwIO "boom"

classifyFail : Cause String -> IO Void Int
let classifyFail c = match c
    case Cause.Fail msg -> do
        printlnString ("sandbox-fail:" ++ msg)
        pure 0
    case _ -> do
        printlnString "sandbox-fail:other"
        pure 0

sleepyBody : Promise Void Unit -> UIO Int
let sleepyBody ready = do
    let _ <- completePromise ready (Exit.Success ())
    sleepFor (seconds 10)
    pure 1

recover : Cause Void -> IO Void Int
let recover c = match c
    case Cause.Interrupt (InterruptCause InterruptTag.Requested by) -> do
        printlnString "sandbox:interrupt-requested"
        pure 2
    case _ -> do
        printlnString "sandbox:other-cause"
        pure 3

child : Promise Void Unit -> UIO Int
let child ready = do
    let r <- catchIO (sandbox (sleepyBody ready)) recover
    printlnString "child-continues"
    pure r

main : UIO Unit
let main = do
    -- typed failure exposed as Fail inside the Cause
    let a <- catchIO (sandbox failing) classifyFail
    let _ = a
    -- interruption exposed as Interrupt inside the Cause; recovery consumes
    -- the pending request and the fiber then terminates successfully
    let ready <- newPromise
    let f <- fork (child ready)
    let _ <- awaitPromise ready
    interruptFork f
    let ex <- await f
    match ex
      case Exit.Success v -> printlnString ("child:" ++ showInt v)
      case Exit.Failure c -> printlnString "child:failed"
