--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "success:7\ncaught:boom\ninterrupted:Requested\n"
--! assertExitCode 0

-- §18.1.11 (Spec.md L19194-19196): `blocking body` preserves the typed
-- success, typed failure, and interruption behavior of body — the bridge
-- must not remap outcomes into blocking-specific errors or defects.
module main

failing : IO String Int
let failing = throwIO "boom"

childBody : Promise Void Unit -> UIO Unit
let childBody ready = do
    let _ <- completePromise ready (Exit.Success ())
    blocking (sleepFor (seconds 10))

main : UIO Unit
let main = do
    -- success passes through
    let v <- blocking (pure 7)
    printlnString ("success:" ++ showInt v)
    -- typed failure passes through
    let r <- catchIO (ioBind (blocking failing) (\n -> pure ("unexpected:" ++ showInt n))) (\m -> pure ("caught:" ++ m))
    printlnString r
    -- The interruptible sleep retains its interruption behavior through the
    -- blocking bridge; `blocking` does not make arbitrary calls cancellable.
    let ready <- newPromise
    let f <- fork (childBody ready)
    let _ <- awaitPromise ready
    interrupt f
    let ex <- await f
    match ex
      case Exit.Success u -> printlnString "completed"
      case Exit.Failure (Cause.Interrupt (InterruptCause InterruptTag.Requested by)) -> printlnString "interrupted:Requested"
      case Exit.Failure c -> printlnString "other"
-- STATUS(8c3c7747): PASS — `blocking` preserves success, typed failure, and interruption through an interruptible operation.
