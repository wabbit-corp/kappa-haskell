--! mode run
--! assertNoErrors
--! assertNoWarnings
--! assertStdout "left-mask\ninterrupted:Requested\n"
--! assertExitCode 0

-- §18.1.12: an interruption request suppressed by
-- `uninterruptible` is NOT lost — it remains pending when the body leaves
-- the region and becomes observable at the next interruption point (here
-- the sleep). The tail of the region runs ("left-mask"); the code past the
-- next interruption point does not ("not-reached" never prints).
module main

import std.prelude.(type Exit(..))

body : Promise Void Unit -> Promise Void Unit -> UIO Unit
let body ready go = do
    let _ <- completePromise ready (Exit.Success ())
    let _ <- awaitPromise go
    -- the interrupt request is already pending here; delivery is suppressed
    printlnString "left-mask"

child : Promise Void Unit -> Promise Void Unit -> UIO Unit
let child ready go = do
    uninterruptible (body ready go)
    sleepFor (seconds 10)
    printlnString "not-reached"

main : UIO Unit
let main = do
    let ready <- newPromise
    let go <- newPromise
    let f <- fork (child ready go)
    let _ <- awaitPromise ready
    interruptFork f
    let _ <- completePromise go (Exit.Success ())
    let ex <- await f
    match ex
      case Exit.Success u -> printlnString "completed"
      case Exit.Failure (Cause.Interrupt (InterruptCause InterruptTag.Requested by)) -> printlnString "interrupted:Requested"
      case Exit.Failure c -> printlnString "other"
