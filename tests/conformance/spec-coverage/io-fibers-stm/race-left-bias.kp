--! mode run
--! assertNoErrors
--! assertStdout "tie:left:1\n"

-- §18.1.6 (Spec.md L18981): if both race sides become simultaneously
-- observable as completed with no source-level prior winner, the LEFT side
-- wins. Two already-complete computations (no suspension in either) are the
-- canonical no-prior-winner tie: the result must be LeftWins, never
-- RightWins.
module main

main : UIO Unit
let main = do
    let f <- fork (race (ioPure 1) (ioPure 2))
    let ex <- await f
    match ex
      case Exit.Success r ->
        match r
        case RaceResult.LeftWins v -> printlnString ("tie:left:" ++ showInt v)
        case RaceResult.RightWins v -> printlnString ("tie:right:" ++ showInt v)
      case Exit.Failure c -> printlnString "tie:failed"
