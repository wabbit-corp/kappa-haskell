--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_ERASED_RUNTIME_USE

-- §18.1.17.1: in an abortive operation clause (declared resumption
-- quantity 0), the bound resumption k has quantity 0 and is unusable by
-- the ordinary quantity rules (§12.2); applying k in the clause body is
-- a quantity error (runtime use of a 0-quantity binding).
module main

bad : Int
let bad : Int =
    block
        scoped effect Fail =
            0 raise : Unit -> Int

        let comp : Eff <[Fail : Fail]> Int =
            do
                let x <- Fail.raise ()
                pure x

        let handled =
            deep handle Fail comp with
                case return x -> pure x
                case raise _ k -> k 5

        runPure handled
