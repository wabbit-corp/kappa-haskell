type NatBetween
    (lo : Nat)
    (hi : Nat)
    : Type =
    Refined Nat (\value -> (contains (lo .. hi) value) = True)

--! requires capability symbolicCardinality
--! assertNoErrors
--! assertSymbolicCardinality (if lo <= hi then hi - lo + 1 else 0) for NatBetween lo hi
--! assertOrdinalRepresentation (if lo <= hi then hi - lo + 1 else 0) for NatBetween lo hi
