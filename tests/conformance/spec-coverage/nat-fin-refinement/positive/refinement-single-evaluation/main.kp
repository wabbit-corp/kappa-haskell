type NatBetween
    (lo : Nat)
    (hi : Nat)
    : Type =
    Refined Nat (\value -> (contains (lo .. hi) value) = True)

-- Spec 16.1.9 single evaluation and ownership: base-to-refinement
-- insertion evaluates the source exactly once, binds it to one stable
-- representative when needed, and refers every generated predicate
-- goal and the target construction to that representative. It MUST NOT
-- duplicate, discard, or consume the source beyond what the original
-- expected-type boundary permits. (The quantity boundary itself —
-- a linear source cannot meet the unrestricted base demand of
-- `refine` — is pinned by negative/refined-linear-construction.)
refineOnce :
    (x : Nat) ->
    (@0 inRange : (contains (2 .. 30) x) = True) ->
    NatBetween 2 30

let refineOnce x =
    x

-- The reverse boundary performs exactly one `refinementValue`
-- projection (Spec 16.1.9 case 2), so the round trip observes the
-- original value.
observedOnce :
    Nat

let observedOnce =
    refineOnce 7 @refl

--! assertNoErrors
--! assertEval observedOnce 7
