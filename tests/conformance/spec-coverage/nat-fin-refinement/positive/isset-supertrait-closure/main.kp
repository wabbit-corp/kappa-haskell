-- Spec 14.1 declares `trait IsSet a => Eq (parametric 0 a : Type)`: Eq
-- evidence carries IsSet in its uniquely determined supertrait closure,
-- and supertrait projection from LOCAL evidence yields it
-- (Spec 14.1.4, 14.3.3, 16.3.3 step 1). Projection is evidence
-- projection, not ambient global instance generation, and Spec 28.2
-- requires no `Eq (Option a)` or `Eq (List a)` prelude instances, so
-- the probes bind abstract Eq evidence and project IsSet from it; no
-- global summon appears here.

isSetFromEqOption :
    (@evidence : Eq (Option Bool)) ->
    IsSet (Option Bool)

let isSetFromEqOption @evidence =
    witness

isSetFromEqList :
    (@evidence : Eq (List Bool)) ->
    IsSet (List Bool)

let isSetFromEqList @evidence =
    witness

--! assertNoErrors
