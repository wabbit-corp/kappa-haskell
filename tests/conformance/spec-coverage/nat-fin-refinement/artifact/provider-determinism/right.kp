-- Identical to left.kp except for one unrelated import, which must not
-- change provider selection, certificate content, or semantic identity
-- (Spec 15.8.2). The suite compares canonical proof/certificate body
-- bytes across both independently compiled modules through production
-- KCoreText (docs/NAT-FIN-REFINEMENT-PLAN.md).
import std.hash

public data ProviderCarrier : Type =
    ProviderCarrier

public stable :
    (m : Nat) ->
    (n : Nat) ->
    natAdd m n = natAdd n m

-- summon takes its type argument explicitly (Spec 16.3.3.1); the law
-- member's endpoints are forall (implicit) binders (Spec 28.2.2), so
-- they are supplied with @-arguments.
let stable m n =
    (summon (CommutativeAdditiveMonoid Nat)).addCommutative @m @n
