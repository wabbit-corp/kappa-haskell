--! assertNoErrors
--! assertOrdinalRepresentation 5 for Fin 5
--! assertOrdinalRepresentation 4 for Compass
--! assertOrdinalRepresentation 20 for CompassStep
--! assertExactNaturalRepresentation for Nat
--! assertRefinementRepresentation Nat for NatBetween 2 30
