--! mode check
--! assertNoErrors

-- §16.1.8 proof sources (L16748-16759): the FIRST enumerated transport
-- proof source is "an explicit local or implicit equality proof", and
-- constructor-forced family-argument equalities are another. An erased
-- local proof p : x = y and a ReflT-forced equality must each license
-- the single-replacement transport (shape 1, L16712-16719) of
-- FlagBox x to the demanded FlagBox y.
module main

data FlagBox (b : Bool) : Type =
    MakeFlagBox

needsSame : (@0 b : Bool) -> FlagBox b -> Unit
let needsSame @b (x : FlagBox b) : Unit = ()

-- POSITIVE: explicit erased local equality proof.
viaProof : forall (@0 x : Bool) (@0 y : Bool). (@0 p : x = y) -> FlagBox x -> Unit
let viaProof @x @y @p (box : FlagBox x) : Unit =
    needsSame @y box

data EqT (a : Type) (x : a) (y : a) : Type =
    ReflT : EqT a x x

-- POSITIVE: constructor-forced family-argument equality in the branch.
viaForced : forall (@0 x : Bool) (@0 y : Bool). EqT Bool x y -> FlagBox x -> Unit
let viaForced @x @y (p : EqT Bool x y) (box : FlagBox x) : Unit =
    match p
    case ReflT -> needsSame @y box

-- STATUS(ab0a1126): FAIL — SPEC-CORRECT — viaForced now passes, but viaProof is still rejected with E_APPLICATION_ARGUMENT_MISMATCH at line 21 even though the explicit erased proof p : x = y is the first required §16.1.8 proof source.
