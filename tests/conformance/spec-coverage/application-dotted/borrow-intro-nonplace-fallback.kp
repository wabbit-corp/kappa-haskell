--! mode check
--! assertNoErrors

-- §16.1.7.1 Step 1 (L16451-16461): outermost borrow introduction applies
-- only when the argument is a borrowable place expression (§12.4.2). A
-- non-place argument — a call result or a record literal — skips the
-- borrowed check and elaboration continues to Step 2, whose ordinary
-- check accepts the owned temporary here.
module main

type Holder = (value : Int)

mkHolder : Unit -> Holder
let mkHolder () = (value = 3)

peek : (& h : Holder) -> Int
let peek (& h : Holder) : Int = h.value

-- POSITIVE: call-result argument, not a place; Step 2 accepts it.
fromCall : Int
let fromCall = peek (mkHolder ())

-- POSITIVE: record-literal argument, not a stable place.
fromLiteral : Int
let fromLiteral = peek (value = 4)
