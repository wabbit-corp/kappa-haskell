-- Source: Racket guide apply.scrbl (higher-order functions)
-- Source docs: racket guide apply.scrbl (corpus repos/github-racket-racket/docs/pkgs/racket-doc/scribblings/guide/apply.scrbl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §12.1 (function types), §16.1.7.1 (argument checking), §11.3.3 (implicit universalization), §3.1 (E_APPLICATION_ARGUMENT_MISMATCH), §3.2.3 (kappa.type.mismatch)
--
-- Pins: higher-order functions carry the callback's type in their own type;
-- passing a callback whose function type does not fit the parameter is an
-- argument mismatch, and passing a non-function where a callback is expected
-- is a type mismatch.

--! mode check

-- POSITIVE: map applies a function to each element of a list.
mapList : (a -> b) -> List a -> List b
let mapList f xs =
    match xs
    case Nil    -> Nil
    case h :: t -> f h :: mapList f t

-- POSITIVE: filter retains elements for which the predicate holds.
filterList : (a -> Bool) -> List a -> List a
let filterList p xs =
    match xs
    case Nil    -> Nil
    case h :: t ->
        if p h
        then h :: filterList p t
        else filterList p t

-- POSITIVE: fold reduces a list with a binary function.
foldLeft : (b -> a -> b) -> b -> List a -> b
let foldLeft f acc xs =
    match xs
    case Nil    -> acc
    case h :: t -> foldLeft f (f acc h) t

-- POSITIVE: compose two functions.
composeFn : (b -> c) -> (a -> b) -> a -> c
let composeFn g f x = g (f x)

-- POSITIVE: apply a list of functions to a single value.
applyAll : List (a -> a) -> a -> a
let applyAll fs x =
    match fs
    case Nil     -> x
    case f :: gs -> applyAll gs (f x)

-- POSITIVE: flip argument order of a two-argument function.
flipFn : (a -> b -> c) -> b -> a -> c
let flipFn f b0 a0 = f a0 b0

plusInt : Int -> Int -> Int
let plusInt x y = x + y

summed : Int
let summed = foldLeft plusInt 0 [1, 2, 3]

-- Monomorphic wrappers keep the negative diagnostics deterministic.
mapIntList : (Int -> Int) -> List Int -> List Int
let mapIntList f xs = mapList f xs

filterIntList : (Int -> Bool) -> List Int -> List Int
let filterIntList p xs = filterList p xs

-- NEGATIVE: callback type mismatch — the parameter wants Int -> Int but
-- plusInt is Int -> Int -> Int.
badMap : List Int
let badMap = mapIntList plusInt [1, 2, 3]   --!! E_APPLICATION_ARGUMENT_MISMATCH

-- NEGATIVE: passing a non-function as the callback.
badFilter : List Int
let badFilter = filterIntList 42 [1, 2, 3]   --!! E_TYPE_MISMATCH

--! assertDiagnosticFamily error kappa.type.mismatch
--! assertErrorCount 2
--! assertEval summed 6
-- STATUS(a0497523): PASS
