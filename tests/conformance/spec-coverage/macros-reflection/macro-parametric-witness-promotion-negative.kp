-- §11.1.2.3B + §21.2: macro expansion is not an observation-mode laundering
-- boundary. Splicing generated syntax that denotes parametric A into an
-- ordinary Type result must report the dedicated promotion diagnostic at the
-- user splice/use rather than accept the generated code.
--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_PARAMETRIC_TYPE_PROMOTION
--! assertDiagnosticFamily error kappa.type.parametric-promotion

module main

bad : (A : Type) -> Type
let bad A =
    $(pure '{ A })
