--! mode check
--! assertNoErrors
--! assertNoWarnings

-- §24.9: sameDynRep : forall (@0 a b : Type). DynRep a -> DynRep b ->
-- Dec (a = b). §24.1: checkedCastWith consults exactly this decision,
-- Yes p carrying propositional equality between the represented types.
-- Pins the declared Dec result shape and its Yes/No elimination.
module main

import std.gradual.*

-- Prefix (=) application: semantically the canonical §24.9 type.
sameDynRepDec :
    forall (@0 a : Type) (@0 b : Type).
    DynRep a -> DynRep b -> Dec ((=) a b)
let sameDynRepDec ra rb = sameDynRep ra rb

-- The literal canonical spelling from §24.9 (infix = at type endpoints).
sameDynRepDecInfix :
    forall (@0 a : Type) (@0 b : Type).
    DynRep a -> DynRep b -> Dec (a = b)
let sameDynRepDecInfix ra rb = sameDynRep ra rb

decideEq :
    forall (@0 a : Type) (@0 b : Type).
    DynRep a -> DynRep b -> Bool
let decideEq ra rb =
    match sameDynRep ra rb
    case Dec.Yes _ -> True
    case Dec.No _ -> False

-- Consume the equality carried by Dec.Yes rather than merely inspecting
-- its constructor. The proof transports an `a` payload to `b`; Dec.No
-- produces no value. This pins both the result shape and its useful
-- dependent-elimination behavior.
transportIfSame :
    forall (@0 a : Type) (@0 b : Type).
    DynRep a -> DynRep b -> a -> Option b
let transportIfSame ra rb value =
    match sameDynRep ra rb
    case Dec.Yes refl -> Some value
    case Dec.No _ -> None

--! assertType transportIfSame (forall (@0 a : Type) (@0 b : Type). DynRep a -> DynRep b -> a -> Option b)

