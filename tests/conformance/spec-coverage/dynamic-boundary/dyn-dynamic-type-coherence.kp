--! mode check
--! assertNoErrors
--! assertNoWarnings

-- §24.3: multiple coherent DynamicType a instances in one effective
-- instance environment MUST produce extensionally equivalent
-- representations for purposes of sameDynRep. Pins the canonical
-- observation vocabulary: comparing the dynRep members of two evidences
-- for the SAME type yields Dec (a = a) (§24.9), and packing with one
-- evidence's rep while casting with the other's is Result CastBlame a.
module main

import std.gradual.*

observeCoherence :
    forall (@0 a : Type).
    (@d1 : DynamicType a) ->
    (@d2 : DynamicType a) ->
    Bool
let observeCoherence (@d1 : DynamicType a) (@d2 : DynamicType a) =
    match sameDynRep d1.dynRep d2.dynRep
    case Dec.Yes _ -> True
    case Dec.No _ -> False

-- Cross-instance round-trip: extensional equivalence means a payload
-- packed under one evidence's representation is castable under the
-- other's (§24.1 semantics of checkedCastWith).
crossCast :
    forall (@0 a : Type).
    (@d1 : DynamicType a) ->
    (@d2 : DynamicType a) ->
    a -> Result CastBlame a
let crossCast (@d1 : DynamicType a) (@d2 : DynamicType a) x =
    checkedCastWith d2.dynRep (toDynWith d1.dynRep x)

-- Preserve both observations instead of discarding them: a coherent pair
-- must take the Some branch, whose payload is the cross-evidence cast. A
-- future runtime instantiation can therefore distinguish an incoherent No
-- result from a successful coherent round trip without changing this API.
coherenceProbe :
    forall (@0 a : Type).
    (@d1 : DynamicType a) ->
    (@d2 : DynamicType a) ->
    a -> Option (Result CastBlame a)
let coherenceProbe (@d1 : DynamicType a) (@d2 : DynamicType a) x =
    match sameDynRep d1.dynRep d2.dynRep
    case Dec.Yes refl ->
        Some (checkedCastWith d2.dynRep (toDynWith d1.dynRep x))
    case Dec.No _ -> None

--! assertType coherenceProbe (forall (@0 a : Type). (@d1 : DynamicType a) -> (@d2 : DynamicType a) -> a -> Option (Result CastBlame a))

