-- spaces-then-tabs case: indentation "  \t\t" must be reported at the
-- FIRST tab (line 15, column 3) -- not at the line start, not at the
-- second tab, and not at the first non-blank token.

module main

main : UIO Unit
let main = do
  		printInt 1
