-- §19.3/§19.2: error-side exhaustiveness of `try match` is exactly that of
-- `try`'s except clauses. When MonadError.Error m is a closed data type, the
-- except patterns are checked like an ordinary match over that type; covering
-- only some constructors with no catch-all is rejected.
--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_PATTERN_NON_EXHAUSTIVE
module main

data MyErr : Type =
    ErrA
    ErrB

risky : IO MyErr Int
let risky = raise ErrA

-- POSITIVE: except arms cover the closed error type.
good : IO MyErr Int
let good = do
    try match risky
      case n -> pure n
      except ErrA -> pure 0
      except ErrB -> pure 1

-- NEGATIVE: ErrB is not covered and there is no catch-all.
bad : IO MyErr Int
let bad = do
    try match risky --!! E_PATTERN_NON_EXHAUSTIVE
      case n -> pure n
      except ErrA -> pure 0
-- STATUS(a0497523): PASS
