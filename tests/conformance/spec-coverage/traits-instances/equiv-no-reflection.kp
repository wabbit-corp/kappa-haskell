--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.type.mismatch

-- §14.1.1 + §16.3.3 step 5: `Eq` is reflective decidable observational
-- identity — §14.1.1 declares `trait IsSet a => Eq` with required
-- `eqSound`/`eqComplete` proof members, and §16.3.3 step 5 reflects
-- `(x == y) = True` into `x = y` only through `Eq.eqSound`. `Equiv` is a
-- NON-reflecting boolean equivalence: "The compiler never synthesizes
-- `x = y` from `(x ~= y) = True`. Only `Eq` supports equality reflection;
-- `Equiv` does not." The hand-written PropEq below mirrors the normative
-- Eq shape so the positive half is independent of the shipped prelude;
-- the prelude-Eq member probes (eqSound at Int, IsSet-supertrait
-- projection, the removed eqIsSet member) are pinned by
-- tests/conformance/spec-coverage/nat-fin-refinement/negative/
-- eq-reflection-equiv-boundary. The negative half shows Equiv evidence
-- grants no derivation.
module main

-- A proof-carrying equality trait in the §14.1.1 Eq mold.
trait PropEq (a : Type) =
    peq : a -> a -> Bool
    peqSound : (x : a) -> (y : a) -> (p : (=) (peq x y) True) -> (=) x y

-- POSITIVE: reflection through the required proof member typechecks.
reflects : (@d : PropEq Int) -> (x : Int) -> (y : Int) -> (p : (=) (d.peq x y) True) -> (=) x y
let reflects (@d : PropEq Int) x y p = d.peqSound x y p

-- NEGATIVE: prelude Equiv carries only the boolean (~=); a proof of
-- (x ~= y) = True MUST NOT yield x = y. `refl` checks at x = x only, and
-- no compiler rule may close the gap from the Equiv hypothesis.
noReflect : (x : Int) -> (y : Int) -> (p : (=) (x ~= y) True) -> (=) x y
let noReflect x y p = refl --!! kappa.type.mismatch

