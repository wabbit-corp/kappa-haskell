-- Source: nim-lang/Nim#15251, nim-lang/Nim#9156, nim-lang/RFCs#346.
-- Spec: §14.3.1 and §16.3.3 (all demanded constraints must resolve),
--       §3.2.4 (kappa.implicit.unsolved).
-- Resolving the higher-kinded Container premise does not discharge an
-- independent Printable premise for the element type.

module test

--! mode check

trait Container (parametric 0 f : (parametric 0 a : Type) -> Type) =
    empty : forall (a : Type). f a
    insert : forall (a : Type). a -> f a -> f a
    toList : forall (a : Type). f a -> List a

data List (a : Type) : Type =
    Nil
    Cons a (List a)

instance Container List =
    let empty = Nil
    let insert x xs = Cons x xs
    let toList xs = xs

trait Printable (a : Type) =
    prettyPrint : (& x : a) -> String

instance Printable Int =
    let prettyPrint _ = "<int>"

printAndInsert :
    forall (f : (parametric 0 x : Type) -> Type) (a : Type).
    Container f => Printable a => a -> f a
let printAndInsert x =
    let _ = prettyPrint x in
    insert x empty

badBool : List Bool
let badBool = printAndInsert True  --!! kappa.implicit.unsolved

--! assertDiagnosticFamily error kappa.implicit.unsolved
--! assertErrorCount 1

-- STATUS(a0497523): PASS
