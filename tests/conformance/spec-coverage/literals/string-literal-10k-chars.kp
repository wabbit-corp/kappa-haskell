--! mode run
--! assertNoErrors
--! assertStdout "True\nTrue\nTrue\n"

-- SPEC COVERAGE (robust literals): a 10,000-character string literal
-- on a single source line. Spec 6.3.1 places no length limit on basic
-- string literals; Spec 6.3.6: String is immutable UTF-8 text whose
-- unit-named counts must be exact, so byteLength = scalarCount = 10000
-- for this ASCII payload, and Eq String compares the exact scalar
-- sequence, so the literal equals the append of its two 5000-char
-- halves written as separate literals.

import std.unicode.*

s : String
let s = ""

main : UIO Unit
let main = do
    println (byteLength s == 10000)
    println (scalarCount s == 10000)
    println (s == stringAppend "" "")
-- STATUS(a0497523): PASS
