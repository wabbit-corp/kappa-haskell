--! mode check
--! assertDiagnostic error E_UNEXPECTED_INDENTATION

-- §5.4 continuation regions: after `let x =` ends its line, the first
-- significant physical line MUST have indentation strictly greater than
-- the anchor (the indentation of the first token of the continued
-- construct). A continuation line at exactly the anchor indentation is
-- rejected as unexpected indentation (recovery diagnostics may follow).

module main

main : UIO Unit
let main = do
    let x =
    4
    printInt x

