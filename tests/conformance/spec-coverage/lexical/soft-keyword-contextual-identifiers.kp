--! mode run
--! assertNoErrors
--! assertStdout "42\n11\n5\n13\n"

-- §5.2: keywords are soft/contextual — implementations must permit
-- their use as ordinary identifiers where a keyword is not
-- syntactically expected. Pins the spec's own `let type = 42` example
-- plus `effectLabel` (special only as a kind-qualified/import-export
-- selector) and `intrinsic` (special only in intrinsic-trait
-- declarations), each as a do-local binder and as a parameter binder.

module main

addUp : Integer -> Integer -> Integer
let addUp effectLabel intrinsic = effectLabel + intrinsic

main : UIO Unit
let main = do
    let type = 42
    println type
    let effectLabel = 11
    println effectLabel
    let intrinsic = 5
    println intrinsic
    println (addUp 6 7)

