--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_PARAMETRIC_TYPE_PROMOTION
--! assertDiagnosticFamily error kappa.type.parametric-promotion

type AnyTypeWitness : Type =
    (ordinary 0 level : TypeLevel,
     T : Type level)

bad :
    (p : AnyTypeWitness) ->
    Type p.level

let bad p =
    p.T
