-- §30.2.0: a parametric dependency whose checked result classifier does not
-- carry it must remain visible when that result reaches an ordinary sink.
module main

consumeType : (ordinary T : Type) -> Int
let consumeType T = 0

bad : (A : Type) -> (f : forall B. Type) -> Int
let bad A f = consumeType (f @A)

--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_PARAMETRIC_TYPE_PROMOTION
--! assertDiagnosticFamily error kappa.type.parametric-promotion
