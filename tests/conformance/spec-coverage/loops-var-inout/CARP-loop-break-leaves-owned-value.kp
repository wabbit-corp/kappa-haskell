--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.quantity.positive-lower-bound

-- Source issue: carp-lang/Carp#1052
-- Spec: §18.6 (bindings introduced inside loops: a loop-local 1/>=1 binding
--       cannot be skipped by `continue` or `break`),
--       §12.2.5, §3.2.5 (kappa.quantity.positive-lower-bound)
-- Carp #1052: `break` was invisible to memory management, leaking a value
-- allocated in the loop body.  The portable Kappa obligation is that every
-- exit path from the binding's scope — `break` included — must discharge a
-- loop-local linear binding's positive lower bound.
-- NOTE: overlaps with tests/conformance/spec-coverage/loops-var-inout/loop-local-gte1-break-return-skip.kp
--       (that file pins the >=1 case; this one pins the linear-payload case).
module main

data Buf : Type = Buf (n : Int)

consumeBuf : (1 b : Buf) -> Int
let consumeBuf (1 b : Buf) : Int =
    match b
    case Buf n -> n

-- POSITIVE: the linear allocated in the loop body is consumed before the
-- early exit; every path leaving the binding's scope discharges it.
loopOk : Bool -> UIO Unit
let loopOk (cond : Bool) : UIO Unit =
    do
        while cond do
            let 1 b = Buf 2
            let _ = consumeBuf b
            break
        pure ()

-- NEGATIVE: the loop body allocates a linear `b` and early-exits with
-- `break` before consuming it; the break path leaves the positive
-- lower-bound obligation unsatisfied.
loopLeak : Bool -> UIO Unit
let loopLeak (cond : Bool) : UIO Unit =
    do
        while cond do
            let 1 b = Buf 1 --!! kappa.quantity.positive-lower-bound
            break
        pure ()

-- STATUS(a0497523): PASS
