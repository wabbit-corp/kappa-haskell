--                   (accepted form: fallback branch exits via return)
-- Source tests: corpus repos/github-hylo-lang-hylo/tests/Tests/HyloTests/TestCases/TypeChecking/ConditionalBinding.hylo (restored 2026-06-11 from HYLO_ISSUE_IMPORT_PLAN.md)
-- Spec: §18.2.1 ("failExpr is an explicit abrupt-control do-item (`return`,
--       `break`, or `continue`)"), §18.5
-- Pins: the abrupt-control form of the let-else failure arm: `else _ ->
-- return 0` exits the enclosing named function, and the success binder is in
-- scope for the remaining do-items.

--! mode run
--! assertNoErrors
--! assertStdout "3\n0\n"

module main

parseOrReturn : Option Int -> UIO Int
let parseOrReturn opt = do
    let? Some n = opt
    else _ -> return 0
    pure (n + 1)

main : UIO Unit
let main = do
    let a <- parseOrReturn (Some 2)
    println a
    let b <- parseOrReturn None
    println b
-- Promotion restored after workspace reconciliation.
-- STATUS(2a161551): FAIL — promoted conformance regression: the permitted abrupt `let?` failure arm parses `return` as an unresolved expression name instead of a §18.2.1 do-item.
