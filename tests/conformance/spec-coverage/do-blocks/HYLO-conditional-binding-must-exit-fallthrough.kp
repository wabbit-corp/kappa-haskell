-- Spec: §18.2.1 ("the failure arm is terminal and is accepted only in one of
--       the following two forms": an abrupt-control do-item, or an expression
--       of type `m Void`), §3.2.3
-- Pins: Hylo's conditional binding maps to Kappa `let? ... else`. A failure
-- arm that produces an ordinary value at the block's result type falls
-- through past the binding point and MUST be rejected: `pure 42 : UIO Int`
-- is neither abrupt control nor `m Void`.

--! mode check

module main

badLetElse : Option Int -> UIO Int
let badLetElse opt = do
    let? Some n = opt
    else _ -> pure 42    --!! E_TYPE_EQUALITY_MISMATCH
    pure n

--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.type.mismatch
-- Promotion restored after workspace reconciliation.
-- STATUS(2a161551): FAIL — promoted conformance regression: the compiler accepts `pure 42 : UIO Int` as a fallthrough failure arm even though §18.2.1 requires abrupt control or `m Void`.
