-- §17.1.3 (Spec L17835-L17847): a constructor test whose discriminating
-- scrutinee is available only at quantity 0 is a compile-time error unless
-- the constructor shape is forced by non-erased information. With an
-- abstract GADT index, neither constructor is forced, so both `match` and
-- `if e is C` on the erased scrutinee must be rejected.

--! mode check

data PNat : Type =
    Z
    S PNat

data Natural (n : PNat) : Type =
    Zero : Natural Z
    Succ : (pred : Natural n) -> Natural (S n)

-- POSITIVE control: a non-erased scrutinee of the same type matches freely.
isZeroVisible : Natural n -> Bool
let isZeroVisible v =
    match v
    case Zero -> True
    case Succ p -> False

-- NEGATIVE: `n` is abstract, so the erased scrutinee could be either
-- constructor; the match needs runtime constructor shape.
isZeroErased : (0 v : Natural n) -> Bool
let isZeroErased v =
    match v
    case Zero -> True
    case Succ p -> False

-- NEGATIVE: §17.1.3 applies equally to the `if e is C` form.
testErased : (0 v : Natural n) -> Bool
let testErased v =
    if v is Zero then True else False

--! assertDiagnosticFamily error kappa.quantity.unsatisfied
--! assertErrorCount 2

-- STATUS(a51e1bf): PASS
