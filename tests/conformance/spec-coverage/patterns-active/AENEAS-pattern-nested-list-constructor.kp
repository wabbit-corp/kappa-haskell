-- Source issues: AENEAS-161, AENEAS-30 (background context only).
-- Spec: §17.2.1 and §17.2.2 (nested and infix constructor patterns),
--       plus §17.1 (`match`).
-- Aeneas generates nested ADT patterns. This case combines the prefix
-- Option constructor with the infix List constructor.

module test

--! mode check

-- POSITIVE: matching on a list of Options.
countSomes : forall (a : Type). List (Option a) -> Int
let countSomes xs =
    match xs
    case Nil                 -> 0
    case (::) (Some _) t     -> 1 + countSomes t
    case (::) None t         -> countSomes t

--! assertNoErrors

-- Finalized Core reports E_PARAMETRIC_TYPE_PROMOTION for the structurally
-- recursive polymorphic call after syntax/type checking.
-- STATUS(a0497523): FAIL
