-- Stress test: when termination fails, the error span points to the recursive call
-- Spec: §3.2.11 (termination diagnostics), §15.3 (structural descent).

--! mode check

data Nat2 : Type =
    Z
    S Nat2

-- NEGATIVE: bad calls itself with a strictly larger argument; the error must
-- be reported at the specific recursive call site.
bad : Nat2 -> Nat2
let bad n =
    match n
    case Z   -> S Z
    case S m -> bad (S (S m))   --!! kappa.termination.failure

--! assertDiagnosticFamily error kappa.termination.failure

-- Promotion restored after workspace reconciliation.
-- STATUS(2a161551): FAIL — promoted conformance regression: the non-decreasing recursive call receives only W_TERMINATION_UNVERIFIED instead of the required termination error at the call site.
