-- §14.4 (Spec L14890-L14899): `IsTrait t` is COMPILER-ISSUED evidence that
-- t is a trait evidence type; it is synthesized only for well-formed full
-- trait applications, and user source MUST NOT define IsTrait instances.
-- Goals at non-trait types must therefore stay unsolved.
--! mode check
--! assertErrorCount 3
module main

-- NEGATIVE: Int is not a trait application; the goal must be unsolved.
notTrait : IsTrait Int
let notTrait = summon (IsTrait Int) --!! kappa.implicit.unsolved

-- NEGATIVE: List Int is a data type, not trait evidence.
alsoNot : IsTrait (List Int)
let alsoNot = summon (IsTrait (List Int)) --!! kappa.implicit.unsolved

data Tok : Type =
    MkTok

-- NEGATIVE: user-defined IsTrait instances are forbidden (L14893).
instance IsTrait Tok --!! E_INSTANCE_HEAD

