module lib

-- §14.5 (opacity clause) + §14.5.1: deriving may inspect the
-- constructors of an `opaque data` type only where that representation
-- is visible — here, inside the defining module. `derive Eq Secret` is
-- the portable compiler-owned derivation of §14.5.1, so it MUST be
-- accepted here and its exported instance published.
opaque data Secret : Type =
    MkSecret (payload : Int)

mkSecret : Int -> Secret
let mkSecret n = MkSecret n

derive Eq Secret
