-- Source issue: ROSETTE-196 (Unsoundness with quantifiers due to
--                interaction with lexical scope, path conditions, and
--                rewrite rules)
-- Spec: §9.3 (`let ... in`: later bindings shadow, names resolve to the
--       innermost binding), §16.2 (lambdas).
-- Pins: a lambda parameter shadows any outer let binding of the same
-- name; references in the lambda body resolve to the innermost binder;
-- a closure built before a shadowing binding keeps the outer binding it
-- captured. This is the lexical rule Rosette's flow-insensitive rewriter
-- depends on.

--! mode check

module main

-- POSITIVE: the lambda parameter x shadows the outer let-bound x = 5.
shadowLambda : Int
let shadowLambda =
    let
        x = 5
        f = \x -> x + 1
    in f 100

-- POSITIVE: each nested binding shadows the previous one; the innermost
-- wins.
nested : Int
let nested =
    let
        x = 1
    in
        let
            x = 2
        in
            let
                x = 3
            in x

-- POSITIVE: a closure captured before the shadowing binding still sees
-- the outer x.
sibling : Int
let sibling =
    let
        x = 7
        f = \y -> y + x
    in
        let
            x = 99
        in f 1

--! assertNoErrors
--! assertEval shadowLambda 101
--! assertEval nested 3
--! assertEval sibling 8

-- STATUS(a0497523): PASS
