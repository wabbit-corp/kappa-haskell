module main

-- §9.1.1 expanded form: an expanded-form projection MUST have exactly
-- one `place` binder, and each accessor clause kind (get/inout/set/sink)
-- may appear at most once.

type Cell = (value : Int,)

projection twoRoots (place p : Cell) (place q : Cell) : Int = --!! E_PROJECTION_EXPANDED_ACCESSOR_PLACE_BINDER_MISMATCH
    get -> p.value

projection dupGet (place p : Cell) : Int = --!! E_PROJECTION_ACCESSOR_CLAUSE_DUPLICATE
    get -> p.value
    get -> p.value

--! mode check
--! assertErrorCount 2
--! assertDiagnosticCodes E_PROJECTION_EXPANDED_ACCESSOR_PLACE_BINDER_MISMATCH, E_PROJECTION_ACCESSOR_CLAUSE_DUPLICATE
