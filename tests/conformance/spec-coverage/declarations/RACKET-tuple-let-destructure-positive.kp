-- Source: Racket guide define.scrbl (define-values for multiple values),
--         Racket match.scrbl (let-values / destructuring bind)
-- Source docs: racket guide define.scrbl (corpus repos/github-racket-racket/docs/pkgs/racket-doc/scribblings/guide/define.scrbl; restored 2026-06-11 from RACKET_CANDIDATE_LEDGER.md)
-- Spec: §9.1/§9.3 (let pattern bindings), §9.1.2 (tuple patterns of matching arity are irrefutable), §13.2 (tuples are anonymous records)
--
-- Pins: a let binding may destructure a tuple by pattern, both components
-- becoming ordinary bindings; nested/sequential destructuring works; so does
-- destructuring a tuple returned by a function. (Racket's parameter-position
-- destructuring has no Kappa counterpart: §16.2 lambda/function binders admit
-- identifiers and wildcards, not patterns — so those cases bind via let.)

--! mode check

-- POSITIVE: destructure a pair in a let binding.
splitPair : (Int, Int) -> Int
let splitPair p =
    let (a, b) = p
    a + b

-- POSITIVE: destructure nested tuples in sequential bindings.
sumThree : (Int, (Int, Int)) -> Int
let sumThree outer =
    let
        (x, inner) = outer
        (y, z)     = inner
    in
    x + y + z

-- POSITIVE: destructure a nested tuple with one nested pattern.
sumNested : ((Int, Int), (Int, Int)) -> Int
let sumNested q =
    let ((a, b), (c, d)) = q
    a + b + c + d

-- POSITIVE: destructure a tuple returned by a function.
quotRem17by5 : (Int, Int)
let quotRem17by5 = (3, 2)

useQuotRem : Int
let useQuotRem =
    let (q, r) = quotRem17by5
    q + r

splitApplied : Int
let splitApplied = splitPair (1, 2)

nestedApplied : Int
let nestedApplied = sumNested ((1, 2), (3, 4))

threeApplied : Int
let threeApplied = sumThree (1, (2, 3))

--! assertNoErrors
--! assertEval splitApplied 3
--! assertEval nestedApplied 10
--! assertEval threeApplied 6
--! assertEval useQuotRem 5
-- STATUS(a0497523): PASS
