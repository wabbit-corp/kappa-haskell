--! mode run
--! assertNoErrors
--! assertStdout "int 3\nstr hi\nint 3\n"

-- §13.1.3 (Spec.md L12284-L12292): widening from Variant r1 to Variant
-- r2 (every member of r1 in r2) is expected-type-directed and zero-cost:
-- no payload rewrite or row-relative retagging. Behavioral pin: a value
-- injected at the SMALL union, widened to the BIG union (in a different
-- member order), still selects the branch of its original member type
-- with its payload intact — a re-tagged value would take a wrong branch.
module main

type Small = (| Integer | String |)
type Big = (| Bool | String | Integer |)

describe : Big -> String
let describe v =
    match v
    case (| n : Integer |) -> stringAppend "int " (showInt n)
    case (| s : String |)  -> stringAppend "str " s
    case (| b : Bool |)    -> "bool"

widen : Small -> Big
let widen v = v

viaSmallInt : Small
let viaSmallInt = 3

viaSmallStr : Small
let viaSmallStr = "hi"

main : UIO Unit
let main = do
    printlnString (describe (widen viaSmallInt))
    printlnString (describe (widen viaSmallStr))
    -- widening inserted directly by the argument's expected type
    printlnString (describe viaSmallInt)

