--! mode check
--! assertNoErrors

-- §16.1.8 (Spec.md L20829-L20937) x §13.1.3 (L16294-L16299): composition
-- of member transport and union widening. The argument has type
-- (| FlagBox b | String |) and the parameter demands (| FlagBox True |
-- String | Bool |). Neither rule alone suffices: a transport plan cannot
-- ADD a union member (rows differ by membership, not by a subterm
-- replacement), and §13.1.3 widening needs every member of r1 in r2 by
-- MemberId, which holds only after the branch-bool transport FlagBox b ->
-- FlagBox True. Elaboration composes them (transport the member, then
-- widen). The permuted target checks that the composition also goes
-- through §13.1.1 row equality modulo permutation (L16260-L16263).
module main

data FlagBox (b : Bool) : Type =
    MakeFlagBox

needsBig : (| FlagBox True | String | Bool |) -> Unit
let needsBig (u : (| FlagBox True | String | Bool |)) : Unit = ()

needsBigPermuted : (| Bool | FlagBox True | String |) -> Unit
let needsBigPermuted (u : (| Bool | FlagBox True | String |)) : Unit = ()

useIt : (b : Bool) -> (| FlagBox b | String |) -> Unit
let useIt (b : Bool) (u : (| FlagBox b | String |)) : Unit =
    if b then needsBig u else ()

usePermuted : (b : Bool) -> (| FlagBox b | String |) -> Unit
let usePermuted (b : Bool) (u : (| FlagBox b | String |)) : Unit =
    if b then needsBigPermuted u else ()

