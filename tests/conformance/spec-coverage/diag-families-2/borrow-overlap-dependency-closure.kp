--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.borrow.overlap
-- §3.3.4: the diagnostic MUST say the conflict comes from dependency
-- closure, not direct path equality.
--! assertDiagnosticMatch (depend|closure|overlap)

-- §3.3.4 (spec example, L4163ff): opening `~s.buffer` for update while
-- borrowing `s.len` conflicts through DEPENDENCY CLOSURE — the type of
-- `buffer` (`Vec this.len Byte`) depends on `len`, so their footprints
-- are not disjoint even though the two static paths differ.
module main

data Byte : Type =
    Byte

data Vec (n : Nat) (a : Type) : Type =
    VNil

type Sized : Type = (len : Nat, buffer : Vec this.len Byte)

touch : forall (@0 n : Nat). (inout b : Vec n Byte) -> (& l : Nat) -> UIO (1 b : Vec n Byte,)
let touch @n (inout b : Vec n Byte) (& l : Nat) : UIO (1 b : Vec n Byte,) =
    pure (b = b,)

bad : (1 s : Sized) -> UIO Unit
let bad (1 s : Sized) : UIO Unit = do
    touch ~s.buffer s.len
    pure ()
-- STATUS(a51e1bf): PASS
