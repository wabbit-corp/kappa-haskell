--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_BORROW_OVERLAP
--! assertDiagnosticFamily error kappa.borrow.overlap
--! assertDiagnosticRelated error kappa.borrow.overlap borrow-start
--! assertDiagnosticRelated error kappa.borrow.overlap borrow-conflict

-- Combination (§3.3.4 overlap × §18.6 mutable variables): the var-place
-- facet of a mutable binding participates in footprint overlap checking
-- like any other stable place — two `~p.left` inout arguments of one
-- call conflict by direct path equality even when `p` is a `var`.
-- Positive half: disjoint fields of the same var place are fine.
module main

type Pair = (left : Int, right : Int)

step2 : (inout a : Int) -> (inout b : Int) -> UIO (1 a : Int, 1 b : Int)
let step2 (inout a : Int) (inout b : Int) : UIO (1 a : Int, 1 b : Int) =
    pure (a = b, b = a)

bad : UIO Unit
let bad = do
    var p : Pair = (left = 1, right = 2)
    step2 ~p.left ~p.left
    pure ()

good : UIO Unit
let good = do
    var p : Pair = (left = 1, right = 2)
    step2 ~p.left ~p.right
    pure ()
