--! mode check
--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_BORROW_OVERLAP
--! assertDiagnosticFamily error kappa.borrow.overlap
-- §3.1.1A/§3.3.4: both conflicting footprints MUST be related.
--! assertDiagnosticRelated error kappa.borrow.overlap borrow-start
--! assertDiagnosticRelated error kappa.borrow.overlap borrow-conflict

-- §3.3.4, §18.9.3, §12.4: PREFIX overlap — a whole-record `~p` and a
-- field `~p.left` of the same root in one call conflict, because one
-- footprint is a proper prefix of the other. Positive half: disjoint
-- sibling fields of the same root are fine.
module main

type Pair = (left : Int, right : Int)

bumpBoth : (inout whole : Pair) -> (inout part : Int) -> UIO (1 whole : Pair, 1 part : Int)
let bumpBoth (inout whole : Pair) (inout part : Int) : UIO (1 whole : Pair, 1 part : Int) =
    pure (whole = whole, part = part)

step2 : (inout a : Int) -> (inout b : Int) -> UIO (1 a : Int, 1 b : Int)
let step2 (inout a : Int) (inout b : Int) : UIO (1 a : Int, 1 b : Int) =
    pure (a = b, b = a)

badPrefix : (1 p : Pair) -> UIO Unit
let badPrefix (1 p : Pair) : UIO Unit = do
    bumpBoth ~p ~p.left
    pure ()

goodDisjoint : (1 p : Pair) -> UIO Unit
let goodDisjoint (1 p : Pair) : UIO Unit = do
    step2 ~p.left ~p.right
    pure ()
