-- §16.4.1 × §17.1.2 × §17.1.5 × §30.2.2.11 × §30.2.7 × §10.2.1: for
-- v : Natural (S Z), the else branch of `if v is Succ` holds
-- LacksCtor v ⟨Succ⟩; the only other constructor Zero forces the index
-- equation Z = S Z, which the §10.2.1 generated no-confusion package
-- (constructor disjointness / constructor-result consequences) refutes.
-- Under §30.2.7's four-way ConstructorCompatibility judgment that is
-- rule 3: "A supported no-confusion rule or the required
-- arithmetic/index solver may instead produce a checked refutation of
-- the required bridge. This yields Refuted", and "Refuted contributes
-- Empty". Combined with the branch's LacksCtor Succ the whole remainder
-- is empty, so `match v case impossible` in the else branch MUST be
-- accepted; "contradictory refinement contexts mark the branch
-- unreachable" (§30.2.2.11).
--
-- CONTRAST (not exercised in this MUST-accept file; belongs in a
-- negative twin): at an abstract index `Natural n` the Zero arm's bridge
-- n = Z is unsolved — §30.2.7 UnknownCompatibility — which "never
-- justifies omitting the constructor branch merely because the index
-- bridge was not solved"; a `case impossible` there must be rejected.
--! mode check
--! assertNoErrors
module main

data PNat : Type =
    Z
    S PNat

data Natural (n : PNat) : Type =
    Zero : Natural Z
    Succ : (pred : Natural n) -> Natural (S n)

-- POSITIVE per spec: else side is unreachable — Succ is excluded by flow
-- evidence and Zero is refuted by the ground index.
predOf : Natural (S Z) -> Natural Z
let predOf v =
    if v is Succ then v.pred
    else
        match v
        case impossible

-- STATUS(ab0a1126): FAIL — SPEC-CORRECT — E_INDEXED_IMPOSSIBLE_REACHABLE at line 39 ignores the else branch's LacksCtor Succ fact combined with the ground Z versus S Z constructor-index refutation; §17.1.5 requires that empty remainder to be accepted.
