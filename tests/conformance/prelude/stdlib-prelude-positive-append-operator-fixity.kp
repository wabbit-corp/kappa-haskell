module main

-- Regression: the prelude defines the append operator `(++) = monoid.append`
-- but shipped no fixity declaration for it, so `x ++ y` failed to parse with
-- "Unexpected tokens at the end of the expression". Spec.md's normative fixity
-- table (the `(::) (++) : infix right 50` row) requires the prelude to provide
-- it. With the fixity in place, `++` parses as a right-associative infix
-- operator and resolves its `Monoid` constraint normally.
--
-- The carrier is `String`, a prelude-provided LAWFUL `Monoid` (§28.2.2 Monoid
-- is lawful by default: every instance discharges appendAssoc/leftId/rightId;
-- `String` discharges them through the gated escape via `instance IsSet
-- String`). A three-operand chain `a ++ b ++ c` exercises the right-associative
-- parse; `append` is associative, so the value is the same either grouping.

-- Right-associative: parses as "a" ++ ("bb" ++ "ccc").
joined : String
let joined = "a" ++ "bb" ++ "ccc"

-- empty is the left/right identity of the String monoid.
withEmpty : String
let withEmpty = "" ++ joined ++ ""

--! mode check
--! assertNoErrors
--! assertType joined String
--! assertEval joined "abbccc"
--! assertEval withEmpty "abbccc"
