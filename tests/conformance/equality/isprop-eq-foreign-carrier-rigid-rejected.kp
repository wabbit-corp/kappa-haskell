module main

-- §14.4 soundness (NEGATIVE) — carrier-recovery integrity in the IsProp-under-Pi
-- solver. The carrier of an equality is the equands' OWN homogeneous type; here
-- that is 'Bool', which is NOT a set in the prelude. The equands additionally
-- mention a 'String' rigid 's'. A solver that recovered the carrier from a
-- foreign type merely OCCURRING in a stuck equand would grab 'IsSet String' from
-- 's' and certify the non-h-prop 'IsProp ((=) (eqStr s s) False)', letting
-- 'unsafeAssertProof' forge a FALSE 'Bool' equality: since 'eqStr "" "" ≡ True',
-- 'falseLaw @""' is '(=) True False', and 'subst' over a discriminator family
-- transports 'Unit : disc True' into 'disc False = Void', inhabiting 'Void'.
--
-- The 'IsProp ((=) @Bool ...)' obligation MUST be unsolved (Bool has no IsSet),
-- rejecting the assertion. This pins the carrier-recovery hole closed: the base
-- case of 'propEvidence' (Kappa.Check) uses ONLY the equand's true type
-- ('equandType'), never a foreign rigid's type.

disc : Bool -> Type
let disc b =
    match b
    case True -> Unit
    case False -> Void

falseLaw : forall (s : String). (=) (eqStr s s) False
let falseLaw = unsafeAssertProof "forge via a foreign set-typed carrier"

boom : Void
let boom = subst @Bool @disc @(eqStr "" "") @False (falseLaw @"") Unit

--! mode check
--! allow_unsafe_assert_proof
--! assertDiagnostic error E_UNSOLVED_IMPLICIT
