module main

-- §14.4 soundness (NEGATIVE): Kappa v1 equality is intensional and does NOT
-- assume UIP.  `unsafeAssertProof` may construct a proof of `(=) True False`
-- only if `IsProp ((=) True False)` is available — which, per §14.4, requires
-- `IsSet Bool`.  No such instance exists, so the IsProp-under-Pi closure
-- solver's equality base case FAILS (it does not fabricate set-ness), the
-- `IsProp` obligation is unsolved, and the assertion is REJECTED.
--
-- Were UIP admitted unconditionally (the unsound `isPropEq` without an `IsSet`
-- hypothesis), `bogus : (=) True False` would type-check and `subst` would
-- transport `Unit : disc True` to `disc False = Void`, inhabiting `Void` —
-- a soundness catastrophe.  This test pins that the hole stays closed.

disc : Bool -> Type
let disc b = match b case True -> Unit case False -> Void

bogus : (=) True False
let bogus = unsafeAssertProof "spec-forbidden"

boom : Void
let boom = subst @Bool @disc @True @False bogus Unit

--! mode check
--! allow_unsafe_assert_proof
--! assertDiagnostic error E_UNSOLVED_IMPLICIT
