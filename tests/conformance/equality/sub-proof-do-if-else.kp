-- §16.4.2/§18.6.2: an IO-kernel do-block `if` STATEMENT pushes the NEGATED
-- condition into its `else`-suite (as the if-EXPRESSION else-branch already
-- does). In the `else` of `if x < y`, `(x < y) = False`, so `subDefined x y`
-- = `(y <= x) = True` holds branch-locally and discharges checked subtraction.
-- NOTE: the condition is spelled with the primitive comparison because the
-- current negation-fact bridge operates on that layer; the standard
-- `Ord Nat` spelling of the same negated-condition discharge (§28.2.3
-- `subDefined x y = (y <= x)` + §15.8.4 negation) is pinned by
-- tests/pending-import/spec-coverage/nat-fin-refinement/positive/
-- branch-negation-checked-sub.
--! assertNoErrors

module main

consume : Nat -> Nat
let consume n = n

doIfElseOk : Nat -> Nat -> UIO Unit
let doIfElseOk x y = do
    if ltInt (natToInt x) (natToInt y) then
        printlnString "lt"
    else
        let d = consume (x - y)
        printlnString "ge"
