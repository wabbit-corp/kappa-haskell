-- §16.4.2 SOUNDNESS PIN: the `else`-suite negated fact must NOT leak past the
-- `if` into the rest of the do-scope. Neither branch here is abrupt, so no
-- §8.2.2A postdominating refinement survives the join; after the conditional,
-- the order of x and y is unknown again and the trailing `x - y` is rejected.
-- NOTE: the condition keeps the primitive comparison spelling because the
-- current negation-fact bridge operates on that layer; the standard
-- `Ord Nat` spelling of negated-condition facts (§28.2.3 + §15.8.4) is
-- pinned by tests/pending-import/spec-coverage/nat-fin-refinement/
-- positive/branch-negation-checked-sub.
--! assertDiagnostic error E_UNSOLVED_IMPLICIT

module main

consume : Nat -> Nat
let consume n = n

doElseLeak : Nat -> Nat -> UIO Unit
let doElseLeak x y = do
    if ltInt (natToInt x) (natToInt y) then
        printlnString "lt"
    else
        printlnString "ge"
    let d = consume (x - y) --!! E_UNSOLVED_IMPLICIT
    printlnString "after"
