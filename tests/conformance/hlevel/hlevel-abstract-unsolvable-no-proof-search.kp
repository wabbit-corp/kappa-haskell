module main

-- §8 h-level — arbitrary / symbolic h-level goals must NOT be solved by
-- unbounded proof search.
--
-- A symbolic h-level is not guessed by unbounded proof search. IsNType is an
-- intrinsic trait, but no intrinsic introduction rule can decide a rigid n.

arbitraryNType : (n : Nat) -> IsNType n Bool
let arbitraryNType n = summon (IsNType n Bool)

--! mode check
--! assertDiagnostic error E_UNSOLVED_IMPLICIT
