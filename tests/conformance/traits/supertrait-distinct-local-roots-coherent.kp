-- §14.3.3 / §16.3.3: projected evidence from distinct symbolic local trait
-- roots is coherent for a trait goal. Generated IsSubsingleton evidence
-- justifies a deterministic representative; local artifact identity is not
-- required.
module main

trait Root (0 a : Type)

trait Root a => LeftRoot (0 a : Type)

trait Root a => RightRoot (0 a : Type)

requireRoot :
    forall (a : Type).
    (@root : Root a) ->
    Unit

let requireRoot = ()

coherent :
    forall (a : Type).
    (@left : LeftRoot a) ->
    (@right : RightRoot a) ->
    Unit

let coherent @left @right =
    requireRoot

--! mode check
--! assertNoErrors
