module test

-- Higher-rank soundness (NEGATIVE): an erased `@0 s : String` binder whose
-- identity is a genuine TYPE-FORMER INDEX (here a region/place label `&[s]`)
-- remains part of type identity. Coercing `OneStr` to `TwoStr` would require
-- the one region selected by `OneStr` to equal two independently quantified
-- regions, so higher-rank subsumption rejects it as a type mismatch.
--
-- This is not §16.3.3 implicit-candidate resolution: no omitted argument is
-- being selected from multiple in-scope terms. It therefore uses the
-- `kappa.type.mismatch` family rather than `kappa.implicit.ambiguous`.

type OneStr = forall (@0 s : String). (&[s] _ : Unit) -> (&[s] _ : Unit) -> Unit
type TwoStr = forall (@0 s : String)(@0 t : String). (&[s] _ : Unit) -> (&[t] _ : Unit) -> Unit

oneToTwo : OneStr -> TwoStr
let oneToTwo f = f

--! mode check
--! assertDiagnostic error E_TYPE_EQUALITY_MISMATCH
