module main

-- §28.2.2/§14.4: the prelude's `Monoid` is LAWFUL BY DEFAULT — the trait
-- carries the monoid laws (appendAssoc/appendLeftIdentity/appendRightIdentity)
-- as mandatory members, surfaced as propositional equalities.  Because Kappa v1
-- equality is intensional (Spec §14.4, no UIP), such a law is an h-prop ONLY
-- over a SET, so a `Monoid` instance exists exactly for carriers that can
-- discharge those laws: `String` (its laws asserted through the gated escape via
-- `instance IsSet String`) and `List a` (its laws PROVEN by honest structural
-- induction, element-agnostic).  The effect carriers `IO e a` / `STM a` are NOT
-- `Monoid`s — their equality is not an h-prop, so the laws cannot be asserted;
-- effectful choice belongs to `Alternative STM`, not to `Monoid` (see
-- lawful-monoid-effect-carrier-lawless.kp).

-- The set carriers resolve the (lawful) `Monoid`:
needMonoid : forall (a : Type). (@_ : Monoid a) -> Unit
let needMonoid = Unit

let lawfulString : Unit = needMonoid @String
let lawfulList : Unit = needMonoid @(List Integer)

-- `append`/`empty` work (the operation members of the lawful trait):
let appended : String = append "a" "b"
let joined : List Integer = append (1 :: Nil) (2 :: Nil)

--! mode check
--! assertNoErrors
