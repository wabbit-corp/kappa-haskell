module main

trait Root (0 a : Type)

trait Root a => LeftRoot (0 a : Type)

trait Root a => RightRoot (0 a : Type)

ambiguousWitness :
    forall (a : Type).
    (@left : LeftRoot a) ->
    (@right : RightRoot a) ->
    Root a

let ambiguousWitness @left @right =
    witness

--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.implicit.ambiguous
