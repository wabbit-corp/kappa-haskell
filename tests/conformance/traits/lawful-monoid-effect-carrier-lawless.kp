module main

-- §14.4 soundness: the prelude's `Monoid` is LAWFUL BY DEFAULT (it carries the
-- monoid laws as mandatory members).  The effect carrier `IO e a` CANNOT
-- discharge those laws — its propositional equality is not an h-prop (no
-- `IsSet (IO e a)`), and fabricating one is exactly the unsoundness this avoids.
-- So `STM a` is NOT a `Monoid`: a `Monoid (STM a)` obligation is unsatisfiable
-- (no such instance, and none can be fabricated). Transactional choice instead
-- belongs to the lawful `Alternative STM` interface required by §18.1.14.

needMonoid : forall (a : Type). (@_ : Monoid a) -> Unit
let needMonoid = Unit

needAlternative : forall (f : (0 A : Type) -> Type). (@_ : Alternative f) -> Unit
let needAlternative = Unit

-- `Alternative STM` resolves through the standard transactional-choice
-- instance, whose `empty` is `retry` and whose choice operation is `orElse`.
let lawfulSTMAlternative : Unit = needAlternative @STM

-- But `Monoid (STM a)` does NOT: no instance, and transactional choice does
-- not satisfy the unrelated value-level append contract.
badMonoid : forall (a : Type). Unit
let badMonoid = needMonoid @(STM a)

--! mode check
--! assertDiagnostic error E_UNSOLVED_IMPLICIT
--! assertErrorCount 1
