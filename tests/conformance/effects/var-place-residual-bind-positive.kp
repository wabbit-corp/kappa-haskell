module main

bumpOld : (inout v : Int) -> UIO (1 v : Int, old : Int)
let bumpOld (inout v : Int) : UIO (1 v : Int, old : Int) =
    pure (v = addInt v 1, old = v)

main : UIO Int
let main = do
    var x = 5
    let (old = before) <- bumpOld ~x
    pure (addInt before x)

--! assertNoErrors
--! assertExecute main 11
