--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_CONTINUATION_CAPTURE

-- §18.1.20: the multi-shot capture check must see resolved operation sites
-- nested under immediate action expressions, not only a direct bind RHS head.
module main

bad : (1 x : Int) -> Int
let bad (1 x : Int) : Int =
    block
        scoped effect Choice =
            ω choose : Unit -> Bool

        let comp : Eff <[Choice : Choice]> Int =
            do
                let b <-
                    match True
                    case True -> Choice.choose ()
                    case False -> pure False
                if b then x else x

        let handled =
            deep handle Choice comp with
                case return y -> pure y
                case choose _ k ->
                    do
                        let a <- k True
                        let _ <- k False
                        pure a

        runPure handled
