module main

type Cell = (value : Int,)

projection cellValue (place this : Cell) : Int =
    yield this.value

bad : UIO Unit
let bad = do
    let cell = (value = 1,)
    let proj = cellValue
    let _ <- pure (proj ~cell)
    pure ()

--! mode check
--! assertDiagnostic error E_QTT_INOUT_MARKER_UNEXPECTED
