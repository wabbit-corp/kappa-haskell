--! mode run
--! assertNoErrors
--! assertStdout "parent-resumed\nbg-finalized:Requested\n"

-- §18.1.4 / PRIMITIVES #5 `disconnect` (ZIO): DETACHED interruption.
--
-- `disconnect action` runs `action` on its own forked child and `join`s it, so a
-- normal success/failure passes straight through. The ONE difference from running
-- `action` inline is the interrupt edge: if the fiber RUNNING `disconnect action`
-- is interrupted while joined, `disconnect` issues a NON-waiting interrupt to the
-- child and unwinds the parent IMMEDIATELY — the child's finalizers keep running
-- in the BACKGROUND rather than blocking the parent (the default structured
-- behavior is "the interrupter waits for the target's finalizers").
--
-- Deterministic observation (no reliance on a particular interleaving):
--   * `slowChild` parks; its onInterrupt finalizer completes a Promise, recording
--     the InterruptCause tag it was interrupted with.
--   * `parent` runs `disconnect (slowChild done)`. We `cede` it onto the child's
--     sleep, then `interrupt parent` (the WAITING form). Because the join is
--     detached, `interrupt` only waits for `parent`'s own (trivial) unwind, NOT
--     for the child's finalizer — so main reaches "parent-resumed" without hanging.
--   * We then `awaitPromiseExit done`: the child's finalizer completed it in the
--     BACKGROUND after parent had already left, proving finalization continued
--     post-detach. The `Requested` tag confirms it was the detach interrupt.
--
-- Were the child NOT disconnected (inline `slowChild`), `interrupt parent` would
-- block until the child's finalizer ran (the §18.1.4 wait-for-finalizers edge);
-- detachment is exactly what lets the parent return first. The promise hand-off
-- makes the result order-independent across interp / C / LLVM.
module main

import std.prelude.(type Exit(..), type InterruptCause(..), type InterruptTag(..))

tagOf : InterruptCause -> String
let tagOf ic = match ic
    case InterruptCause Requested _ -> "Requested"
    case InterruptCause _ _ -> "other"

-- A child that parks; on interrupt its finalizer records the cause's tag into the
-- promise. The promise is the cross-fiber observable for the background finalizer.
recordTag : Promise Void String -> InterruptCause -> UIO Unit
let recordTag done ic =
    ioBind (completePromise done (Success (tagOf ic))) (\b -> ioPure Unit)

slowChild : Promise Void String -> UIO Unit
let slowChild done = onInterrupt (sleepFor (seconds 10)) (recordTag done)

main : UIO Unit
let main = do
    let done <- newPromise
    -- run the child DETACHED inside `parent`: parent's interrupt won't wait on it.
    let p <- fork (disconnect (slowChild done))
    cede
    cede
    interrupt p
    -- `interrupt` (waiting) returns once `parent` itself has terminated; the
    -- detached join makes that prompt — no blocking on the child's finalizer.
    printlnString "parent-resumed"
    -- The child's onInterrupt finalizer completed `done` in the background.
    let ex <- awaitPromiseExit done
    match ex
      case Success tag -> printlnString (stringAppend "bg-finalized:" tag)
      case Failure _ -> printlnString "bg-finalized:fail"
