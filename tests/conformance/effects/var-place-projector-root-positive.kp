--! assertNoErrors
--! assertExecute main 2

module main

type Cell = (value : Int,)

projection cellValue (place this : Cell) : Int =
    yield this.value

bump : (inout v : Int) -> UIO (1 v : Int,)
let bump (inout v : Int) : UIO (1 v : Int,) =
    pure (v = addInt v 1,)

main : UIO Int
let main = do
    var cell = (value = 1,)
    let proj = cellValue
    bump ~(proj cell)
    pure cell.value
