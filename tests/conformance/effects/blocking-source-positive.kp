--! mode run
--! assertNoErrors
--! assertStdout "before\ninside\nafter\n"

-- Spec §18.1.11: source-level `blocking` is an IO action transformer.  It is
-- not only a build-manifest FFI classification token.
module main

main : UIO Unit
let main = do
    printlnString "before"
    blocking (printlnString "inside")
    printlnString "after"
