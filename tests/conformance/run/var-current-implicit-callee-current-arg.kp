--! mode run
--! assertNoErrors
--! assertStdout "42\n"

takeImplicit : (@ω n : Int) -> Int -> UIO Int
let takeImplicit (@ω n : Int) (_ : Int) : UIO Int =
    pure n

main : UIO Unit
let main = do
    var f : (@ω n : Int) -> Int -> UIO Int = takeImplicit
    var x = 42
    let n <- f @x 0
    printlnString (showInt n)
