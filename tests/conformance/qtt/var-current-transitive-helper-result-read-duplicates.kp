--! assertDiagnostic error E_VAR_READ_DUPLICATES_LINEAR_VALUE

module main

data Token : Type =
    Token

data Box : Type =
    Empty
    Full (1 tok : Token)

let mkBox1 tok =
    Full tok

let mkBox2 tok =
    mkBox1 tok

bad : UIO Unit
let bad = do
    var box = mkBox2 Token
    let snapshot = box
    pure ()
