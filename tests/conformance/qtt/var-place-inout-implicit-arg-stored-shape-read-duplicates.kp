--! assertDiagnostic error E_VAR_READ_DUPLICATES_LINEAR_VALUE

module main

data Token : Type =
    Token

data Box : Type =
    Empty
    Full (1 tok : Token)

replace : forall (a : Type). (inout b : Box) -> UIO (1 b : Box,)
let replace @a (inout b : Box) : UIO (1 b : Box,) =
    pure (b = Full Token,)

bad : UIO Unit
let bad = do
    var box : Box = Empty
    replace @Int ~box
    let snapshot = box
    pure ()
