--! assertErrorCount 3
--! assertDiagnostic error E_VAR_READ_DUPLICATES_LINEAR_VALUE
--! assertDiagnostic error E_QTT_LINEAR_DROP

module main

data Token : Type =
    Token

data Box : Type =
    Full { 1 tok : Token }

bad : UIO Unit
let bad = do
    var cell : Box = Full { tok = Token }
    let copy <- readRef @(IO Void) (ref cell)
    pure ()
