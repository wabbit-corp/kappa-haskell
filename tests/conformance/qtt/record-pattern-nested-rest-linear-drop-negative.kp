--! mode check
--! assertDiagnostic error E_QTT_LINEAR_DROP

@PrivateByDefault module main

data Token : Type =
    Token

type Inner : Type = (1 tok : Token, tag : Int)
type Outer : Type = (inner : Inner,)

bad : (1 outer : Outer) -> Int
let bad (1 outer : Outer) : Int =
    match outer
    case (inner = (tag = n, ..)) -> n
