module main

import lib.core.*
import lib.json as json

decodeStringFromJson : json.JsonValue -> IO GameError String
let decodeStringFromJson value =
    match value
    case json.JsonString text -> pure text

loadLore : List json.JsonValue -> IO GameError (List Rumor)
let loadLore values =
    do
        let texts <- traverse decodeStringFromJson values
        if listLength texts == listLength texts then pure (map Rumor texts) else pure Nil
