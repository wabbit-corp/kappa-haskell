--! assertDiagnostic error E_VAR_READ_DUPLICATES_LINEAR_VALUE

module main

data Token : Type =
    Token

data Box : Type =
    Empty
    Full (1 tok : Token)

bad : forall (m : (0 A : Type) -> Type). (@mon : Monad m) -> (@mr : MonadRef m) -> m Unit
let bad (@mon : Monad m) (@mr : MonadRef m) : m Unit = do
    var cell = Full Token
    let snapshot <- mr.readRef @Box (ref cell)
    pureA ()
