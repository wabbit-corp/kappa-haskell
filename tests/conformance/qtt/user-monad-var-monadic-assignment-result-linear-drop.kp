--! mode check
--! assertDiagnostic error E_QTT_LINEAR_DROP

module main

data Token : Type =
    Token

data Cell : Type =
    Empty
    Full (1 tok : Token)

data Wrap (0 a : Type) : Type =
    MkWrap (runWrap : UIO a)

instance Applicative Wrap =
    let pureA x = MkWrap (pureIO x)
    let liftA2 f ma mb =
        match ma
        case MkWrap ioa ->
            match mb
            case MkWrap iob ->
                MkWrap (bindIO ioa (\a -> bindIO iob (\b -> pureIO (f a b))))

instance Monad Wrap =
    let (>>=) ma f =
        match ma
        case MkWrap ioa ->
            MkWrap (bindIO ioa (\a ->
                match f a
                case MkWrap iob -> iob))

instance MonadRef Wrap =
    let Ref = __IORef
    let newRef x = MkWrap (__ioNewRef x)
    let readRef r = MkWrap (__ioReadRef r)
    let writeRef r x = MkWrap (__ioWriteRef r x)

makeFull : Wrap Cell
let makeFull = pureA (Full Token)

bad : Wrap Unit
let bad = do
    var cell : Cell = Empty
    cell <- makeFull
    pureA ()
