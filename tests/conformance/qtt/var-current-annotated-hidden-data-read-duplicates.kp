--! assertDiagnostic error E_VAR_READ_DUPLICATES_LINEAR_VALUE

module main

data Token : Type =
    Token

data Box : Type =
    Empty
    Full (1 tok : Token)

makeBox : Unit -> Box
let makeBox _ =
    Full Token

bad : UIO Unit
let bad = do
    var box : Box = makeBox ()
    let copy = box
    pure ()
