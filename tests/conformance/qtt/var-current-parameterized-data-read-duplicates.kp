--! assertDiagnostic error E_VAR_READ_DUPLICATES_LINEAR_VALUE

module main

data Token : Type =
    Token

data Cell : Type =
    Empty
    Full (1 tok : Token)

data Wrap (0 a : Type) : Type =
    Wrap (value : a)

bad : UIO Unit
let bad = do
    var box : Wrap Cell = Wrap (Full Token)
    let snapshot = box
    pure ()
