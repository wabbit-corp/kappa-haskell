--! assertNoErrors
--! assertEval ordered 1
--! assertEval distincts 33
--! assertEval paged 5
--! assertEval grouped 46
--! assertEval joined 38

-- §20.6–§20.8: order by (stable), distinct by (first representative),
-- skip/take on an ordered pipeline, group by with Monoid aggregation,
-- and an inner join.

-- §28.2.2: `Monoid` is LAWFUL BY DEFAULT — every instance discharges
-- appendAssoc/appendLeftIdentity/appendRightIdentity. The group-by aggregation
-- therefore folds over a LAWFUL `Monoid`; here `Monoid (List a)` (laws proven
-- by honest structural induction in the prelude). Each group's rows are
-- collected (as singleton lists, concatenated by the List monoid) and summed
-- per group, then the per-group sums are summed — same total the bespoke
-- integer-sum monoid produced, but with a genuinely lawful carrier.

sumList : List Int -> Int
let sumList xs =
    match xs
    case Nil -> 0
    case x :: rest -> x + sumList rest

headOr : Int -> List Int -> Int
let headOr d xs =
    match xs
    case Nil -> d
    case x :: _ -> x

ordered : Int
let ordered =
    headOr 0 [
        for x in [2, 3, 1]
        order by x
        yield x
    ]

distincts : Int
let distincts =
    sumList [
        for row in [(key = 1, value = 11), (key = 1, value = 99), (key = 2, value = 22)]
        distinct by row.key
        yield row.value
    ]

paged : Int
let paged =
    sumList [
        for x in [9, 2, 3, 1, 9]
        order by x
        skip 1
        take 2
        yield x
    ]

grouped : Int
let grouped =
    sumList [
        for x in [1, 2, 3, 40]
        group by (if x < 10 then 0 else 1) { items = (x :: Nil) } into g
        yield sumList g.items
    ]

joined : Int
let joined =
    sumList [
        for x in [1, 2]
        join y in [(1, 10), (2, 20), (2, 3)] on y._1 == x
        yield x + y._2
    ]
