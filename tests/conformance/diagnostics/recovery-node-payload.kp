--! mode check
--! assertDiagnostic error E_RECOVERY_SKIPPED_INVALID_SYNTAX
--! assertDiagnosticPayload error E_RECOVERY_SKIPPED_INVALID_SYNTAX /payload/kind recovery-node
--! assertDiagnosticPayload error E_RECOVERY_SKIPPED_INVALID_SYNTAX /payload/recoverySite declaration
--! assertDiagnosticPayload error E_RECOVERY_SKIPPED_INVALID_SYNTAX /payload/expected declaration-start
--! assertDiagnosticPayload error E_RECOVERY_SKIPPED_INVALID_SYNTAX /payload/confidence likely
--! assertDiagnostic error E_NAME_UNRESOLVED
-- §3.1.14A minimum recovery contract: a malformed top-level declaration
-- is recovered as a TYPED recovery node — not discarded trivia — and
-- the diagnostic it raises identifies that node in structured payload
-- (kind "recovery-node" with recoverySite/expected/confidence/skipped).
-- §3.1.4: the declaration-skip recovery exposes the portable alias
-- E_RECOVERY_SKIPPED_INVALID_SYNTAX (asserted here via the portable
-- spelling, which the harness matches against the impl code's alias).
-- Recovery continues to the next declaration (its unresolved name is
-- still reported), proving cross-declaration recovery while the invalid
-- program is never accepted.
module main

%% this operator chain is not a declaration

let after : Int = missingName
