@PrivateByDefault module main

data Box (a : Type) : Type =
    Box (value : a)

forget : (F : (parametric 0 A : Type) -> Type) -> (G : (parametric 0 A : Type) -> Type,)
let forget F = (G = F,)

pkg : (G : (parametric 0 A : Type) -> Type,)
let pkg = forget (type Box)

bad : pkg.G Int -> Int
let bad x =
    match x
    case pkg.G.Box n -> n
