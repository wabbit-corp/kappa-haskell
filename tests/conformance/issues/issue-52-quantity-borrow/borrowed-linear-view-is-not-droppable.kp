module main

data Token : Type =
    Token

data LinearBox : Type =
    LinearBox (value : Int) (1 token : Token)

readValue : (1 & box : LinearBox) -> Int
let readValue box =
    box.value

ignoreLinearBorrow : (1 & box : LinearBox) -> Unit
let ignoreLinearBorrow box =
    ()

