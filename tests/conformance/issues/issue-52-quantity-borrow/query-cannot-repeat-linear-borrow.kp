module main

data Token : Type =
    Token

data LinearBox : Type =
    LinearBox (value : Int) (1 token : Token)

readValue : (1 & box : LinearBox) -> Int
let readValue box =
    box.value

repeatLinearBorrowInQuery : (1 & box : LinearBox) -> List Int
let repeatLinearBorrowInQuery box =
    [
        for n in [1, 2]
        yield readValue box + n
    ]

--! mode check
--! assertErrorCount 1
--! assertDiagnosticFamily error kappa.quantity.positive-lower-bound
