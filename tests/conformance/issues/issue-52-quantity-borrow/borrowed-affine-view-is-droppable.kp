module main

data Token : Type =
    Token

data LinearBox : Type =
    LinearBox (value : Int) (1 token : Token)

readValue : (1 & box : LinearBox) -> Int
let readValue box =
    box.value

ignoreAffineBorrow : (<=1 & box : LinearBox) -> Unit
let ignoreAffineBorrow box =
    ()

--! mode check
--! assertNoErrors
--! assertTotal ignoreAffineBorrow
