module main

--! mode check
--! requires capability kcoreText
--! dumpFormat kcore
--! assertNoErrors
--! assertStageDumpRoundTrips KCore

data Inner : Type = Inner Int
data Outer : Type = Outer Inner

readOuter : Outer -> Int
let readOuter value =
    match value
    case captured @ (Outer (Inner n)) if n > 0 -> n
    case _ -> 0
