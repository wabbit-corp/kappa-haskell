--! mode check
--! requires capability stageDumps
--! requires capability kcoreText
--! dumpFormat kcore
--! canonicalDumps
--! assertNoErrors
--! assertStageDumpRoundTrips KCore

-- Spec §30.2.0A: using serializes the checked acquire action, resource pattern,
-- and selected Releasable member without recognizing IO or a member spelling.
module main

data Resource : Type = Resource Int

instance Releasable (IO e) Resource =
    let release _ = ioPure ()

acquire : UIO Resource
let acquire = ioPure (Resource 1)

run : UIO Unit
let run = do
    using Resource value <- acquire
    ioPure ()
