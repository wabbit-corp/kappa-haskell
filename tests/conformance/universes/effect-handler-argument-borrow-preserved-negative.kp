--! mode check
--! assertDiagnostic error E_QTT_BORROW_CONSUME

-- Spec §18.1.15 and §30.2.0: borrowed access on an operation argument is
-- retained when the corresponding handler clause binder is introduced.
module main

effect Inspect =
    1 inspect : (& x : Int) -> Int

bad : Eff <[Inspect : Inspect]> Int -> Int
let bad computation =
    block
        let handled =
            deep handle Inspect computation with
                case return x -> pure x
                case inspect x k -> k x
        runPure handled
