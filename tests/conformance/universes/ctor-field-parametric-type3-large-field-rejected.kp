-- §10.4.1/§11.1.2.3A: the parametric binder itself is exempt from
-- constructor-size checking, but later fields mentioning the witness are
-- checked normally.
--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_DATA_CONSTRUCTOR_FIELD_UNIVERSE
--! assertDiagnosticFamily error kappa.universe.constructor-size

data BadBox : Type0 =
    BadBox (parametric 0 T : Type3) (foo : T)
