-- §11.1.2.5: TypeLevel is ordinary runtime-capable data. It can be passed,
-- returned, stored, projected, and sealed without making a universe expression
-- canonical merely by doing so. Runtime use of an opened existential witness
-- is covered separately because every existential witness is quantity zero.
--! mode check
--! assertNoErrors

idLevel : TypeLevel -> TypeLevel
let idLevel u = u

type LevelBox : Type = (level : TypeLevel,)

box : LevelBox
let box = (level = idLevel 1,)

projected : TypeLevel
let projected = box.level

type PackedLevel : Type = exists (u : TypeLevel). Unit

packed : PackedLevel
let packed = seal exists (u = projected). () as PackedLevel
