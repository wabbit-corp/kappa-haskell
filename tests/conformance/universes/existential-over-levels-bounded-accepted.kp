-- §11.1.2.7/§11.1.2.8: bounded existential packaging uses ordinary erased
-- level-comparison proof evidence.
--! mode check
--! assertNoErrors
--! requires capability stageDumps
--! requires capability kcoreText
--! assertStageDumpRoundTrips KCore

type TypesBelowOmega : Typeω =
    exists (u : TypeLevel). (@0 p : u < ω, T : Type u)
