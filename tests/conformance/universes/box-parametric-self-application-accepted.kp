-- §11.1.2.3A: a stored parametric-polymorphic function may be instantiated at
-- the small type that stores it.
--! mode check
--! assertNoErrors

type Poly : Type =
    (0 A : Type) -> A -> A

data Box : Type =
    MkBox (f : Poly)

useBox : Box -> Box
let useBox b =
    match b
    case MkBox f ->
        f Box b
