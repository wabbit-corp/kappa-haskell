--! mode check
--! requires capability stageDumps
--! requires capability kcoreText
--! dumpFormat kcore
--! canonicalDumps
--! assertNoErrors
--! assertStageDumpRoundTrips KCore

-- Spec §30.2.0A: success and failure patterns of a refutable do binding carry
-- separate typed scopes in the serialized checkpoint.
module main

run : List Integer -> UIO Unit
let run values = do
    let? head :: _ = values
    else _ ->
        printlnString "empty"
    printlnString (showInt head)
