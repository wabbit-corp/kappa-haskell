-- A stable opaque total TypeLevel application is an admissible universe
-- index. Destructuring a record preserves the projection identity: the
-- pattern binder denotes the same level as the projected field.
--! mode check
--! assertNoErrors

module main

opaque let shifted (u : TypeLevel) : TypeLevel =
    succ u

type LevelBox : Type =
    (level : TypeLevel,)

atLevel :
    (u : TypeLevel) ->
    (@0 bounded : shifted u < omega + 1) ->
    (A : Type (shifted u)) ->
    A ->
    A
let atLevel u bounded A value = value

throughPattern :
    (box : LevelBox) ->
    (@0 bounded : shifted box.level < omega + 1) ->
    (A : Type (shifted box.level)) ->
    A ->
    A
let throughPattern box bounded A value =
    match box
    case (level = u,) ->
        atLevel u @bounded A value
