--! mode check
--! requires capability stageDumps
--! requires capability kcoreText
--! dumpFormat kcore
--! canonicalDumps
--! assertNoErrors
--! assertStageDumpRoundTrips KCore

-- Spec §30.2.0A: do-kernel binders are structural lexical binders in the
-- checkpoint; later items must resolve to their stable local identities.
module main

run : UIO Int
let run = do
    let value <- ioPure 7
    return value
