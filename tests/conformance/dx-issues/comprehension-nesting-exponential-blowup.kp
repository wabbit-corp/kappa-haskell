--! assertNoWarnings
--! assertType xs List Int

-- DX EXPECTATION (not necessarily spec-required): syntactically nested
-- list comprehensions ([ for x in <inner>, yield x ] wrapped around
-- itself) should check in time roughly linear in nesting depth — each
-- level adds one generator over the previous plan (Spec §20 queries).
--
-- What currently happens (a0497523): checking is exponential in nesting
-- depth, roughly 2x per level: depth 10/14/18/22 checks in
-- 0.14s/0.82s/11.8s/>90s (timeout). A 22-line nested comprehension makes
-- the compiler effectively hang, which is a tooling/DoS hazard for
-- editor integrations. Breadth is fine: ONE comprehension with 50
-- generator clauses checks instantly, so the blowup is specifically
-- per-nesting-level (plan or row duplication), not per-clause.
-- This file pins depth 14 (~0.8s) as a canary that still completes.
module main

xs : List Int
let xs = [ for x13 in [ for x12 in [ for x11 in [ for x10 in [ for x9 in [ for x8 in [ for x7 in [ for x6 in [ for x5 in [ for x4 in [ for x3 in [ for x2 in [ for x1 in [ for x0 in [1], yield x0 ], yield x1 ], yield x2 ], yield x3 ], yield x4 ], yield x5 ], yield x6 ], yield x7 ], yield x8 ], yield x9 ], yield x10 ], yield x11 ], yield x12 ], yield x13 ]
-- STATUS(8c3c7747): PASS — retained at depth 14 as a conformance performance canary.
