--! assertNoErrors
--! assertNoWarnings
module main

-- Transparent helper measures are accepted only because the helper normalizes
-- to primitive arithmetic; the helper spelling itself is not trusted.
maxInt : Integer -> Integer -> Integer
let maxInt a b =
    if leInt a b then b else a

countdownViaHelpers : Integer -> Integer
let countdownViaHelpers n decreases maxInt 0 n =
    if leInt n 0 then 0 else countdownViaHelpers (subInt n 1)

-- The same normalized primitive measure is independent of whether the helper
-- uses the selected comparison operator surface or names the primitive.
maxIntViaOperator : Int -> Int -> Int
let maxIntViaOperator a b =
    if a >= b then a else b

countdownViaOperators : Int -> Int
let countdownViaOperators n decreases maxIntViaOperator 0 n =
    if n <= 0 then 0 else countdownViaOperators (n - 1)
