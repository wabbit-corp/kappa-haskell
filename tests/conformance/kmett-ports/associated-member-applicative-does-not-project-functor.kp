--! mode check
--! assertNoErrors

-- Regression found while adding Either's Bitraversable instance. The
-- associated member receives `Applicative f`, whose declared superclass is
-- `Functor f`; the direct `map` call pins superclass projection inside a
-- polymorphic instance method.

module main

trait TraverseOne t =
    traverseOne : forall f a b. (@_ : Applicative f) -> (a -> f b) -> t a -> f (t b)

data Box a =
    MkBox (value : a)

instance TraverseOne Box =
    let traverseOne function box =
        match box
        case MkBox value -> map (\result -> MkBox result) (function value)
