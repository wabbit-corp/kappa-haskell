--! mode check
--! assertNoErrors

-- Compiler regression found while porting Edward Kmett's `bifunctors`.
-- §7.2/§7.5 contextual facet selection requires the `PairF` occurrence in the
-- instance head to select the type facet rather than the same-spelling
-- constructor facet.

module main

trait BifunctorLike
    (parametric 0 p : (parametric 0 A : Type) -> (parametric 0 B : Type) -> Type)

data PairF (parametric 0 a : Type) (parametric 0 b : Type) : Type =
    PairF (left : a) (right : b)

instance BifunctorLike PairF
