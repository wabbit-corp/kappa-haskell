-- [import note] §6.1.5 performs whole-declaration numeric inference before
-- defaulting.  The second argument fixes the shared carrier to String, so the
-- portable failure is missing Eq String and FromInteger String evidence; an
-- eager Int default followed by an argument mismatch would be order-dependent.
-- Source issue: MLatu #21 ("Switch from traits to type classes"). The
--   proposed `instance Eq Int { define = (Int, Int -> Bool) ... }`
--   states that the method type is fixed by the instance head. Kappa's
--   overloaded literal rule instead infers the common carrier from the full
--   application, then rejects the unavailable carrier dictionaries.
-- Spec: traits.instances, traits.instances.resolution_algorithm,
--       literals.numeric_literals.typing, expressions.implicits.

module test

--! mode check

trait Eq (a : Type) =
    eq : a -> a -> Bool

instance Eq Int =
    let eq x y = x == y

-- NEGATIVE: the String operand fixes the shared carrier to String. Neither
-- Eq String nor FromInteger String is available.
mixed : Bool
let mixed = eq 7 "seven"

--! assertDiagnosticFamily error kappa.implicit.unsolved
--! assertErrorCount 2
