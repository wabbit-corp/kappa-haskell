-- Source issues: METACOQ-96
-- Spec: types.universes, types.universes.cumulativity,
--       compiler.frontir.standard_diagnostic_families.type_equality
--
-- A sort cannot inhabit itself, and a sort cannot skip levels: `Type2 : Type3`,
-- not `Type2 : Type0`. Both failures are universe-constraint diagnostics;
-- self-containment additionally has its dedicated portable alias.

module negative

--! mode check

-- NEGATIVE: a sort cannot inhabit itself.
sortInItself : Type0
let sortInItself = Type0   --!! E_UNIVERSE_SELF_CONTAINMENT

skipLevel : Type0
let skipLevel = Type2   --!! E_UNIVERSE_CONSTRAINT_UNSATISFIABLE

--! assertDiagnosticFamily error kappa.universe.constraint
--! assertDiagnostic error E_UNIVERSE_SELF_CONTAINMENT
