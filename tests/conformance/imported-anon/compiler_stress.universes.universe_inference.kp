-- Stress test: universe levels are inferred when not explicitly annotated
-- Spec: types.universes.inference_sketch

--! mode check

-- Reifying A as the result requires an ordinary (runtime-relevant) type
-- binder; its TypeLevel is still inferred from the argument.
idType : (ordinary A : Type) -> Type
let idType A = A

-- Both A and B universe levels are inferred independently.
const : (A : Type) -> (B : Type) -> A -> B -> A
let const A B x _ = x

-- TypeLevel of the Box parameter is inferred.
data Box (A : Type) : Type =
    MkBox A

-- Exercise inference at each site.
let boxed   : Box Int  = MkBox 1
let boxedT  : Box Type = MkBox Int

let answer  : Int    = const Int (Type 0) 42 String

--! assertNoErrors
