-- Source issues: ponyc#1441, ponyc#379, ponyc#375, ponyc#568
-- Spec: expressions.lambdas, types.quantification
-- Pony issue #1441: lambda capture types were not inferred from the outer
-- scope, requiring explicit annotations. Issue #379: a lambda whose captured
-- value mentions an outer type parameter must retain that parameter in the
-- closure's inferred type.

--! mode check

-- POSITIVE: a lambda that captures a value from its enclosing scope.
addCapture : Int -> (Int -> Int)
let addCapture base =
    let f = \x -> x + base
    f

result1 : Int
let result1 = addCapture 10 5

-- The inner lambda captures `f : a -> a`; therefore its inferred closure type
-- depends on the outer declaration's `a` even though the lambda parameter is
-- unannotated.
makeTwice :
    forall (a : Type).
    (a -> a) -> (a -> a)
let makeTwice f =
    let twice = \x -> f (f x)
    twice

-- POSITIVE: a higher-order function where the lambda captures a type param.
applyTwice :
    forall (a : Type).
    (a -> a) -> a -> a
let applyTwice f x = f (f x)

doubled : Int
let doubled = makeTwice (\n -> n + 1) 3

--! assertNoErrors
--! assertType makeTwice forall (a : Type). (a -> a) -> (a -> a)
--! assertEval result1 15
--! assertEval doubled 5

-- STATUS(8c3c7747): PASS — value captures and captures whose type mentions an outer type parameter are inferred.
