-- Stress test: mutually recursive indexed types; termination checker handles mutual structure
-- Spec: data_types.gadts, declarations.terms

--! mode check

-- EvenList and OddList are mutually recursive; their indices track element count.
data EvenList (a : Type) (n : Nat) : Type =
  ENil  : EvenList a 0
  ECons : a -> OddList a n -> EvenList a (n+1)

data OddList (a : Type) (n : Nat) : Type =
  OCons : a -> EvenList a n -> OddList a (n+1)

-- sizeE and sizeO are mutually recursive; they decrease on the Nat index.
sizeE : forall (a : Type) (n : Nat). EvenList a n -> Nat
let sizeE xs =
  match xs
  case ENil       -> 0
  case ECons _ ys -> 1 + sizeO ys

sizeO : forall (a : Type) (n : Nat). OddList a n -> Nat
let sizeO ys =
  match ys
  case OCons _ xs -> 1 + sizeE xs

-- headE: extract the first element of a non-empty EvenList.
headE : forall (a : Type) (n : Nat). EvenList a (n+1) -> a
let headE xs =
  match xs
  case ECons x _ -> x
  case ENil      -> impossible

--! assertNoErrors
--! assertNoWarnings

