-- Source issues: FSTAR-1964, FSTAR-3263
-- Spec: compiler.frontir.standard_diagnostic_families.implicit_trait_proof
-- Trait resolution for implicit arguments must succeed when the instance
-- is uniquely determined. Failure must produce a clear diagnostic naming
-- the unresolved implicit, not a cryptic type mismatch.

--! mode check

-- Use fixture-local names so this test exercises resolution rather than
-- colliding with the Prelude's Show and Eq declarations.
trait Render (a : Type) =
    render : a -> String

-- Instance for Nat.
instance Render Nat =
    let render n = showInt (natToInt n)

-- A function that requires Render.
display : forall (a : Type). (@_ : Render a) -> a -> String
let display x = render x

-- POSITIVE TEST: instance is available; display must resolve the implicit.
test_nat_display : String
let test_nat_display = display (42 : Nat)

--! assertNoErrors

-- POSITIVE TEST: trait resolution with type polymorphism.
trait Same (a : Type) =
    same : a -> a -> Bool

instance Same Nat =
    let same x y = x == y

find_eq : forall (a : Type). (@_ : Same a) -> a -> a -> Bool
let find_eq x y = same x y

test_nat_eq : Bool
let test_nat_eq = find_eq (3 : Nat) (3 : Nat)

--! assertNoErrors

-- STATUS(58b5b0fe): PASS
