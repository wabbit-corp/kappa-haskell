-- Source issues: egraphs-good/egglog #386 (User Defined Generics),
--   egraphs-good/egglog #397 (Mutually recursive datatypes),
--   egraphs-good/egglog #298 (Clarifying Valid Types).
-- Spec: data_types.data_declarations (§10.1),
--       data_types.well_formedness (§10.4, strict positivity).
-- A `data` declaration's constructor signatures must be well-formed and the
-- recursive use of the type must respect strict positivity (no occurrence of
-- the type to the left of an arrow inside a constructor argument), otherwise
-- the elaborator must reject the declaration with
-- E_DATA_NOT_STRICTLY_POSITIVE.

module test

--! mode check

-- POSITIVE: ordinary recursive data type (positive recursion).
data Nat : Type =
    Zero
    Succ (n : Nat)

toInt : Nat -> Int
let toInt n =
    match n
    case Zero      -> 0
    case (Succ m)  -> toInt m + 1

-- POSITIVE: rose tree with List is strictly positive. `List`'s element
-- parameter is strictly positive, so recursive Rose values occur in stored
-- recursive positions.

data Rose (a : Type) : Type =
    Node a (List (Rose a))

-- NON-POSITIVE: the constructor field contains a negative occurrence of Bad
-- in the domain of a function. The field type `Bad -> Bad` is mixed overall,
-- with one negative and one positive occurrence.

data Bad : Type =                         --!! E_DATA_NOT_STRICTLY_POSITIVE
    MkBad (k : Bad -> Bad)

-- POSITIVE BUT NOT STRICTLY POSITIVE: the occurrence of BadCont crosses two
-- function domains, so the two variance reversals make it positive overall.
-- It is nevertheless not strictly positive because the recursive occurrence
-- is hidden in function-domain positions rather than stored as recursive
-- subdata.

data BadCont : Type =                     --!! E_DATA_NOT_STRICTLY_POSITIVE
    MkBadCont (k : (BadCont -> Int) -> Int)

--! assertDiagnosticCodes E_DATA_NOT_STRICTLY_POSITIVE, E_DATA_NOT_STRICTLY_POSITIVE
