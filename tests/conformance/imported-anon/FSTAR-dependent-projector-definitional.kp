-- Source issue: FSTAR-1526
-- Spec: core_semantics.definitional_equality
-- Projectors for dependent pair types (sigma types) must have a
-- definitional reduction: the projector applied to a constructor
-- must reduce to the projected component.

--! mode check

-- A dependent pair type.
data DPair (0 A : Type) (0 B : A -> Type) : Type =
    MkDPair : (x : A) -> (y : B x) -> DPair A B

-- The first projector must reduce definitionally.
dpair_fst : forall (A : Type) (B : A -> Type). DPair A B -> A
let dpair_fst p =
    match p
      case MkDPair x _ -> x

-- The second projector depends on the first.
dpair_snd : forall (A : Type) (B : A -> Type). (p : DPair A B) -> B (dpair_fst p)
let dpair_snd p =
    match p
      case MkDPair _ y -> y

-- The definitional equality dpair_fst (MkDPair a b) = a reduces to
-- `refl`. This states the reduction directly instead of relying on F*'s
-- surface subset-type coercion, which is not Kappa syntax.
check_fst_reduces :
    (a : Nat) -> dpair_fst (MkDPair a ()) = a
let check_fst_reduces a = refl

--! assertNoErrors

-- STATUS(58b5b0fe): PASS
