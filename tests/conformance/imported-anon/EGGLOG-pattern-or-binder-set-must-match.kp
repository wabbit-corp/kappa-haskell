-- Source issues: egraphs-good/egglog #94 (Parser might mishandle differently-named
--   values constrained to be equal),
--   egraphs-good/egglog #401 (Rewrite regardless of variant).
-- Spec: expressions.patterns.validity
--       (§17.2.3 — "Each alternative must bind the same set of names. Each
--       bound name must have definitionally equal types across alternatives.").
-- Or-patterns require each alternative to bind the same set of names. Kappa's
-- dedicated E_OR_PATTERN_BINDER_MISMATCH diagnostic identifies the malformed
-- alternatives directly, before either arm body is elaborated.

module test

--! mode check

data Math : Type =
    Num (n : Int)
    Var (s : String)
    Add (e1 : Math) (e2 : Math)
    Sub (e1 : Math) (e2 : Math)

-- POSITIVE: both alternatives bind `l` and `r` at the same types.
leftChild : Math -> Math
let leftChild m =
    match m
    case (Add l r | Sub l r) -> l
    case other               -> other

-- POSITIVE: nullary alternatives bind nothing on either side.
isLeaf : Math -> Bool
let isLeaf m =
    match m
    case (Num _ | Var _) -> True
    case _               -> False

-- NEGATIVE: alternatives bind different name sets.
mixed : Math -> Math
let mixed m =
    match m
    case (Add l r | Sub a b) -> l    --!! E_OR_PATTERN_BINDER_MISMATCH
    case other               -> other

-- NEGATIVE: one alternative binds a name the other does not.
onlyOne : Math -> Math
let onlyOne m =
    match m
    case (Add l r | Num _) -> l      --!! E_OR_PATTERN_BINDER_MISMATCH
    case other             -> other

--! assertErrorCount 2
--! assertDiagnosticCodes E_OR_PATTERN_BINDER_MISMATCH, E_OR_PATTERN_BINDER_MISMATCH
