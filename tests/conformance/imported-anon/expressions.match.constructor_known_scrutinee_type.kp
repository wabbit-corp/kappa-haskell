-- Source issue: Koka #9
-- Spec: modules.names.lexical_lookup
-- §7.1 binding-group formation permits at most one local declaration of a
-- given kind and spelling in one lexical scope. Expected scrutinee types do
-- not turn two same-scope constructor declarations into distinct bindings.

module test

--! mode check
--! assertDiagnosticFamily error kappa-hs.name.duplicate

data Foo : Type =
    FooA : Foo
    FooB : Foo

data Bar : Type =
    FooA : Bar    -- duplicate local constructor declaration
    BarB : Bar
