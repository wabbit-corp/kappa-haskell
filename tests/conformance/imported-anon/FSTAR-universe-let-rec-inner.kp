-- Source issue: FSTAR-786
-- Spec: types.universes.erasure_elaboration_time
-- TypeLevel variable must not leak from outer to inner let rec via de Bruijn index.

--! mode check

-- An outer polymorphic function contains an inner local function also polymorphic.
-- The inner function's type variable B must be independent of the outer A.
outer : forall (A : Type). A -> Unit
let outer x =
    let inner : forall (B : Type). B -> Unit = \y -> ()
    inner x

--! assertNoErrors

-- STATUS(8f860308): FAIL — promoted conformance regression: this Spec-correct test now reaches two unrelated E_UNIVERSE_CONSTRAINT_UNSATISFIABLE errors while finalizing std.prelude.arrayAsSized.
