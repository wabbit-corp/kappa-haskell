-- Stress test: a guarded case introduces guard-success evidence into the branch
-- Spec: expressions.match.guarded_cases_introduce_guard_success_evidence

--! mode check

-- requirePositive demands erased implicit evidence that n > 0; the boolean
-- proposition sugar elaborates to (n > 0) = True (§11.4.2).
requirePositive : (n : Int) -> (@0 p : n > 0) -> String
let requirePositive n = "positive: " ++ showInt n

-- POSITIVE: inside the guarded branch, the compiler knows n > 0 from the guard.
describeInt : Int -> String
let describeInt n =
    match n
    case n if n > 0 -> requirePositive n
    case _          -> "non-positive"

--! assertNoErrors

