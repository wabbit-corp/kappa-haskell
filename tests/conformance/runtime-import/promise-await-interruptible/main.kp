--! mode run
--! assertNoErrors
--! assertStdout "first-waiter:interrupted\ncomplete:T\nsecond-waiter:9\n"

-- Imported from:
--   Cats Effect DeferredSuite / concurrent get cancel before forcing
--   ZIO PromiseSpec / interrupted promise waiters do not complete the promise
-- Spec target: §18.1.9, awaitPromise is interruptible and completion remains
-- one-shot after a waiter is interrupted.
module main

import std.prelude.(type Exit(..), type Cause(..), type InterruptCause(..), type InterruptTag(..))

showBool : Bool -> String
let showBool b = if b then "T" else "F"

waiter : Promise Void Unit -> Promise Void Int -> UIO Int
let waiter ready p = do
    let ok <- completePromise ready (Success Unit)
    let _ = ok
    awaitPromise p

main : UIO Unit
let main = do
    let p <- newPromise
    let ready <- newPromise
    let first <- fork (waiter ready p)
    awaitPromise ready
    interrupt first
    let ex1 <- await first
    match ex1
      case Success v -> printlnString ("first-waiter:value:" ++ showInt v)
      case Failure (Interrupt (InterruptCause Requested _)) -> printlnString "first-waiter:interrupted"
      case Failure _ -> printlnString "first-waiter:other"
    let ok <- completePromise p (Success 9)
    printlnString ("complete:" ++ showBool ok)
    let second <- fork (awaitPromise p)
    let ex2 <- await second
    match ex2
      case Success v -> printlnString ("second-waiter:" ++ showInt v)
      case Failure _ -> printlnString "second-waiter:failed"
