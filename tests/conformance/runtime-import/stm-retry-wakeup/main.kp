--! mode run
--! assertNoErrors
--! assertStdout "woke:12\n"

-- Imported from:
--   ZIO ZSTMSpec / retry suspends and resumes when a read TVar changes
-- Spec target: §18.1.13, retry aborts the transaction attempt and suspends
-- until a TVar read by that attempt is changed.
module main

consumer : TVar Int -> STM Int
let consumer tv = do
    let v <- readTVar tv
    check (v > 0)
    readTVar tv

main : UIO Unit
let main = do
    let tv <- atomically (newTVar 0)
    let fiber <- fork (atomically (consumer tv))
    cede
    atomically (writeTVar tv 12)
    let ex <- await fiber
    match ex
      case Success v -> printlnString ("woke:" ++ showInt v)
      case Failure _ -> printlnString "failed"
