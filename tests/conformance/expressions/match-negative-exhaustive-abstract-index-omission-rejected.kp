module main

-- Kappa analogue: §17.1.1 exhaustiveness under an ABSTRACT GADT index. Under the
-- free skolem `f`, the uncovered arms `Always`/`Also : Choice True` are NOT
-- provably-Empty (they are inhabited at f := True), so omitting them is NOT
-- exhaustive and MUST be rejected. The §30.2.7 query must report Unknown — not
-- Empty — for a ctor-result-vs-rigid-index unify-failure, otherwise a reachable
-- omitted arm would be wrongly accepted as covered.
-- Spec: §17.1.1, §30.2.7

--! mode check

data Choice (flag : Bool) : Type =
    Always : Choice True
    Also : Choice True
    Never : Choice False

-- NEGATIVE: covering only `Never` under the abstract index `f` is non-exhaustive
-- — Always/Also remain reachable (at f := True).
bad : forall (f : Bool). Choice f -> Int
let bad c =
    match c
      case Never -> 0

--! assertErrorCount 1
--! assertDiagnosticMatch exhaustive|non-exhaustive|missing
