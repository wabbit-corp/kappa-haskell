module main

-- Kappa analogue: `-> impossible` must be rejected on a genuinely reachable
-- arm. Under a `Choice True` scrutinee, `Always : Choice True` IS inhabited, so
-- its refined fiber is Contractible (not Empty) and the §30.2.7 query gives no
-- emptiness fact. The body `impossible` is therefore reachable (§17.1.4).
-- Spec: §17.1.4, §30.2.7

--! mode check

data Choice (flag : Bool) : Type =
    Always : Choice True
    Also : Choice True
    Never : Choice False

-- NEGATIVE: `Always -> impossible` is rejected — Always is reachable.
badImpossible : Choice True -> Int
let badImpossible c =
    match c
      case Always -> impossible
      case Also -> 2
      case Never -> impossible

--! assertErrorCount 1
--! assertDiagnosticMatch impossible|reachable|unreachable
