module main

-- Kappa analogue: the §30.2.7 inhabitance-summary query proves a Void-typed
-- scrutinee uninhabited, so `match v case impossible` (§17.1.5) is accepted —
-- the empty remainder is structurally uninhabited.
-- Spec: §17.1.4, §17.1.5, §30.2.7

--! mode check

-- A zero-constructor data type. Its §30.2.7 summary is Empty (a sum over no
-- reachable arms).
data Void2 : Type

-- POSITIVE: `case impossible` discharges the empty remainder of a Void2 match.
absurdImpossible : forall (a : Type). Void2 -> a
let absurdImpossible v =
    match v
    case impossible

-- POSITIVE: the same holds when the empty scrutinee is reached via a field of
-- another type (Void2 used structurally).
data Wrap : Type =
    MkWrap (hole : Void2)

absurdWrap : forall (a : Type). Wrap -> a
let absurdWrap w =
    match w
      case (MkWrap v) ->
        match v
        case impossible

--! assertNoErrors
--! assertType absurdImpossible forall (a : Type). Void2 -> a
--! assertType absurdWrap forall (a : Type). Wrap -> a
