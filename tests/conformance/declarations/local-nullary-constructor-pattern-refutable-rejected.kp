-- §9.1.2/§9.3: a nullary constructor spelling must remain a pattern candidate
-- until constructor resolution. This two-constructor fiber makes the binding
-- refutable and therefore rejects it.
--! mode check
--! assertErrorCount 1
--! assertDiagnostic error E_REFUTABLE_LET_PATTERN

module main

data Flag : Type =
    Off
    On

answer : Int
let answer =
    block
        let Off = On
        7
