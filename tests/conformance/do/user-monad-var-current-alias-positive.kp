module main

--! mode check
--! assertNoErrors

-- §18.6.2: a current-value read bound to a simple local aliases the same
-- VarCurrent representative for arbitrary lawful MonadRef carriers.

data Wrap (a : Type) : Type =
    MkWrap (runWrap : UIO a)

instance Applicative Wrap =
    let pureA x = MkWrap (pureIO x)
    let liftA2 f ma mb =
        match ma
        case MkWrap ioa ->
            match mb
            case MkWrap iob ->
                MkWrap (bindIO ioa (\a -> bindIO iob (\b -> pureIO (f a b))))

instance Monad Wrap =
    let (>>=) ma f =
        match ma
        case MkWrap ioa ->
            MkWrap (bindIO ioa (\a ->
                match f a
                case MkWrap iob -> iob))

instance MonadRef Wrap =
    let Ref = __IORef
    let newRef x = MkWrap (__ioNewRef x)
    let readRef r = MkWrap (__ioReadRef r)
    let writeRef r x = MkWrap (__ioWriteRef r x)

data Cell : Type =
    Empty
    Full (val : Int)

foo : Wrap Int
let foo = do
    var cell : Cell = Full 9
    let snap = cell
    if snap is Full then
        pureA cell.val
    else
        pureA 0
