--! mode check
--! assertErrorCount 1
--! assertDiagnosticMatch exhaustive|non-exhaustive|missing

module main

data Cell : Type =
    Empty
    Full (val : Int)

forget : Ref Cell -> Bool
let forget r = True

bad : UIO Unit
let bad = do
    var cell : Cell = Full 1
    if cell is Full then
        if forget (ref cell) then
            printlnString "escaped"
        else
            printlnString "not escaped"
        let n =
            match cell
            case Full v -> v
        printlnString (showInt n)
    else
        printlnString "empty"
