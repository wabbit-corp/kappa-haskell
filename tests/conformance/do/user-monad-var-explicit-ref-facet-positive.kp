--! assertNoErrors
--! assertExecute main 5

module main

data Wrap (0 a : Type) : Type =
    MkWrap (runWrap : UIO a)

instance Applicative Wrap =
    let pure x = MkWrap (pureIO x)
    let liftA2 f ma mb =
        match ma
        case MkWrap ioa ->
            match mb
            case MkWrap iob ->
                MkWrap (bindIO ioa (\a -> bindIO iob (\b -> pureIO (f a b))))

instance Monad Wrap =
    let (>>=) ma f =
        match ma
        case MkWrap ioa ->
            MkWrap (bindIO ioa (\a ->
                match f a
                case MkWrap iob -> iob))

instance MonadRef Wrap =
    let Ref = __IORef
    let newRef x = MkWrap (__ioNewRef x)
    let readRef r = MkWrap (__ioReadRef r)
    let writeRef r x = MkWrap (__ioWriteRef r x)

direct : Wrap Int
let direct = do
    var x = 1
    let a <- readRef (ref x)
    writeRef (ref x) (addInt a 1)
    let b <- readRef (ref x)
    pure (addInt a b)

generic : forall (m : (0 A : Type) -> Type). (@_ : Monad m) -> (@_ : MonadRef m) -> Int -> m Int
let generic n : m Int = do
    var x = n
    let a <- readRef (ref x)
    writeRef (ref x) (addInt a 1)
    readRef (ref x)

main : UIO Int
let main =
    match direct
    case MkWrap ioDirect ->
        bindIO ioDirect (\d ->
            match (generic 1 : Wrap Int)
            case MkWrap ioGeneric ->
                bindIO ioGeneric (\g -> pureIO (addInt d g)))
