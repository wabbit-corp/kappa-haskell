module main

-- §18.6.2 NEGATIVE: once ref x escapes through an ordinary binding, later
-- reads of x remain ordinary reads and must not use VarCurrent flow facts. The
-- write through r is intentionally not a direct recognized writeRef (ref x).
--! mode check
--! assertErrorCount 1
--! assertDiagnosticMatch exhaustive|non-exhaustive|missing

data Cell : Type =
    Empty
    Full (val : Int)

bad : UIO Unit
let bad = do
    var cell : Cell = Full 1
    if cell is Full then
        let r = ref cell
        writeRef r Empty
        let n =
            match cell
            case Full v -> v
        printlnString (showInt n)
    else
        printlnString "empty"
