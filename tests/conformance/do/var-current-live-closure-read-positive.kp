-- §18.6.1: a bare mutable-variable occurrence inside a user-written lambda
-- is accepted when the lambda body has its own do block. The read is live at
-- call time, not a hoisted snapshot.
--! mode run
--! assertStdout "1\n2\n"

module main

main : UIO Unit
let main = do
    var x = 1
    let live = \() -> do
        x
    let a <- live ()
    x = 2
    let b <- live ()
    printlnString (show a)
    printlnString (show b)
