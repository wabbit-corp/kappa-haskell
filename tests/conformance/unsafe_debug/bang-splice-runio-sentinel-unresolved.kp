module main

-- §18.3.1 / §4.5 SOUNDNESS (NEGATIVE): the prior implementation desugared `!e`
-- to an internal `__runIO!` splice-head whose name the lexer "could not
-- produce". But backtick-quoted identifiers (Lexer §) accept an ARBITRARY
-- payload, so `` `__runIO!` `` IS source-spellable. The spec-correct bind-lift
-- removes the sentinel mechanism entirely: there is no `__runIO!` global, so
-- the name resolves to NOTHING (E_NAME_UNRESOLVED).

dead : Void
let dead = `__runIO!` (throwIO Unit)

--! assertDiagnostic error E_NAME_UNRESOLVED
