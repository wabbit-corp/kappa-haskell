module main

-- §4.5 SOUNDNESS (NEGATIVE, same composition class as the __runIO 6th hole):
-- '__arrayIndexUnsafe : forall a. Array a -> Int -> a' extracts an element
-- PURELY. Its result 'a' is pinned to the 'Array a' argument, so the original
-- free-RESULT door-survey passed it over. But '__arrayFromList : forall a.
-- List a -> Array a' applied to the empty list '[]' builds an 'Array (free a)'
-- with NO element (a genuinely empty array — the producer is sound), and
-- indexing it liberates the free 'a' at ANY proposition:
-- 'let bad : (=) True False = __arrayIndexUnsafe (__arrayFromList []) 0'
-- type-checks, and 'subst' over a discriminator family then inhabits 'Void'.
-- Users have the safe 'arrayIndex'/'Array.get' wrappers (which return Option or
-- trap); the bare unsafe prim is gated out of ordinary code. A plain module
-- naming it is rejected.

bad : (=) True False
let bad = __arrayIndexUnsafe (__arrayFromList []) 0

--! assertDiagnostic error E_UNSAFE_INTRINSIC_GATED
