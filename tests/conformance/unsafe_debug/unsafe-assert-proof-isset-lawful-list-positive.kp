module main

-- §11.4/§14.4: companion to the `String` positive, over the PARAMETRIC set
-- carrier `List b` (`instance IsSet (List a)`).  The law equands are stuck
-- recursive `listAppend` applications on neutral arguments, so the carrier
-- cannot be read off the equand value structurally; the IsProp-under-Pi solver
-- recovers it from the law binders (whose type is the carrier) and resolves
-- `IsSet (List b)` parametrically before threading it into `isPropEq`.

trait LawfulSemigroup (a : Type) =
    combine : a -> a -> a
    combineAssoc :
        forall (x : a) (y : a) (z : a).
        (=) (combine (combine x y) z) (combine x (combine y z))

instance LawfulSemigroup (List b) =
    let combine p q = listAppend p q
    let combineAssoc = unsafeAssertProof "List.combine is associative"

--! mode check
--! allow_unsafe_assert_proof
--! assertNoErrors
--! assertAuditLedger unsafeAssertProof
