module main

data Byte : Type =
    Byte

data Array (n : Nat) (a : Type) : Type =
    Array

type SizedBuffer = (len : Nat, buffer : Array this.len Byte, checksum : Nat)

bad : SizedBuffer -> SizedBuffer
let bad buf = buf.{ len = 20 }

