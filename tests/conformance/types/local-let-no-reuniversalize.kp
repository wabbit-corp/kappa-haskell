--! mode check
--! assertNoErrors

-- §11.3.3: the free lowercase variable in the outer signature is implicitly
-- universalized there. Once in scope, it is not re-universalized in the
-- block-local signature: `v : a` resolves to that enclosing binder, so the
-- argument `x : a` checks.
module main

wrap : (1 x : a) -> a
let wrap x =
    block
        let v : a = x
        v
