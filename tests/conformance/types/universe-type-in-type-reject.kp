--! assertDiagnostic error E_UNIVERSE_CONSTRAINT_UNSATISFIABLE

-- §11.1: a record carrying a `Type`-valued field inhabits Type1, so
-- ascribing it to Type0 is a universe inconsistency: a strong-Σ storing a
-- type must sit strictly above the universe of that type. Cumulativity is one-directional
-- (Type m ≤ Type n only when m ≤ n), so Type1 is not accepted at Type0.
module main

recInType0 : Type0
let recInType0 = (ordinary ty : Type,)
