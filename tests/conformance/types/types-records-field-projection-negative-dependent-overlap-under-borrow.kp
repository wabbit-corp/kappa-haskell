module main

data Byte : Type =
    Byte

data Array (n : Nat) (a : Type) : Type =
    Array

type Sized = (1 len : Nat, 1 buffer : Array this.len Byte)

bad : (1 r : Sized) -> (Nat, Sized)
let bad r =
    block
        let n =
            block
                let & b = r.buffer
                r.len
        (n, r)

--! assertErrorCount 1
--! assertDiagnosticCodes E_QTT_BORROW_OVERLAP
