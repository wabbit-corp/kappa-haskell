-- LLVM parity: cooperative scheduling — sleepFor (a Duration, single-agent
-- runtime advances instantly) and cede.  fork/await drive two fibers.
module main

worker : Int -> UIO Unit
let worker n = do
    sleepFor (millis 1)
    cede
    printlnString (showInt n)

main : UIO Unit
let main = do
    let f1 <- fork (worker 1)
    let r1 <- await f1
    let f2 <- fork (worker 2)
    let r2 <- await f2
    printlnString "done"
