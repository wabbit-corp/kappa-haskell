-- Milestone E: a do-block as a FUNCTION BODY, called from main's do-block.
-- `shout n` returns a do-block action; main sequences it (`let _ <- shout 7`), so the
-- action runs to completion (printing 7 then !) before main continues with
-- "done".  Effect order: 7, !, done.
module main

shout : Integer -> UIO Unit
let shout n = do
    printlnString (showInt n)
    printlnString "!"

main : UIO Unit
let main = do
    let _ <- shout 7
    printlnString "done"
