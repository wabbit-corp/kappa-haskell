-- M2: two mutually-referencing top-level CAFs (arity-0 globals).  `base` is a
-- pure-prim CAF; `answer` is another CAF that references `base` via CGlob and
-- shows it; `main` prints `answer`.  Each accessor (kg_*) is emitted once and
-- memoised; the cross-global call links base <- answer <- main.  Prints "42".
module main

base : Int
let base = addInt 40 2

answer : String
let answer = showInt base

main : UIO Unit
let main = printlnString answer
