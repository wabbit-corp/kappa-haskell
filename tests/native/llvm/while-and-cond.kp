-- LLVM-backend parity regression for mutable-var current reads through
-- short-circuiting operators.
--
-- `(&&) : Bool -> Thunk Bool -> Bool` and `(||) : Bool -> Thunk Bool -> Bool`
-- (Prelude) wrap their RHS in a `Thunk` (a `CThunkE`).  The source uses bare
-- mutable-variable reads around those operators; the do-item lift must insert
-- the reads and compile them consistently in the C and LLVM do-kernels.
--
-- The RHS remains short-circuited at runtime (an `&&` with a False LHS / a `||`
-- with a True LHS), so interp == C == LLVM agree on output.
--
-- After the counting loop `i == n == 3`, so:
--   b1 = eqInt 3 99 (False) && (var-reading thunk)  -> short-circuits -> "b1-no"
--   b2 = eqInt 3 3  (True)  || (var-reading thunk)   -> short-circuits -> "b2-yes"
--
-- Expected stdout:
--   0
--   1
--   2
--   b1-no
--   b2-yes
module main

main : UIO Unit
let main = do
    var i = 0
    var n = 3
    -- A counting loop whose `&&` condition reads `i` and thunks a literal RHS.
    while (ltInt i n && ltInt 0 1) do
        printlnString (showInt i)
        i = addInt i 1
    -- `&&` with a False LHS: its RHS is never forced.
    let b1 = eqInt n 99 && ltInt i n
    -- `||` with a True LHS: same, the var-reading thunk RHS is never forced.
    let b2 = eqInt n 3 || ltInt i n
    printlnString (if b1 then "b1-yes" else "b1-no")
    printlnString (if b2 then "b2-yes" else "b2-no")
