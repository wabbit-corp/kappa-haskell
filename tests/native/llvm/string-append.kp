-- Milestone B: stringAppend (kp_stringAppend) of two String literals — a
-- pure-direct prim newly added to the LLVM table.  Combined with a nested
-- append so two saturated kp_stringAppend calls chain.  Prints "hello world".
module main
main : UIO Unit
let main = printlnString (stringAppend (stringAppend "hello" " ") "world")
