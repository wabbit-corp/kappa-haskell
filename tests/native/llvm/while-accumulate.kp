-- Milestone G: accumulation into a `var` across a `while` loop (no per-iteration
-- print — the loop runs purely for its mutation, then the sum is printed once).
-- Exercises a longer loop (sum 1..10 = 55) so the `writeRef`/`readRef` action
-- re-evaluation is the only thing producing the right total.  Expected: `55\n`.
module main

main : UIO Unit
let main = do
    var i = 1
    var acc = 0
    while leInt i 10 do
        acc = addInt acc i
        i = addInt i 1
    printlnString (showInt acc)
