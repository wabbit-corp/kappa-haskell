-- LLVM parity: fork/await on the M:N runtime, plus the Exit match.  `await`
-- establishes a happens-before edge so the output is deterministic.
module main

main : UIO Unit
let main = do
    let f1 <- fork (printlnString "first")
    let _ <- await f1
    let f2 <- fork (ioPure 42)
    let r <- await f2
    match r
    case Success v -> printlnString (showInt v)
    case Failure c -> printlnString "failed"
