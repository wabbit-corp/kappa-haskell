-- §19.5/§18.8.3 `using pat <- acquire`: binds the resource (borrowed) for the
-- rest of the do-block and attaches its `release` to the protected scope, which
-- runs on scope exit in LIFO order with defers. Two nested `using` items here
-- exercise the LIFO release ordering on normal completion (release 2 before
-- release 1). Non-suspending, so it builds on interp == C == LLVM.
module main

data Res : Type = MkRes (rid : Int)

instance Releasable (IO e) Res =
    let release r = match r case MkRes i -> printlnString (stringAppend "release " (showInt i))

acquireRes : Int -> UIO Res
let acquireRes i = do
    printlnString (stringAppend "acquire " (showInt i))
    pure (MkRes i)

main : UIO Unit
let main = do
    using a <- acquireRes 1
    using b <- acquireRes 2
    printlnString "body"
