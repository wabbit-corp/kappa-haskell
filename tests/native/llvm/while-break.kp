-- Milestone G: a `while` loop with an early `break`.  The condition `ltInt i 10`
-- would run ten times, but when `i` reaches 5 the `break` (a `krt2_break()`
-- action) exits the innermost `krt2_while` (rt.c KK_LOOP / RK_BREAK).  Expected
-- stdout: `0\n1\n2\n3\n4\nstopped at 5\n`.
module main

main : UIO Unit
let main = do
    var i = 0
    while ltInt i 10 do
        if eqInt i 5 then
            break
        printlnString (showInt i)
        i = addInt i 1
    printlnString (stringAppend "stopped at " (showInt i))
