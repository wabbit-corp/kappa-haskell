-- Milestone D: a DEEP tail-recursive function — the trampoline / kbounce proof.
-- The recursive call `countdown (subInt n 1)` is in TAIL position, so it lowers
-- (via compileTail) to `kbounce(kg_countdown(), subInt n 1)` rather than a
-- nested kapp; the driving kapp's trampoline drains the bounce, so the C stack
-- stays CONSTANT no matter how deep the recursion.
--
-- 500_000 iterations is chosen to (a) sit within the interpreter's normalization
-- fuel (so interp == C == LLVM holds in the parity harness) while (b) being far
-- past the ~hundreds-of-thousands of C frames a NON-trampolined lowering would
-- overflow at.  The native LLVM binary additionally survives 5_000_000 by hand —
-- conclusive evidence the bounce is load-bearing.  Returns 42 (the base value),
-- proving the recursion ran all the way down.
module main

countdown : Int -> Int
let countdown n decreases n =
    if leInt n 0 then 42 else countdown (subInt n 1)

main : UIO Unit
let main = printlnString (showInt (countdown 500000))
