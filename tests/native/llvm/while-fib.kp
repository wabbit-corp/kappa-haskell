-- Milestone G fix: a `let` whose rhs reads TWO `var`s in one expression
-- (`let t = addInt a b`). The checker lifts both current-value reads to
-- preceding MonadRef.readRef binds, so LLVM receives a pure KLet and the loop
-- re-reads each cell through the CK action tree. Iterative fib(10) = 55.
module main

main : UIO Unit
let main = do
    var a = 0
    var b = 1
    var i = 0
    while ltInt i 10 do
        let t = addInt a b
        a = b
        b = t
        i = addInt i 1
    printlnString (showInt a)
