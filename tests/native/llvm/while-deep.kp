-- Milestone G: a DEEP `while` loop — 1,000,000 iterations that must NOT
-- stack-overflow.  `krt2_while` is CK-machine-driven (rt.c OP_WHILE → KK_LOOP
-- re-runs `iterate` in place), so each iteration pops its bind frame and the
-- spine stays bounded no matter how many times the loop runs — the loop analogue
-- of the `kbounce` trampoline that makes deep tail recursion stack-safe.  Sums
-- 0+1+…+999999 = 499999500000 and prints it.  Expected: `499999500000\n`.
module main

main : UIO Unit
let main = do
    var i = 0
    var acc = 0
    while ltInt i 1000000 do
        acc = addInt acc i
        i = addInt i 1
    printlnString (showInt acc)
