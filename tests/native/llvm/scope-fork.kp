-- LLVM parity: structured concurrency — newScope/forkIn/awaitPromiseExit/
-- shutdownScope.  A child forked into a scope blocks on a never-completed
-- promise; shutdownScope interrupts + awaits it before returning.
module main

main : UIO Unit
let main = do
    s <- newScope
    p <- newPromise
    f <- forkIn s (awaitPromiseExit p)
    shutdownScope s
    printlnString "drained"
