-- Milestone G: early `return` out of a `while` loop, in the program's entry
-- function.  `main` counts up, printing each value, and `return`s as soon as the
-- running square reaches the threshold — `krt2_return(())` (rt.c OP_RETURN /
-- RK_RETURN) unwinds the fiber, so the lines AFTER the loop never run.  The
-- loop prints 0..4 then returns at i = 5 (5*5 = 25 >= 20), so `done` is never
-- printed.  Expected stdout: `0\n1\n2\n3\n4\n`.
module main

main : UIO Unit
let main = do
    var i = 0
    while ltInt i 1000 do
        if leInt 20 (mulInt i i) then
            return
        printlnString (showInt i)
        i = addInt i 1
    printlnString "done"
