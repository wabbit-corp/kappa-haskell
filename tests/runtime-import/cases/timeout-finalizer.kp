--! mode run
--! assertNoErrors
--! assertStdout "timeout-cleanup\ntimed-out\n"

-- Imported from:
--   Cats Effect IOSuite / timeout invokes finalizers on timed out things
-- Spec target: §18.1.6, timeout interrupts the running computation and waits
-- for all finalizers before returning Timeout.
module main

slow : UIO Int
let slow = do
    defer (printlnString "timeout-cleanup")
    sleepFor (seconds 10)
    ioPure 1

let timed = do
    v <- timeout (millis 20) slow
    printlnString ("value:" ++ showInt v)

main : UIO Unit
let main = do
    catchIO timed (\err -> printlnString "timed-out")
