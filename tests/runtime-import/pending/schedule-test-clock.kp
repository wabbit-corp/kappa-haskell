--! mode run
--! assertNoErrors
--! assertStdout "recurs0:1\nrecurs2:3\nretry-once:2\ntest-clock:woke\n"

-- Pending class: library-proposal (`std.schedule`, `std.test_clock`)
-- Pending import from zio ScheduleSpec and scheduler/test-clock suites:
--   - recurs zero/positive semantics
--   - retry-once semantics
--   - deterministic clock adjustment for sleeps and time-based schedules
--
-- This needs standard schedule combinators plus a deterministic test clock.

module main

import std.schedule.(term recurs, term once, term repeatSchedule, term retrySchedule)
import std.test_clock.(term withTestClock, term adjustTestClock)
import std.time.(term seconds)

bump : Ref Int -> UIO Unit
let bump ref = do
  n <- readRef ref
  writeRef ref (n + 1)

failOnceThenSucceed : Ref Int -> IO String Unit
let failOnceThenSucceed ref = do
  n <- readRef ref
  writeRef ref (n + 1)
  if n == 0 then
    raise "retry"
  else
    ioPure Unit

main : UIO Unit
let main = do
  r0 <- newRef 0
  repeatSchedule (recurs 0) (bump r0)
  n0 <- readRef r0
  printlnString ("recurs0:" ++ showInt n0)

  r2 <- newRef 0
  repeatSchedule (recurs 2) (bump r2)
  n2 <- readRef r2
  printlnString ("recurs2:" ++ showInt n2)

  rr <- newRef 0
  _ <- retrySchedule once (failOnceThenSucceed rr)
  attempts <- readRef rr
  printlnString ("retry-once:" ++ showInt attempts)

  withTestClock (do
    gate <- newPromise @Unit
    sleeper <- fork (do
      sleepFor (seconds 5)
      completePromise gate (Success Unit)
    )
    adjustTestClock (seconds 5)
    awaitPromise gate
    printlnString "test-clock:woke"
    interrupt sleeper
  )
