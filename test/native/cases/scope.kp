-- §18.1.8/§32.2.3 structured concurrency on the native runtime (CPS do-kernel,
-- Stage 3).  A child is forked INTO an explicit scope and blocks forever on a
-- never-completed promise; `shutdownScope` must interrupt it and await its
-- termination before returning — so the program drains and prints, rather than
-- hanging or leaking the child.  Driven through the runtime's
-- OP_NEW_SCOPE/OP_FORK_IN/OP_SHUTDOWN_SCOPE nodes; must match the interpreter.
module main

main : UIO Unit
let main = do
    s <- newScope
    p <- newPromise
    f <- forkIn s (awaitPromiseExit p)
    shutdownScope s
    printlnString "drained"
