--! mode run
--! assertNoErrors
--! assertStdout "acquired\nreleased-on-interrupt\ninterrupted\n"

-- §18.1.12 bracket finalizer-on-interrupt. `bracketM` runs its acquire and the
-- finalizer-registration as one MASKED (uninterruptible) region via `mask`, so a
-- fiber interrupted while parked in `use` is GUARANTEED to have registered its
-- release first — the release therefore RUNS on interrupt (ZIO/bracket
-- semantics). Before the masking fix the interrupt could be delivered between
-- acquire returning and the release being installed, skipping the finalizer.
--
-- A Promise handshake makes the parent interrupt only after the child reaches
-- `use` and is about to park in the sleep; the interrupt is then taken at that
-- suspension point and unwinds through the registered release (run masked,
-- §32.2.5).
module main

import std.prelude.(type Exit(..))

weakenVoidIO : forall (e : Type) (a : Type). UIO a -> IO e a
let weakenVoidIO act =
    catchIO act (\v -> ioPure (absurd v))

acquireR : IO String Integer
let acquireR = do
    printlnString "acquired"
    ioPure 1

releaseR : Integer -> IO String Unit
let releaseR r = printlnString "released-on-interrupt"

useSleep : Promise Void Unit -> Integer -> IO String Integer
let useSleep ready r = do
    let _ <- weakenVoidIO (completePromise ready (Success ()))
    sleepFor (seconds 10)
    ioPure r

main : UIO Unit
let main = do
    let ready <- newPromise
    let f <- fork (bracket acquireR releaseR (useSleep ready))
    let _ <- awaitPromise ready
    interrupt f
    let ex <- await f
    match ex
      case Success v -> printlnString "completed"
      case Failure c -> printlnString "interrupted"
