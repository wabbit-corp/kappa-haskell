-- §29.1 std.atomic under the real nproc-worker scheduler: the LOAD-BEARING
-- atomicity test.  N fibers each do M `atomicFetchAdd 1` on ONE shared
-- AtomicRef; with a correct boxed atomic cell the final value is EXACTLY N*M
-- with no lost updates, regardless of how the workers interleave across the
-- worker pool.
--
-- This is deterministic by design: the answer is N*M iff atomicity holds, so the
-- printed total matches under the interpreter (single-agent: trivially exact)
-- AND the native multi-worker runtime (exact iff the fetch-add is really atomic).
-- The OLD plain-Ref lowering RACED here and lost updates; the mutex-protected
-- AtomicRef wiring does not.  N*M = 16 * 4000 = 64000.
module main

import std.atomic.(type AtomicRef)
import std.atomic.(ctor RmwSeqCst, ctor LoadSeqCst)
import std.atomic.(term newAtomicRef, term atomicLoad, term atomicFetchAdd)

-- Do M fetch-adds of 1 on the shared cell.
worker : AtomicRef Integer -> Integer -> UIO Unit
let worker cell m =
    if leInt m 0
    then pure ()
    else do
        let oldValue <- atomicFetchAdd RmwSeqCst cell 1
        worker cell (subInt m 1)

-- Fork `n` workers (each doing `m` increments), then await them all.  Forking
-- the rest BEFORE awaiting this one lets all n run concurrently; the awaits then
-- establish the happens-before edge so the final load sees every increment.
spawnAll : AtomicRef Integer -> Integer -> Integer -> UIO Unit
let spawnAll cell n m =
    if leInt n 0
    then pure ()
    else do
        let f <- fork (worker cell m)
        spawnAll cell (subInt n 1) m
        let result <- await f
        pure ()

main : UIO Unit
let main = do
    let cell <- newAtomicRef 0
    spawnAll cell 16 4000
    let total <- atomicLoad LoadSeqCst cell
    printlnString (showInt total)        -- 64000, exactly, with no lost updates
