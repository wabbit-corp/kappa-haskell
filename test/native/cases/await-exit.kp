-- §18.1.4 await's outcome is an `Exit e a` the RUNTIME builds (krt2i_success/
-- failure).  Matching it from .kp dispatches by the ctor's fixed KCT_ id, so the
-- runtime-delivered `Success`/`Failure` must carry those ids (kappart.h) — else
-- the match is non-exhaustive.  Driven through the CPS do-kernel; ≡ interpreter.
module main

import std.prelude.(type Exit(..))

main : UIO Unit
let main = do
    let f <- fork (ioPure 42)
    let r <- await f
    match r
    case Success v -> printlnString (showInt v)
    case Failure c -> printlnString "failed"
