-- A projected field named readRef is not, by itself, MonadRef evidence.
-- The scalar-loop recognizer must not treat fake.readRef as a mutable-cell read.
module main

type Fake = (readRef : Ref Int -> UIO Int)

fake : Fake
let fake =
    ( readRef = \r -> ioPure 1
    )

main : UIO Unit
let main = do
    var x = -1
    while ltInt x 0 do
        let v <- fake.readRef (ref x)
        x = addInt v 1
    printlnString (showInt x)
