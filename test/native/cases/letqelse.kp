-- §18.2.1 `let?` else with a refutation RESIDUE pattern.  The residue is
-- matched against the scrutinee: a residue that matches binds its variables
-- and runs the else body; an irrefutable residue always binds.  (A refutable
-- residue that does NOT match is a runtime error — covered by letqmiss.kp,
-- which must abort like the interpreter rather than bind the wrong fields.)
-- Native output must match the interpreter.
module main

data W : Type = P (a : Int) | Q (a : Int) | R

testQ : UIO Unit
let testQ = do
    let? P n = Q 99 else Q r -> do
        printlnString (stringAppend "got-q=" (showInt r))
        return ()

testOther : UIO Unit
let testOther = do
    let? P m = R else other -> do
        printlnString "irrefutable-else"
        return ()

testR : UIO Unit
let testR = do
    let? P k = R else R -> do
        printlnString "matched-R"
        return ()

main : UIO Unit
let main = do
    -- Each failed binding returns from its helper, because §18.2.1 requires
    -- the failure arm to be terminal with respect to the following do-items.
    testQ
    testOther
    testR
    printlnString "done"
