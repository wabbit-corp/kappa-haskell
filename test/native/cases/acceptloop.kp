-- CPS LOOP FAMILY (CPS-DESIGN §4): the canonical ACCEPT-LOOP shape
-- `while running { c <- <await a connection>; fork (handle c) }`.  The
-- suspending bind (`await`) is NESTED in the loop body, so the block is
-- CPS-lowered (OP_WHILE/KK_LOOP) and the loop body actually parks on each
-- `await`.  The `running` Bool var is a selected builtin-IO MonadRef cell,
-- re-read each iteration via the selected read action (OP_READ_REF in this
-- builtin path) in the condition and flipped to False with `:=` (selected
-- write action / OP_WRITE_REF) to terminate — so the loop does not spin forever and the
-- post-loop print observes the final value.  Deterministic ⇒ ≡ interpreter.
module main

import std.prelude.(type Exit(..))

-- "handle a connection": print its id.
handle : Int -> UIO Unit
let handle c = printlnString (stringAppend "handled " (showInt c))

main : UIO Unit
let main = do
    var running = True
    var next = 0
    while running do
        -- "accept": a forked fiber yields the next connection id; await it.
        let accepted : UIO Int = ioPure next
        let af <- fork accepted
        let ec <- await af
        match ec
          case Success c -> do
            let hf <- fork (handle c)
            let _ <- await hf
          case Failure _ -> printlnString "accept failed"
        next = addInt next 1
        if leInt next 3 then
            running = True
        else
            running = False
    printlnString "server stopped"
