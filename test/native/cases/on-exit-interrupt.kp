--! mode run
--! assertNoErrors
--! assertStdout "body-ok\nexit:Success\nnormal-done\nint:Requested\nexit:Interrupt\ninterrupted\n"

-- §18.1.4 onExit / onInterrupt (reason-carrying finalizers):
--   * onExit runs on EVERY exit, receiving the reconstructed terminal Exit;
--   * onInterrupt runs ONLY when the scope exits via interrupt, with the cause.
-- The interrupt path uses a Promise handshake rather than timing guesses: the
-- child completes `ready` from inside the protected body, after both finalizers
-- have been registered and before it parks in `sleepFor`.
module main

import std.prelude.(type Exit(..), type Cause(..), type InterruptCause(..), type InterruptTag(..))

classifyExit : forall (a : Type). Exit Void a -> String
let classifyExit ex = match ex
    case Success _ -> "exit:Success"
    case Failure c -> match c
      case Interrupt _ -> "exit:Interrupt"
      case Fail _ -> "exit:Fail"
      case _ -> "exit:other"

classifyCause : InterruptCause -> String
let classifyCause ic = match ic
    case InterruptCause Requested _ -> "int:Requested"
    case InterruptCause _ _ -> "int:other"

okBody : UIO Unit
let okBody = printlnString "body-ok"

-- normal completion: onExit fires with Success; onInterrupt is SKIPPED.
normalChild : UIO Unit
let normalChild = onInterrupt (onExit okBody (\ex -> printlnString (classifyExit ex))) (\ic -> printlnString (classifyCause ic))

sleepBody : Promise Void Unit -> UIO Unit
let sleepBody ready = do
    let _ <- completePromise ready (Success ())
    sleepFor (seconds 10)

-- interrupt path: onInterrupt fires with the cause (inner, LIFO first); onExit
-- then sees the Interrupt exit (outer).
sleeper : Promise Void Unit -> UIO Unit
let sleeper ready = onExit (onInterrupt (sleepBody ready) (\ic -> printlnString (classifyCause ic))) (\ex -> printlnString (classifyExit ex))

main : UIO Unit
let main = do
    -- 1) normal exit: body-ok, exit:Success; onInterrupt skipped
    let fn <- fork normalChild
    let en <- await fn
    let _ = en
    printlnString "normal-done"
    -- 2) interrupt exit: int:Requested (onInterrupt), exit:Interrupt (onExit)
    let ready <- newPromise
    let s <- fork (sleeper ready)
    let _ <- awaitPromise ready
    interrupt s
    let ex <- await s
    match ex
      case Success v -> printlnString "completed"
      case Failure c -> printlnString "interrupted"
