module main

import std.prelude.(type Cause(..), type Exit(..), type InterruptCause(..), type InterruptTag(..))

deferredAction : UIO Unit
let deferredAction = do
    finallyIO (__reraiseCause (Interrupt (InterruptCause Requested None))) (printlnString "cleanup")
    printlnString "unreachable"

childBody : UIO Unit
let childBody = do
    defer deferredAction
    pure ()

main : UIO Unit
let main = do
    let f <- fork childBody
    let ex <- await f
    match ex
    case Success _ -> printlnString "success"
    case Failure (Interrupt (InterruptCause Requested _)) -> printlnString "interrupt"
    case Failure _ -> printlnString "other"
