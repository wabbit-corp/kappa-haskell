-- CPS LOOP FAMILY (CPS-DESIGN §4): a counter `while` loop that FORKS + AWAITS
-- once per iteration.  The block reaches `fork`/`await`, so it is CPS-lowered:
-- `var`/`while`/`:=` use selected builtin-IO MonadRef actions (OP_NEW_REF/
-- OP_WHILE/OP_WRITE_REF in this path), and the suspending bind inside the loop
-- body actually PARKS the parent on `await`.  The loop var read in the condition
-- + body is hoisted to a selected read action (OP_READ_REF in this path), so
-- each iteration re-tests and re-reads the LIVE cell — never a build-time
-- snapshot.  Output is deterministic (each await is a happens-before edge), so
-- it must match the interpreter, which runs `while` iteratively.
module main

emit : Int -> UIO Unit
let emit n = printlnString (stringAppend "tick " (showInt n))

main : UIO Unit
let main = do
    var i = 1
    while leInt i 5 do
        let f <- fork (emit i)
        let r <- await f
        i = addInt i 1
    printlnString "done"
