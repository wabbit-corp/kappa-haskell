-- Large-N var-while sum. Report-only for the C/default lane until that backend
-- has evidence-aware var-loop scalarization, or the benchmark harness grows an
-- explicit LLVM ratio lane. Boxed/kref lowering is the correctness fallback for
-- this lane, not the target.
module main
main : UIO Unit
let main = do
    var total = 0
    var i = 1
    while leInt i 100000000 do
        total = addInt total i
        i = addInt i 1
    printlnString (showInt total)
