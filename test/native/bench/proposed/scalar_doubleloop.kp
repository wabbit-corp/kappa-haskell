-- Bench: scalar_doubleloop
-- Purpose: a monomorphic Double accumulation loop — the Double analogue of the
--   Int fast path. R2.2 landed an unboxed Double worker for this shape, so this
--   fixture is now a regression guard against returning to per-iteration kdbl
--   boxing.
-- Expected optimized lowering: a scalar `double` while loop, zero
--   per-iteration allocation, no overflow escape needed (IEEE wraps/inf, unlike
--   unbounded Int).
-- Raw-C baseline idea (raw/scalar_doubleloop.c): `volatile double acc; for(...) acc+=x;`
--   runtime N. Current gate: allocation <=100KB; ratio promotion waits for a
--   stable raw-C comparison lane.
-- Failure mode it detects: Double scalars regressing to boxes, where
--   total_bytes scales with N instead of staying near zero.
module main
sumD : Double -> Int -> Double
let sumD acc n = if leInt n 0 then acc else sumD (addDouble acc (intToDouble n)) (subInt n 1)
main : UIO Unit
let main = printlnString (showDouble (sumD 0.0 2000000))
