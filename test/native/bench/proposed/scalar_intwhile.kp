-- Bench: scalar_intwhile
-- Purpose: the LLVM-backend mutable-var while-loop anchor. Under S2.3b the old
--   unboxed var-loop scalarizer is suspended because it bypassed selected
--   MonadRef evidence; this benchmark now guards the safe generic path.
-- Expected LLVM lowering: no mutable-var scalar worker; the loop is a `krt2_while`
--   do-kernel action using the checker-selected MonadRef read/write actions.
-- Result must equal: sum 0..10000000 inclusive = 50000005000000.
module main

main : UIO Unit
let main = do
    var i = 0
    var acc = 0
    while leInt i 10000000 do
        acc = addInt acc i
        i = addInt i 1
    printlnString (showInt acc)
