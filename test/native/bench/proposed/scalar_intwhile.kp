-- Bench: scalar_intwhile
-- Purpose: the LLVM-backend mutable-var while-loop anchor. Under S2.3b any
--   scalarizer must preserve the checker-selected MonadRef evidence; the old
--   evidence-oblivious raw-ref peephole is invalid, but scalarization remains
--   required when equivalence can be proven.
-- Expected LLVM lowering: an evidence-aware mutable-var scalar worker
--   (`@kscalarloop_N`) with native int64 arithmetic and no per-iteration boxed
--   `krt2_while`; unproven evidence/shapes must use the selected-action
--   fallback instead of this worker.
-- Result must equal: sum 0..10000000 inclusive = 50000005000000.
module main

main : UIO Unit
let main = do
    var i = 0
    var acc = 0
    while leInt i 10000000 do
        acc = addInt acc i
        i = addInt i 1
    printlnString (showInt acc)
