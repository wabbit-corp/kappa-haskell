module main

make : Int -> List Int -> List Int
let make n acc =
    if leInt n 0 then acc
    else make (subInt n 1) ((::) n acc)

count : List Int -> Int
let count xs =
    block
        go : List Int -> Int
        let go ys decreases listLength ys =
            match ys
            case Nil -> 0
            case _ :: rest -> addInt 1 (go rest)
        go xs

main : UIO Unit
let main = do
    let xs = make 8372 Nil
    printlnString (showInt (count xs))
--! mode run
