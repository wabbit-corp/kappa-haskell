-- xlang/forkjoin — Tier 2 Savina Fork-Join (spawn/join throughput).
--
-- Spawn N fibers, each running a small CPU task (a modular integer mixing loop
-- seeded by the fiber index), join all of them, and print a checksum.  This
-- measures fork/await throughput on the kappart2 M:N runtime, not raw compute.
--
-- DESIGN NOTES
--  * The per-fiber task is INTEGER, not sin/sqrt: Kappa exposes no transcendental
--    Double primitives (no sqrt/sin in the Prelude), and a float checksum would
--    not be byte-identical across Go/GHC/Kappa rounding anyway.  An exact modular
--    integer task is deterministic and reproducible everywhere.
--  * `modInt ... 2147483647` keeps every intermediate within a fixed-width Int —
--    the shared atomic cell holds a machine word (AtomicValue Integer is a 64-bit
--    slot), so an unbounded bignum result would be rejected at runtime — and makes
--    the result ORDER-INDEPENDENT, so the checksum is the same regardless of how
--    the workers interleave across the worker pool (addition is commutative).
--  * The checksum is accumulated through a lock-free `atomicFetchAdd`, so the
--    final total is exact with no lost updates; it equals the interpreter and is
--    deterministic across runs (verified).
--  * `spawnAll` forks fiber i, recurses to fork the REST, and only then awaits i
--    (the atomic-race idiom): every fiber is live before any join, which is the
--    Savina fork-then-join-all shape.
--
-- N = 100000 fibers, 200 mixing steps each  =>  checksum 107372465295244.
-- N is HARDCODED (getArgs/stdin do not exist yet) and must match every ref impl.
module main

import std.atomic.(type AtomicRef)
import std.atomic.(ctor RmwSeqCst, ctor LoadSeqCst)
import std.atomic.(term newAtomicRef, term atomicLoad, term atomicFetchAdd)

-- per-fiber CPU task: a modular integer mixing loop, `k` steps, seeded by `acc`.
task : Integer -> Integer -> Integer
let task acc k =
    if leInt k 0 then acc
    else task (modInt (addInt (mulInt acc 1000003) k) 2147483647) (subInt k 1)

-- one fiber: compute the task for index i, add the result to the shared cell.
worker : AtomicRef Integer -> Integer -> UIO Unit
let worker cell i = do
    let v = task (addInt i 1) 200
    let old <- atomicFetchAdd RmwSeqCst cell v
    pure ()

-- fork fibers [i, n): fork i, recurse to fork the rest, then await i.  Forking
-- the rest BEFORE awaiting this one keeps all n fibers live concurrently; the
-- awaits then establish the happens-before edge so the final load sees every add.
spawnAll : AtomicRef Integer -> Integer -> Integer -> UIO Unit
let spawnAll cell i n =
    if leInt n i then pure ()
    else do
        let f <- fork (worker cell i)
        spawnAll cell (addInt i 1) n
        let r <- await f
        pure ()

main : UIO Unit
let main = do
    let cell <- newAtomicRef 0
    spawnAll cell 0 100000             -- N HARDCODED = 100000
    let total <- atomicLoad LoadSeqCst cell
    printlnString (showInt total)      -- 107372465295244, exactly, no lost updates
